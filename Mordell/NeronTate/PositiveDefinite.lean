module

public import Mordell.AbelianVariety.EvenOddClass
public import Mordell.Algebra.Quadratic.LatticeCriterion
public import Mordell.NeronTate.Bilinear
public import Mordell.Height.Class.AmpleBoundedBelow
public import Mordell.Height.Class.Northcott
public import Mordell.AbelianVariety.SpreadingOut

/-!
# Positive definiteness of the Néron–Tate height

Let `A` be an abelian variety over a field `K` algebraic over `ℚ` and let `c ∈ Pic(A) ⊗ ℚ` be
ample and even. Then the bilinear form `B_c` of the Néron–Tate height `ĥ_c` of `c`
(`Faltings.neronTateBilinear`) is positive definite on every finitely generated subgroup
`Γ` of `A(K)`: its `ℝ`-bilinear extension to `ℝ ⊗ Γ` is a positive definite inner product.

The form `x ↦ B_c(x, x)` on `Γ` is nonnegative and has finite sublevel sets, so the lattice
criterion `Faltings.posDef_of_finite_setOf_le` gives positive definiteness.

* Nonnegativity: `B_c(x, x) = ĥ_c(x) + ĥ_c(-x)`, and `ĥ_c` is bounded below, since it differs
  by a bounded function from a height of the ample class `c`, which is bounded below. So
  `n² B_c(x, x) = B_c(n x, n x)` is bounded below in `n`, whence `B_c(x, x) ≥ 0`.
* Finiteness: a sublevel set of `B_c(x, x)` lies in a sublevel set of `ĥ_c`, which is finite on
  `Γ` by Northcott's theorem `Faltings.IsHeightOfClass.finite_setOf_pointDegree_le_and_le`, once
  the points of `Γ` are known to have bounded degree over a field of definition of `A`.

## Main results

* `Faltings.neronTateBilinear_posDef`: for a finitely generated abelian group `Γ` embedded in
  `A(K)`, there is a symmetric `ℝ`-bilinear form on `ℝ ⊗[ℤ] Γ` extending `B_c` and positive
  on every non-zero vector.

## Implementation notes

The source takes `A` over a number field `k` and `Γ ⊆ A(k̄)`; here the base field `K` is any
algebraic extension of `ℚ`, and the source's statement is the case `K = k̄` applied to the base
change of `A`.

The class `c` lies in `ℚ ⊗[ℤ] Pic(A)`, as for `Faltings.neronTateBilinear` and
`Faltings.IsEvenClass`; ampleness `Faltings.IsAmpleClass` is stated on `Pic(A) ⊗[ℤ] ℚ` and is
applied to the image of `c` under `TensorProduct.comm`.

The group `A(K)` carries the (multiplicatively written) group structure
`CategoryTheory.Hom.group`, which is not commutative as an instance. A finitely generated
subgroup `Γ ⊆ A(K)` is therefore given as a finitely generated abelian group `Γ` together with
an injective homomorphism `φ : Γ →+ Additive A(K)`; a subgroup is the case of its inclusion.
The `ℝ`-bilinear extension of `B_c` is the bilinear form on `ℝ ⊗[ℤ] Γ` whose value on
`(1 ⊗ x, 1 ⊗ y)` is `B_c(φ x, φ y)`; it is unique since the pure tensors `1 ⊗ x` span
`ℝ ⊗[ℤ] Γ` over `ℝ`.

A field of definition of `A` is produced by spreading out: `Spec K` is the limit of the spectra
of the subfields `ℚ(s) ⊆ K` generated by finite sets `s`, and the group scheme `A`, being of
finite presentation and proper, has a proper model `X` over some `ℚ(s)` whose multiplication and
inverse base change to those of `A` (Stacks, Tag 01ZM). The residue field of the image in `X` of
a product `p q` lies in any subfield of `K` containing those of `p` and `q`, and similarly for
`p⁻¹`. So the residue fields of the points of `Γ` all lie in the compositum `L` of those of its
generators and of the origin, a finite extension of `ℚ(s)`, and their degrees are bounded by
`[L : ℚ(s)]`. Evenness of `c` is not used.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Sec. 2 and Sec. 5.
* X. Wu, *Diophantine geometry*, Lemma 2.6.
* [The Stacks Project][stacks], Tag 01ZM
-/

public section

open CategoryTheory AlgebraicGeometry TensorProduct
open scoped MonObj

universe u

namespace Faltings

/-- The `ℝ`-bilinear extension to `ℝ ⊗[ℤ] Γ` of a symmetric biadditive real form `b` on a
finitely generated abelian group `Γ`, with `0 ≤ b x x` and finite sublevel sets, is
symmetric and positive definite. -/
private theorem exists_bilinForm_tmul_isSymm_pos {Γ : Type*} [AddCommGroup Γ] [AddGroup.FG Γ]
    (b : Γ →+ Γ →+ ℝ) (hb : ∀ x y, b x y = b y x)
    (hq : ∀ x, 0 ≤ b x x) (hfin : ∀ C : ℝ, {x : Γ | b x x ≤ C}.Finite) :
    ∃ B : LinearMap.BilinForm ℝ (ℝ ⊗[ℤ] Γ),
      (∀ x y : Γ, B (1 ⊗ₜ x) (1 ⊗ₜ y) = b x y) ∧
      B.IsSymm ∧ ∀ v : ℝ ⊗[ℤ] Γ, v ≠ 0 → 0 < B v v := by
  have : Module.Finite ℤ Γ := Module.Finite.iff_addGroup_fg.mpr ‹_›
  let bZ : Γ →ₗ[ℤ] Γ →ₗ[ℤ] ℝ :=
    { toFun := fun x => (b x).toIntLinearMap
      map_add' := fun x y => by ext; simp
      map_smul' := fun n x => by ext; simp }
  let B : LinearMap.BilinForm ℝ (ℝ ⊗[ℤ] Γ) :=
    LinearMap.liftBaseChange ℝ
      (((LinearMap.liftBaseChangeEquiv ℝ).toLinearMap.restrictScalars ℤ) ∘ₗ bZ)
  have hB : ∀ x y : Γ, B (1 ⊗ₜ x) (1 ⊗ₜ y) = b x y := fun x y => by
    rw [LinearMap.liftBaseChange_tmul, one_smul]
    exact (LinearMap.liftBaseChange_tmul ℝ (bZ x) 1 y).trans (one_smul _ _)
  have hsymm : LinearMap.flip B = B := by
    refine TensorProduct.AlgebraTensorModule.ext fun r x => ?_
    refine TensorProduct.AlgebraTensorModule.ext fun s y => ?_
    have h1 : (r ⊗ₜ[ℤ] x : ℝ ⊗[ℤ] Γ) = r • (1 ⊗ₜ x) := by rw [smul_tmul', smul_eq_mul, mul_one]
    have h2 : (s ⊗ₜ[ℤ] y : ℝ ⊗[ℤ] Γ) = s • (1 ⊗ₜ y) := by rw [smul_tmul', smul_eq_mul, mul_one]
    rw [LinearMap.flip_apply, h1, h2]
    simp only [map_smul, LinearMap.smul_apply, hB, hb x y, smul_eq_mul]
    ring
  exact ⟨B, hB, LinearMap.BilinForm.isSymm_def.2 fun v w => LinearMap.congr_fun₂ hsymm w v,
    fun v hv => posDef_of_finite_setOf_le b hb hq hfin (TensorProduct.mk ℤ ℝ Γ 1)
      (TensorProduct.isBaseChange ℤ Γ ℝ) B hB v hv⟩

/-- A biadditive form on an abelian group whose diagonal is bounded below is nonnegative on the
diagonal, since `b (n x) (n x) = n² b x x`. -/
private theorem self_nonneg_of_le_self {G : Type*} [AddCommGroup G] (b : G →+ G →+ ℝ) {M : ℝ}
    (h : ∀ x, M ≤ b x x) (x : G) : 0 ≤ b x x := by
  by_contra! hb
  obtain ⟨n, hn⟩ := exists_nat_gt (M / b x x)
  have hsq : b (n • x) (n • x) = (n : ℝ) ^ 2 * b x x := by
    simp only [map_nsmul, AddMonoidHom.nsmul_apply, nsmul_eq_mul]; ring
  have hn' : (n : ℝ) * b x x < M := (div_lt_iff_of_neg hb).1 hn
  have hn1 : (0 : ℝ) ≤ n * (n - 1) := by
    rcases n with _ | n
    · simp
    · push_cast; nlinarith
  nlinarith [h (n • x)]

section Height

variable {K : Type u} [Field K] [Algebra ℚ K] [Algebra.IsAlgebraic ℚ K]
  (A : Over (Spec (CommRingCat.of K))) [GrpObj A] [IsAbelianVariety K A]
  (c : ℚ ⊗[ℤ] Stacks.Picard.ofScheme A.left)

/-- The Néron–Tate height `ĥ_c` underlying `neronTateBilinear A c`, on the group `A(K)`. -/
private noncomputable abbrev ntHeight
    (z : Additive (Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A)) : ℝ :=
  Classical.epsilon (IsNeronTateHeight A c) ⟨z.toMul.left, Over.w z.toMul⟩

/-- `B_c(z, z) = ĥ_c(z) + ĥ_c(-z)`: both sides are `b(z, z)` for `ĥ_c = ½ b(z, z) + ℓ(z)`. -/
private theorem neronTateBilinear_self_eq_add_neg
    (z : Additive (Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A)) :
    neronTateBilinear A c z z = ntHeight A c z + ntHeight A c (-z) := by
  have : IsCommMonObj A := isCommMonObj_of_isProper_of_geometricallyIntegral A
  obtain ⟨-, b, -, ℓ, hf⟩ :=
    Classical.epsilon_spec (exists_isNeronTateHeight_of_isAlgebraic A c)
  have hfz : ∀ z, ntHeight A c z = b z z / 2 + ℓ z := fun z => hf _
  rw [neronTateBilinear_apply]
  change ntHeight A c (z + z) - ntHeight A c z - ntHeight A c z = _
  simp only [hfz, map_add, map_neg, AddMonoidHom.add_apply, AddMonoidHom.neg_apply, neg_neg]
  ring

/-- The Néron–Tate height of an ample class is bounded below on `A(K)`. -/
private theorem exists_le_ntHeight [IsProjectiveVariety K A.hom] [Smooth A.hom]
    (hample : IsAmpleClass A.hom (TensorProduct.comm ℤ ℚ _ c)) :
    ∃ D, ∀ z, D ≤ ntHeight A c z := by
  obtain ⟨⟨h, hh, C, hC⟩, -⟩ :=
    Classical.epsilon_spec (exists_isNeronTateHeight_of_isAlgebraic A c)
  obtain ⟨D, hD⟩ := hh.exists_le_of_isAmpleClass hample
  refine ⟨D - C, fun z => ?_⟩
  have := (abs_le.1 (hC ⟨z.toMul.left, Over.w z.toMul⟩)).1
  have := hD ⟨z.toMul.left, Over.w z.toMul⟩
  linarith

end Height

/-! ### Spreading out `A` over a number field -/

section SpreadingOut

open CategoryTheory.Limits MonoidalCategory CartesianMonoidalCategory Stacks.EtaleCohomology

variable {K : Type u} [Field K]

/-- The prime field `ℚ ⊆ K`, as a field in the universe of `K`. -/
private abbrev primeField (K : Type u) [Field K] [Algebra ℚ K] : Type u :=
  ↥(⊥ : IntermediateField ℚ K)

/-- The subfield `ℚ(s) ⊆ K` generated by a finite set `s`. -/
private abbrev stageField [Algebra ℚ K] (s : Finset K) : Type u :=
  ↥(IntermediateField.adjoin (primeField K) (s : Set K))

/-- The inverse system of the `Spec ℚ(s)`, for the finite subsets `s ⊆ K`. -/
private noncomputable abbrev stageDiagram (K : Type u) [Field K] [Algebra ℚ K] :
    (Finset K)ᵒᵖ ⥤ Scheme.{u} :=
  (finsetIntermediateFieldDiagram (primeField K) K).op ⋙ Scheme.Spec

/-- The cone of the `Spec K ⟶ Spec ℚ(s)` over `stageDiagram K`. -/
private noncomputable abbrev stageCone (K : Type u) [Field K] [Algebra ℚ K] :
    Cone (stageDiagram K) :=
  Scheme.Spec.mapCone (finsetIntermediateFieldCocone (primeField K) K).op

/-- `Spec K` is the limit of the `Spec ℚ(s)`, since `K` is the filtered colimit of the `ℚ(s)`. -/
private noncomputable def isLimit_stageCone (K : Type u) [Field K] [Algebra ℚ K] :
    IsLimit (stageCone K) :=
  isLimitOfPreserves Scheme.Spec (finsetIntermediateFieldIsColimit (K := primeField K) (L := K)).op

/-- A scheme over `Spec K`, seen over the vertex of `stageCone K`. -/
private abbrev overStageCone [Algebra ℚ K] (A : Over (Spec (CommRingCat.of K))) :
    Over (stageCone K).pt :=
  A

/-- The group structure of `A`, seen over the vertex of `stageCone K`. -/
@[instance_reducible]
private def grpObjOverStageCone [Algebra ℚ K] (A : Over (Spec (CommRingCat.of K))) [GrpObj A] :
    GrpObj (overStageCone A) :=
  ‹GrpObj A›

/-- The group structure of `A`, seen over the source of the leg of `stageCone K` at `i`. -/
@[instance_reducible]
private def grpObjOverStageConeLeg [Algebra ℚ K] (A : Over (Spec (CommRingCat.of K))) [GrpObj A]
    (i : (Finset K)ᵒᵖ) :
    GrpObj (C := Over (((Functor.const (Finset K)ᵒᵖ).obj (stageCone K).pt).obj i))
      (overStageCone A) :=
  ‹GrpObj A›

attribute [local instance] grpObjOverStageCone grpObjOverStageConeLeg

private theorem isScalarTower_rat {E : Type u} [Field E] [Algebra ℚ E] [Algebra E K]
    [Algebra ℚ K] : IsScalarTower ℚ E K :=
  IsScalarTower.of_algebraMap_eq' (Subsingleton.elim _ _)

/-- The field `ℚ(s)` is a number field. -/
private theorem numberField_stageField [Algebra ℚ K] [Algebra.IsAlgebraic ℚ K] (s : Finset K) :
    NumberField (stageField s) := by
  have := isScalarTower_rat (E := primeField K) (K := K)
  have : FiniteDimensional (primeField K) (stageField s) :=
    IntermediateField.finiteDimensional_adjoin fun x _ =>
      (Algebra.IsAlgebraic.isAlgebraic (R := ℚ) x).isIntegral.tower_top
  have h : FiniteDimensional ℚ (stageField s) := Module.Finite.trans (primeField K) _
  refine { to_finiteDimensional := ?_ }
  convert h
  exact Subsingleton.elim _ _

/-- A proper group scheme of finite presentation over the limit of a cofiltered system has a
proper model at some stage, with a multiplication and an inverse whose base changes are those of
the group scheme (Stacks, Tag 01ZM). -/
private theorem exists_model_of_isLimit {I : Type u} [Category.{u} I] [IsCofiltered I]
    [EssentiallySmall.{u} I] (D : I ⥤ Scheme.{u}) (c : Cone D) (hc : IsLimit c)
    [∀ {i j : I} (e : i ⟶ j), IsAffineHom (D.map e)] [∀ i : I, CompactSpace (D.obj i)]
    [∀ i : I, QuasiSeparatedSpace (D.obj i)] (A : Over c.pt) [GrpObj A]
    (hA : FinitePresentation A.hom) (hp : IsProper A.hom) :
    ∃ (i : I) (X : Over (D.obj i)) (φ : (Over.pullback (c.π.app i)).obj X ≅ A)
      (m : X ⊗ X ⟶ X) (v : X ⟶ X),
      IsProper X.hom ∧ MulCompat (Over.pullback (c.π.app i)) m φ ∧
        InvCompat (Over.pullback (c.π.app i)) v φ := by
  have : MorphismProperty.RespectsIso (@IsProper : MorphismProperty Scheme.{u}) :=
    MorphismProperty.IsStableUnderBaseChange.respectsIso
  -- a model of finite presentation
  obtain ⟨i₀, X₀, hX₀, ⟨e₀⟩⟩ :=
    LimitFPObjectDescent.exists_model_of_finitePresentation D c hc A hA
  let φ₀ : (Over.pullback (c.π.app i₀)).obj X₀ ≅ A := e₀.symm
  -- properness is attained at a stage
  have hp₀ : IsProper ((Over.pullback (c.π.app i₀)).obj X₀).hom := by
    rw [← Over.w φ₀.hom]
    have : IsIso φ₀.hom.left := inferInstanceAs (IsIso ((Over.forget _).mapIso φ₀).hom)
    exact (MorphismProperty.cancel_left_of_respectsIso @IsProper _ _).2 hp
  obtain ⟨i₁, e₁, hp₁⟩ := exists_isProper_pullback D c hc X₀ hX₀ hp₀
  let X₁ := (Over.pullback (D.map e₁)).obj X₀
  let φ₁ : (Over.pullback (c.π.app i₁)).obj X₁ ≅ A :=
    (pullbackCompIso D c e₁).app X₀ ≪≫ φ₀
  have hX₁ : FinitePresentation X₁.hom := finitePresentation_pullback _ hX₀
  -- the multiplication descends
  obtain ⟨i₂, e₂, g₂, hg₂⟩ := exists_map_eq D c hc (finitePresentation_tensor hX₁ hX₁) hX₁
    (Functor.OplaxMonoidal.δ (Over.pullback (c.π.app i₁)) X₁ X₁ ≫ (φ₁.hom ⊗ₘ φ₁.hom) ≫
      μ[A] ≫ φ₁.inv)
  let X₂ := (Over.pullback (D.map e₂)).obj X₁
  let φ₂ : (Over.pullback (c.π.app i₂)).obj X₂ ≅ A :=
    (pullbackCompIso D c e₂).app X₁ ≪≫ φ₁
  let m₂ : X₂ ⊗ X₂ ⟶ X₂ := Functor.LaxMonoidal.μ (Over.pullback (D.map e₂)) X₁ X₁ ≫ g₂
  have hm₂ : MulCompat (Over.pullback (c.π.app i₂)) m₂ φ₂ :=
    mulCompat_of_map_eq _ _ (pullbackCompIso D c e₂) φ₁ g₂ hg₂
  have hX₂ : FinitePresentation X₂.hom := finitePresentation_pullback _ hX₁
  -- the inverse descends
  obtain ⟨i₃, e₃, g₃, hg₃⟩ := exists_map_eq D c hc hX₂ hX₂ (φ₂.hom ≫ ι[A] ≫ φ₂.inv)
  have hp₂ : IsProper X₂.hom := by
    have : IsProper X₁.hom := hp₁
    exact inferInstanceAs (IsProper (pullback.snd X₁.hom (D.map e₂)))
  refine ⟨i₃, (Over.pullback (D.map e₃)).obj X₂, (pullbackCompIso D c e₃).app X₂ ≪≫ φ₂,
    Functor.LaxMonoidal.μ (Over.pullback (D.map e₃)) X₂ X₂ ≫ (Over.pullback (D.map e₃)).map m₂,
    g₃, ?_, hm₂.transport _ _ (pullbackCompIso D c e₃) _,
    invCompat_of_map_eq _ _ (pullbackCompIso D c e₃) φ₂ g₃ hg₃⟩
  exact inferInstanceAs (IsProper (pullback.snd X₂.hom (D.map e₃)))

/-- An abelian variety over `K` has a proper model over some `Spec ℚ(s)`, with a multiplication
and an inverse whose base changes to `Spec K` are those of `A`. -/
private theorem exists_model [Algebra ℚ K] (A : Over (Spec (CommRingCat.of K))) [GrpObj A]
    [IsAbelianVariety K A] :
    ∃ (i : (Finset K)ᵒᵖ) (X : Over ((stageDiagram K).obj i))
      (φ : (Over.pullback ((stageCone K).π.app i)).obj X ≅ overStageCone A)
      (m : X ⊗ X ⟶ X) (v : X ⟶ X),
      IsProper X.hom ∧ MulCompat (Over.pullback ((stageCone K).π.app i)) m φ ∧
        InvCompat (Over.pullback ((stageCone K).π.app i)) v φ := by
  have : EssentiallySmall.{u} (Finset K)ᵒᵖ := essentiallySmallSelf _
  have {i j : (Finset K)ᵒᵖ} (e : i ⟶ j) : IsAffineHom ((stageDiagram K).map e) :=
    inferInstanceAs (IsAffineHom (Spec.map _))
  have (i : (Finset K)ᵒᵖ) : CompactSpace ((stageDiagram K).obj i) :=
    inferInstanceAs (CompactSpace (Spec _))
  have (i : (Finset K)ᵒᵖ) : QuasiSeparatedSpace ((stageDiagram K).obj i) :=
    inferInstanceAs (QuasiSeparatedSpace (Spec _))
  have hA : FinitePresentation A.hom := ⟨inferInstance, inferInstance, inferInstance⟩
  have hp : IsProper A.hom := inferInstance
  exact exists_model_of_isLimit (stageDiagram K) (stageCone K) (isLimit_stageCone K)
    (overStageCone A) hA hp

/-- The field of definition of `A` over `ℚ(s)` given by a proper model at the stage `s`. -/
private noncomputable def fieldOfDefinitionOfModel [Algebra ℚ K] [Algebra.IsAlgebraic ℚ K]
    (A : Over (Spec (CommRingCat.of K))) [GrpObj A] [IsAbelianVariety K A]
    [IsProjectiveVariety K A.hom] {i : (Finset K)ᵒᵖ} {X : Over ((stageDiagram K).obj i)}
    (φ : (Over.pullback ((stageCone K).π.app i)).obj X ≅ overStageCone A)
    (hM : IsProper X.hom) :
    letI := numberField_stageField i.unop
    Faltings.FieldOfDefinition K A.hom (stageField i.unop) :=
  letI := numberField_stageField i.unop
  { model := X.left
    toSpec := X.hom
    isVariety := by
      have : IsIntegral (pullback X.hom ((stageCone K).π.app i)) :=
        isIntegral_of_flat_of_surjective ((Over.forget _).mapIso φ.symm).hom
      obtain ⟨h1, h2⟩ := flat_surjective_Spec_map (algebraMap (stageField i.unop) K)
      have : Flat ((stageCone K).π.app i) := h1
      have : Surjective ((stageCone K).π.app i) := h2
      have : Flat (pullback.fst X.hom ((stageCone K).π.app i)) := inferInstance
      have : Surjective (pullback.fst X.hom ((stageCone K).π.app i)) := inferInstance
      have := isIntegral_of_flat_of_surjective
        (pullback.fst X.hom ((stageCone K).π.app i))
      have hqc : QuasiCompact (X.hom : X.left ⟶ (stageDiagram K).obj i) := by
        have := hM; infer_instance
      exact @IsVariety.mk _ _ _ X.hom this hM.toIsSeparated hM.toLocallyOfFiniteType hqc
    iso := (Over.forget _).mapIso φ.symm
    iso_hom_snd := Over.w φ.inv }

end SpreadingOut

/-! ### Points of the model and their residue fields -/

section ModelPoint

open CategoryTheory.Limits MonoidalCategory CartesianMonoidalCategory Functor.LaxMonoidal

variable {K : Type u} [Field K] {S : Scheme.{u}} {π : Spec (CommRingCat.of K) ⟶ S} {X : Over S}
  {A : Over (Spec (CommRingCat.of K))} [GrpObj A] (φ : (Over.pullback π).obj X ≅ A)

/-- The image in the model `X` of a point `p` of `A`, for an identification `φ` of the base
change of `X` with `A`. -/
private noncomputable def modelPoint (p : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A) :
    Spec (CommRingCat.of K) ⟶ X.left :=
  (p ≫ φ.inv).left ≫ pullback.fst X.hom π

omit [GrpObj A] in
private theorem modelPoint_comp_hom (p : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A) :
    modelPoint φ p ≫ X.hom = π := by
  simp only [modelPoint, Category.assoc, pullback.condition]
  have := Over.w (p ≫ φ.inv)
  simp only [Over.pullback_obj_hom, Over.mk_hom] at this
  rw [← Category.assoc, this, Category.id_comp]

/-- The image of a product `p q` in the model is the image of `(p, q)` in `X ×_S X` followed by
the multiplication `m` of the model. -/
private theorem exists_modelPoint_mul {m : X ⊗ X ⟶ X}
    (hm : MulCompat (Over.pullback π) m φ)
    (p q : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A) :
    ∃ w : Spec (CommRingCat.of K) ⟶ pullback X.hom X.hom,
      w ≫ pullback.fst _ _ = modelPoint φ p ∧ w ≫ pullback.snd _ _ = modelPoint φ q ∧
        modelPoint φ (p * q) = w ≫ m.left := by
  have key : (p * q) ≫ φ.inv = lift (p ≫ φ.inv) (q ≫ φ.inv) ≫
      Functor.LaxMonoidal.μ (Over.pullback π) X X ≫ (Over.pullback π).map m := by
    rw [Hom.mul_def]
    have h2 : μ[A] ≫ φ.inv = (φ.inv ⊗ₘ φ.inv) ≫ Functor.LaxMonoidal.μ (Over.pullback π) X X ≫
        (Over.pullback π).map m := by
      rw [Iso.comp_inv_eq]
      simp only [Category.assoc]
      rw [hm, ← Category.assoc, tensorHom_comp_tensorHom, Iso.inv_hom_id, tensorHom_id,
        id_whiskerRight, Category.id_comp]
    rw [Category.assoc, h2, ← Category.assoc, lift_map]
  refine ⟨(lift (p ≫ φ.inv) (q ≫ φ.inv) ≫
    Functor.LaxMonoidal.μ (Over.pullback π) X X).left ≫ pullback.fst _ _, ?_, ?_, ?_⟩
  · simp only [Over.comp_left, Category.assoc]
    rw [Over.μ_pullback_left_fst_fst]
    simp only [Over.lift_left]
    erw [pullback.lift_fst_assoc]
    rfl
  · simp only [Over.comp_left, Category.assoc]
    rw [Over.μ_pullback_left_fst_snd]
    simp only [Over.lift_left]
    erw [pullback.lift_snd_assoc]
    rfl
  · simp only [modelPoint, key, Over.comp_left, Category.assoc]
    congr 2
    erw [pullback.lift_fst]

/-- The image of an inverse `p⁻¹` in the model is the image of `p` followed by the inverse `v`
of the model. -/
private theorem modelPoint_inv {v : X ⟶ X} (hv : InvCompat (Over.pullback π) v φ)
    (p : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A) :
    modelPoint φ p⁻¹ = modelPoint φ p ≫ v.left := by
  have h : ι[A] ≫ φ.inv = φ.inv ≫ (Over.pullback π).map v := by
    rw [Iso.comp_inv_eq, Category.assoc, hv, Iso.inv_hom_id_assoc]
  simp only [modelPoint, Hom.inv_def, Category.assoc, h, Over.comp_left]
  erw [pullback.lift_fst]

/-- The residue field of a `K`-point `q` of a scheme, as a subfield of `K`. -/
private noncomputable abbrev residueRange {Y : Scheme.{u}} (q : Spec (CommRingCat.of K) ⟶ Y) :
    Subfield K :=
  (Y.descResidueField (Scheme.stalkClosedPointTo q)).hom.fieldRange

/-- A `K`-point whose residue field lies in `L` factors through `Spec L`. -/
private theorem exists_spec_comp_eq_of_residueRange_le {Y : Scheme.{u}}
    (q : Spec (CommRingCat.of K) ⟶ Y) (L : Subfield K) (h : residueRange q ≤ L) :
    ∃ r : Spec (CommRingCat.of L) ⟶ Y, Spec.map (CommRingCat.ofHom L.subtype) ≫ r = q := by
  let β := (Y.descResidueField (Scheme.stalkClosedPointTo q)).hom.codRestrict L
    fun y => h ⟨y, rfl⟩
  refine ⟨Spec.map (CommRingCat.ofHom β) ≫ Y.fromSpecResidueField _, ?_⟩
  rw [← Category.assoc, ← Spec.map_comp]
  exact Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K Y q

/-- A `K`-point factoring through `Spec L` has residue field in `L`. -/
private theorem residueRange_le_of_spec_comp_eq {Y : Scheme.{u}}
    {q : Spec (CommRingCat.of K) ⟶ Y} (L : Subfield K) (r : Spec (CommRingCat.of L) ⟶ Y)
    (hr : Spec.map (CommRingCat.ofHom L.subtype) ≫ r = q) : residueRange q ≤ L := by
  simpa using fieldRange_descResidueField_le L.subtype r hr

private theorem epi_spec_map_subtype (L : Subfield K) :
    Epi (Spec.map (CommRingCat.ofHom L.subtype)) := by
  obtain ⟨h1, h2⟩ := flat_surjective_Spec_map L.subtype
  exact Flat.epi_of_flat_of_surjective _

/-- If the residue fields of the images of `p` and `q` lie in `L`, so does that of `p q`. -/
private theorem residueRange_modelPoint_mul_le {m : X ⊗ X ⟶ X}
    (hm : MulCompat (Over.pullback π) m φ) (L : Subfield K)
    {p q : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A}
    (hp : residueRange (modelPoint φ p) ≤ L) (hq : residueRange (modelPoint φ q) ≤ L) :
    residueRange (modelPoint φ (p * q)) ≤ L := by
  obtain ⟨w, hw1, hw2, hw⟩ := exists_modelPoint_mul φ hm p q
  obtain ⟨rp, hrp⟩ := exists_spec_comp_eq_of_residueRange_le _ L hp
  obtain ⟨rq, hrq⟩ := exists_spec_comp_eq_of_residueRange_le _ L hq
  have := epi_spec_map_subtype L
  have hc : rp ≫ X.hom = rq ≫ X.hom := by
    rw [← cancel_epi (Spec.map (CommRingCat.ofHom L.subtype)), ← Category.assoc,
      ← Category.assoc, hrp, hrq, modelPoint_comp_hom, modelPoint_comp_hom]
  have hw' : w = Spec.map (CommRingCat.ofHom L.subtype) ≫ pullback.lift rp rq hc := by
    apply pullback.hom_ext
    · rw [hw1, Category.assoc, pullback.lift_fst, hrp]
    · rw [hw2, Category.assoc, pullback.lift_snd, hrq]
  rw [hw, hw', Category.assoc]
  exact residueRange_le_of_spec_comp_eq L _ rfl

/-- If the residue field of the image of `p` lies in `L`, so does that of `p⁻¹`. -/
private theorem residueRange_modelPoint_inv_le {v : X ⟶ X}
    (hv : InvCompat (Over.pullback π) v φ) (L : Subfield K)
    {p : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A}
    (hp : residueRange (modelPoint φ p) ≤ L) : residueRange (modelPoint φ p⁻¹) ≤ L := by
  rw [modelPoint_inv φ hv]
  exact (fieldRange_descResidueField_comp_le _ _ rfl).trans hp

end ModelPoint

section Northcott

attribute [local instance] grpObjOverStageCone grpObjOverStageConeLeg

/-- **Northcott on a finitely generated subgroup**: the Néron–Tate height `ĥ_c` of an ample
class has finite sublevel sets on a finitely generated subgroup of `A(K)`. -/
private theorem finite_setOf_neronTateHeight_le {K : Type u} [Field K] [Algebra ℚ K]
    [Algebra.IsAlgebraic ℚ K] (A : Over (Spec (CommRingCat.of K))) [GrpObj A]
    [IsAbelianVariety K A] [IsProjectiveVariety K A.hom] [Smooth A.hom]
    (c : ℚ ⊗[ℤ] Stacks.Picard.ofScheme A.left)
    (hample : IsAmpleClass A.hom (TensorProduct.comm ℤ ℚ _ c))
    {Γ : Type*} [AddCommGroup Γ] [AddGroup.FG Γ]
    (φ : Γ →+ Additive (Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A))
    (hφ : Function.Injective φ) (C : ℝ) :
    {x : Γ | ntHeight A c (φ x) ≤ C}.Finite := by
  obtain ⟨i, X, φM, m, v, hM, hm, hv⟩ := exists_model A
  let := numberField_stageField i.unop
  have := isScalarTower_rat (E := stageField i.unop) (K := K)
  have : Algebra.IsAlgebraic (stageField i.unop) K := Algebra.IsAlgebraic.tower_top (K := ℚ) _
  let F := fieldOfDefinitionOfModel A φM hM
  obtain ⟨⟨h, hh, C₁, hC⟩, -⟩ :=
    Classical.epsilon_spec (exists_isNeronTateHeight_of_isAlgebraic A c)
  obtain ⟨-, S, -, hS⟩ := AddGroup.fg_iff'.mp ‹AddGroup.FG Γ›
  -- the residue field of a point over the field of definition `ℚ(s)`
  let res (P : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A) :
      IntermediateField (stageField i.unop) K :=
    F.pointResidueField P.left (Over.w P)
  have hres (P : Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A) :
      (res P).toSubfield = residueRange (modelPoint (A := A) φM P) := rfl
  -- `L` is the compositum of the residue fields of the origin and of the generators
  let gen : Option S → (Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A) :=
    fun o => o.elim 1 fun g => (φ g).toMul
  let L : IntermediateField (stageField i.unop) K := ⨆ o, res (gen o)
  have : ∀ o, FiniteDimensional (stageField i.unop) (res (gen o)) := fun o =>
    F.finiteDimensional_pointResidueField _ _
  have : FiniteDimensional (stageField i.unop) L :=
    IntermediateField.finiteDimensional_iSup_of_finite
  have hgen (o : Option S) : residueRange (modelPoint (A := A) φM (gen o)) ≤ L.toSubfield := by
    rw [← hres]
    exact le_iSup (fun o => res (gen o)) o
  have hG (x : Γ) : residueRange (modelPoint (A := A) φM (φ x).toMul) ≤ L.toSubfield := by
    have hx : x ∈ AddSubgroup.closure (S : Set Γ) := hS ▸ AddSubgroup.mem_top x
    induction hx using AddSubgroup.closure_induction with
    | mem g hg => exact hgen (some ⟨g, hg⟩)
    | zero => rw [map_zero, toMul_zero]; exact hgen none
    | add x y _ _ hx hy =>
      rw [map_add, toMul_add]
      exact residueRange_modelPoint_mul_le φM hm _ hx hy
    | neg x _ hx =>
      rw [map_neg, toMul_neg]
      exact residueRange_modelPoint_inv_le φM hv _ hx
  have hdeg (x : Γ) : F.pointDegree (φ x).toMul.left (Over.w (φ x).toMul) ≤
      Module.finrank (stageField i.unop) L :=
    IntermediateField.finrank_le_of_le_right fun y hy => hG x hy
  have hfin := IsHeightOfClass.finite_setOf_pointDegree_le_and_le F hample hh
    (Module.finrank (stageField i.unop) L) Module.finrank_pos (C + C₁)
  let sec (x : Γ) : {p : Spec (CommRingCat.of K) ⟶ A.left // p ≫ A.hom = 𝟙 _} :=
    ⟨(φ x).toMul.left, Over.w (φ x).toMul⟩
  have hinj : Function.Injective sec := fun x y hxy =>
    hφ (Additive.toMul.injective (Over.OverMorphism.ext (congrArg Subtype.val hxy)))
  refine (hfin.preimage hinj.injOn).subset fun x hx => ⟨hdeg x, ?_⟩
  have hx' : ntHeight A c (φ x) ≤ C := hx
  linarith [(abs_le.1 (hC (sec x))).1]

end Northcott

/-- **Positive definiteness of the Néron–Tate height.** Let `A` be an abelian variety over a
field `K` algebraic over `ℚ` and `c ∈ Pic(A) ⊗ ℚ` ample and even. For every finitely generated
abelian group `Γ` embedded in `A(K)` by `φ`, the `ℝ`-bilinear extension of
`B_c = Faltings.neronTateBilinear A c` to `ℝ ⊗[ℤ] Γ` is a positive definite inner product. -/
@[faltings "thm_nt_neron_tate_positive_definite"]
theorem neronTateBilinear_posDef {K : Type u} [Field K] [Algebra ℚ K]
    [Algebra.IsAlgebraic ℚ K] (A : Over (Spec (CommRingCat.of K))) [GrpObj A]
    [IsAbelianVariety K A] [IsProjectiveVariety K A.hom] [Smooth A.hom]
    (c : ℚ ⊗[ℤ] Stacks.Picard.ofScheme A.left)
    (hample : IsAmpleClass A.hom (TensorProduct.comm ℤ ℚ _ c))
    (heven : IsEvenClass K A c)
    {Γ : Type*} [AddCommGroup Γ] [AddGroup.FG Γ]
    (φ : Γ →+ Additive (Over.mk (𝟙 (Spec (CommRingCat.of K))) ⟶ A))
    (hφ : Function.Injective φ) :
    ∃ B : LinearMap.BilinForm ℝ (ℝ ⊗[ℤ] Γ),
      (∀ x y : Γ, B (1 ⊗ₜ x) (1 ⊗ₜ y) = neronTateBilinear A c (φ x) (φ y)) ∧
      B.IsSymm ∧ ∀ v : ℝ ⊗[ℤ] Γ, v ≠ 0 → 0 < B v v := by
  obtain ⟨b, hbB, hbs⟩ := neronTateBilinear_symm_and_biadditive A c
  obtain ⟨D, hD⟩ := exists_le_ntHeight A c hample
  have hself (x : Γ) : ntHeight A c (φ x) + D ≤ (b.comp φ).compl₂ φ x x := by
    rw [AddMonoidHom.compl₂_apply, AddMonoidHom.comp_apply, hbB,
      neronTateBilinear_self_eq_add_neg]
    linarith [hD (-φ x)]
  simpa [hbB] using exists_bilinForm_tmul_isSymm_pos ((b.comp φ).compl₂ φ)
    (fun x y => hbs (φ x) (φ y))
    (self_nonneg_of_le_self (M := 2 * D) _ fun x => by linarith [hself x, hD (φ x)])
    fun C => (finite_setOf_neronTateHeight_le A c hample φ hφ (C - D)).subset
      fun x (hx : _ ≤ C) => show _ ≤ C - D by linarith [hself x]

end Faltings

