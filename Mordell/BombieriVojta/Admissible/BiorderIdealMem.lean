module
public import Mordell.BombieriVojta.Admissible.BiorderIdeal

/-!
# Membership in the ideals `J_{A,B}`

Let `C` be a scheme over a field `K`, `x` a point of `C ×_K C` with projections `z` and `w`, and
`ς`, `ς'` local uniformizing parameters of `C` at `z` and `w`. Suppose the completed local ring
`𝒪̂_x` is identified with `K⟦X₀, X₁⟧` by a ring isomorphism `φ` that is the identity on `K` and
sends `ς ∘ pr₁ ↦ X₀`, `ς' ∘ pr₂ ↦ X₁`. Then an element `a` of `𝒪̂_x`, expanded as
`φ a = ∑ c_{ij} X₀^i X₁^j`, lies in `J_{A,B} = 𝔪_z^{A+1} 𝒪̂_x + 𝔪_w^{B+1} 𝒪̂_x` if and only if
`c_{ij} = 0` for all `i ≤ A` and `j ≤ B`.

## Main results

* `Faltings.mem_completedStalkBiorderIdeal_iff_coeff`: the membership criterion for
  `Faltings.completedStalkBiorderIdeal` in terms of the coefficients of the expansion.

## Implementation notes

The source states the lemma for a curve `C` over `k̄` at a point of `(C × C)(k̄)`, with
`𝒪̂_{(z,w)} = k̄⟦ς, ς'⟧`. Here `C` is any scheme over any field `K`, and the identification is
an explicit ring isomorphism `φ` with `MvPowerSeries (Fin 2) K`, pinned by its values on `K` and
on `ς ∘ pr₁`, `ς' ∘ pr₂` (as in `Faltings.IsAdmissiblePair`). The existence of such a `φ` forces
`x` to be `K`-rational with `(ς ∘ pr₁, ς' ∘ pr₂)` a regular system of parameters, so these are
not assumed separately.

## References

* [E. Bombieri, *The Mordell conjecture revisited*, §6][bombieri1990]
-/

open AlgebraicGeometry CategoryTheory Limits IsLocalRing

namespace Faltings

universe u

/-- In `R⟦X₀, X₁⟧`, a power series lies in `(X₀^{A+1}, X₁^{B+1})` iff its coefficients of
`X₀^i X₁^j` with `i ≤ A`, `j ≤ B` vanish. -/
private lemma mem_span_X_pow_sup_span_X_pow_iff {R : Type*} [CommRing R] (A B : ℕ)
    (p : MvPowerSeries (Fin 2) R) :
    p ∈ Ideal.span {MvPowerSeries.X 0 ^ (A + 1)} ⊔ Ideal.span {MvPowerSeries.X 1 ^ (B + 1)} ↔
      ∀ i ≤ A, ∀ j ≤ B,
        MvPowerSeries.coeff (Finsupp.single 0 i + Finsupp.single 1 j) p = 0 := by
  classical
  simp only [Submodule.mem_sup, Ideal.mem_span_singleton, MvPowerSeries.X_pow_dvd_iff]
  constructor
  · rintro ⟨y, hy, z, hz, rfl⟩ i hi j hj
    rw [map_add, hy _ (by simpa using Nat.lt_succ_of_le hi),
      hz _ (by simpa using Nat.lt_succ_of_le hj), add_zero]
  · intro h
    let q : MvPowerSeries (Fin 2) R := fun e => if A < e 0 then MvPowerSeries.coeff e p else 0
    refine ⟨q, fun m hm => ite_eq_right_iff.2 fun h' => absurd h' (by omega), p - q,
      fun m hm => ?_, add_sub_cancel _ _⟩
    rw [map_sub, sub_eq_zero]
    change MvPowerSeries.coeff m p = if A < m 0 then MvPowerSeries.coeff m p else 0
    split_ifs with h0
    · rfl
    · convert h (m 0) (by omega) (m 1) (by omega)
      ext k
      fin_cases k <;> simp

/-- If `𝔪_z = (ς)` and `𝔪_w = (ς')`, a ring map `φ` out of the completed stalk sends
`J_{A,B}` to the ideal generated by the images of `ς^{A+1}` and `ς'^{B+1}`. -/
private lemma map_completedStalkBiorderIdeal {T X Y : Scheme} {f : X ⟶ T} {g : Y ⟶ T}
    {p : (pullback f g : Scheme)} {S : Type*} [CommRing S]
    {G : Type*} [FunLike G (AdicCompletion (maximalIdeal ((pullback f g).presheaf.stalk p))
      ((pullback f g).presheaf.stalk p)) S] [RingHomClass G _ S] (φ : G)
    {ς : X.presheaf.stalk (pullback.fst f g p)} {ς' : Y.presheaf.stalk (pullback.snd f g p)}
    (hς : maximalIdeal _ = Ideal.span {ς}) (hς' : maximalIdeal _ = Ideal.span {ς'})
    (A B : ℕ) :
    (completedStalkBiorderIdeal f g p A B).map φ =
      Ideal.span {φ (algebraMap _ _ ((pullback.fst f g).stalkMap p ς)) ^ (A + 1)} ⊔
        Ideal.span {φ (algebraMap _ _ ((pullback.snd f g).stalkMap p ς')) ^ (B + 1)} := by
  simp [completedStalkBiorderIdeal, hς, hς', Ideal.span_singleton_pow, Ideal.map_sup,
    Ideal.map_span]

/-- Let `ς`, `ς'` be local uniformizing parameters of `C` at the two projections of a point `x`
of `C ×_K C`, and let `φ` identify the completed local ring at `x` with `K⟦X₀, X₁⟧`, the identity
on `K` and sending `ς ∘ pr₁ ↦ X₀`, `ς' ∘ pr₂ ↦ X₁`. Then an element `a` of the completed local
ring lies in `completedStalkBiorderIdeal f f x A B` if and only if every coefficient of
`X₀^i X₁^j` in `φ a` with `i ≤ A` and `j ≤ B` vanishes. -/
@[faltings "lem_bvr_ideal_membership"]
public theorem mem_completedStalkBiorderIdeal_iff_coeff {K : Type u} [Field K] {C : Scheme.{u}}
    {f : C ⟶ Spec (.of K)} {x : ↥(pullback f f)}
    (ς : C.presheaf.stalk (pullback.fst f f x)) (ς' : C.presheaf.stalk (pullback.snd f f x))
    (hς : maximalIdeal _ = Ideal.span {ς}) (hς' : maximalIdeal _ = Ideal.span {ς'})
    (φ : AdicCompletion (maximalIdeal ((pullback f f).presheaf.stalk x))
      ((pullback f f).presheaf.stalk x) ≃+* MvPowerSeries (Fin 2) K)
    (hφK : ∀ c : K, φ (algebraMap _ _ ((pullback f f).presheaf.germ ⊤ x trivial
      ((pullback.fst f f ≫ f).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) =
        MvPowerSeries.C c)
    (hφ₀ : φ (algebraMap _ _ ((pullback.fst f f).stalkMap x ς)) = MvPowerSeries.X 0)
    (hφ₁ : φ (algebraMap _ _ ((pullback.snd f f).stalkMap x ς')) = MvPowerSeries.X 1)
    (A B : ℕ) (a : AdicCompletion (maximalIdeal ((pullback f f).presheaf.stalk x))
      ((pullback f f).presheaf.stalk x)) :
    a ∈ completedStalkBiorderIdeal f f x A B ↔
      ∀ i ≤ A, ∀ j ≤ B,
        MvPowerSeries.coeff (Finsupp.single 0 i + Finsupp.single 1 j) (φ a) = 0 := by
  rw [← mem_span_X_pow_sup_span_X_pow_iff, ← hφ₀, ← hφ₁,
    ← map_completedStalkBiorderIdeal φ hς hς']
  simp [Ideal.mem_map_of_equiv]

end Faltings
