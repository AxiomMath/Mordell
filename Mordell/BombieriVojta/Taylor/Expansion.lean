module
public import Mordell.BombieriVojta.Taylor.CurveProduct
public import StacksFrontier.AlgebraicGeometry.CurveLocalRing.Basic
public import StacksFrontier.RingTheory.RegularLocalRing.AssociatedGradedPolynomial

/-!
# Expansions in local parameters

Let `O` be a domain with a ring homomorphism `c : K → O` from a field, an evaluation
`ev : O → K` with `ev ∘ c = id`, and a nonzero `ς ∈ ker ev` such that `g - c (ev g) ∈ ς O` for
every `g`. Then every `f ∈ O` has a unique expansion `F ∈ K⟦X⟧` in powers of `ς`, meaning that
`f` is congruent modulo `ς ^ n` to the truncation of `F` below degree `n` evaluated at `ς`, and
`f ↦ F` is a ring homomorphism `O → K⟦X⟧` sending `ς` to `X`. This applies to the local ring
`𝒪_{C,z}` of a curve at a `K`-point with a uniformizer `ς`.

For two smooth curves `C`, `D` over `K` and a `K`-point `p` of `C ×_K D` with uniformizers `ς`,
`ς'` at its coordinates, the two one-variable expansions glue through the universal property of
the fibre product to a ring homomorphism `Ψ : 𝒪_{C ×_K D, p} → K⟦X₀, X₁⟧` sending `ς ∘ pr₁` to
`X₀`, `ς' ∘ pr₂` to `X₁` and the constants to the constants. Through `Ψ` an expansion in the two
parameters is unique, so any expansion computes the Taylor coefficients `taylorCoeff₂`.

## Main definitions

* `Faltings.BombieriVojta.IsExpansion`: `F` is an expansion of `f` in powers of `ς`.
* `Faltings.BombieriVojta.expansionHom`: the expansion as a ring homomorphism `O →+* K⟦X⟧`.
* `Faltings.BombieriVojta.IsExpansion₂`: `F` is an expansion of `f` in two parameters `ϖ, ϖ'`.
* `Faltings.BombieriVojta.boxTrunc`: the truncation of a power series in two variables to the
  bidegrees in `[0, n) × [0, n)`.
* `Faltings.BombieriVojta.const`: the constants `K → 𝒪_{Y,y}` of a scheme over `Spec K`.
* `Faltings.BombieriVojta.curveExpansion`: the expansion `𝒪_{Y,z} →+* K⟦X⟧` in a uniformizer
  at a `K`-point of a curve.

## Main results

* `Faltings.BombieriVojta.IsExpansion.unique`: expansions in one parameter are unique.
* `Faltings.BombieriVojta.coeff_bidegree_eq`: through a ring homomorphism to `K⟦X₀, X₁⟧`
  sending the parameters to the variables, expansions in two parameters are unique.
* `Faltings.BombieriVojta.isExpansion₂_mul`: the product of expansions of `f₁` in `ς` and of
  `f₂` in `ς'` is an expansion of `f₁ f₂` in `ς, ς'`.
* `Faltings.BombieriVojta.exists_eval_map_sub_mem`: in a local ring with maximal ideal
  `(ϖ, ϖ')` and residue field `K`, every element is congruent modulo `𝔪 ^ n` to a polynomial
  in `ϖ, ϖ'` with constant coefficients.
* `Faltings.BombieriVojta.exists_isExpansion₂`: hence every element has an expansion in `ϖ, ϖ'`.
* `Faltings.BombieriVojta.IsExpansion₂.unique`: in a two-dimensional regular local ring with
  maximal ideal `(ϖ, ϖ')`, expansions in `ϖ, ϖ'` are unique.
* `Faltings.BombieriVojta.isExpansion₂_map`: if moreover `Ψ : O → K⟦X₀, X₁⟧` sends `ϖ, ϖ'` to the
  variables and the constants to the constants, then `Ψ f` is an expansion of `f`.
* `Faltings.BombieriVojta.maximalIdeal_stalk_pullback_eq_span`: at a `K`-point of `C ×_K D`
  the maximal ideal is generated by `ς ∘ pr₁` and `ς' ∘ pr₂`.
* `Faltings.BombieriVojta.exists_ringHom_mvPowerSeries`: the homomorphism
  `𝒪_{C ×_K D, p} → K⟦X₀, X₁⟧`.
* `Faltings.BombieriVojta.taylorCoeff₂_eq_coeff`: an expansion computes `taylorCoeff₂`.

## Implementation notes

No completion is formed. The expansion of `f` in powers of `ς` has coefficients `ev (σⁱ f)`,
where `σ g` is a chosen `r` with `g - c (ev g) = ς r`; it is multiplicative because expansions
are unique in the domain `O`. The gluing to `𝒪_{C ×_K D, p}` goes through
`AlgebraicGeometry.SpecToEquivOfLocalRing`.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Section 6, pp. 624–626
-/

open AlgebraicGeometry CategoryTheory IsLocalRing Limits Polynomial

universe u

namespace Faltings.BombieriVojta

@[expose] public section

section OneVariable

variable {K O : Type*} [Field K] [CommRing O] (c : K →+* O) (ev : O →+* K) (ς : O)

/-- A chosen `r` with `g - c (ev g) = ς * r`: the quotient by `ς` of `g` minus its value. Iterating
it and evaluating gives the coefficients of the expansion of `g` in powers of `ς`. -/
noncomputable def shift (g : O) : O := Classical.epsilon fun r ↦ g - c (ev g) = ς * r

/-- The truncation of `F` below degree `n`, evaluated at `ς` through `c`, is
`∑_{i < n} c (F_i) ς ^ i`. -/
theorem eval₂_trunc (F : PowerSeries K) (n : ℕ) :
    (PowerSeries.trunc n F).eval₂ c ς =
      ∑ i ∈ Finset.range n, c (PowerSeries.coeff i F) * ς ^ i := by
  rw [PowerSeries.trunc_apply, eval₂_finsetSum, Finset.range_eq_Ico]
  simp only [eval₂_monomial]

variable {c ev ς}

private theorem expansion (hex : ∀ g, ∃ r, g - c (ev g) = ς * r) (n : ℕ) (f : O) :
    f = ∑ i ∈ Finset.range n, c (ev ((shift c ev ς)^[i] f)) * ς ^ i +
      ς ^ n * (shift c ev ς)^[n] f := by
  induction n generalizing f with
  | zero => simp
  | succ n ih =>
    have h1 : f - c (ev f) = ς * shift c ev ς f := Classical.epsilon_spec (hex f)
    rw [Finset.sum_range_succ', Function.iterate_succ_apply]
    conv_lhs => rw [show f = c (ev f) + ς * shift c ev ς f by rw [← h1]; ring, ih (shift c ev ς f)]
    simp only [Function.iterate_succ_apply, Function.iterate_zero_apply, pow_zero, mul_one,
      pow_succ]
    ring_nf
    rw [Finset.mul_sum]
    simp only [mul_assoc]

private theorem sub_mem_of_expansion (hex : ∀ g, ∃ r, g - c (ev g) = ς * r) (n : ℕ) (f : O) :
    f - (PowerSeries.trunc n (PowerSeries.mk fun i ↦ ev ((shift c ev ς)^[i] f))).eval₂ c ς ∈
      Ideal.span {ς} ^ n := by
  rw [eval₂_trunc]
  simp only [PowerSeries.coeff_mk]
  have h : f - ∑ i ∈ Finset.range n, c (ev ((shift c ev ς)^[i] f)) * ς ^ i =
      ς ^ n * (shift c ev ς)^[n] f := sub_eq_iff_eq_add'.mpr (expansion hex n f)
  rw [h, Ideal.span_singleton_pow]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

/-- A polynomial of degree `< n` whose value at `ς` lies in `ς ^ n O` is zero, when `O` is a
domain, `ς ≠ 0` is killed by `ev` and `ev` is a retraction of `c`. -/
public theorem eq_zero_of_eval₂_mem [IsDomain O] (hev : ∀ a, ev (c a) = a) (hς : ev ς = 0)
    (hς0 : ς ≠ 0) (n : ℕ) (p : K[X]) (hp : ∀ d, n ≤ d → p.coeff d = 0)
    (hmem : p.eval₂ c ς ∈ Ideal.span {ς} ^ n) : p = 0 := by
  induction n generalizing p with
  | zero => ext d; simpa using hp d (Nat.zero_le d)
  | succ n ih =>
    have hsplit := X_mul_divX_add p
    have hker : ∀ y ∈ Ideal.span {ς} ^ (n + 1), ev y = 0 := by
      intro y hy
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hy
      obtain ⟨r, rfl⟩ := hy
      simp [hς]
    have h0 : p.coeff 0 = 0 := by
      have := hker _ hmem
      rw [← hsplit, eval₂_add, eval₂_mul, eval₂_X, eval₂_C, map_add, map_mul, hς, hev] at this
      simpa using this
    have hdiv : p.divX = 0 := by
      apply ih
      · exact fun d hd ↦ by simpa [coeff_divX] using hp (d + 1) (by omega)
      · rw [← hsplit, h0, map_zero, add_zero, eval₂_mul, eval₂_X, Ideal.span_singleton_pow,
          Ideal.mem_span_singleton'] at hmem
        obtain ⟨r, hr⟩ := hmem
        rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton']
        refine ⟨r, mul_left_cancel₀ hς0 ?_⟩
        rw [← hr]
        ring
    rw [← hsplit, hdiv, h0]
    simp

variable (c ς) in
/-- `F` is an expansion of `f` in powers of `ς`: for every `n`, `f` is congruent modulo `ς ^ n`
to the truncation of `F` below degree `n`, evaluated at `ς`. -/
def IsExpansion (F : PowerSeries K) (f : O) : Prop :=
  ∀ n, f - (PowerSeries.trunc n F).eval₂ c ς ∈ Ideal.span {ς} ^ n

/-- Expansions in powers of `ς` are unique, when `O` is a domain, `ς ≠ 0` is killed by `ev` and
`ev` is a retraction of `c`. -/
theorem IsExpansion.unique [IsDomain O] (hev : ∀ a, ev (c a) = a) (hς : ev ς = 0)
    (hς0 : ς ≠ 0) {F G : PowerSeries K} {f : O} (hF : IsExpansion c ς F f)
    (hG : IsExpansion c ς G f) :
    F = G := by
  ext i
  have h := eq_zero_of_eval₂_mem hev hς hς0 (i + 1) (PowerSeries.trunc (i + 1) F -
    PowerSeries.trunc (i + 1) G) (fun d hd ↦ by
      simp [PowerSeries.coeff_trunc, show ¬ d < i + 1 by omega])
    (by rw [eval₂_sub]; simpa using Ideal.sub_mem _ (hG (i + 1)) (hF (i + 1)))
  simpa [PowerSeries.coeff_trunc, sub_eq_zero] using congrArg (fun p ↦ p.coeff i) h

/-- A polynomial `p` is an expansion of its value `p(ς)`. -/
theorem isExpansion_coe (p : K[X]) : IsExpansion c ς (p : PowerSeries K) (p.eval₂ c ς) := by
  intro n
  have hdvd : Polynomial.X ^ n ∣ p - PowerSeries.trunc n (p : PowerSeries K) := by
    rw [X_pow_dvd_iff]
    intro d hd
    simp [PowerSeries.coeff_trunc, hd]
  obtain ⟨q, hq⟩ := hdvd
  rw [← eval₂_sub, hq, eval₂_mul, eval₂_X_pow, Ideal.span_singleton_pow]
  exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

/-- The sum of expansions of `f` and `g` is an expansion of `f + g`. -/
theorem IsExpansion.add {F G : PowerSeries K} {f g : O} (hF : IsExpansion c ς F f)
    (hG : IsExpansion c ς G g) : IsExpansion c ς (F + G) (f + g) := by
  intro n
  rw [map_add, eval₂_add]
  simpa [add_sub_add_comm] using Ideal.add_mem _ (hF n) (hG n)

/-- The product of expansions of `f` and `g` is an expansion of `f * g`. -/
theorem IsExpansion.mul {F G : PowerSeries K} {f g : O} (hF : IsExpansion c ς F f)
    (hG : IsExpansion c ς G g) : IsExpansion c ς (F * G) (f * g) := by
  intro n
  rw [← PowerSeries.trunc_trunc_mul_trunc, ← Polynomial.coe_mul]
  have h1 := isExpansion_coe (c := c) (ς := ς) (PowerSeries.trunc n F * PowerSeries.trunc n G) n
  have h2 : f * g - (PowerSeries.trunc n F * PowerSeries.trunc n G).eval₂ c ς =
      (f - (PowerSeries.trunc n F).eval₂ c ς) * g +
        (PowerSeries.trunc n F).eval₂ c ς * (g - (PowerSeries.trunc n G).eval₂ c ς) := by
    rw [eval₂_mul]
    ring
  have h3 := Ideal.add_mem _ (Ideal.mul_mem_right g _ (hF n)) (Ideal.mul_mem_left _
    ((PowerSeries.trunc n F).eval₂ c ς) (hG n))
  rw [← h2] at h3
  simpa using Ideal.add_mem _ h3 h1

/-- The series `∑ᵢ ev (shiftⁱ f) Xⁱ` is an expansion of `f`. -/
theorem isExpansion_mk (hex : ∀ g, ∃ r, g - c (ev g) = ς * r) (f : O) :
    IsExpansion c ς (PowerSeries.mk fun i ↦ ev ((shift c ev ς)^[i] f)) f :=
  fun n ↦ sub_mem_of_expansion hex n f

variable [IsDomain O] (hev : ∀ a, ev (c a) = a) (hς : ev ς = 0) (hς0 : ς ≠ 0)
  (hex : ∀ g, ∃ r, g - c (ev g) = ς * r)

include hev hς hς0 hex

variable (c ev ς) in
/-- The expansion of an element of `O` in powers of `ς`, as a ring homomorphism `O → K⟦X⟧`. -/
noncomputable def expansionHom : O →+* PowerSeries K where
  toFun f := PowerSeries.mk fun i ↦ ev ((shift c ev ς)^[i] f)
  map_one' := IsExpansion.unique hev hς hς0 (isExpansion_mk hex 1)
    (by simpa using isExpansion_coe (c := c) (ς := ς) 1)
  map_mul' f g := IsExpansion.unique hev hς hς0 (isExpansion_mk hex (f * g))
    ((isExpansion_mk hex f).mul (isExpansion_mk hex g))
  map_zero' := IsExpansion.unique hev hς hς0 (isExpansion_mk hex 0)
    (by simpa using isExpansion_coe (c := c) (ς := ς) 0)
  map_add' f g := IsExpansion.unique hev hς hς0 (isExpansion_mk hex (f + g))
    ((isExpansion_mk hex f).add (isExpansion_mk hex g))

/-- `expansionHom` sends `f` to the series `∑ᵢ ev (shiftⁱ f) Xⁱ`. -/
theorem expansionHom_apply (f : O) :
    expansionHom c ev ς hev hς hς0 hex f = PowerSeries.mk fun i ↦ ev ((shift c ev ς)^[i] f) := rfl

/-- The `i`-th coefficient of the expansion of `f` is `ev (shiftⁱ f)`. -/
theorem coeff_expansionHom (f : O) (i : ℕ) :
    PowerSeries.coeff i (expansionHom c ev ς hev hς hς0 hex f) = ev ((shift c ev ς)^[i] f) := by
  rw [expansionHom_apply, PowerSeries.coeff_mk]

/-- The expansion of the value `p(ς)` of a polynomial `p` is `p`. -/
theorem expansionHom_eval₂ (p : K[X]) :
    expansionHom c ev ς hev hς hς0 hex (p.eval₂ c ς) = p :=
  IsExpansion.unique hev hς hς0 (isExpansion_mk hex _) (isExpansion_coe p)

/-- The expansion of a constant `c a` is the constant series `C a`. -/
theorem expansionHom_comp_c :
    (expansionHom c ev ς hev hς hς0 hex).comp c = PowerSeries.C := by
  ext1 a
  simpa using expansionHom_eval₂ hev hς hς0 hex (Polynomial.C a)

/-- The expansion of `ς` is `X`. -/
theorem expansionHom_self : expansionHom c ev ς hev hς hς0 hex ς = PowerSeries.X := by
  simpa using expansionHom_eval₂ hev hς hς0 hex Polynomial.X

/-- The constant coefficient of the expansion of `f` is `ev f`. -/
theorem constantCoeff_expansionHom (f : O) :
    PowerSeries.constantCoeff (expansionHom c ev ς hev hς hς0 hex f) = ev f := by
  rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, coeff_expansionHom]
  rfl

end OneVariable

section TwoVariables

variable {K O : Type*} [Field K] [CommRing O]

/-- The exponent `X₀ ^ j₁ * X₁ ^ j₂` of a monomial in two variables. -/
noncomputable abbrev bidegree (j : ℕ × ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.single 0 j.1 + Finsupp.single 1 j.2

variable (c : K →+* O) (ϖ ϖ' : O) in
/-- `F` is an expansion of `f` in the two parameters `ϖ, ϖ'`: for every `n`, `f` minus the
truncation `∑_{j₁, j₂ < n} c(F_{j₁ j₂}) ϖ ^ j₁ ϖ' ^ j₂` lies in `(ϖ, ϖ') ^ n`. -/
def IsExpansion₂ (F : MvPowerSeries (Fin 2) K) (f : O) : Prop :=
  ∀ n : ℕ, f - ∑ j ∈ Finset.range n ×ˢ Finset.range n,
      c (MvPowerSeries.coeff (bidegree j) F) * ϖ ^ j.1 * ϖ' ^ j.2 ∈ Ideal.span {ϖ, ϖ'} ^ n

/-- A power series in `(X₀, X₁) ^ n` has order at least `n`. -/
theorem le_order_of_mem_pow (n : ℕ) (h : MvPowerSeries (Fin 2) K)
    (hh : h ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1}) ^ n) :
    (n : ℕ∞) ≤ h.order := by
  induction n generalizing h with
  | zero => simp
  | succ n ih =>
    rw [pow_succ] at hh
    refine Submodule.mul_induction_on hh (fun x hx y hy ↦ ?_) (fun x y hx hy ↦ ?_)
    · have hy1 : 1 ≤ y.order := by
        rw [MvPowerSeries.one_le_order_iff_constCoeff_eq_zero]
        have : Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} ≤
            RingHom.ker (MvPowerSeries.constantCoeff (σ := Fin 2) (R := K)) := by
          rw [Ideal.span_le]
          rintro z (rfl | rfl) <;> simp
        exact this hy
      calc ((n + 1 : ℕ) : ℕ∞) = (n : ℕ∞) + 1 := by push_cast; rfl
        _ ≤ x.order + y.order := add_le_add (ih x hx) hy1
        _ ≤ (x * y).order := MvPowerSeries.le_order_mul
    · exact le_trans (le_min hx hy) MvPowerSeries.min_order_le_add

/-- `bidegree` is injective. -/
theorem bidegree_injective : Function.Injective bidegree := by
  intro j k h
  have h0 := congrArg (fun d ↦ d 0) h
  have h1 := congrArg (fun d ↦ d 1) h
  simp only [Finsupp.coe_add, Pi.add_apply, Finsupp.single_eq_same, ne_eq, zero_ne_one,
    not_false_eq_true, Finsupp.single_eq_of_ne, add_zero, one_ne_zero, zero_add] at h0 h1
  exact Prod.ext h0 h1

/-- A ring map sending `c a` to `C a`, `ϖ` to `X₀` and `ϖ'` to `X₁` sends
`c x * ϖ ^ j₁ * ϖ' ^ j₂` to the monomial `x X₀ ^ j₁ X₁ ^ j₂`. -/
theorem map_monomial_eq {c : K →+* O} {ϖ ϖ' : O} (Ψ : O →+* MvPowerSeries (Fin 2) K)
    (hc : ∀ a, Ψ (c a) = MvPowerSeries.C a) (h0 : Ψ ϖ = MvPowerSeries.X 0)
    (h1 : Ψ ϖ' = MvPowerSeries.X 1) (x : K) (j : ℕ × ℕ) :
    Ψ (c x * ϖ ^ j.1 * ϖ' ^ j.2) = MvPowerSeries.monomial (bidegree j) x := by
  rw [map_mul, map_mul, map_pow, map_pow, hc, h0, h1, MvPowerSeries.X_pow_eq,
    MvPowerSeries.X_pow_eq, mul_assoc, MvPowerSeries.monomial_mul_monomial, mul_one,
    ← MvPowerSeries.monomial_zero_eq_C_apply, MvPowerSeries.monomial_mul_monomial, zero_add,
    mul_one]

/-- Expansions in two parameters `ϖ, ϖ'` are unique, given a ring map to `K⟦X₀, X₁⟧` sending `ϖ`
to `X₀`, `ϖ'` to `X₁` and `c a` to `C a`. -/
theorem coeff_bidegree_eq {c : K →+* O} {ϖ ϖ' : O} (Ψ : O →+* MvPowerSeries (Fin 2) K)
    (hc : ∀ a, Ψ (c a) = MvPowerSeries.C a) (h0 : Ψ ϖ = MvPowerSeries.X 0)
    (h1 : Ψ ϖ' = MvPowerSeries.X 1) {F G : MvPowerSeries (Fin 2) K} {f : O}
    (hF : IsExpansion₂ c ϖ ϖ' F f) (hG : IsExpansion₂ c ϖ ϖ' G f) (a b : ℕ) :
    MvPowerSeries.coeff (bidegree (a, b)) F = MvPowerSeries.coeff (bidegree (a, b)) G := by
  set n := a + b + 1
  have hmem := Ideal.sub_mem _ (hG n) (hF n)
  rw [sub_sub_sub_cancel_left] at hmem
  have hmap := Ideal.mem_map_of_mem Ψ hmem
  rw [Ideal.map_pow, Ideal.map_span, Set.image_pair, h0, h1] at hmap
  have hord := le_order_of_mem_pow n _ hmap
  have hcoeff := MvPowerSeries.coeff_of_lt_order (d := bidegree (a, b)) (lt_of_lt_of_le (by
    norm_cast; simp [n, bidegree, map_add]) hord)
  have hab : (a, b) ∈ Finset.range n ×ˢ Finset.range n := by
    simp [n]
  simp only [map_sub, map_sum, map_monomial_eq Ψ hc h0 h1, MvPowerSeries.coeff_monomial,
    bidegree_injective.eq_iff] at hcoeff
  rw [Finset.sum_ite_eq, Finset.sum_ite_eq] at hcoeff
  simpa only [hab, ↓reduceIte, sub_eq_zero] using hcoeff

/-- A ring map `φ` sends `(ς) ^ n` into `(S) ^ n` whenever `φ ς ∈ S`. -/
theorem map_mem_pow_span {O₁ : Type*} [CommRing O₁] (φ : O₁ →+* O) {ς y : O₁} {n : ℕ}
    (hy : y ∈ Ideal.span {ς} ^ n) (S : Set O) (hS : φ ς ∈ S) : φ y ∈ Ideal.span S ^ n := by
  have := Ideal.mem_map_of_mem φ hy
  rw [Ideal.map_pow, Ideal.map_span, Set.image_singleton] at this
  exact Ideal.pow_right_mono (Ideal.span_mono (Set.singleton_subset_iff.mpr hS)) n this

/-- If `F₁` is an expansion of `f₁` in `ς` and `F₂` one of `f₂` in `ς'`, then
`F₁(X₀) F₂(X₁)` is an expansion of `φ₁ f₁ * φ₂ f₂` in `φ₁ ς, φ₂ ς'`. -/
theorem isExpansion₂_mul {O₁ O₂ : Type*} [CommRing O₁] [CommRing O₂] (c : K →+* O)
    (φ₁ : O₁ →+* O) (φ₂ : O₂ →+* O) (c₁ : K →+* O₁) (c₂ : K →+* O₂)
    (hc₁ : ∀ a, φ₁ (c₁ a) = c a) (hc₂ : ∀ a, φ₂ (c₂ a) = c a) {ς : O₁} {ς' : O₂}
    {F₁ F₂ : PowerSeries K} {f₁ : O₁} {f₂ : O₂}
    (hF₁ : ∀ n, f₁ - (PowerSeries.trunc n F₁).eval₂ c₁ ς ∈ Ideal.span {ς} ^ n)
    (hF₂ : ∀ n, f₂ - (PowerSeries.trunc n F₂).eval₂ c₂ ς' ∈ Ideal.span {ς'} ^ n) :
    IsExpansion₂ c (φ₁ ς) (φ₂ ς')
      (fun d ↦ PowerSeries.coeff (d 0) F₁ * PowerSeries.coeff (d 1) F₂) (φ₁ f₁ * φ₂ f₂) := by
  intro n
  set A := (PowerSeries.trunc n F₁).eval₂ c₁ ς
  set B := (PowerSeries.trunc n F₂).eval₂ c₂ ς'
  have key : ∑ j ∈ Finset.range n ×ˢ Finset.range n,
      c (MvPowerSeries.coeff (bidegree j)
        (fun d ↦ PowerSeries.coeff (d 0) F₁ * PowerSeries.coeff (d 1) F₂)) *
        φ₁ ς ^ j.1 * φ₂ ς' ^ j.2 = φ₁ A * φ₂ B := by
    simp only [A, B, eval₂_trunc, map_sum, Finset.sum_mul_sum, Finset.sum_product]
    refine Finset.sum_congr rfl fun i _ ↦ Finset.sum_congr rfl fun j _ ↦ ?_
    change c ((fun d : Fin 2 →₀ ℕ ↦ PowerSeries.coeff (d 0) F₁ * PowerSeries.coeff (d 1) F₂)
      (bidegree (i, j))) * _ * _ = _
    simp only [bidegree, map_mul, map_pow, hc₁, hc₂]
    simp
    ring
  rw [key, show φ₁ f₁ * φ₂ f₂ - φ₁ A * φ₂ B = φ₁ (f₁ - A) * φ₂ f₂ + φ₁ A * φ₂ (f₂ - B) by
    simp only [map_sub]; ring]
  exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (map_mem_pow_span φ₁ (hF₁ n) _ (by simp)))
    (Ideal.mul_mem_left _ _ (map_mem_pow_span φ₂ (hF₂ n) _ (by simp)))

/-- The sum of expansions of `f` and `g` is an expansion of `f + g`. -/
theorem IsExpansion₂.add {c : K →+* O} {ϖ ϖ' f g : O} {F G : MvPowerSeries (Fin 2) K}
    (hF : IsExpansion₂ c ϖ ϖ' F f) (hG : IsExpansion₂ c ϖ ϖ' G g) :
    IsExpansion₂ c ϖ ϖ' (F + G) (f + g) := fun n ↦ by
  convert add_mem (hF n) (hG n) using 1
  simp only [map_add, add_mul, Finset.sum_add_distrib]
  ring

/-- If `F` is an expansion of `f`, then `C a * F` is an expansion of `c a * f`. -/
theorem IsExpansion₂.const_mul {c : K →+* O} {ϖ ϖ' f : O} {F : MvPowerSeries (Fin 2) K}
    (hF : IsExpansion₂ c ϖ ϖ' F f) (a : K) :
    IsExpansion₂ c ϖ ϖ' (MvPowerSeries.C a * F) (c a * f) := fun n ↦ by
  convert Ideal.mul_mem_left _ (c a) (hF n) using 1
  simp only [MvPowerSeries.coeff_C_mul, map_mul, mul_sub, Finset.mul_sum, mul_assoc]

/-- `0` is an expansion of `0`. -/
theorem isExpansion₂_zero (c : K →+* O) (ϖ ϖ' : O) : IsExpansion₂ c ϖ ϖ' 0 0 :=
  fun n ↦ by simp

/-- The sum of expansions of the `f i` is an expansion of `∑ i, f i`. -/
theorem isExpansion₂_sum {c : K →+* O} {ϖ ϖ' : O} {ι : Type*} (s : Finset ι)
    (f : ι → O) (F : ι → MvPowerSeries (Fin 2) K)
    (h : ∀ i ∈ s, IsExpansion₂ c ϖ ϖ' (F i) (f i)) :
    IsExpansion₂ c ϖ ϖ' (∑ i ∈ s, F i) (∑ i ∈ s, f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using isExpansion₂_zero c ϖ ϖ'
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha]
    exact (h a (Finset.mem_insert_self a s)).add
      (ih fun i hi ↦ h i (Finset.mem_insert_of_mem hi))

end TwoVariables

section Truncation

open MvPolynomial

variable {K R : Type*} [Field K] [CommRing R]

/-- A polynomial whose monomials all have degree at least `n` and coefficients in `I ^ k`,
evaluated at elements of `I`, lies in `I ^ (k + n)`. -/
theorem eval_mem_pow_of_le_degree {σ : Type*} [Finite σ] (I : Ideal R) (x : σ → R)
    (hx : ∀ i, x i ∈ I) {k n : ℕ} (Q : MvPolynomial σ R)
    (hQ : ∀ e ∈ Q.support, Q.coeff e ∈ I ^ k ∧ n ≤ e.degree) : eval x Q ∈ I ^ (k + n) := by
  have := Fintype.ofFinite σ
  rw [MvPolynomial.eval_eq']
  refine Ideal.sum_mem _ fun e he ↦ ?_
  have hprod : ∏ i, x i ^ e i ∈ I ^ e.degree := by
    rw [Finsupp.degree_eq_sum, ← Finset.prod_pow_eq_pow_sum]
    exact Ideal.prod_mem_prod fun i _ ↦ Ideal.pow_mem_pow (hx i) _
  rw [pow_add]
  exact Ideal.mul_mem_mul (hQ e he).1 (Ideal.pow_le_pow_right (hQ e he).2 hprod)

/-- Each entry of `![ϖ, ϖ']` lies in the ideal `(ϖ, ϖ')`. -/
public theorem vecCons_mem_span_pair (ϖ ϖ' : R) (i : Fin 2) :
    ![ϖ, ϖ'] i ∈ Ideal.span {ϖ, ϖ'} := by
  fin_cases i <;> exact Ideal.subset_span (by simp)

/-- Two polynomials over `K` agreeing in degrees `< n` have values at `(ϖ, ϖ')`, through `c`,
congruent modulo `(ϖ, ϖ') ^ n`. -/
theorem eval_map_sub_eval_map_mem (c : K →+* R) (ϖ ϖ' : R) {n : ℕ}
    (P Q : MvPolynomial (Fin 2) K) (h : ∀ e : Fin 2 →₀ ℕ, e.degree < n → P.coeff e = Q.coeff e) :
    eval ![ϖ, ϖ'] (map c P) - eval ![ϖ, ϖ'] (map c Q) ∈ Ideal.span {ϖ, ϖ'} ^ n := by
  rw [← map_sub, ← map_sub]
  have := eval_mem_pow_of_le_degree (Ideal.span {ϖ, ϖ'}) ![ϖ, ϖ'] (vecCons_mem_span_pair ϖ ϖ')
    (k := 0) (n := n) (map c (P - Q)) fun e he ↦ by
      refine ⟨by simp, ?_⟩
      by_contra hlt
      rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_map, MvPolynomial.coeff_sub,
        h e (not_le.1 hlt), sub_self, map_zero] at he
      exact he rfl
  simpa using this

/-- The `X₀`-exponent of `bidegree j` is `j.1`. -/
@[simp]
theorem bidegree_apply_zero (j : ℕ × ℕ) : bidegree j 0 = j.1 := by simp [bidegree]

/-- The `X₁`-exponent of `bidegree j` is `j.2`. -/
@[simp]
theorem bidegree_apply_one (j : ℕ × ℕ) : bidegree j 1 = j.2 := by simp [bidegree]

/-- Every exponent `e` on `Fin 2` is `bidegree (e 0, e 1)`. -/
theorem bidegree_apply_eq (e : Fin 2 →₀ ℕ) : bidegree (e 0, e 1) = e := by
  ext i
  fin_cases i <;> simp

/-- The total degree of `bidegree j` is `j.1 + j.2`. -/
theorem degree_bidegree (j : ℕ × ℕ) : (bidegree j).degree = j.1 + j.2 := by
  rw [Finsupp.degree_eq_sum, Fin.sum_univ_two]
  simp

/-- The truncation of a power series in two variables to the bidegrees in `[0, n) × [0, n)`. -/
noncomputable def boxTrunc (n : ℕ) (F : MvPowerSeries (Fin 2) K) : MvPolynomial (Fin 2) K :=
  ∑ j ∈ Finset.range n ×ˢ Finset.range n, monomial (bidegree j) (MvPowerSeries.coeff (bidegree j) F)

/-- The coefficient of `e` in `boxTrunc n F` is that of `F` if `e 0, e 1 < n`, and `0`
otherwise. -/
theorem coeff_boxTrunc (n : ℕ) (F : MvPowerSeries (Fin 2) K) (e : Fin 2 →₀ ℕ) :
    (boxTrunc n F).coeff e = if e 0 < n ∧ e 1 < n then MvPowerSeries.coeff e F else 0 := by
  classical
  rw [boxTrunc, MvPolynomial.coeff_sum]
  simp_rw [MvPolynomial.coeff_monomial]
  by_cases h : e 0 < n ∧ e 1 < n
  · rw [ite_eq_left h, Finset.sum_eq_single (e 0, e 1)]
    · rw [bidegree_apply_eq, ite_eq_left rfl]
    · intro j _ hj
      rw [ite_eq_right]
      rintro rfl
      exact hj (by simp)
    · intro hj
      exact absurd (by simpa [Finset.mem_product] using h) hj
  · rw [ite_eq_right h]
    refine Finset.sum_eq_zero fun j hj ↦ ?_
    rw [ite_eq_right]
    rintro rfl
    exact h (by simpa [Finset.mem_product] using hj)

/-- In total degrees `< n`, `boxTrunc n F` has the coefficients of `F`. -/
theorem coeff_boxTrunc_of_degree_lt {n : ℕ} (F : MvPowerSeries (Fin 2) K)
    {e : Fin 2 →₀ ℕ} (he : e.degree < n) :
    (boxTrunc n F).coeff e = MvPowerSeries.coeff e F := by
  rw [coeff_boxTrunc, ite_eq_left]
  rw [Finsupp.degree_eq_sum, Fin.sum_univ_two] at he
  omega

/-- The value of `boxTrunc n F` at `(ϖ, ϖ')` is the truncation appearing in `IsExpansion₂`. -/
theorem eval_map_boxTrunc (c : K →+* R) (ϖ ϖ' : R) (n : ℕ) (F : MvPowerSeries (Fin 2) K) :
    eval ![ϖ, ϖ'] (map c (boxTrunc n F)) = ∑ j ∈ Finset.range n ×ˢ Finset.range n,
      c (MvPowerSeries.coeff (bidegree j) F) * ϖ ^ j.1 * ϖ' ^ j.2 := by
  simp only [boxTrunc, map_sum, MvPolynomial.map_monomial, MvPolynomial.eval_monomial]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  rw [Finsupp.prod_fintype _ _ (fun i ↦ pow_zero _), Fin.prod_univ_two]
  simp [mul_assoc]

/-- `F` is an expansion of `f` in `ϖ, ϖ'` iff `f` is congruent modulo `(ϖ, ϖ') ^ n` to the value
of `boxTrunc n F` at `(ϖ, ϖ')`, for every `n`. -/
theorem isExpansion₂_iff (c : K →+* R) (ϖ ϖ' : R) (F : MvPowerSeries (Fin 2) K) (f : R) :
    IsExpansion₂ c ϖ ϖ' F f ↔
      ∀ n, f - eval ![ϖ, ϖ'] (map c (boxTrunc n F)) ∈ Ideal.span {ϖ, ϖ'} ^ n := by
  simp only [eval_map_boxTrunc, IsExpansion₂]

/-- One step of successive approximation: an approximation of `f` modulo `𝔪 ^ n` by a polynomial
in `ϖ, ϖ'` with constant coefficients improves to one modulo `𝔪 ^ (n + 1)` by adding a form of
degree `n`, when `𝔪 = (ϖ, ϖ')` and `K` maps onto the residue field. -/
theorem exists_eval_map_sub_mem_succ [IsLocalRing R] {ϖ ϖ' : R}
    (hϖ : maximalIdeal R = Ideal.span {ϖ, ϖ'}) (c : K →+* R) (ev : R →+* K)
    (hev : ∀ k, ev (c k) = k) (f : R) {n : ℕ} {G : MvPolynomial (Fin 2) K}
    (hG : f - eval ![ϖ, ϖ'] (map c G) ∈ maximalIdeal R ^ n) :
    ∃ G' : MvPolynomial (Fin 2) K, f - eval ![ϖ, ϖ'] (map c G') ∈ maximalIdeal R ^ (n + 1) ∧
      ∀ e : Fin 2 →₀ ℕ, e.degree ≠ n → G'.coeff e = G.coeff e := by
  rw [hϖ, ← Matrix.range_cons_cons_empty ϖ ϖ' ![]] at hG
  obtain ⟨P, hP, hPe⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous _ _).1 hG
  refine ⟨G + P.map ev, ?_, fun e he ↦ ?_⟩
  · have heq : f - eval ![ϖ, ϖ'] (map c (G + map ev P)) =
        eval ![ϖ, ϖ'] (P - map (c.comp ev) P) := by
      rw [map_add, MvPolynomial.map_map, map_add (MvPolynomial.eval _),
        map_sub (MvPolynomial.eval _), hPe]
      ring
    rw [heq, add_comm n 1]
    refine eval_mem_pow_of_le_degree (maximalIdeal R) ![ϖ, ϖ']
      (hϖ ▸ vecCons_mem_span_pair ϖ ϖ') _ fun e he ↦ ⟨?_, ?_⟩
    · rw [pow_one, MvPolynomial.coeff_sub, MvPolynomial.coeff_map, RingHom.comp_apply]
      by_contra hy
      have hu := (IsLocalRing.notMem_maximalIdeal.1 hy).map ev
      rw [map_sub, hev, sub_self] at hu
      exact not_isUnit_zero hu
    · have hne : P.coeff e ≠ 0 := by
        intro h0
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub, MvPolynomial.coeff_map, h0,
          map_zero, sub_zero] at he
        exact he rfl
      rw [Finsupp.degree_eq_weight_one]
      exact (hP hne).ge
  · have : P.coeff e = 0 := by
      by_contra h0
      exact he (by rw [Finsupp.degree_eq_weight_one]; exact hP h0)
    rw [MvPolynomial.coeff_add, MvPolynomial.coeff_map, this, map_zero, add_zero]

/-- Every element of a local ring with maximal ideal `(ϖ, ϖ')` is congruent modulo `𝔪 ^ n` to the
value of a polynomial over `K`, when `K` maps onto the residue field. -/
theorem exists_eval_map_sub_mem [IsLocalRing R] {ϖ ϖ' : R}
    (hϖ : maximalIdeal R = Ideal.span {ϖ, ϖ'}) (c : K →+* R) (ev : R →+* K)
    (hev : ∀ k, ev (c k) = k) (f : R) (n : ℕ) :
    ∃ G : MvPolynomial (Fin 2) K, f - eval ![ϖ, ϖ'] (map c G) ∈ maximalIdeal R ^ n := by
  induction n with
  | zero => exact ⟨0, by simp⟩
  | succ n ihn =>
    obtain ⟨G, hG⟩ := ihn
    exact (exists_eval_map_sub_mem_succ hϖ c ev hev f hG).imp fun _ h ↦ h.1

/-- Every element of a local ring with maximal ideal `(ϖ, ϖ')` has an expansion in `ϖ, ϖ'`, when
`K` maps onto the residue field.

The approximations of `f` modulo `𝔪 ^ n` given by successive approximation agree in degrees `< n`
with all later ones, so their coefficients stabilise to a power series. -/
theorem exists_isExpansion₂ [IsLocalRing R] {ϖ ϖ' : R}
    (hϖ : maximalIdeal R = Ideal.span {ϖ, ϖ'}) (c : K →+* R) (ev : R →+* K)
    (hev : ∀ k, ev (c k) = k) (f : R) : ∃ F, IsExpansion₂ c ϖ ϖ' F f := by
  choose g hg using fun n (G : MvPolynomial (Fin 2) K)
    (hG : f - eval ![ϖ, ϖ'] (map c G) ∈ maximalIdeal R ^ n) ↦
    exists_eval_map_sub_mem_succ hϖ c ev hev f hG
  let seq : (n : ℕ) →
      {G : MvPolynomial (Fin 2) K // f - eval ![ϖ, ϖ'] (map c G) ∈ maximalIdeal R ^ n} :=
    fun n ↦ Nat.rec (motive := fun n ↦
        {G : MvPolynomial (Fin 2) K // f - eval ![ϖ, ϖ'] (map c G) ∈ maximalIdeal R ^ n})
      ⟨0, by simp⟩ (fun n G ↦ ⟨g n G.1 G.2, (hg n G.1 G.2).1⟩) n
  have hstab : ∀ (e : Fin 2 →₀ ℕ) (k : ℕ), e.degree + 1 ≤ k →
      (seq k).1.coeff e = (seq (e.degree + 1)).1.coeff e := by
    intro e k hk
    induction k, hk using Nat.le_induction with
    | base => rfl
    | succ k hk ih => exact ((hg k _ _).2 e (by omega)).trans ih
  let F : MvPowerSeries (Fin 2) K := fun e ↦ (seq (e.degree + 1)).1.coeff e
  refine ⟨F, (isExpansion₂_iff _ _ _ _ _).2 fun n ↦ ?_⟩
  rw [← sub_add_sub_cancel _ (eval ![ϖ, ϖ'] (map c (seq n).1))]
  refine add_mem (hϖ ▸ (seq n).2) (eval_map_sub_eval_map_mem c ϖ ϖ' _ _ fun e he ↦ ?_)
  rw [coeff_boxTrunc_of_degree_lt _ he]
  exact hstab e n he

end Truncation

section Regular

open MvPolynomial

variable {K R : Type*} [Field K] [CommRing R]

/-- In a regular local ring of dimension two with maximal ideal `(ϖ, ϖ')`, a homogeneous
polynomial of degree `d` whose value at `(ϖ, ϖ')` lies in `𝔪 ^ (d + 1)` has all its coefficients
in `𝔪`. -/
private theorem coeff_mem_maximalIdeal_of_isHomogeneous [IsRegularLocalRing R]
    (hdim : ringKrullDim R = 2) {ϖ ϖ' : R} (hϖ : maximalIdeal R = Ideal.span {ϖ, ϖ'})
    {d : ℕ} {P : MvPolynomial (Fin 2) R} (hP : P.IsHomogeneous d)
    (hev : eval ![ϖ, ϖ'] P ∈ maximalIdeal R ^ (d + 1)) (e : Fin 2 →₀ ℕ) :
    P.coeff e ∈ maximalIdeal R := by
  classical
  set xs : List R := [ϖ, ϖ'] with hxs_def
  have hxs : Ideal.ofList xs = maximalIdeal R := by
    rw [hϖ, Ideal.ofList]
    congr 1
    ext r
    simp [xs]
  have hmin : xs.length = (maximalIdeal R).spanFinrank := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [hdim] at h
    exact_mod_cast h.symm
  have hx : ∀ i : Fin xs.length, xs[i] ∈ maximalIdeal R := by
    intro i
    rw [hϖ]
    fin_cases i <;> exact Ideal.subset_span (by simp [xs])
  have hinj :=
    (IsRegularLocalRing.gradedRing_maximalIdeal_isPolynomialAlgebra xs hxs hmin hx).1.1
  have hfun : (fun i : Fin xs.length ↦ xs[i]) = ![ϖ, ϖ'] := by
    funext i
    fin_cases i <;> rfl
  have key := AssociatedGraded.polyGradedHom_map (maximalIdeal R)
    (fun i : Fin xs.length ↦ xs[i]) hx (P := P) hP
  have hzero : AssociatedGraded.polyGradedHom (maximalIdeal R) (fun i : Fin xs.length ↦ xs[i]) hx
      (P.map (Ideal.Quotient.mk (maximalIdeal R))) = 0 := by
    rw [key]
    change DirectSum.of (fun j ↦ AssociatedGraded.piece (M := R) (maximalIdeal R) j) d
      (AssociatedGraded.mk (M := R) (maximalIdeal R) d ⟨_, _⟩) = 0
    rw [AssociatedGraded.mk, (Submodule.Quotient.mk_eq_zero _).2, map_zero]
    change MvPolynomial.eval (fun i : Fin xs.length ↦ xs[i]) P ∈
      AssociatedGraded.power (M := R) (maximalIdeal R) (d + 1)
    rw [AssociatedGraded.ring_power_eq, hfun]
    exact hev
  have hP0 : P.map (Ideal.Quotient.mk (maximalIdeal R)) = 0 :=
    hinj (hzero.trans (map_zero _).symm)
  have : (P.map (Ideal.Quotient.mk (maximalIdeal R))).coeff e = 0 := by
    rw [hP0, AddMonoidAlgebra.coeff_zero, Finsupp.coe_zero, Pi.zero_apply]
  rwa [MvPolynomial.coeff_map, Ideal.Quotient.eq_zero_iff_mem] at this

/-- A constant `c k` in the maximal ideal is zero. -/
private theorem eq_zero_of_map_mem_maximalIdeal [IsLocalRing R] (c : K →+* R) {k : K}
    (h : c k ∈ maximalIdeal R) : k = 0 := by
  by_contra hk
  exact (mem_maximalIdeal _).1 h ((isUnit_iff_ne_zero.2 hk).map c)

/-- In a regular local ring of dimension two with maximal ideal `(ϖ, ϖ')`, if the value at
`(ϖ, ϖ')` of a polynomial over `K` (mapped through `c`) lies in `𝔪 ^ n`, its coefficients of
degree `< n` vanish. -/
theorem coeff_eq_zero_of_eval_map_mem [IsRegularLocalRing R]
    (hdim : ringKrullDim R = 2) {ϖ ϖ' : R} (hϖ : maximalIdeal R = Ideal.span {ϖ, ϖ'})
    (c : K →+* R) {n : ℕ} (G : MvPolynomial (Fin 2) K)
    (h : eval ![ϖ, ϖ'] (map c G) ∈ maximalIdeal R ^ n) (e : Fin 2 →₀ ℕ) (he : e.degree < n) :
    G.coeff e = 0 := by
  suffices H : ∀ d, d < n → ∀ e : Fin 2 →₀ ℕ, e.degree = d → G.coeff e = 0 from
    H _ he e rfl
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
  intro hdn
  set H := map c G with hH
  set A := homogeneousComponent d H with hA
  have hB : eval ![ϖ, ϖ'] (H - A) ∈ maximalIdeal R ^ (d + 1) := by
    have := eval_mem_pow_of_le_degree (maximalIdeal R) ![ϖ, ϖ']
      (hϖ ▸ vecCons_mem_span_pair ϖ ϖ') (k := 0) (n := d + 1) (H - A) fun e he ↦ by
        refine ⟨by simp, ?_⟩
        by_contra hlt
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub, hA,
          MvPolynomial.coeff_homogeneousComponent] at he
        rcases Nat.lt_succ_iff_lt_or_eq.1 (not_le.1 hlt) with hlt' | heq
        · rw [ite_eq_right hlt'.ne, sub_zero, hH, MvPolynomial.coeff_map,
            ih _ hlt' (hlt'.trans hdn) e rfl, map_zero] at he
          exact he rfl
        · rw [ite_eq_left heq, sub_self] at he
          exact he rfl
    simpa using this
  have hAm : eval ![ϖ, ϖ'] A ∈ maximalIdeal R ^ (d + 1) := by
    have : eval ![ϖ, ϖ'] A = eval ![ϖ, ϖ'] H - eval ![ϖ, ϖ'] (H - A) := by simp
    rw [this]
    exact sub_mem (Ideal.pow_le_pow_right hdn h) hB
  intro e he
  have := coeff_mem_maximalIdeal_of_isHomogeneous hdim hϖ
    (MvPolynomial.homogeneousComponent_isHomogeneous d H) hAm e
  rw [MvPolynomial.coeff_homogeneousComponent, ite_eq_left he, hH, MvPolynomial.coeff_map] at this
  exact eq_zero_of_map_mem_maximalIdeal c this

/-- In a two-dimensional regular local ring whose maximal ideal is `(ϖ, ϖ')`, an element has at
most one expansion in the parameters `ϖ, ϖ'`. -/
theorem IsExpansion₂.unique [IsRegularLocalRing R] (hdim : ringKrullDim R = 2) {ϖ ϖ' : R}
    (hϖ : maximalIdeal R = Ideal.span {ϖ, ϖ'}) {c : K →+* R} {f : R}
    {F G : MvPowerSeries (Fin 2) K} (hF : IsExpansion₂ c ϖ ϖ' F f)
    (hG : IsExpansion₂ c ϖ ϖ' G f) : F = G := by
  rw [isExpansion₂_iff] at hF hG
  ext e
  have hlt : e.degree < e.degree + 1 := Nat.lt_succ_self _
  have hmem : eval ![ϖ, ϖ'] (map c (boxTrunc (e.degree + 1) G - boxTrunc (e.degree + 1) F)) ∈
      maximalIdeal R ^ (e.degree + 1) := by
    rw [hϖ, map_sub, map_sub]
    convert sub_mem (hF (e.degree + 1)) (hG (e.degree + 1)) using 1
    ring
  have := coeff_eq_zero_of_eval_map_mem hdim hϖ c _ hmem e hlt
  rw [MvPolynomial.coeff_sub, coeff_boxTrunc_of_degree_lt _ hlt, coeff_boxTrunc_of_degree_lt _ hlt,
    sub_eq_zero] at this
  exact this.symm

end Regular

section Existence

variable {K O : Type*} [Field K] [CommRing O] {c : K →+* O} {ϖ ϖ' : O}
  (Ψ : O →+* MvPowerSeries (Fin 2) K)

/-- A ring map sending `ϖ, ϖ'` to the variables sends `(ϖ, ϖ') ^ n` into `(X₀, X₁) ^ n`, whose
elements have no coefficient of degree `< n`. -/
theorem coeff_map_eq_zero_of_mem_pow (h0 : Ψ ϖ = MvPowerSeries.X 0)
    (h1 : Ψ ϖ' = MvPowerSeries.X 1) {n : ℕ} {r : O} (hr : r ∈ Ideal.span {ϖ, ϖ'} ^ n)
    {e : Fin 2 →₀ ℕ} (he : e.degree < n) : MvPowerSeries.coeff e (Ψ r) = 0 := by
  have hmap := Ideal.mem_map_of_mem Ψ hr
  rw [Ideal.map_pow, Ideal.map_span, Set.image_pair, h0, h1] at hmap
  exact MvPowerSeries.coeff_of_lt_order (lt_of_lt_of_le (by exact_mod_cast he)
    (le_order_of_mem_pow n _ hmap))

/-- `Ψ` of the value at `(ϖ, ϖ')` of a polynomial over `K` is the polynomial itself. -/
theorem map_eval_map (hc : ∀ a, Ψ (c a) = MvPowerSeries.C a)
    (h0 : Ψ ϖ = MvPowerSeries.X 0) (h1 : Ψ ϖ' = MvPowerSeries.X 1)
    (P : MvPolynomial (Fin 2) K) :
    Ψ (MvPolynomial.eval ![ϖ, ϖ'] (MvPolynomial.map c P)) = (P : MvPowerSeries (Fin 2) K) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [hc]
  | add p q hp hq => simp only [map_add, hp, hq, MvPolynomial.coe_add]
  | mul_X p i hp =>
    rw [map_mul, MvPolynomial.map_X, map_mul, MvPolynomial.eval_X, map_mul, hp,
      MvPolynomial.coe_mul, MvPolynomial.coe_X]
    fin_cases i <;> simp [h0, h1]

/-- If `Ψ` sends `ϖ, ϖ'` to `X₀, X₁` and `c a` to `C a`, the maximal ideal of `O` is `(ϖ, ϖ')`
and `ev` is a retraction of `c`, then `Ψ f` is an expansion of `f` in `ϖ, ϖ'`. -/
theorem isExpansion₂_map [IsLocalRing O] (hm : maximalIdeal O = Ideal.span {ϖ, ϖ'})
    (ev : O →+* K) (hev : ∀ k, ev (c k) = k) (hc : ∀ a, Ψ (c a) = MvPowerSeries.C a)
    (h0 : Ψ ϖ = MvPowerSeries.X 0) (h1 : Ψ ϖ' = MvPowerSeries.X 1) (f : O) :
    IsExpansion₂ c ϖ ϖ' (Ψ f) f := by
  refine (isExpansion₂_iff c ϖ ϖ' _ f).2 fun n ↦ ?_
  obtain ⟨G, hG⟩ := exists_eval_map_sub_mem hm c ev hev f n
  rw [hm] at hG
  rw [← sub_add_sub_cancel _ (MvPolynomial.eval ![ϖ, ϖ'] (MvPolynomial.map c G))]
  refine add_mem hG (eval_map_sub_eval_map_mem c ϖ ϖ' _ _ fun e he ↦ ?_)
  rw [coeff_boxTrunc_of_degree_lt _ he]
  have := coeff_map_eq_zero_of_mem_pow Ψ h0 h1 hG he
  rw [map_sub, map_eval_map Ψ hc h0 h1, map_sub, MvPolynomial.coeff_coe, sub_eq_zero] at this
  exact this.symm

end Existence

section Schemes

variable {K : Type u} [Field K]

/-- For `f = Spec φ`, the map `stalkClosedPointTo f` sends the germ of a global section `a` to
`φ a`. -/
theorem stalkClosedPointTo_germ_of_eq {R S : CommRingCat.{u}} [IsLocalRing S]
    (f : Spec S ⟶ Spec R) (φ : R ⟶ S) (hf : f = Spec.map φ) (a : R) :
    (Scheme.stalkClosedPointTo f).hom
      ((Spec R).presheaf.germ ⊤ (f (closedPoint S)) trivial ((Scheme.ΓSpecIso R).inv a)) = φ a := by
  subst hf
  simpa using congr($(Scheme.germ_stalkClosedPointTo_Spec φ) ((Scheme.ΓSpecIso R).inv a))

/-- Two morphisms `Spec S ⟶ Spec R` with `S` local are equal once their `stalkClosedPointTo`
agree on the germs of global sections. -/
theorem ext_of_germ {R : CommRingCat.{u}} {S : CommRingCat.{u}} [IsLocalRing S]
    (f₁ f₂ : Spec S ⟶ Spec R)
    (h : ∀ a, (Scheme.stalkClosedPointTo f₁).hom
      ((Spec R).presheaf.germ ⊤ (f₁ (closedPoint S)) trivial ((Scheme.ΓSpecIso R).inv a)) =
      (Scheme.stalkClosedPointTo f₂).hom
      ((Spec R).presheaf.germ ⊤ (f₂ (closedPoint S)) trivial ((Scheme.ΓSpecIso R).inv a))) :
    f₁ = f₂ := by
  rw [← Spec.map_preimage f₁, ← Spec.map_preimage f₂]
  congr 1
  ext a
  rw [← stalkClosedPointTo_germ_of_eq f₁ _ (Spec.map_preimage f₁).symm,
    ← stalkClosedPointTo_germ_of_eq f₂ _ (Spec.map_preimage f₂).symm, h]

/-- The constants `K → 𝒪_{Y,y}` of a scheme `Y` over `Spec K`, through its structure morphism. -/
noncomputable def const {Y : Scheme.{u}} [Y.Over (Spec (.of K))] (y : Y) :
    K →+* Y.presheaf.stalk y :=
  ((Scheme.ΓSpecIso (.of K)).inv ≫ (Y ↘ Spec (.of K)).appTop ≫
      Y.presheaf.germ ⊤ y trivial).hom

/-- The constants `const y` factor through the stalk map of the structure morphism at `y`. -/
theorem const_eq {Y : Scheme.{u}} [Y.Over (Spec (.of K))] (y : Y) :
    const y = ((Scheme.ΓSpecIso (.of K)).inv ≫
      (Spec (.of K)).presheaf.germ ⊤ ((Y ↘ Spec (.of K)) y) trivial ≫
        (Y ↘ Spec (.of K)).stalkMap y).hom := by
  rw [Scheme.Hom.germ_stalkMap (Y ↘ Spec (.of K)) ⊤ y trivial]
  rfl

/-- Evaluation at a `K`-point `q` is a retraction of the constants. -/
theorem ev_const {Y : Scheme.{u}} [Y.Over (Spec (.of K))] (q : Spec (.of K) ⟶ Y)
    (hq : q ≫ (Y ↘ Spec (.of K)) = 𝟙 _) (a : K) :
    (Scheme.stalkClosedPointTo q).hom (const (q (closedPoint K)) a) = a := by
  rw [const_eq, ← CommRingCat.comp_apply, Category.assoc, Category.assoc,
    ← Scheme.stalkClosedPointTo_comp]
  exact stalkClosedPointTo_germ_of_eq _ (𝟙 _) (hq.trans (Spec.map_id _).symm) a

/-- A morphism over `Spec K` is compatible with the constants on the stalks. -/
theorem const_comp {Y Z : Scheme.{u}} [Y.Over (Spec (.of K))] [Z.Over (Spec (.of K))]
    (f : Y ⟶ Z) (h : f ≫ (Z ↘ Spec (.of K)) = Y ↘ Spec (.of K)) (y : Y) (a : K) :
    const (K := K) y a = (f.stalkMap y).hom (const (K := K) (f y) a) := by
  have e : (Scheme.ΓSpecIso (.of K)).inv ≫ (Y ↘ Spec (.of K)).appTop ≫ Y.presheaf.germ ⊤ y trivial =
      ((Scheme.ΓSpecIso (.of K)).inv ≫ (Z ↘ Spec (.of K)).appTop ≫
        Z.presheaf.germ ⊤ (f y) trivial) ≫ f.stalkMap y := by
    rw [← h, Scheme.Hom.comp_appTop]
    simp only [Category.assoc]
    rw [Scheme.Hom.germ_stalkMap f ⊤ y trivial]
    rfl
  exact congr($e a)

/-- For `q : Spec R ⟶ Y`, `stalkClosedPointTo (q ≫ (Y ↘ Spec K))` sends the germ of the
constant `a` to the image of `const _ a` under `stalkClosedPointTo q`. -/
theorem stalkClosedPointTo_comp_over_germ {Y : Scheme.{u}} [Y.Over (Spec (.of K))]
    {R : CommRingCat.{u}} [IsLocalRing R] (q : Spec R ⟶ Y) (a : K) :
    (Scheme.stalkClosedPointTo (q ≫ (Y ↘ Spec (.of K)))).hom
      ((Spec (.of K)).presheaf.germ ⊤ _ trivial ((Scheme.ΓSpecIso (.of K)).inv a)) =
    (Scheme.stalkClosedPointTo q).hom (const (q (closedPoint R)) a) := by
  have : (Scheme.ΓSpecIso (.of K)).inv ≫ (Spec (.of K)).presheaf.germ ⊤ _ trivial ≫
      Scheme.stalkClosedPointTo (q ≫ (Y ↘ Spec (.of K))) =
      ((Scheme.ΓSpecIso (.of K)).inv ≫
        (Spec (.of K)).presheaf.germ ⊤ ((Y ↘ Spec (.of K)) (q (closedPoint R))) trivial ≫
        (Y ↘ Spec (.of K)).stalkMap (q (closedPoint R))) ≫ Scheme.stalkClosedPointTo q := by
    rw [Scheme.stalkClosedPointTo_comp]
    simp only [Category.assoc]
    rfl
  rw [const_eq]
  exact congr($this a)

/-- The identification of stalks at inseparable points preserves the constants. -/
theorem stalkCongr_const {Y : Scheme.{u}} [Y.Over (Spec (.of K))] {y y' : Y}
    (h : Inseparable y y') (a : K) : (Y.presheaf.stalkCongr h).hom (const y a) = const y' a := by
  have : ((Scheme.ΓSpecIso (.of K)).inv ≫ (Y ↘ Spec (.of K)).appTop ≫
      Y.presheaf.germ ⊤ y trivial) ≫ (Y.presheaf.stalkCongr h).hom =
      ((Scheme.ΓSpecIso (.of K)).inv ≫ (Y ↘ Spec (.of K)).appTop ≫
      Y.presheaf.germ ⊤ y' trivial) := by
    simp only [Category.assoc, TopCat.Presheaf.stalkCongr_hom]
    erw [TopCat.Presheaf.germ_stalkSpecializes]
  exact congr($this a)

/-- For a local homomorphism `ψ : 𝒪_{Y,y} ⟶ R`, the morphism `Spec R ⟶ Y` it defines sends the
closed point to `y`, and its `stalkClosedPointTo` is `ψ` up to the identification of stalks. -/
theorem stalkClosedPointTo_fromSpecStalk_eq {Y : Scheme.{u}} {R : CommRingCat.{u}}
    [IsLocalRing R] (y : Y) (ψ : Y.presheaf.stalk y ⟶ R) [IsLocalHom ψ.hom] :
    ∃ h : (Spec.map ψ ≫ Y.fromSpecStalk y) (closedPoint R) = y,
      Scheme.stalkClosedPointTo (Spec.map ψ ≫ Y.fromSpecStalk y) =
        (Y.presheaf.stalkCongr (.of_eq h)).hom ≫ ψ :=
  SpecToEquivOfLocalRing_eq_iff.mp
    ((SpecToEquivOfLocalRing Y R).apply_symm_apply ⟨y, ψ, inferInstance⟩)

/-- Equal morphisms `Spec R ⟶ Y` have the same `stalkClosedPointTo`, up to the identification of
stalks. -/
theorem stalkClosedPointTo_congr {Y : Scheme.{u}} {R : CommRingCat.{u}} [IsLocalRing R]
    {f₁ f₂ : Spec R ⟶ Y} (h : f₁ = f₂) :
    Scheme.stalkClosedPointTo f₁ =
      (Y.presheaf.stalkCongr (.of_eq (by rw [h]))).hom ≫ Scheme.stalkClosedPointTo f₂ := by
  subst h
  simp

/-- Local homomorphisms `ψC`, `ψD` from the stalks of `C` and `D` at the coordinates of `p` into a
local ring `R`, agreeing on the constants and followed by `ε` the evaluations, glue to a
homomorphism from the stalk of `C ×_K D` at `p` restricting to `ψC` and `ψD`. -/
theorem exists_stalk_hom {C D : Scheme.{u}} [C.Over (Spec (.of K))] [D.Over (Spec (.of K))]
    (p : Spec (.of K) ⟶ pullback (C ↘ Spec (.of K)) (D ↘ Spec (.of K)))
    {R : CommRingCat.{u}} [IsLocalRing R] (ε : R ⟶ CommRingCat.of K) [IsLocalHom ε.hom]
    (ψC : C.presheaf.stalk ((p ≫ pullback.fst _ _) (closedPoint K)) ⟶ R) [IsLocalHom ψC.hom]
    (ψD : D.presheaf.stalk ((p ≫ pullback.snd _ _) (closedPoint K)) ⟶ R) [IsLocalHom ψD.hom]
    (hεC : ψC ≫ ε = Scheme.stalkClosedPointTo (p ≫ pullback.fst _ _))
    (hεD : ψD ≫ ε = Scheme.stalkClosedPointTo (p ≫ pullback.snd _ _))
    (hc : ∀ a, ψC.hom (const (K := K) _ a) = ψD.hom (const (K := K) _ a)) :
    ∃ Ψ : (pullback (C ↘ Spec (.of K)) (D ↘ Spec (.of K))).presheaf.stalk (p (closedPoint K)) ⟶ R,
      (pullback.fst _ _ : pullback (C ↘ Spec (.of K)) (D ↘ Spec (.of K)) ⟶ C).stalkMap
          (p (closedPoint K)) ≫ Ψ = ψC ∧
      (pullback.snd _ _ : pullback (C ↘ Spec (.of K)) (D ↘ Spec (.of K)) ⟶ D).stalkMap
          (p (closedPoint K)) ≫ Ψ = ψD := by
  set gC := Spec.map ψC ≫ C.fromSpecStalk _
  set gD := Spec.map ψD ≫ D.fromSpecStalk _
  obtain ⟨hgC, hstcC⟩ := stalkClosedPointTo_fromSpecStalk_eq _ ψC
  obtain ⟨hgD, hstcD⟩ := stalkClosedPointTo_fromSpecStalk_eq _ ψD
  have hcond : gC ≫ (C ↘ Spec (.of K)) = gD ≫ (D ↘ Spec (.of K)) := by
    refine ext_of_germ _ _ fun a ↦ ?_
    rw [stalkClosedPointTo_comp_over_germ, stalkClosedPointTo_comp_over_germ, hstcC, hstcD,
      CommRingCat.comp_apply, CommRingCat.comp_apply, stalkCongr_const, stalkCongr_const]
    exact hc a
  set g := pullback.lift gC gD hcond
  have hρ : Spec.map ε ≫ g = p := by
    refine pullback.hom_ext ?_ ?_
    · rw [Category.assoc, pullback.lift_fst, ← Category.assoc, ← Spec.map_comp, hεC,
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk]
    · rw [Category.assoc, pullback.lift_snd, ← Category.assoc, ← Spec.map_comp, hεD,
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk]
  have hpt : g (closedPoint R) = p (closedPoint K) := by
    rw [← hρ]
    change g _ = g (Spec.map ε (closedPoint K))
    rw [Spec_closedPoint]
  refine ⟨(TopCat.Presheaf.stalkCongr _ (.of_eq hpt.symm)).hom ≫ Scheme.stalkClosedPointTo g,
    ?_, ?_⟩
  · rw [Scheme.Hom.stalkMap_congr_point_assoc _ _ _ hpt.symm, ← Scheme.stalkClosedPointTo_comp,
      stalkClosedPointTo_congr (pullback.lift_fst _ _ _), hstcC]
    simp only [TopCat.Presheaf.stalkCongr_hom]
    erw [TopCat.Presheaf.stalkSpecializes_comp_assoc, TopCat.Presheaf.stalkSpecializes_comp_assoc,
      TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp]
  · rw [Scheme.Hom.stalkMap_congr_point_assoc _ _ _ hpt.symm, ← Scheme.stalkClosedPointTo_comp,
      stalkClosedPointTo_congr (pullback.lift_snd _ _ _), hstcD]
    simp only [TopCat.Presheaf.stalkCongr_hom]
    erw [TopCat.Presheaf.stalkSpecializes_comp_assoc, TopCat.Presheaf.stalkSpecializes_comp_assoc,
      TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp]

/-- Two local homomorphisms out of the stalk of a fibre product into a local ring agree once they
agree after the stalk maps of both projections. -/
theorem stalk_pullback_hom_ext {X Y Z : Scheme.{u}} {f : X ⟶ Z} {g : Y ⟶ Z}
    (x : ↥(pullback f g)) {R : CommRingCat.{u}} [IsLocalRing R]
    (Φ₁ Φ₂ : (pullback f g).presheaf.stalk x ⟶ R) [IsLocalHom Φ₁.hom] [IsLocalHom Φ₂.hom]
    (h₁ : (pullback.fst f g).stalkMap x ≫ Φ₁ = (pullback.fst f g).stalkMap x ≫ Φ₂)
    (h₂ : (pullback.snd f g).stalkMap x ≫ Φ₁ = (pullback.snd f g).stalkMap x ≫ Φ₂) :
    Φ₁ = Φ₂ := by
  have key : Spec.map Φ₁ ≫ (pullback f g).fromSpecStalk x =
      Spec.map Φ₂ ≫ (pullback f g).fromSpecStalk x := by
    refine pullback.hom_ext ?_ ?_
    · rw [Category.assoc, Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk,
        ← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp, h₁]
    · rw [Category.assoc, Category.assoc, ← Scheme.SpecMap_stalkMap_fromSpecStalk,
        ← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp, h₂]
  have := (SpecToEquivOfLocalRing (pullback f g) R).symm.injective
    (a₁ := ⟨x, Φ₁, inferInstance⟩) (a₂ := ⟨x, Φ₂, inferInstance⟩)
    (by simpa only [SpecToEquivOfLocalRing_symm_apply] using key)
  simpa only [Sigma.mk.injEq, heq_eq_eq, true_and, Subtype.mk.injEq] using this

end Schemes

section Curves

variable {K : Type u} [Field K]

/-- Evaluation at a `K`-point kills the maximal ideal of the stalk. -/
theorem ev_eq_zero_of_mem {Y : Scheme.{u}} (q : Spec (.of K) ⟶ Y)
    {g : Y.presheaf.stalk (q (closedPoint K))} (hg : g ∈ maximalIdeal _) :
    (Scheme.stalkClosedPointTo q).hom g = 0 := by
  by_contra h
  exact (mem_maximalIdeal _ |>.mp hg) (IsLocalHom.map_nonunit _ (isUnit_iff_ne_zero.mpr h))

/-- At a `K`-point with uniformizer `ς`, every germ `g` minus the constant `g(q)` is a multiple
of `ς`. -/
theorem exists_sub_eq_mul {Y : Scheme.{u}} [Y.Over (Spec (.of K))] (q : Spec (.of K) ⟶ Y)
    (hq : q ≫ (Y ↘ Spec (.of K)) = 𝟙 _) {ς : Y.presheaf.stalk (q (closedPoint K))}
    (hς : maximalIdeal _ = Ideal.span {ς}) (g : Y.presheaf.stalk (q (closedPoint K))) :
    ∃ r, g - const (K := K) _ ((Scheme.stalkClosedPointTo q).hom g) = ς * r := by
  have hmem : g - const (K := K) _ ((Scheme.stalkClosedPointTo q).hom g) ∈ maximalIdeal _ := by
    rw [mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have := (hu.map (Scheme.stalkClosedPointTo q).hom)
    rw [map_sub, ev_const q hq, sub_self] at this
    exact not_isUnit_zero this
  rw [hς, Ideal.mem_span_singleton'] at hmem
  obtain ⟨r, hr⟩ := hmem
  exact ⟨r, by rw [← hr, mul_comm]⟩

/-- A uniformizer at a `K`-point of a curve is nonzero. -/
theorem ne_zero_of_maximalIdeal_eq {C : Scheme.{u}} [C.Over (Spec (.of K))]
    [IsCurve K (C ↘ Spec (.of K))] (z : Spec (.of K) ⟶ C)
    (hz : z ≫ (C ↘ Spec (.of K)) = 𝟙 _) {ς : C.presheaf.stalk (z (closedPoint K))}
    (hς : maximalIdeal _ = Ideal.span {ς}) : ς ≠ 0 := by
  intro h0
  have : IsClosedImmersion (z ≫ (C ↘ Spec (.of K))) := by
    rw [hz]
    infer_instance
  have : IsClosedImmersion z := IsClosedImmersion.of_comp z (C ↘ Spec (.of K))
  have hcl : IsClosed ({z (closedPoint K)} : Set C) := by
    have := z.isClosedEmbedding.isClosed_range
    convert this using 1
    ext y
    refine ⟨fun h ↦ ⟨_, (Set.mem_singleton_iff.mp h).symm⟩, ?_⟩
    rintro ⟨x, rfl⟩
    rw [Subsingleton.elim x (closedPoint K)]
    rfl
  have hdim := ringKrullDim_stalk_eq_one_of_isCurve K (C ↘ Spec (.of K)) hcl
  have hfield : IsField (C.presheaf.stalk (z (closedPoint K))) :=
    isField_iff_maximalIdeal_eq.mpr (by rw [hς, h0, Ideal.span_singleton_eq_bot.mpr rfl])
  rw [ringKrullDim_eq_zero_of_isField hfield] at hdim
  exact zero_ne_one hdim

/-- `f` is congruent modulo `ς ^ n` to its Taylor polynomial `∑_{i < n} ∂ᵢ f(z) ς ^ i`. -/
theorem isExpansion_taylorCoeff {Y : Scheme.{u}} [Y.Over (Spec (.of K))]
    (z : Spec (.of K) ⟶ Y) (hz : z ≫ (Y ↘ Spec (.of K)) = 𝟙 _)
    {ς : Y.presheaf.stalk (z (closedPoint K))} (hς : maximalIdeal _ = Ideal.span {ς})
    (f : Y.presheaf.stalk (z (closedPoint K))) :
    IsExpansion (const _) ς (PowerSeries.mk (taylorCoeff z ς f)) f :=
  isExpansion_mk (exists_sub_eq_mul z hz hς) f

variable {Y : Scheme.{u}} [Y.Over (Spec (.of K))] [IsCurve K (Y ↘ Spec (.of K))]
  (z : Spec (.of K) ⟶ Y) (hz : z ≫ (Y ↘ Spec (.of K)) = 𝟙 _)
  {ς : Y.presheaf.stalk (z (closedPoint K))} (hς : maximalIdeal _ = Ideal.span {ς})

/-- The expansion `𝒪_{Y,z} → K⟦X⟧` in powers of a uniformizer `ς` at a `K`-point `z` of a curve:
a ring homomorphism sending `ς` to `X` and the constants to the constants. -/
noncomputable def curveExpansion : Y.presheaf.stalk (z (closedPoint K)) →+* PowerSeries K :=
  expansionHom (const _) (Scheme.stalkClosedPointTo z).hom ς (ev_const z hz)
    (ev_eq_zero_of_mem z (hς ▸ Ideal.mem_span_singleton_self ς))
    (ne_zero_of_maximalIdeal_eq z hz hς) (exists_sub_eq_mul z hz hς)

/-- The coefficients of `curveExpansion z hz hς f` are the Taylor coefficients of `f`. -/
theorem coeff_curveExpansion (f : Y.presheaf.stalk (z (closedPoint K))) (j : ℕ) :
    PowerSeries.coeff j (curveExpansion z hz hς f) = taylorCoeff z ς f j :=
  coeff_expansionHom _ _ _ _ f j

/-- The constant coefficient of `curveExpansion z hz hς f` is the value `f(z)`. -/
theorem constantCoeff_curveExpansion (f : Y.presheaf.stalk (z (closedPoint K))) :
    PowerSeries.constantCoeff (curveExpansion z hz hς f) = (Scheme.stalkClosedPointTo z).hom f :=
  constantCoeff_expansionHom _ _ _ _ f

/-- `curveExpansion` sends the uniformizer `ς` to `X`. -/
theorem curveExpansion_self : curveExpansion z hz hς ς = PowerSeries.X :=
  expansionHom_self _ _ _ _

/-- `curveExpansion` sends the constant `a` to the constant series `C a`. -/
theorem curveExpansion_comp_const : (curveExpansion z hz hς).comp (const _) = PowerSeries.C :=
  expansionHom_comp_c _ _ _ _

variable (i : Fin 2)

/-- The constant coefficient of `curveExpansion z hz hς f`, as a series in `Xᵢ`, is `f(z)`. -/
theorem constantCoeff_toMvPowerSeries_curveExpansion
    (f : Y.presheaf.stalk (z (closedPoint K))) :
    MvPowerSeries.constantCoeff (PowerSeries.toMvPowerSeries i (curveExpansion z hz hς f)) =
      (Scheme.stalkClosedPointTo z).hom f := by
  rw [PowerSeries.toMvPowerSeries_apply, MvPowerSeries.constantCoeff_rename]
  exact constantCoeff_expansionHom _ _ _ _ _

/-- `curveExpansion` sends the constant `a` to the constant series `C a`. -/
theorem toMvPowerSeries_curveExpansion_const (a : K) :
    PowerSeries.toMvPowerSeries i (curveExpansion z hz hς (const _ a)) = MvPowerSeries.C a := by
  rw [← PowerSeries.toMvPowerSeries_C i]
  exact congrArg _ (RingHom.congr_fun (expansionHom_comp_c (ev_const z hz)
    (ev_eq_zero_of_mem z (hς ▸ Ideal.mem_span_singleton_self ς))
    (ne_zero_of_maximalIdeal_eq z hz hς) (exists_sub_eq_mul z hz hς)) a)

/-- `curveExpansion` sends the uniformizer `ς` to the variable `Xᵢ`. -/
theorem toMvPowerSeries_curveExpansion_self :
    PowerSeries.toMvPowerSeries i (curveExpansion z hz hς ς) = MvPowerSeries.X i := by
  rw [curveExpansion, expansionHom_self, PowerSeries.toMvPowerSeries_X]

/-- `curveExpansion`, read as a series in `Xᵢ`, is a local homomorphism. -/
theorem isLocalHom_toMvPowerSeries_comp_curveExpansion :
    IsLocalHom ((PowerSeries.toMvPowerSeries i).toRingHom.comp (curveExpansion z hz hς)) :=
  ⟨fun s hs ↦ IsLocalHom.map_nonunit (f := (Scheme.stalkClosedPointTo z).hom) s <|
    isUnit_iff_ne_zero.mpr <| by
      simpa [constantCoeff_toMvPowerSeries_curveExpansion] using hs.map MvPowerSeries.constantCoeff⟩

end Curves

section Product

variable {K : Type u} [Field K] {C D : Scheme.{u}} [C.Over (Spec (.of K))] [D.Over (Spec (.of K))]
  (p : Spec (.of K) ⟶ pullback (C ↘ Spec (.of K)) (D ↘ Spec (.of K)))

/-- There is a ring homomorphism `Ψ : 𝒪_{C ×_K D, p} → K⟦X₀, X₁⟧` sending `ς ∘ pr₁` to `X₀`,
`ς' ∘ pr₂` to `X₁` and the constants to the constants. -/
theorem exists_ringHom_mvPowerSeries [IsCurve K (C ↘ Spec (.of K))]
    [IsCurve K (D ↘ Spec (.of K))]
    (hzC : (p ≫ pullback.fst _ _) ≫ (C ↘ Spec (.of K)) = 𝟙 _)
    (hzD : (p ≫ pullback.snd _ _) ≫ (D ↘ Spec (.of K)) = 𝟙 _)
    {ς : C.presheaf.stalk ((p ≫ pullback.fst _ _) (closedPoint K))}
    {ς' : D.presheaf.stalk ((p ≫ pullback.snd _ _) (closedPoint K))}
    (hς : maximalIdeal _ = Ideal.span {ς}) (hς' : maximalIdeal _ = Ideal.span {ς'}) :
    ∃ Ψ : (pullback (C ↘ Spec (.of K)) (D ↘ Spec (.of K))).presheaf.stalk (p (closedPoint K)) →+*
        MvPowerSeries (Fin 2) K,
      (∀ a, Ψ (const _ a) = MvPowerSeries.C a) ∧
      Ψ ((pullback.fst (C ↘ Spec (.of K)) (D ↘ Spec (.of K))).stalkMap _ ς) =
        MvPowerSeries.X 0 ∧
      Ψ ((pullback.snd (C ↘ Spec (.of K)) (D ↘ Spec (.of K))).stalkMap _ ς') =
        MvPowerSeries.X 1 := by
  let R := CommRingCat.of (MvPowerSeries (Fin 2) K)
  let ψC : C.presheaf.stalk ((p ≫ pullback.fst _ _) (closedPoint K)) ⟶ R :=
    CommRingCat.ofHom ((PowerSeries.toMvPowerSeries 0).toRingHom.comp (curveExpansion _ hzC hς))
  let ψD : D.presheaf.stalk ((p ≫ pullback.snd _ _) (closedPoint K)) ⟶ R :=
    CommRingCat.ofHom ((PowerSeries.toMvPowerSeries 1).toRingHom.comp (curveExpansion _ hzD hς'))
  let ε : R ⟶ CommRingCat.of K := CommRingCat.ofHom MvPowerSeries.constantCoeff
  have : IsLocalHom ψC.hom := isLocalHom_toMvPowerSeries_comp_curveExpansion _ hzC hς 0
  have : IsLocalHom ψD.hom := isLocalHom_toMvPowerSeries_comp_curveExpansion _ hzD hς' 1
  have : IsLocalHom ε.hom := ⟨fun f hf ↦ MvPowerSeries.isUnit_iff_constantCoeff.mpr hf⟩
  obtain ⟨Ψ, hΨC, hΨD⟩ := exists_stalk_hom p ε ψC ψD
    (by ext s; exact constantCoeff_toMvPowerSeries_curveExpansion _ hzC hς 0 s)
    (by ext s; exact constantCoeff_toMvPowerSeries_curveExpansion _ hzD hς' 1 s)
    (fun a ↦ (toMvPowerSeries_curveExpansion_const _ hzC hς 0 a).trans
      (toMvPowerSeries_curveExpansion_const _ hzD hς' 1 a).symm)
  refine ⟨Ψ.hom, fun a ↦ ?_, congr($hΨC ς).trans (toMvPowerSeries_curveExpansion_self _ hzC hς 0),
    congr($hΨD ς').trans (toMvPowerSeries_curveExpansion_self _ hzD hς' 1)⟩
  rw [const_comp (pullback.snd _ _) rfl]
  exact congr($hΨD _).trans (toMvPowerSeries_curveExpansion_const _ hzD hς' 1 a)

/-- If `ψ : E → O` is compatible with sections `c_E, c_O` of evaluations `ev_E, ev_O` to `K`,
every `h ∈ E` is `c_E (ev_E h)` plus a multiple of `t`, and `ψ t` lies in an ideal `I` killed
by `ev_O`, then modulo `I` the element `ψ h` is the constant `c_O (ev_O (ψ h))`. -/
private theorem mk_map_eq_mk_const {O E : Type*} [CommRing O] [CommRing E] (I : Ideal O)
    (cE : K →+* E) (cO : K →+* O) (ev : O →+* K) (evE : E →+* K) (ψ : E →+* O)
    (hψ : ∀ a, ψ (cE a) = cO a) (hev : ∀ a, ev (cO a) = a) (t : E)
    (hsub : ∀ h, ∃ r, h - cE (evE h) = t * r) (htI : ψ t ∈ I) (hevI : ∀ y ∈ I, ev y = 0)
    (h : E) : Ideal.Quotient.mk I (ψ h) = Ideal.Quotient.mk I (cO (ev (ψ h))) := by
  obtain ⟨r, hr⟩ := hsub h
  have e : ψ h = cO (evE h) + ψ t * ψ r := by
    rw [← hψ, ← map_mul, ← map_add, ← hr]
    ring_nf
  rw [e, map_add ev, map_mul ev, hev, hevI _ htI, zero_mul, add_zero,
    map_add (Ideal.Quotient.mk I), map_mul (Ideal.Quotient.mk I),
    Ideal.Quotient.eq_zero_iff_mem.2 htI, zero_mul, add_zero]

/-- At a `K`-point `p` of `C ×_K D`, whose projections are `K`-points with uniformizers `ς` and
`ς'`, the maximal ideal of the local ring is generated by `ς ∘ pr₁` and `ς' ∘ pr₂`. -/
theorem maximalIdeal_stalk_pullback_eq_span
    (hp : p ≫ (pullback (C ↘ Spec (.of K)) (D ↘ Spec (.of K)) ↘ Spec (.of K)) = 𝟙 _)
    (hzC : (p ≫ pullback.fst _ _) ≫ (C ↘ Spec (.of K)) = 𝟙 _)
    (hzD : (p ≫ pullback.snd _ _) ≫ (D ↘ Spec (.of K)) = 𝟙 _)
    {ς : C.presheaf.stalk ((p ≫ pullback.fst _ _) (closedPoint K))}
    {ς' : D.presheaf.stalk ((p ≫ pullback.snd _ _) (closedPoint K))}
    (hς : maximalIdeal _ = Ideal.span {ς}) (hς' : maximalIdeal _ = Ideal.span {ς'}) :
    maximalIdeal ((pullback (C ↘ Spec (.of K)) (D ↘ Spec (.of K))).presheaf.stalk
        (p (closedPoint K))) =
      Ideal.span {(pullback.fst (C ↘ Spec (.of K)) (D ↘ Spec (.of K))).stalkMap _ ς,
        (pullback.snd (C ↘ Spec (.of K)) (D ↘ Spec (.of K))).stalkMap _ ς'} := by
  set x := p (closedPoint K)
  set O := (pullback (C ↘ Spec (.of K)) (D ↘ Spec (.of K))).presheaf.stalk x
  set φ₁ := (pullback.fst (C ↘ Spec (.of K)) (D ↘ Spec (.of K))).stalkMap x
  set φ₂ := (pullback.snd (C ↘ Spec (.of K)) (D ↘ Spec (.of K))).stalkMap x
  set I : Ideal O := Ideal.span {φ₁ ς, φ₂ ς'}
  set ev := (Scheme.stalkClosedPointTo p).hom
  have hϖ : φ₁ ς ∈ maximalIdeal O := fun hu ↦
    (mem_maximalIdeal _).1 (hς ▸ Ideal.mem_span_singleton_self ς) (IsLocalHom.map_nonunit _ hu)
  have hϖ' : φ₂ ς' ∈ maximalIdeal O := fun hu ↦
    (mem_maximalIdeal _).1 (hς' ▸ Ideal.mem_span_singleton_self ς') (IsLocalHom.map_nonunit _ hu)
  have hI : I ≤ maximalIdeal O := by
    rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    exacts [hϖ, hϖ']
  refine le_antisymm ?_ hI
  have : Nontrivial (O ⧸ I) :=
    Submodule.Quotient.nontrivial_iff.2 (ne_top_of_le_ne_top (maximalIdeal.isMaximal O).ne_top hI)
  have : IsLocalRing (O ⧸ I) := IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  let π : O ⟶ CommRingCat.of (O ⧸ I) := CommRingCat.ofHom (Ideal.Quotient.mk I)
  let κ : O ⟶ CommRingCat.of (O ⧸ I) :=
    CommRingCat.ofHom (((Ideal.Quotient.mk I).comp (const (K := K) x)).comp ev)
  have : IsLocalHom π.hom := ⟨fun a ha ↦ by
    by_contra hna
    obtain ⟨b, hb⟩ := ha.exists_right_inv
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
    have hab : a * b - 1 ∈ I := Ideal.Quotient.eq.1 (by rw [map_mul, map_one]; exact hb)
    have h1 : (1 : O) ∈ maximalIdeal O := by
      simpa using sub_mem (Ideal.mul_mem_right b _ ((mem_maximalIdeal a).2 hna)) (hI hab)
    exact (maximalIdeal.isMaximal O).ne_top ((Ideal.eq_top_iff_one _).2 h1)⟩
  have : IsLocalHom κ.hom := by
    change IsLocalHom (((Ideal.Quotient.mk I).comp (const (K := K) x)).comp ev)
    infer_instance
  have hevI : ∀ y ∈ I, ev y = 0 := fun y hy ↦ ev_eq_zero_of_mem p (hI hy)
  have hevc : ∀ a, ev (const (K := K) x a) = a := ev_const p hp
  refine fun g hg ↦ Ideal.Quotient.eq_zero_iff_mem.1 ?_
  have key : π = κ := by
    refine stalk_pullback_hom_ext x π κ ?_ ?_
    · ext h
      exact mk_map_eq_mk_const I _ _ ev _ φ₁.hom
        (fun a ↦ (const_comp (pullback.fst _ _) pullback.condition x a).symm) hevc ς
        (exists_sub_eq_mul _ hzC hς) (Ideal.subset_span (by simp)) hevI h
    · ext h
      exact mk_map_eq_mk_const I _ _ ev _ φ₂.hom
        (fun a ↦ (const_comp (pullback.snd _ _) rfl x a).symm) hevc ς'
        (exists_sub_eq_mul _ hzD hς') (Ideal.subset_span (by simp)) hevI h
  have := congrArg (fun φ ↦ φ.hom g) key
  change Ideal.Quotient.mk I g = Ideal.Quotient.mk I (const (K := K) x (ev g)) at this
  exact this.trans (by rw [ev_eq_zero_of_mem p hg, map_zero, map_zero])

end Product

/-- Through a ring homomorphism `Ψ` to `K⟦X₀, X₁⟧` sending `ϖ, ϖ'` to `X₀, X₁` and the constants
to the constants, any expansion of `f` in `ϖ, ϖ'` computes the Taylor coefficients of `f`. -/
theorem taylorCoeff₂_eq_coeff {K : Type u} [Field K] {X : Scheme.{u}}
    [X.Over (Spec (.of K))] {p : Spec (.of K) ⟶ X} {ϖ ϖ' f : X.presheaf.stalk (p (closedPoint K))}
    (Ψ : X.presheaf.stalk (p (closedPoint K)) →+* MvPowerSeries (Fin 2) K)
    (hc : ∀ a, Ψ (const _ a) = MvPowerSeries.C a) (h0 : Ψ ϖ = MvPowerSeries.X 0)
    (h1 : Ψ ϖ' = MvPowerSeries.X 1) {F : MvPowerSeries (Fin 2) K}
    (hF : IsExpansion₂ (const _) ϖ ϖ' F f) (a b : ℕ) :
    taylorCoeff₂ p ϖ ϖ' f a b = MvPowerSeries.coeff (bidegree (a, b)) F :=
  coeff_bidegree_eq Ψ hc h0 h1
    (Classical.epsilon_spec (p := fun F ↦ IsExpansion₂ (const _) ϖ ϖ' F f) ⟨F, hF⟩) hF a b

/-- A `K`-point of a scheme over `Spec K` is a section of the structure morphism. -/
theorem comp_over_eq_id {K : Type u} [Field K] {X : Scheme.{u}} [X.Over (Spec (.of K))]
    (p : Spec (.of K) ⟶ X) [p.IsOver (Spec (.of K))] : p ≫ (X ↘ Spec (.of K)) = 𝟙 _ := by
  refine (comp_over p (Spec (.of K))).trans ?_
  change Spec.map (CommRingCat.ofHom (algebraMap K K)) = _
  rw [Algebra.algebraMap_self, CommRingCat.ofHom_id, Spec.map_id]

end

end Faltings.BombieriVojta
