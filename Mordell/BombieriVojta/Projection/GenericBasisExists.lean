/-!
# Existence of a generic basis of `H⁰(C, 𝒪(NP))`

Let `C` be a smooth projective geometrically integral curve of genus `g ≥ 2` over a number field
`k`, let `P` be a divisor of degree one on `C`, let `N ≥ 2g + 1` and `n = N - g`, so that
`H⁰(C, 𝒪(NP))` has dimension `n + 1`. The embedding `φ_{NP} : C → ℙⁿ` is determined by a
`k`-basis of `H⁰(C, 𝒪(NP))` only up to an automorphism of `ℙⁿ`. Since `k` is infinite, a basis
in general position satisfies Bombieri's conditions (G1), (G2), (G3): there is a generic basis in
the sense of `Faltings.BombieriSiegel.IsGenericBasis`.

## Main results

* `Faltings.BombieriSiegel.exists_isGenericBasis`: if `n ≥ 2`, there is a generic `k`-basis
  `ℓ₀, …, ℓₙ` of `H⁰(C, 𝒪(NP))`.
* `Faltings.BombieriSiegel.exists_ord_add_eq_zero_of_isGenericBasis`: for `N ≥ 2g` a generic
  basis of `L(NP)` has no base point.
* `Faltings.BombieriSiegel.exists_basis_toProjectiveSpaceOver_germ_eq_div`: for `N ≥ 2g + 1` a
  generic basis `x` of `L(NP)` gives a closed immersion `φ_{NP} : C ⟶ ℙⁿ_k` over `k`, the
  morphism of a basis of `Γ(C, 𝒪(NP))`, whose coordinate functions on the chart
  `φ_{NP}⁻¹ D₊(T_j)` are `x_ν / x_j`.

## Implementation notes

As in `Faltings.BombieriSiegel.IsGenericBasis`, `H⁰(C, 𝒪(D))` is the Riemann–Roch space
`{g ∈ k(C) : ord_Q g + D(Q) ≥ 0 for all Q}` and a divisor is a finitely supported function
`C →₀ ℤ`. The divisor `P` is supported on closed points, and its degree is
`∑_Q P(Q) [κ(Q) : k]`, with `[κ(Q) : k]` given by `AlgebraicGeometry.Scheme.Hom.residueDegree`.
The basis is indexed by `Fin (n + 1)`, so its existence also records that
`dim_k H⁰(C, 𝒪(NP)) = n + 1`.

The basis is chosen one vector at a time. Each condition involving the vector `ℓ_m` and the
vectors already chosen fails only on finitely many proper `k`-subspaces of `V = L(NP)`, and a
vector space over an infinite field is not a finite union of proper subspaces. For (G1) these are
the subspaces of sections vanishing at a zero of `ℓ₀`, proper because `𝒪(NP)` is generated by its
global sections. For (G2) and (G3), with `F = k(u)` for the ratio `u` of two vectors already
chosen, the field `K = k(C)` is finite separable over `F` and generated over `F` by the ratios
`V / ℓ_j`; then `v / ℓ_j` is a primitive element of `K / F` unless two of the finitely many
`F`-embeddings of `K` into an algebraic closure agree on it, which happens on a proper subspace.
The source instead argues with a generic matrix over `k(t_{ab})` followed by a specialisation;
the primitive element criterion `Field.primitive_element_iff_algHom_eq_of_eval` applied to
`K / k(u)` replaces the generic computation of conjugates. The geometric inputs are the
Riemann–Roch dimension `dim L(NP) = N + 1 - g`, the global generation of `𝒪(NP)` and the fact
that the closed immersion `C → ℙⁿ` given by `L(NP)` makes the ratios `V / ℓ` generate `k(C)`.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Section 3; Section 7,
  pp. 627–628; Section 8, p. 629
-/

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits IntermediateField

universe u

/- Mathlib's `[IsSimpleAddGroup G] [IsNilpotent G] : AddCommGroup G` instance is tried first for
`AddCommGroup X.functionField` and, through `IsVariety.toIsIntegral` with an unknown base field,
enumerates every `Field` instance before failing: it is switched off in this file. -/
attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent

namespace Faltings.BombieriSiegel

section Core

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- The `k`-subspace of `K` on which two `F`-embeddings agree. -/
private def eqLocusSubmodule {F : IntermediateField k K} {A : Type*} [Field A] [Algebra F A]
    (φ ψ : K →ₐ[F] A) : Submodule k K where
  carrier := {x | φ x = ψ x}
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_ofPred_eq] at *
    rw [map_add, map_add, ha, hb]
  zero_mem' := by simp
  smul_mem' := by
    intro c x hx
    simp only [Set.mem_ofPred_eq] at *
    rw [Algebra.smul_def, map_mul, map_mul, hx, IsScalarTower.algebraMap_apply k F K c,
      φ.commutes, ψ.commutes]

/-- If `W` generates `K` over `F`, all elements of `W` outside finitely many proper
`k`-subspaces are primitive elements of `K/F`. -/
private theorem exists_finite_bad [CharZero K] (F : IntermediateField k K) [FiniteDimensional F K]
    (W : Submodule k K) (hW : IntermediateField.adjoin F (W : Set K) = ⊤) :
    ∃ s : Set (Submodule k K), s.Finite ∧ (∀ S ∈ s, ¬ W ≤ S) ∧
      ∀ w ∈ W, (∀ S ∈ s, w ∉ S) → F⟮w⟯ = ⊤ := by
  classical
  let A := AlgebraicClosure K
  let ι := {p : (K →ₐ[F] A) × (K →ₐ[F] A) // p.1 ≠ p.2}
  refine ⟨Set.range fun p : ι => eqLocusSubmodule p.1.1 p.1.2, Set.finite_range _, ?_, ?_⟩
  · rintro _ ⟨⟨⟨φ, ψ⟩, hne⟩, rfl⟩ hle
    apply hne
    have h : ∀ x ∈ (W : Set K), φ x = ψ x := fun x hx => hle hx
    have := IntermediateField.algHom_ext_of_eq_adjoin F (S := ⊤) hW.symm
      (φ₁ := φ.comp (IntermediateField.topEquiv (F := F) (E := K)).toAlgHom)
      (φ₂ := ψ.comp (IntermediateField.topEquiv (F := F) (E := K)).toAlgHom)
      (fun x hx => h x hx)
    ext x
    exact congrArg (fun χ : (⊤ : IntermediateField F K) →ₐ[F] A => χ ⟨x, trivial⟩) this
  · intro w _ hw
    let φ₀ : K →ₐ[F] A := IsScalarTower.toAlgHom F K A
    rw [Field.primitive_element_iff_algHom_eq_of_eval F A (fun x => IsAlgClosed.splits _) w φ₀]
    intro ψ hψ
    by_contra hne
    exact hw _ ⟨⟨(φ₀, ψ), hne⟩, rfl⟩ hψ

/-- Over an infinite field, a subspace is not covered by finitely many subspaces not
containing it. -/
private theorem exists_mem_forall_notMem [Infinite k] {M : Type*} [AddCommGroup M] [Module k M]
    (V : Submodule k M) (s : Set (Submodule k M)) (hs : s.Finite) (h : ∀ S ∈ s, ¬ V ≤ S) :
    ∃ v ∈ V, ∀ S ∈ s, v ∉ S := by
  have : Finite s := hs.to_subtype
  obtain ⟨v, hv⟩ := Submodule.exists_forall_notMem_of_forall_ne_top
    (fun S : s => S.1.comap V.subtype) fun S hS => h S.1 S.2 (Submodule.comap_subtype_eq_top.1 hS)
  exact ⟨v, v.2, fun S hS => hv ⟨S, hS⟩⟩

/-- The adjoin of a pair is symmetric. -/
private theorem adjoin_pair_comm (x y : K) : k⟮x, y⟯ = k⟮y, x⟯ := by
  rw [show ({x, y} : Set K) = {y, x} from Set.pair_comm x y]

/-- To show `k⟮a, b⟯ = ⊤` it suffices that it contains a pair generating `K`. -/
private theorem adjoin_pair_eq_top_of {a b x y : K} (h : k⟮x, y⟯ = ⊤) (hx : x ∈ k⟮a, b⟯)
    (hy : y ∈ k⟮a, b⟯) : k⟮a, b⟯ = ⊤ := by
  refine top_le_iff.mp (h ▸ ?_)
  rw [IntermediateField.adjoin_le_iff]
  rintro z (rfl | rfl) <;> assumption

/-- If `F = k⟮u⟯` and `F⟮w⟯ = ⊤`, then `k⟮u, w⟯ = ⊤`. -/
private theorem adjoin_pair_eq_top_of_adjoin_simple {u w : K} (h : (k⟮u⟯)⟮w⟯ = ⊤) :
    k⟮u, w⟯ = ⊤ := by
  rw [← IntermediateField.adjoin_simple_adjoin_simple, h, IntermediateField.restrictScalars_top]

variable (V : Submodule k K) {T : Type*} (W : T → Submodule k K)

/-- The `k`-subspace `{v / x : v ∈ V}`. -/
def divSubmodule (x : K) : Submodule k K := V.map (LinearMap.mulLeft k x⁻¹)

private theorem div_mem_divSubmodule {x v : K} (hv : v ∈ V) : v / x ∈ divSubmodule V x :=
  ⟨v, hv, by simp [div_eq_inv_mul]⟩

/-- If the ratios `V / y` generate `K` for some `y ∈ V`, then so do the ratios `V / x` for every
nonzero `x`. -/
private theorem adjoin_divSubmodule_eq_top_of_eq_top {x y : K} (hx0 : x ≠ 0) (hy : y ∈ V)
    (htop : IntermediateField.adjoin k (divSubmodule V y : Set K) = ⊤) :
    IntermediateField.adjoin k (divSubmodule V x : Set K) = ⊤ := by
  refine top_le_iff.mp (htop ▸ ?_)
  rw [IntermediateField.adjoin_le_iff]
  rintro _ ⟨v, hv, rfl⟩
  have e : (LinearMap.mulLeft k y⁻¹) v = v / x / (y / x) := by
    change y⁻¹ * v = _
    rw [div_div_div_cancel_right₀ hx0, div_eq_inv_mul]
  exact e ▸ div_mem (IntermediateField.subset_adjoin k _ (div_mem_divSubmodule V hv))
    (IntermediateField.subset_adjoin k (divSubmodule V x : Set K) (div_mem_divSubmodule V hy))

/-- A bad set for the `k`-subspace `{v / x}`, pulled back to `V`. -/
private theorem exists_finite_bad_div [CharZero K] (F : IntermediateField k K)
    [FiniteDimensional F K] (x : K)
    (hgen : IntermediateField.adjoin k (divSubmodule V x : Set K) = ⊤) :
    ∃ s : Set (Submodule k K), s.Finite ∧ (∀ S ∈ s, ¬ V ≤ S) ∧
      ∀ w ∈ V, (∀ S ∈ s, w ∉ S) → F⟮w / x⟯ = ⊤ := by
  obtain ⟨s, hs, hprop, hprim⟩ := exists_finite_bad F (divSubmodule V x)
    (IntermediateField.adjoin_eq_top_of_adjoin_eq_top (hprim := hgen))
  refine ⟨(fun S => S.comap (LinearMap.mulLeft k x⁻¹)) '' s, hs.image _, ?_, ?_⟩
  · rintro _ ⟨S, hS, rfl⟩ hle
    apply hprop S hS
    rintro _ ⟨v, hv, rfl⟩
    exact hle hv
  · intro w hw hwS
    refine hprim _ (div_mem_divSubmodule V hw) fun S hS hmem => hwS _ ⟨S, hS, rfl⟩ ?_
    change x⁻¹ * w ∈ S
    rwa [div_eq_inv_mul] at hmem

/-- The conditions on the first `m` vectors `ℓ 0, …, ℓ (m - 1)` of a partial generic basis. -/
private structure IsGood (m : ℕ) (ℓ : ℕ → K) : Prop where
  mem : ∀ i < m, ℓ i ∈ V
  li : LinearIndependent k (fun i : Fin m => ℓ i)
  g1 : ∀ a, 0 < a → a < m → ∀ Q, ¬ (ℓ 0 ∈ W Q ∧ ℓ a ∈ W Q)
  g2 : ∀ a j, 0 < a → a < j → j < m → k⟮ℓ a / ℓ 0, ℓ j / ℓ 0⟯ = ⊤
  g3 : ∀ ν j, 2 ≤ ν → ν < j → j < m → k⟮ℓ j / ℓ ν, ℓ 1 / ℓ 0⟯ = ⊤

private theorem isGood_zero (ℓ : ℕ → K) : IsGood V W 0 ℓ where
  mem := by intro i hi; omega
  li := linearIndependent_empty_type
  g1 := by intro a _ ha; omega
  g2 := by intro a j _ _ hj; omega
  g3 := by intro ν j _ _ hj; omega

variable {V W}

private theorem IsGood.ne_zero {m : ℕ} {ℓ : ℕ → K} (h : IsGood V W m ℓ) {i : ℕ} (hi : i < m) :
    ℓ i ≠ 0 :=
  h.li.ne_zero ⟨i, hi⟩

/-- Condition (G3) for every admissible pair of indices: for `ν, j ≥ 2` it is the stored (G3),
and the remaining cases reduce to (G2). -/
private theorem IsGood.adjoin_div_eq_top {m : ℕ} {ℓ : ℕ → K} (h : IsGood V W m ℓ) {a b : ℕ}
    (ha : a < m) (hb : b < m) (hab : a ≠ b) (h10 : ¬ (a = 1 ∧ b = 0))
    (h01 : ¬ (a = 0 ∧ b = 1)) : k⟮ℓ a / ℓ b, ℓ 1 / ℓ 0⟯ = ⊤ := by
  have h0 := h.ne_zero (show 0 < m by omega)
  have h1 := h.ne_zero (show 1 < m by omega)
  have hν := h.ne_zero ha
  have hj := h.ne_zero hb
  by_cases hb0 : b = 0
  · -- `ℓ_ν / ℓ_0` with `ν ≥ 2`
    have ha2 : 2 ≤ a := by omega
    rw [hb0, adjoin_pair_comm]
    exact h.g2 1 a (by omega) (by omega) ha
  by_cases ha0 : a = 0
  · -- `ℓ_0 / ℓ_j` with `j ≥ 2`
    have hb2 : 2 ≤ b := by omega
    rw [ha0]
    refine adjoin_pair_eq_top_of (h.g2 1 b (by omega) (by omega) hb)
      (IntermediateField.mem_adjoin_pair_right _ _ _) ?_
    have : ℓ b / ℓ 0 = (ℓ 0 / ℓ b)⁻¹ := by rw [inv_div]
    rw [this]
    exact inv_mem (IntermediateField.mem_adjoin_pair_left _ _ _)
  by_cases ha1 : a = 1
  · -- `ℓ_1 / ℓ_j` with `j ≥ 2`
    have hb2 : 2 ≤ b := by omega
    rw [ha1]
    refine adjoin_pair_eq_top_of (h.g2 1 b (by omega) (by omega) hb)
      (IntermediateField.mem_adjoin_pair_right _ _ _) ?_
    have : ℓ b / ℓ 0 = (ℓ 1 / ℓ 0) / (ℓ 1 / ℓ b) := by field_simp
    rw [this]
    exact div_mem (IntermediateField.mem_adjoin_pair_right _ _ _)
      (IntermediateField.mem_adjoin_pair_left _ _ _)
  by_cases hb1 : b = 1
  · -- `ℓ_ν / ℓ_1` with `ν ≥ 2`
    have ha2 : 2 ≤ a := by omega
    rw [hb1]
    refine adjoin_pair_eq_top_of (h.g2 1 a (by omega) (by omega) ha)
      (IntermediateField.mem_adjoin_pair_right _ _ _) ?_
    have : ℓ a / ℓ 0 = (ℓ a / ℓ 1) * (ℓ 1 / ℓ 0) := by field_simp
    rw [this]
    exact mul_mem (IntermediateField.mem_adjoin_pair_left _ _ _)
      (IntermediateField.mem_adjoin_pair_right _ _ _)
  -- `ν, j ≥ 2`
  rcases lt_or_gt_of_ne hab with hlt | hlt
  · refine adjoin_pair_eq_top_of (h.g3 a b (by omega) hlt hb)
      ?_ (IntermediateField.mem_adjoin_pair_right _ _ _)
    have : ℓ b / ℓ a = (ℓ a / ℓ b)⁻¹ := by rw [inv_div]
    rw [this]
    exact inv_mem (IntermediateField.mem_adjoin_pair_left _ _ _)
  · exact h.g3 b a (by omega) hlt ha

section Step

variable [Infinite k] [CharZero K]
  (hbpf : ∀ Q, ¬ V ≤ W Q)
  (hzero : ∀ x ∈ V, x ≠ 0 → {Q | x ∈ W Q}.Finite)
  (hgen : ∀ x ∈ V, x ≠ 0 → IntermediateField.adjoin k (divSubmodule V x : Set K) = ⊤)
  (hfin : ∀ x ∈ V, ∀ y ∈ V, LinearIndependent k ![x, y] → FiniteDimensional k⟮y / x⟯ K)

omit [Infinite k] [CharZero K] in
include hfin in
private theorem IsGood.finiteDimensional {m : ℕ} {ℓ : ℕ → K} (h : IsGood V W m ℓ) {a b : ℕ}
    (hab : a ≠ b) (ha : a < m) (hb : b < m) : FiniteDimensional k⟮ℓ b / ℓ a⟯ K := by
  refine hfin _ (h.mem a ha) _ (h.mem b hb) ?_
  have hinj : Function.Injective ![(⟨a, ha⟩ : Fin m), ⟨b, hb⟩] := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [Fin.ext_iff, eq_comm]
  have := h.li.comp _ hinj
  convert this using 1
  ext i
  fin_cases i <;> rfl

omit [Infinite k] in
include hgen hfin in
/-- The bad subspaces for condition (G2) between `ℓ a` and a new vector. -/
private theorem IsGood.exists_finite_bad_g2 {m : ℕ} {ℓ : ℕ → K} (h : IsGood V W m ℓ) (a : ℕ) :
    ∃ s : Set (Submodule k K), s.Finite ∧ (∀ S ∈ s, ¬ V ≤ S) ∧
      (0 < a → a < m → ∀ w ∈ V, (∀ S ∈ s, w ∉ S) → k⟮ℓ a / ℓ 0, w / ℓ 0⟯ = ⊤) := by
  by_cases ha : 0 < a ∧ a < m
  · have := h.finiteDimensional hfin (show 0 ≠ a by omega) (by omega) ha.2
    obtain ⟨s, hs, hprop, hprim⟩ := exists_finite_bad_div V (k⟮ℓ a / ℓ 0⟯) (ℓ 0)
      (hgen _ (h.mem 0 (by omega)) (h.ne_zero (by omega)))
    exact ⟨s, hs, hprop, fun _ _ w hw hwS => adjoin_pair_eq_top_of_adjoin_simple (hprim w hw hwS)⟩
  · exact ⟨∅, Set.finite_empty, by simp, fun h1 h2 => absurd ⟨h1, h2⟩ ha⟩

omit [Infinite k] in
include hgen hfin in
/-- The bad subspaces for condition (G3) between a new vector over `ℓ ν` and `ℓ 1 / ℓ 0`. -/
private theorem IsGood.exists_finite_bad_g3 {m : ℕ} {ℓ : ℕ → K} (h : IsGood V W m ℓ) (ν : ℕ) :
    ∃ s : Set (Submodule k K), s.Finite ∧ (∀ S ∈ s, ¬ V ≤ S) ∧
      (2 ≤ ν → ν < m → ∀ w ∈ V, (∀ S ∈ s, w ∉ S) → k⟮w / ℓ ν, ℓ 1 / ℓ 0⟯ = ⊤) := by
  by_cases hν : 2 ≤ ν ∧ ν < m
  · have := h.finiteDimensional hfin (show 0 ≠ 1 by omega) (by omega) (by omega)
    obtain ⟨s, hs, hprop, hprim⟩ := exists_finite_bad_div V (k⟮ℓ 1 / ℓ 0⟯) (ℓ ν)
      (hgen _ (h.mem ν hν.2) (h.ne_zero hν.2))
    exact ⟨s, hs, hprop, fun _ _ w hw hwS => by
      rw [adjoin_pair_comm]
      exact adjoin_pair_eq_top_of_adjoin_simple (hprim w hw hwS)⟩
  · exact ⟨∅, Set.finite_empty, by simp, fun h1 h2 => absurd ⟨h1, h2⟩ hν⟩

include hbpf hzero hgen hfin in
private theorem IsGood.exists_succ {m : ℕ} {ℓ : ℕ → K} (h : IsGood V W m ℓ)
    (hm : m < Module.finrank k V) :
    ∃ x, IsGood V W (m + 1) (Function.update ℓ m x) := by
  classical
  choose s2 hs2 hs2p hs2g using h.exists_finite_bad_g2 hgen hfin
  choose s3 hs3 hs3p hs3g using h.exists_finite_bad_g3 hgen hfin
  -- the subspace spanned by the vectors already chosen
  set S0 : Submodule k K := Submodule.span k (Set.range fun i : Fin m => ℓ i) with hS0
  have hS0 : ¬ V ≤ S0 := by
    intro hle
    have : FiniteDimensional k S0 := FiniteDimensional.span_of_finite k (Set.finite_range _)
    have h1 : Module.finrank k V ≤ Module.finrank k S0 := Submodule.finrank_mono hle
    have h2 : Module.finrank k S0 ≤ m := by
      calc Module.finrank k S0 = Set.finrank k (Set.range fun i : Fin m => ℓ i) := rfl
        _ ≤ Fintype.card (Fin m) := finrank_range_le_card _
        _ = m := Fintype.card_fin m
    omega
  -- the zeros of `ℓ 0`
  set Z : Set (Submodule k K) := W '' {Q | 0 < m ∧ ℓ 0 ∈ W Q} with hZ
  have hZfin : Z.Finite := by
    rcases Nat.eq_zero_or_pos m with h0 | h0
    · convert Set.finite_empty
      rw [hZ, Set.image_eq_empty]
      ext Q
      simp [h0]
    · exact ((hzero _ (h.mem 0 h0) (h.ne_zero h0)).subset fun Q hQ => hQ.2).image _
  have hZp : ∀ S ∈ Z, ¬ V ≤ S := by
    rintro _ ⟨Q, _, rfl⟩
    exact hbpf Q
  set s : Set (Submodule k K) := {S0} ∪ Z ∪ (⋃ a ∈ Finset.range m, s2 a) ∪
    (⋃ ν ∈ Finset.range m, s3 ν) with hs
  have hsfin : s.Finite :=
    (((Set.finite_singleton _).union hZfin).union
      ((Finset.range m).finite_toSet.biUnion fun a _ => hs2 a)).union
      ((Finset.range m).finite_toSet.biUnion fun ν _ => hs3 ν)
  have hsp : ∀ S ∈ s, ¬ V ≤ S := by
    intro S hS
    simp only [hs, Set.mem_union, Set.mem_singleton_iff, Set.mem_iUnion] at hS
    rcases hS with ((rfl | hS) | ⟨a, _, hS⟩) | ⟨ν, _, hS⟩
    · exact hS0
    · exact hZp S hS
    · exact hs2p a S hS
    · exact hs3p ν S hS
  obtain ⟨x, hxV, hx⟩ := exists_mem_forall_notMem V s hsfin hsp
  have hxS0 : x ∉ S0 := hx S0 (by simp [hs])
  have hxZ : ∀ S ∈ Z, x ∉ S := fun S hS => hx S (by simp [hs, hS])
  have hx2 : ∀ a < m, ∀ S ∈ s2 a, x ∉ S := fun a ha S hS =>
    hx S (by simp only [hs, Set.mem_union, Set.mem_iUnion, Finset.mem_range];
             exact Or.inl (Or.inr ⟨a, ha, hS⟩))
  have hx3 : ∀ ν < m, ∀ S ∈ s3 ν, x ∉ S := fun ν hν S hS =>
    hx S (by simp only [hs, Set.mem_union, Set.mem_iUnion, Finset.mem_range];
             exact Or.inr ⟨ν, hν, hS⟩)
  refine ⟨x, ?_⟩
  set ℓ' := Function.update ℓ m x with hℓ'
  have hold : ∀ i < m, ℓ' i = ℓ i := fun i hi => Function.update_of_ne (by omega) _ _
  have hnew : ℓ' m = x := Function.update_self _ _ _
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro i hi
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
    · rw [hold i hi]; exact h.mem i hi
    · rw [hnew]; exact hxV
  · have heq : (fun i : Fin (m + 1) => ℓ' i) = Fin.snoc (fun i : Fin m => ℓ i) x := by
      ext i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · simp [hnew]
      · simp [hold j j.2]
    rw [heq, linearIndependent_finSnoc]
    exact ⟨h.li, hxS0⟩
  · intro a ha0 ham Q hQ
    have hm0 : 0 < m := by omega
    rw [hold 0 hm0] at hQ
    rcases Nat.lt_succ_iff_lt_or_eq.mp ham with ham | rfl
    · rw [hold a ham] at hQ
      exact h.g1 a ha0 ham Q hQ
    · rw [hnew] at hQ
      refine hxZ (W Q) ?_ hQ.2
      exact ⟨Q, ⟨hm0, hQ.1⟩, rfl⟩
  · intro a j ha0 haj hjm
    rw [hold 0 (by omega), hold a (by omega)]
    rcases Nat.lt_succ_iff_lt_or_eq.mp hjm with hjm | rfl
    · rw [hold j hjm]; exact h.g2 a j ha0 haj hjm
    · rw [hnew]
      exact hs2g a ha0 haj x hxV (hx2 a haj)
  · intro ν j hν hνj hjm
    rw [hold 0 (by omega), hold 1 (by omega), hold ν (by omega)]
    rcases Nat.lt_succ_iff_lt_or_eq.mp hjm with hjm | rfl
    · rw [hold j hjm]; exact h.g3 ν j hν hνj hjm
    · rw [hnew]
      exact hs3g ν hν hνj x hxV (hx3 ν hνj)

include hbpf hzero hgen hfin in
private theorem exists_isGood (m : ℕ) (hm : m ≤ Module.finrank k V) : ∃ ℓ, IsGood V W m ℓ := by
  induction m with
  | zero => exact ⟨0, isGood_zero V W 0⟩
  | succ m ih =>
    obtain ⟨ℓ, hℓ⟩ := ih (by omega)
    obtain ⟨x, hx⟩ := hℓ.exists_succ hbpf hzero hgen hfin (by omega)
    exact ⟨_, hx⟩

include hbpf hzero hgen hfin in
/-- **The abstract generic basis.** -/
private theorem exists_generic (n : ℕ) (hn : 2 ≤ n) (hV : Module.finrank k V = n + 1) :
    ∃ ℓ : Fin (n + 1) → K, LinearIndependent k ℓ ∧ Submodule.span k (Set.range ℓ) = V ∧
      (∀ a : Fin (n + 1), a ≠ 0 → ∀ Q, ¬ (ℓ 0 ∈ W Q ∧ ℓ a ∈ W Q)) ∧
      (∀ a j : Fin (n + 1), a ≠ 0 → j ≠ 0 → a ≠ j → k⟮ℓ a / ℓ 0, ℓ j / ℓ 0⟯ = ⊤) ∧
      (∀ ν j : Fin (n + 1), ν ≠ j → (ν, j) ≠ (1, 0) → (ν, j) ≠ (0, 1) →
        k⟮ℓ ν / ℓ j, ℓ 1 / ℓ 0⟯ = ⊤) := by
  obtain ⟨n, rfl⟩ : ∃ n', n = n' + 2 := ⟨n - 2, by omega⟩
  obtain ⟨ℓ, h⟩ := exists_isGood hbpf hzero hgen hfin (n + 2 + 1) hV.ge
  refine ⟨fun i => ℓ i, h.li, ?_, ?_, ?_, ?_⟩
  · have hle : Submodule.span k (Set.range fun i : Fin (n + 2 + 1) => ℓ i) ≤ V := by
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      exact h.mem i i.2
    have : FiniteDimensional k V := Module.finite_of_finrank_eq_succ hV
    refine Submodule.eq_of_le_of_finrank_eq hle ?_
    rw [finrank_span_eq_card h.li, Fintype.card_fin, hV]
  · intro a ha Q
    exact h.g1 a (Nat.pos_of_ne_zero (fun h0 => ha (Fin.ext h0))) a.2 Q
  · intro a j ha hj haj
    have ha' : 0 < (a : ℕ) := Nat.pos_of_ne_zero (fun h0 => ha (Fin.ext h0))
    have hj' : 0 < (j : ℕ) := Nat.pos_of_ne_zero (fun h0 => hj (Fin.ext h0))
    rcases lt_or_gt_of_ne (Fin.val_ne_of_ne haj) with hlt | hlt
    · exact h.g2 a j ha' hlt j.2
    · rw [adjoin_pair_comm]
      exact h.g2 j a hj' hlt a.2
  · intro ν j hνj h10 h01
    have hval1 : ((1 : Fin (n + 2 + 1)) : ℕ) = 1 := rfl
    have hval0 : ((0 : Fin (n + 2 + 1)) : ℕ) = 0 := rfl
    simp only [hval0, hval1]
    exact h.adjoin_div_eq_top ν.2 j.2 (Fin.val_ne_of_ne hνj)
      (fun ⟨h1, h0⟩ => h10 (Prod.ext (Fin.ext h1) (Fin.ext h0)))
      (fun ⟨h0, h1⟩ => h01 (Prod.ext (Fin.ext h0) (Fin.ext h1)))

end Step

end Core

/-! ### Coordinates of global sections at points where they do not vanish -/

section Coordinates

/-- The coordinate `ρ(t)` of a global section `t` against a regular meromorphic section is
nonzero as soon as `t` does not vanish at some point. -/
private theorem genericCoord_ne_zero {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    [Stacks.Ample.IsInvertibleModule X L]
    (s : MeromorphicSection X.sheaf L) (hs : IsRegularMeromorphicSection X.sheaf L s)
    {t : Γ(L, ⊤)} {x : X} (ht : x ∈ Stacks.NonvanishingOpen.nonvanishingOpen X L t) :
    Stacks.Zeta.genericCoord X L s hs t ≠ 0 := by
  intro h0
  have h00 := Stacks.Zeta.genericCoord_add X L s hs 0 0
  rw [add_zero, left_eq_add] at h00
  have ht0 : t = 0 := Stacks.Zeta.genericCoord_injective X L s hs (h0.trans h00.symm)
  obtain ⟨w, hw⟩ := Stacks.SectionProduct.exists_notMem_maximalSmul L x
  obtain ⟨r, hr⟩ := (Stacks.SectionProduct.mem_nonvanishingLocus_iff_generates L t x).1 ht w
  exact hw (by rw [hr, ht0, map_zero, smul_zero]; exact zero_mem _)

open Stacks.AlgebraicGeometry.ReflexiveModules in
/-- At a point of codimension one where the global section `t` of the invertible module `L` does
not vanish, the coordinate `ρ(t)` of `t` against a regular meromorphic section `s` has order
`-ord_Z(s)`. -/
private theorem ord_genericCoord_add_eq_zero {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    [Stacks.Ample.IsInvertibleModule X L]
    (s : MeromorphicSection X.sheaf L) (hs : IsRegularMeromorphicSection X.sheaf L s)
    (Z : PrimeDivisor X) [IsDiscreteValuationRing (X.presheaf.stalk Z.genericPoint)]
    (t : Γ(L, ⊤)) (ht : Z.genericPoint ∈ Stacks.NonvanishingOpen.nonvanishingOpen X L t) :
    X.ord (Stacks.Zeta.genericCoord X L s hs t) Z.genericPoint +
      orderOfVanishingMeromorphic X L s hs Z = 0 := by
  have hx1 := PrimeDivisor.coheight_genericPoint Z
  have hgen := (Stacks.SectionProduct.mem_nonvanishingLocus_iff_generates L t
    Z.genericPoint).1 ht
  have ha0 := genericCoord_ne_zero L s hs ht
  have hge := (Stacks.Zeta.genericCoord_mem X L s hs t Z).resolve_left ha0
  refine le_antisymm ?_ hge
  by_contra hlt
  push Not at hlt
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (X.presheaf.stalk Z.genericPoint)
  have hπ0 : algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField ϖ ≠ 0 := by
    simpa using hϖ.ne_zero
  have hπ1 := Stacks.BombieriStepanov.ord_algebraMap_irreducible hx1 hϖ
  set πK := algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField ϖ with hπK
  set a := Stacks.Zeta.genericCoord X L s hs t with ha
  set b := a * πK⁻¹ with hb
  have hb0 : b ≠ 0 := mul_ne_zero ha0 (inv_ne_zero hπ0)
  have hab : a = b * πK := by rw [hb, inv_mul_cancel_right₀ hπ0]
  have hordb : X.ord a Z.genericPoint = X.ord b Z.genericPoint + 1 := by
    rw [hab, Scheme.ord_mul hb0 hπ0, hπ1]
  obtain ⟨m, hm⟩ := (Stacks.Zeta.mem_range_stalkSpecializes_iff X L s hs Z hb0).2 (by omega)
  obtain ⟨r, hr⟩ := hgen m
  have hsp : L.presheaf.stalkSpecializes ((genericPoint_spec X).specializes
      (Set.mem_univ Z.genericPoint)) ((L.presheaf.Γgerm Z.genericPoint).hom t) =
      a • Stacks.Zeta.genericValue X L s := by
    rw [ha, ← Stacks.Zeta.genericCoord_spec X L s hs t]
    exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  rw [hr, Stacks.ModuleStalkSpecialization.stalkSpecializes_smul L _ r _, hsp, smul_smul] at hm
  have hrb : algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField r * a = b :=
    smul_left_injective X.functionField (Stacks.Zeta.genericValue_ne_zero X L s hs) hm
  have h1 : algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField (r * ϖ) = 1 := by
    rw [map_mul, ← hπK]
    rw [hab] at hrb
    have h3 : (algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField r * πK) * b =
        1 * b := by
      rw [one_mul]
      calc _ = algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField r * (b * πK) := by
            ring
        _ = b := hrb
    exact mul_right_cancel₀ hb0 h3
  have h2 : r * ϖ = 1 :=
    (IsFractionRing.injective (X.presheaf.stalk Z.genericPoint) X.functionField)
      (h1.trans (map_one _).symm)
  exact hϖ.not_isUnit (IsUnit.of_mul_eq_one r (by rwa [mul_comm]))

/-- The structure morphism at the generic point is the spectrum of the `k`-algebra structure of
the function field. -/
private theorem fromSpecStalk_genericPoint_comp {k : Type u} [Field k] {X : Scheme.{u}}
    [IsIntegral X] (f : X ⟶ Spec (.of k)) :
    X.fromSpecStalk (genericPoint X) ≫ f = Spec.map ((Scheme.ΓSpecIso (.of k)).inv ≫
      f.appTop ≫ X.presheaf.germ ⊤ (genericPoint X) trivial) := by
  refine ext_of_isAffine ?_
  rw [Scheme.Hom.comp_appTop, Scheme.fromSpecStalk_appTop,
    ← cancel_mono (Scheme.ΓSpecIso _).hom, Scheme.ΓSpecIso_naturality]
  simp

/-- **The ratios of a closed immersion into projective space generate the function field.**
Let `p : X ⟶ ℙⁿ_k` be a closed immersion over `k` whose composite with the projection to `ℙⁿ_ℤ`
is the morphism given by a generating family `t` of global sections of an invertible module, and
let `tᵢ` not vanish at the generic point. Then the germs `t_j / tᵢ` generate `k(X)` over `k`. -/
private theorem adjoin_range_germ_ratio_eq_top {k : Type u} [Field k] {X : Scheme.{u}}
    [IsIntegral X] (f : X ⟶ Spec (.of k)) {L : X.Modules} [Stacks.Ample.IsInvertibleModule X L]
    {n : ℕ} (t : Fin (n + 1) → Γ(L, ⊤)) (ht : Stacks.ProjectiveFromSections.GeneratesStalks t)
    (p : X ⟶ projectiveSpaceOver n (Spec (.of k))) [IsClosedImmersion p]
    (hp1 : p ≫ pullback.fst _ _ = f)
    (hp2 : p ≫ projectiveSpaceOver.toIntegralAtUniverse n _ =
      Stacks.ProjectiveFromSections.toProjectiveSpaceAtUniverse t ht)
    {i : Fin (n + 1)} (hη : genericPoint X ∈ Stacks.ProjectiveFromSections.nvCover t i) :
    letI : Algebra k X.functionField := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
      X.presheaf.germ ⊤ (genericPoint X) trivial).hom.toAlgebra
    IntermediateField.adjoin k (Set.range fun j => X.presheaf.germ
      (Stacks.ProjectiveFromSections.nvCover t i) (genericPoint X) hη
        (Stacks.ProjectiveFromSections.ratio t i j)) = ⊤ := by
  let : Algebra k X.functionField := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
    X.presheaf.germ ⊤ (genericPoint X) trivial).hom.toAlgebra
  set c : Fin (n + 1) → X.functionField := fun j => X.presheaf.germ
    (Stacks.ProjectiveFromSections.nvCover t i) (genericPoint X) hη
      (Stacks.ProjectiveFromSections.ratio t i j) with hc
  set F := IntermediateField.adjoin k (Set.range c) with hF
  let cF : Fin (n + 1) → F := fun j => ⟨c j, IntermediateField.subset_adjoin k _ ⟨j, rfl⟩⟩
  have hci : c i = 1 := by simp only [hc, Stacks.ProjectiveFromSections.ratio_self, map_one]
  have hcF : Ideal.span (Set.range cF) = ⊤ :=
    (Ideal.eq_top_iff_one _).2 (Ideal.subset_span ⟨i, Subtype.ext hci⟩)
  let ιF : CommRingCat.of F ⟶ X.presheaf.stalk (genericPoint X) :=
    CommRingCat.ofHom (algebraMap F X.functionField)
  let kF : CommRingCat.of k ⟶ CommRingCat.of F := CommRingCat.ofHom (algebraMap k F)
  let yF : Spec (.of F) ⟶ projectiveSpaceOver n (Spec (.of k)) :=
    pullback.lift (Spec.map kF) (projectiveSpacePoint cF hcF) (terminal.hom_ext _ _)
  have hsq : Spec.map ιF ≫ yF = X.fromSpecStalk (genericPoint X) ≫ p := by
    apply pullback.hom_ext
    · rw [Category.assoc, pullback.lift_fst, ← Spec.map_comp, Category.assoc, hp1,
        fromSpecStalk_genericPoint_comp]
      rfl
    · rw [Category.assoc, pullback.lift_snd, specMap_comp_projectiveSpacePoint ιF cF hcF
        ((Ideal.eq_top_iff_one _).2 (Ideal.subset_span ⟨i, hci⟩)), Category.assoc, hp2,
        fromSpecStalk_comp_toProjectiveSpaceAtUniverse t ht hη]
      rfl
  -- the `F`-point factors through `X`
  have : Subsingleton (Spec (.of F)) := inferInstanceAs (Subsingleton (PrimeSpectrum F))
  have : IsDominant (Spec.map ιF) :=
    ⟨fun x => subset_closure ⟨IsLocalRing.closedPoint X.functionField, Subsingleton.elim _ _⟩⟩
  have : IsSchemeTheoreticallyDominant (Spec.map ιF) :=
    IsSchemeTheoreticallyDominant.of_isDominant _
  have hker : p.ker ≤ yF.ker := by
    have h1 : (Spec.map ιF ≫ yF).ker = yF.ker := by
      rw [Scheme.Hom.ker_comp, IsSchemeTheoreticallyDominant.ker_eq_bot,
        Scheme.IdealSheafData.map_bot]
    rw [← h1, hsq]
    exact Scheme.Hom.le_ker_comp _ _
  set z := IsClosedImmersion.lift p yF hker with hz_def
  have hz : z ≫ p = yF := IsClosedImmersion.lift_fac _ _ _
  have hz' : Spec.map ιF ≫ z = X.fromSpecStalk (genericPoint X) := by
    rw [← cancel_mono p, Category.assoc, hz, hsq]
  -- hence `F → k(X)` is onto
  have key : ∀ (y : X) (β : X.presheaf.stalk y ⟶ CommRingCat.of F),
      Spec.map β ≫ X.fromSpecStalk y = z → y = genericPoint X → Function.Surjective ιF := by
    rintro y β hβ rfl
    have h2 : Spec.map (β ≫ ιF) ≫ X.fromSpecStalk (genericPoint X) =
        𝟙 _ ≫ X.fromSpecStalk (genericPoint X) := by
      rw [Spec.map_comp, Category.assoc, hβ, hz', Category.id_comp]
    have h3 := (cancel_mono _).1 h2
    rw [← Spec.map_id] at h3
    have h4 := Spec.map_injective h3
    intro a
    refine ⟨β a, ?_⟩
    rw [← CommRingCat.comp_apply, h4]
    rfl
  have hpt : z (IsLocalRing.closedPoint F) = genericPoint X := by
    let ptK : Spec (X.presheaf.stalk (genericPoint X)) :=
      IsLocalRing.closedPoint (X.presheaf.stalk (genericPoint X))
    have h1 : z ((Spec.map ιF) ptK) = genericPoint X := by
      rw [← Scheme.Hom.comp_apply, hz']
      exact Scheme.fromSpecStalk_closedPoint
    have hcl : (Spec.map ιF) ptK = IsLocalRing.closedPoint F := Subsingleton.elim _ _
    rwa [hcl] at h1
  have hsurj := key _ _ (Scheme.Spec_stalkClosedPointTo_fromSpecStalk z) hpt
  rw [eq_top_iff]
  intro a _
  obtain ⟨b, rfl⟩ := hsurj a
  exact b.2

/-- The canonical isomorphism `f^* g^* ≅ (f ≫ g)^*` carries the double pullback of a global section
to its pullback along the composite. -/
private theorem pullbackComp_hom_app_pullbackSectionTop {X Y Z : Scheme.{u}} (f : X ⟶ Y)
    (g : Y ⟶ Z) (M : Z.Modules) (s : M.val.obj (Opposite.op ⊤)) :
    ((Scheme.Modules.pullbackComp f g).hom.app M).val.app (Opposite.op ⊤)
        (pullbackSectionTop f ((Scheme.Modules.pullback g).obj M) (pullbackSectionTop g M s)) =
      pullbackSectionTop (f ≫ g) M s := by
  rw [← pullbackSectionTop_comp f g M s]
  exact SheafOfModules.iso_hom_app_apply_inv ((Scheme.Modules.pullbackComp f g).app M)
    (Opposite.op ⊤) _

end Coordinates

/-! ### The curve -/

section Curve

variable {k : Type u} [Field k] {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f]
  [IsProjectiveVariety k f] [Smooth f] [GeometricallyIntegral f] [IsLocallyNoetherian C]

/-- The divisor `D` read on the closed points. -/
private noncomputable def closedDivisor (D : C →₀ ℤ) : Stacks.Zeta.ClosedPoint C →₀ ℤ :=
  Finsupp.comapDomain Subtype.val D Subtype.val_injective.injOn

omit [IsLocallyNoetherian C] in
private theorem closedDivisor_apply (D : C →₀ ℤ) (x : Stacks.Zeta.ClosedPoint C) :
    closedDivisor D x = D x.1 := rfl

/-- The sections of `𝒪(D)` vanishing at the closed point `Q`. -/
private noncomputable def vanishingSpace (D : Stacks.Zeta.ClosedPoint C →₀ ℤ)
    (Q : Stacks.Zeta.ClosedPoint C) :
    letI := functionFieldAlgebra k f
    Submodule k C.functionField :=
  Stacks.Zeta.rrSpace f (D - Finsupp.single Q 1)

omit [GeometricallyIntegral f] in
/-- A section of `𝒪(D)` with a zero at `Q` lies in `vanishingSpace f D Q`. -/
private theorem mem_vanishingSpace_of (D : Stacks.Zeta.ClosedPoint C →₀ ℤ)
    {Q : Stacks.Zeta.ClosedPoint C} {g : C.functionField}
    (hg : letI := functionFieldAlgebra k f; g ∈ Stacks.Zeta.rrSpace f D)
    (hQ : 0 < C.ord g Q.1 + D Q) :
    letI := functionFieldAlgebra k f
    g ∈ vanishingSpace f D Q := by
  let := functionFieldAlgebra k f
  rcases (Stacks.Zeta.mem_rrSpace f).1 hg with h0 | hall
  · exact (Stacks.Zeta.mem_rrSpace f).2 (Or.inl h0)
  refine (Stacks.Zeta.mem_rrSpace f).2 (Or.inr fun x => ?_)
  by_cases hx : x = Q
  · subst hx
    simp only [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_eq_same]
    omega
  · simp only [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_eq_of_ne hx, sub_zero]
    exact hall x

omit [GeometricallyIntegral f] [IsLocallyNoetherian C] in
/-- The degree of the class of a closed point is its residue degree. -/
private theorem picardDegree_pointClass_eq (x : Stacks.Zeta.ClosedPoint C) :
    Stacks.Picard.picardDegree f (Stacks.Zeta.topologicalKrullDim_le_one f)
      (Stacks.Zeta.pointClass f x) = f.residueDegree x.1 := by
  have := Stacks.Zeta.isEffectiveCartierDivisor_pointIdeal f x
  have hdeg := Stacks.Picard.picardDegree_divisorPicardClass f
    (Stacks.Zeta.topologicalKrullDim_le_one f) (Stacks.Zeta.pointIdeal x)
  have hI : IsIntegral (Stacks.Zeta.pointIdeal x).subscheme :=
    isIntegral_subscheme_vanishingIdeal x.2
  have hS : Subsingleton (Stacks.Zeta.pointIdeal x).subscheme :=
    subsingleton_subscheme_vanishingIdeal x.2
  obtain ⟨η⟩ : Nonempty (Stacks.Zeta.pointIdeal x).subscheme :=
    nonempty_subscheme_vanishingIdeal x.2
  have hres := Stacks.Chow.residueDegree_eq_finrank_globalSections k
    ((Stacks.Zeta.pointIdeal x).subschemeι ≫ f) η
  rw [residueDegree_comp,
    Stacks.Chow.residueDegree_eq_one_of_isPreimmersion (Stacks.Zeta.pointIdeal x).subschemeι,
    mul_one] at hres
  have hpt : (Stacks.Zeta.pointIdeal x).subschemeι η = x.1 :=
    (Scheme.IdealSheafData.range_subschemeι_vanishingIdeal
      (⟨{x.1}, x.2⟩ : TopologicalSpace.Closeds C)).subset ⟨η, rfl⟩
  rw [hpt] at hres
  change Stacks.Picard.picardDegree f _ (Stacks.Divisors.picardClass _) = _
  rw [hdeg, ← hres]

omit [GeometricallyIntegral f] [IsLocallyNoetherian C] in
/-- The degree of the class of a divisor on the closed points. -/
private theorem picardDegree_divisorClass_eq (D : Stacks.Zeta.ClosedPoint C →₀ ℤ) :
    Stacks.Picard.picardDegree f (Stacks.Zeta.topologicalKrullDim_le_one f)
      (Stacks.Zeta.divisorClass f D) = D.sum fun x n => n * (f.residueDegree x.1 : ℤ) := by
  rw [Stacks.Zeta.divisorClass_apply, map_finsuppSum]
  refine Finsupp.sum_congr fun x _ => ?_
  rw [map_zsmul, picardDegree_pointClass_eq, smul_eq_mul]

/-- **Riemann–Roch in large degree.** -/
private theorem finrank_rrSpace_eq (D : Stacks.Zeta.ClosedPoint C →₀ ℤ)
    (hD : 2 * (genus f : ℤ) - 1 ≤ D.sum fun x n => n * (f.residueDegree x.1 : ℤ)) :
    letI := functionFieldAlgebra k f
    (Module.finrank k (Stacks.Zeta.rrSpace f D) : ℤ) =
      (D.sum fun x n => n * (f.residueDegree x.1 : ℤ)) + 1 - genus f := by
  let := functionFieldAlgebra k f
  have hdim := Stacks.Zeta.topologicalKrullDim_le_one f
  rw [Stacks.Zeta.finrank_rrSpace f D, ← picardDegree_divisorClass_eq f D]
  rw [← picardDegree_divisorClass_eq f D] at hD
  set c := Stacks.Zeta.divisorClass f D
  have hL := (Stacks.Picard.picardRepresentative C.toRingedSpace c).property
  set L := (Stacks.Picard.picardRepresentative C.toRingedSpace c).obj
  have : SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 L := hL
  have hL' : SheafOfModules.IsInvertible C.sheaf.obj C.ringCatSheaf.property L := hL
  have : IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop) :=
    isIso_globalSections_of_geometricallyIntegral k f
  have hRR := finrank_sub_finrank_eq_invertibleCurveDegree_add_genus k f hdim L
  have hvan := isZero_cohomologyOverField_one_of_geometricallyIntegral k f L hL' hD
  have h1 : Module.finrank k (cohomologyOverField k f L 1) = 0 := by
    have := ModuleCat.subsingleton_of_isZero hvan
    exact Module.finrank_zero_of_subsingleton
  rwa [h1, Nat.cast_zero, sub_zero] at hRR

omit [GeometricallyIntegral f] in
/-- If `D` has the class of the invertible module `L` and `s` is a regular meromorphic section of
`L`, then `D = div s + div h` for some `h ≠ 0`, and `h⁻¹ ρ(u) ∈ L(D)` for every global section
`u` of `L`. -/
private theorem exists_eq_sectionDivisor_add_divOf (D : Stacks.Zeta.ClosedPoint C →₀ ℤ)
    (L : C.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible C.sheaf.obj C.ringCatSheaf.property L]
    (hL : Stacks.SheafOfModules.IsInvertible C.sheaf.obj C.ringCatSheaf.property L)
    (hc : Stacks.SheafOfModules.picardClass C.sheaf.obj C.ringCatSheaf.property L hL =
      Stacks.Zeta.divisorClass f D)
    (s : MeromorphicSection C.sheaf L) (hs : IsRegularMeromorphicSection C.sheaf L s) :
    letI := functionFieldAlgebra k f
    ∃ (h : C.functionField) (hh : h ≠ 0),
      D = Stacks.Zeta.sectionDivisor f L s hs + Stacks.Zeta.divOf f hh ∧
      ∀ u : Γ(L, ⊤), h⁻¹ * Stacks.Zeta.genericCoord C L s hs u ∈ Stacks.Zeta.rrSpace f D := by
  let := functionFieldAlgebra k f
  obtain ⟨h, hh, hhD⟩ := Stacks.Zeta.exists_divOf_eq_of_divisorClass_eq_zero f
    (D := D - Stacks.Zeta.sectionDivisor f L s hs)
    (by rw [map_sub, Stacks.Zeta.divisorClass_sectionDivisor f L s hs hL, hc, sub_self])
  have hD : D = Stacks.Zeta.sectionDivisor f L s hs + Stacks.Zeta.divOf f hh := by
    rw [hhD]; abel
  refine ⟨h, hh, hD, fun u => ?_⟩
  rw [hD, Stacks.Zeta.mem_rrSpace_add_divOf_iff f hh, mul_inv_cancel_left₀ hh,
    ← Stacks.Zeta.range_coordLinear f L s hs]
  exact ⟨u, rfl⟩

/-- **Global generation.** If `deg D ≥ 2g`, then for every closed point `Q` some section of
`𝒪(D)` does not vanish at `Q`. -/
private theorem exists_mem_rrSpace_notMem_vanishingSpace (D : Stacks.Zeta.ClosedPoint C →₀ ℤ)
    (hD : 2 * (genus f : ℤ) ≤ D.sum fun x n => n * (f.residueDegree x.1 : ℤ))
    (Q : Stacks.Zeta.ClosedPoint C) :
    letI := functionFieldAlgebra k f
    ¬ Stacks.Zeta.rrSpace f D ≤ vanishingSpace f D Q := by
  let := functionFieldAlgebra k f
  rw [← picardDegree_divisorClass_eq f D] at hD
  set c := Stacks.Zeta.divisorClass f D
  have hL := (Stacks.Picard.picardRepresentative C.toRingedSpace c).property
  set L : C.Modules := (Stacks.Picard.picardRepresentative C.toRingedSpace c).obj
  have : SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 L := hL
  have : AlgebraicGeometry.SheafOfModules.IsInvertible C.sheaf.obj C.ringCatSheaf.property L :=
    hL.toAlgebraicGeometry
  have : Stacks.Ample.IsInvertibleModule C L := hL
  have : IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop) :=
    isIso_globalSections_of_geometricallyIntegral k f
  -- `L` is generated by its global sections, so some section does not vanish at `Q`
  let S : CohenMacaulayCurveSituation :=
    { k := k, X := C, f := f
      dimension_one := IsCurve.topologicalKrullDim_eq_one (k := k) (f := f) }
  have hgg := S.isGeneratedByGlobalSections_of_two_mul_genus_le L hD
  have hgen := generatesStalks_id_of_isGeneratedByGlobalSections L hgg
  obtain ⟨t, ht⟩ := Stacks.ProjectiveFromSections.exists_mem_nvCover_of_generatesStalks id hgen Q.1
  -- a regular meromorphic section `s` of `L`, and `D = div s + div h`
  obtain ⟨s, hs⟩ := exists_isRegularMeromorphicSection_of_isIntegral C L
  obtain ⟨h, hh, hD', hmem⟩ := exists_eq_sectionDivisor_add_divOf f D L hL
    (Stacks.Picard.classOf_picardRepresentative C.toRingedSpace c) s hs
  -- the coordinate of `t` has the exact order `-ord(s)` at `Q`
  set Z := Stacks.Zeta.primeDivisorOfClosedPoint f Q
  have hZ : Z.genericPoint = Q.1 := PrimeDivisor.genericPoint_ofCoheightOne _ _
  have : IsDiscreteValuationRing (C.presheaf.stalk Z.genericPoint) :=
    Stacks.BombieriStepanov.isDiscreteValuationRing_stalk_of_coheight_eq_one f _
      (PrimeDivisor.coheight_genericPoint Z)
  have hord := ord_genericCoord_add_eq_zero L s hs Z t (by rw [hZ]; exact ht)
  rw [hZ] at hord
  set a := Stacks.Zeta.genericCoord C L s hs t
  have ha0 : a ≠ 0 := genericCoord_ne_zero L s hs ht
  -- the section `v = a / h` of `𝒪(D)` does not vanish at `Q`
  intro hle
  have hvmem : h⁻¹ * a ∈ Stacks.Zeta.rrSpace f D := hmem t
  have hv0 : h⁻¹ * a ≠ 0 := mul_ne_zero (inv_ne_zero hh) ha0
  have hvan := ((Stacks.Zeta.mem_rrSpace f).1 (hle hvmem)).resolve_left hv0 Q
  have hmul : C.ord a Q.1 = C.ord h Q.1 + C.ord (h⁻¹ * a) Q.1 := by
    have := Stacks.Zeta.dvr_closedPoint f Q
    rw [← Scheme.ord_mul hh hv0, mul_inv_cancel_left₀ hh]
  have hDQ : D Q = Stacks.Zeta.sectionDivisor f L s hs Q + C.ord h Q.1 := by
    rw [hD', Finsupp.add_apply, Stacks.Zeta.divOf_apply]
  rw [Stacks.Zeta.sectionDivisor_apply] at hDQ
  change D Q = orderOfVanishingMeromorphic C L s hs Z + C.ord h Q.1 at hDQ
  simp only [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_eq_same] at hvan
  linarith

/-- **The ratios of `L(D)` generate the function field.** If `deg D ≥ 2g + 1`, then for every
nonzero `x ∈ L(D)` the quotients `v / x`, `v ∈ L(D)`, generate `k(C)` over `k`: the sections of
`𝒪(D)` give a closed immersion of `C` into projective space. -/
private theorem adjoin_divSubmodule_eq_top (D : Stacks.Zeta.ClosedPoint C →₀ ℤ)
    (hD : 2 * (genus f : ℤ) + 1 ≤ D.sum fun x n => n * (f.residueDegree x.1 : ℤ)) :
    letI := functionFieldAlgebra k f
    ∀ x ∈ Stacks.Zeta.rrSpace f D, x ≠ 0 →
      IntermediateField.adjoin k (divSubmodule (Stacks.Zeta.rrSpace f D) x : Set C.functionField)
        = ⊤ := by
  let := functionFieldAlgebra k f
  -- it suffices to find one `y`
  suffices hy : ∃ y ∈ Stacks.Zeta.rrSpace f D, y ≠ 0 ∧ IntermediateField.adjoin k
      (divSubmodule (Stacks.Zeta.rrSpace f D) y : Set C.functionField) = ⊤ by
    obtain ⟨y, hyV, -, hy⟩ := hy
    exact fun x _ hx0 => adjoin_divSubmodule_eq_top_of_eq_top _ hx0 hyV hy
  have hD1 : 2 * (genus f : ℤ) ≤ D.sum fun x n => n * (f.residueDegree x.1 : ℤ) := by omega
  rw [← picardDegree_divisorClass_eq f D] at hD hD1
  set c := Stacks.Zeta.divisorClass f D
  have hL := (Stacks.Picard.picardRepresentative C.toRingedSpace c).property
  set L : C.Modules := (Stacks.Picard.picardRepresentative C.toRingedSpace c).obj
  have : SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 L := hL
  have : AlgebraicGeometry.SheafOfModules.IsInvertible C.sheaf.obj C.ringCatSheaf.property L :=
    hL.toAlgebraicGeometry
  have : Stacks.Ample.IsInvertibleModule C L := hL
  have : IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop) :=
    isIso_globalSections_of_geometricallyIntegral k f
  let S : CohenMacaulayCurveSituation :=
    { k := k, X := C, f := f
      dimension_one := IsCurve.topologicalKrullDim_eq_one (k := k) (f := f) }
  have hgg := S.isGeneratedByGlobalSections_of_two_mul_genus_le L hD1
  have hgen := generatesStalks_id_of_isGeneratedByGlobalSections L hgg
  -- a basis of `H⁰(C, L)` generating `L`, and the morphism to projective space
  obtain ⟨n', t, ht, hspan⟩ := exists_fin_basis_generatesStalks_of_generatesStalks_id f L hgen
  have hcov := Stacks.ProjectiveFromSections.isOpenCover_nvCover_of_generatesStalks t ht
  obtain ⟨p, hp1, hpin⟩ :=
    Stacks.ProjGlobalSectionsAppTop.exists_hom_projectiveSpaceOver_of_generatesStalks t ht f
  have hp2 : p ≫ projectiveSpaceOver.toIntegralAtUniverse n' (Spec (.of k)) =
      Stacks.ProjectiveFromSections.toProjectiveSpaceAtUniverse t ht := by
    refine (C.openCoverOfIsOpenCover _ hcov).hom_ext _ _ fun i => ?_
    exact (hpin i).trans (Stacks.ProjectiveFromSections.ι_toProjectiveSpaceAtUniverse t ht i).symm
  obtain ⟨α, hiso, hα⟩ := Stacks.TwistPullbackPinned.exists_iso_pullback_twistingSheafAtUniverse t
    (p ≫ projectiveSpaceOver.toIntegralAtUniverse n' (Spec (.of k))) hcov hpin
  have := hiso
  -- the morphism is a closed immersion
  let τ := projectiveSpaceOver.toIntegralAtUniverse n' (Spec (.of k))
  let θ : (Scheme.Modules.pullback p).obj
      (Stacks.AmpleProjectiveImmersion.projectiveSpaceTwistingSheaf n' (Spec (.of k))) ≅ L :=
    (Scheme.Modules.pullbackComp p τ).app
      (Stacks.AmpleProjectiveImmersion.twistingSheafAtUniverse n') ≪≫ asIso α
  have : IsProper (Stacks.Tag01VT.projectiveSpaceHom n' (Spec (.of k))) :=
    projectiveSpaceOver_isProper n' (Spec (.of k))
  have hci : IsClosedImmersion p := by
    refine isClosedImmersion_of_pinned_of_span_of_surjectsOnDegreeTwo_baseChange f
      (Stacks.Tag01VT.projectiveSpaceHom n' (Spec (.of k))) p hp1 _ L θ
      (fun i : ULift.{u} (Fin (n' + 1)) => Stacks.TwistPullbackPinned.pullbackCoordSection τ i.down)
      (fun i : ULift.{u} (Fin (n' + 1)) => t i.down) (fun i => ?_) (fun σ => ?_) ?_
    · rw [← hα i.down, pullbackCoordSection_eq, pullbackCoordSection_eq]
      exact congrArg (fun y => (Scheme.Modules.Hom.app α ⊤) y)
        (pullbackComp_hom_app_pullbackSectionTop p τ _ _)
    · let : Module k Γ(L, ⊤) := Module.compHom _ (baseRingMap f)
      exact Submodule.span_mono (by rintro _ ⟨i, rfl⟩; exact ⟨ULift.up i, rfl⟩) (hspan σ)
    · intro X' g' f' h
      have : IsIntegral (S.ofIsPullback h).X := S.isIntegral_ofIsPullback h
      refine (S.ofIsPullback h).surjectsOnDegreeTwo_of_two_mul_genus_add_one_le _ ?_
      rw [S.invertibleCurveDegree_ofIsPullback h L]
      change 2 * (genus f' : ℤ) + 1 ≤ _
      rw [genus_baseChange S.k _ g' f' S.f h]
      exact hD
  -- the ratios generate `k(C)`
  obtain ⟨i, hη⟩ :=
    Stacks.ProjectiveFromSections.exists_mem_nvCover_of_generatesStalks t ht (genericPoint C)
  have htop := adjoin_range_germ_ratio_eq_top f t ht p hp1 hp2 hη
  -- a regular meromorphic section `s` of `L`, and `D = div s + div h`
  obtain ⟨s, hs⟩ := exists_isRegularMeromorphicSection_of_isIntegral C L
  obtain ⟨h, hh, -, hmem⟩ := exists_eq_sectionDivisor_add_divOf f D L hL
    (Stacks.Picard.classOf_picardRepresentative C.toRingedSpace c) s hs
  have hratio := fun j => germ_ratio_mul_genericCoord L s hs t i j hη
  have hρi := genericCoord_ne_zero L s hs hη
  refine ⟨h⁻¹ * Stacks.Zeta.genericCoord C L s hs (t i), hmem _,
    mul_ne_zero (inv_ne_zero hh) hρi, ?_⟩
  refine top_le_iff.mp (htop ▸ ?_)
  rw [IntermediateField.adjoin_le_iff]
  rintro _ ⟨j, rfl⟩
  refine IntermediateField.subset_adjoin _ _ ⟨_, hmem (t j), ?_⟩
  change (h⁻¹ * Stacks.Zeta.genericCoord C L s hs (t i))⁻¹ *
    (h⁻¹ * Stacks.Zeta.genericCoord C L s hs (t j)) = _
  rw [← hratio j]
  field_simp

omit [GeometricallyIntegral f] in
/-- A nonzero section vanishes at finitely many closed points. -/
private theorem finite_setOf_mem_vanishingSpace (D : Stacks.Zeta.ClosedPoint C →₀ ℤ) :
    letI := functionFieldAlgebra k f
    ∀ x ∈ Stacks.Zeta.rrSpace f D, x ≠ 0 → {Q | x ∈ vanishingSpace f D Q}.Finite := by
  let := functionFieldAlgebra k f
  intro x _ hx
  refine ((Stacks.Zeta.finite_setOf_ord_ne_zero f hx).union D.support.finite_toSet).subset ?_
  intro Q hQ
  have hQ' := ((Stacks.Zeta.mem_rrSpace f).1 hQ).resolve_left hx Q
  simp only [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_eq_same] at hQ'
  by_contra hcon
  simp only [Set.mem_union, Set.mem_ofPred_eq, Finset.mem_coe, Finsupp.mem_support_iff, not_or,
    not_not] at hcon
  omega

omit [Smooth f] [IsLocallyNoetherian C] in
/-- The constant field: an element of `k(C)` algebraic over `k` lies in `k`. -/
private theorem mem_range_algebraMap_of_isAlgebraic [CharZero k] (z : C.functionField)
    (hz : letI := functionFieldAlgebra k f; IsAlgebraic k z) :
    letI := functionFieldAlgebra k f
    z ∈ Set.range (algebraMap k C.functionField) := by
  let := functionFieldAlgebra k f
  let : Algebra k (C.residueField (genericPoint C)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ C.Γevaluation (genericPoint C)).hom.toAlgebra
  have hirr : separableClosure k (C.residueField (genericPoint C)) = ⊥ :=
    ((geometricallyIrreducible_tfae_functionField k C f (genericPoint C)
      (genericPoint_spec C)).out 1 3).mp (show GeometricallyIrreducible f from inferInstance)
  let e : C.functionField ≃ₐ[k] C.residueField (genericPoint C) :=
    AlgEquiv.ofRingEquiv (f := genericResidueEquiv C) (fun a => rfl)
  have hsep : separableClosure k C.functionField = ⊥ := by
    rw [← separableClosure.map_eq_of_algEquiv e.symm, hirr, IntermediateField.map_bot]
  have hzs : z ∈ separableClosure k C.functionField := by
    rw [mem_separableClosure_iff]
    exact PerfectField.separable_of_irreducible (minpoly.irreducible hz.isIntegral)
  rw [hsep] at hzs
  exact IntermediateField.mem_bot.mp hzs

/-- The ratio of two independent sections is transcendental, and `k(C)` is finite over it. -/
private theorem finiteDimensional_adjoin_div [CharZero k] (D : Stacks.Zeta.ClosedPoint C →₀ ℤ) :
    letI := functionFieldAlgebra k f
    ∀ x ∈ Stacks.Zeta.rrSpace f D, ∀ y ∈ Stacks.Zeta.rrSpace f D,
      LinearIndependent k ![x, y] → FiniteDimensional k⟮y / x⟯ C.functionField := by
  let := functionFieldAlgebra k f
  intro x _ y _ hxy
  have hx0 : x ≠ 0 := by simpa using hxy.ne_zero 0
  have hz : Transcendental k (y / x) := by
    intro halg
    obtain ⟨c, hc⟩ := mem_range_algebraMap_of_isAlgebraic f _ halg
    have hyc : y = c • x := by rw [Algebra.smul_def, hc, div_mul_cancel₀ _ hx0]
    have := (LinearIndependent.pair_iff.1 hxy) c (-1) (by rw [hyc]; simp)
    simp at this
  have htr : Algebra.trdeg k C.functionField = 1 := Faltings.trdeg_functionField_eq_one k f
  have : Algebra.EssFiniteType k C.functionField := Stacks.Zeta.essFiniteType_ffAlg f
  have h1 : IsTranscendenceBasis k (fun _ : PUnit.{u + 1} => y / x) := by
    refine AlgebraicIndependent.isTranscendenceBasis_of_trdeg_le_of_finite ?_ ?_
    · exact (algebraicIndependent_unique_type_iff).mpr hz
    · rw [htr]; simp
  have h2 : Algebra.IsAlgebraic k⟮y / x⟯ C.functionField := by
    have := h1.isAlgebraic_field
    rwa [Set.range_const] at this
  have : Algebra.EssFiniteType k⟮y / x⟯ C.functionField :=
    Algebra.EssFiniteType.of_comp k k⟮y / x⟯ C.functionField
  exact Algebra.finite_of_essFiniteType_of_isAlgebraic

end Curve

/-- **Generic choice of coordinates.** Let `C` be a smooth projective geometrically integral curve
of genus `g ≥ 2` over a number field `k`, let `P` be a divisor of degree one on `C`, and let
`N ≥ 2g + 1` and `n = N - g`. If `n ≥ 2`, there is a generic `k`-basis `ℓ = (ℓ₀, …, ℓₙ)` of
`H⁰(C, 𝒪(NP))`, i.e. one satisfying `Faltings.BombieriSiegel.IsGenericBasis`. -/
@[faltings "lem_bvs_generic_coordinates"]
public theorem exists_isGenericBasis (k : Type u) [Field k] [NumberField k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
    [GeometricallyIntegral f] [IsLocallyNoetherian C] (hg : 2 ≤ genus f)
    (P : C →₀ ℤ) (hPclosed : ∀ Q ∈ P.support, IsClosed ({Q} : Set C))
    (hP : ∑ᶠ Q : C, P Q * (f.residueDegree Q : ℤ) = 1)
    (N : ℕ) (hN : 2 * genus f + 1 ≤ N) (n : ℕ) (hn : n = N - genus f) (hn2 : 2 ≤ n) :
    ∃ ℓ : Fin (n + 1) → C.functionField, IsGenericBasis k f ((N : ℤ) • P) ℓ := by
  let := functionFieldAlgebra k f
  obtain ⟨D', hD'⟩ : ∃ D', D' = closedDivisor ((N : ℤ) • P) := ⟨_, rfl⟩
  have hsupp : ∀ Q ∈ ((N : ℤ) • P).support, IsClosed ({Q} : Set C) := fun Q hQ =>
    hPclosed Q (Finsupp.support_smul hQ)
  have hdeg : (D'.sum fun x m => m * (f.residueDegree x.1 : ℤ)) = N := by
    have h1 : (D'.sum fun x m => m * (f.residueDegree x.1 : ℤ)) =
        ∑ Q ∈ ((N : ℤ) • P).support, ((N : ℤ) • P) Q * (f.residueDegree Q : ℤ) := by
      rw [Finsupp.sum, hD', closedDivisor, Finsupp.comapDomain_support]
      refine Finset.sum_preimage Subtype.val _ _
        (fun Q => ((N : ℤ) • P) Q * (f.residueDegree Q : ℤ)) fun Q hQ hQr => ?_
      exact absurd ⟨⟨Q, hsupp Q hQ⟩, rfl⟩ hQr
    have h2 : ∑ᶠ Q : C, ((N : ℤ) • P) Q * (f.residueDegree Q : ℤ) =
        ∑ Q ∈ ((N : ℤ) • P).support, ((N : ℤ) • P) Q * (f.residueDegree Q : ℤ) := by
      refine finsum_eq_sum_of_support_subset _ fun Q hQ => ?_
      simp only [Function.mem_support, ne_eq] at hQ
      simp only [Finset.mem_coe, Finsupp.mem_support_iff]
      intro h0
      exact hQ (by rw [h0, zero_mul])
    have h3 : ∑ᶠ Q : C, ((N : ℤ) • P) Q * (f.residueDegree Q : ℤ) =
        (N : ℤ) * ∑ᶠ Q : C, P Q * (f.residueDegree Q : ℤ) := by
      rw [mul_finsum]
      · refine finsum_congr fun Q => ?_
        rw [Finsupp.smul_apply, smul_eq_mul, mul_assoc]
    rw [h1, ← h2, h3, hP, mul_one]
  have hdim : Module.finrank k (Stacks.Zeta.rrSpace f D') = n + 1 := by
    have := finrank_rrSpace_eq f D' (by rw [hdeg]; omega)
    rw [hdeg] at this
    omega
  have : CharZero C.functionField :=
    charZero_of_injective_algebraMap (algebraMap k C.functionField).injective
  obtain ⟨ℓ, hli, hspan, hG1, hG2, hG3⟩ := exists_generic (V := Stacks.Zeta.rrSpace f D')
    (W := vanishingSpace f D')
    (fun Q => exists_mem_rrSpace_notMem_vanishingSpace f D' (by rw [hdeg]; omega) Q)
    (finite_setOf_mem_vanishingSpace f D') (adjoin_divSubmodule_eq_top f D' (by rw [hdeg]; omega))
    (finiteDimensional_adjoin_div f D') n hn2 hdim
  have hmemV : ∀ i, ℓ i ∈ Stacks.Zeta.rrSpace f D' := fun i =>
    hspan ▸ Submodule.subset_span ⟨i, rfl⟩
  refine ⟨ℓ, ⟨hli, ?_, ?_, hG2, hG3⟩⟩
  · erw [hspan]
    ext g
    rw [hD']
    change (g = 0 ∨ ∀ x : Stacks.Zeta.ClosedPoint C, 0 ≤ C.ord g x.1 + closedDivisor _ x) ↔ _
    simp only [Subtype.forall, closedDivisor_apply, Set.mem_ofPred_eq]
  · intro a ha Q hQ hvan
    refine hG1 a ha ⟨Q, hQ⟩ ⟨?_, ?_⟩
    · exact mem_vanishingSpace_of f D' (hmemV 0) (by rw [hD', closedDivisor_apply]; exact hvan.1)
    · exact mem_vanishingSpace_of f D' (hmemV a) (by rw [hD', closedDivisor_apply]; exact hvan.2)

/-! ### Base-point freeness of a generic basis, and the embedding `φ_{NP}` on its charts -/

section PhiNP

attribute [local instance]
  Stacks.AlgebraicGeometry.ProjectiveSpaceGeneratingSections.globalSectionsModule

/-- **A basis of `L(NP)` has no base point.** If `N ≥ 2g` and `x₀, …, xₙ` is a generic basis of
`L(N P)`, then at every point `c` of codimension one some `x_i` has the exact order `-N P(c)`,
i.e. the section `x_i` of `𝒪(N P)` does not vanish at `c`. -/
public theorem exists_ord_add_eq_zero_of_isGenericBasis {k : Type u} [Field k]
    (X : CurveWithDegreeOneDivisor k) [IsLocallyNoetherian X.C] (N : ℕ)
    (hN : 2 * genus X.f ≤ N) {n : ℕ} (x : Fin (n + 1) → X.C.functionField)
    (hx : haveI : IsCurve k X.f := Stacks.Chow.isCurve_of_smoothOfRelativeDimension_one X.f
      IsGenericBasis k X.f ((N : ℤ) • X.P.mapDomain Subtype.val) x) :
    ∀ c, Order.coheight c = 1 →
      ∃ i, X.C.ord (x i) c + ((N : ℤ) • X.P.mapDomain Subtype.val) c = 0 := by
  have : Smooth X.f := SmoothOfRelativeDimension.smooth 1 X.f
  have : IsCurve k X.f := Stacks.Chow.isCurve_of_smoothOfRelativeDimension_one X.f
  let := functionFieldAlgebra k X.f
  intro c hc
  set D' : Stacks.Zeta.ClosedPoint X.C →₀ ℤ := (N : ℤ) • X.P
  have hD'Q : ∀ Q : Stacks.Zeta.ClosedPoint X.C,
      D' Q = ((N : ℤ) • X.P.mapDomain Subtype.val) Q.1 := fun Q => by
    simp only [D', Finsupp.smul_apply, smul_eq_mul]
    rw [Finsupp.mapDomain_apply_of_injective Subtype.val_injective]
  have hdeg : (D'.sum fun x m => m * (X.f.residueDegree x.1 : ℤ)) = N := by
    rw [Finsupp.sum_smul_index (fun _ => zero_mul _)]
    simp only [mul_assoc]
    rw [← Finsupp.mul_sum, X.degree_P, mul_one]
  have hmemD : ∀ w : X.C.functionField, w ∈ Submodule.span k (Set.range x) ↔
      w ∈ Stacks.Zeta.rrSpace X.f D' := by
    intro w
    rw [← SetLike.mem_coe, hx.span_eq, Stacks.Zeta.mem_rrSpace]
    simp only [Set.mem_ofPred_eq]
    refine or_congr Iff.rfl ⟨fun hQ Q => (hD'Q Q).symm ▸ hQ Q.1 Q.2, fun hQ Q hQc => ?_⟩
    have := hQ ⟨Q, hQc⟩
    rwa [hD'Q] at this
  let Q : Stacks.Zeta.ClosedPoint X.C :=
    ⟨c, Stacks.EtaleCohomology.isClosed_singleton_of_coheight_eq_one X.f hc⟩
  by_contra hne
  push Not at hne
  refine exists_mem_rrSpace_notMem_vanishingSpace X.f D' (by rw [hdeg]; exact_mod_cast hN) Q ?_
  intro w hw
  rw [← hmemD] at hw
  refine Submodule.span_le.2 ?_ hw
  rintro _ ⟨i, rfl⟩
  have hxi : x i ∈ Stacks.Zeta.rrSpace X.f D' := (hmemD _).1 (Submodule.subset_span ⟨i, rfl⟩)
  refine mem_vanishingSpace_of X.f D' hxi ?_
  have h0 := ((Stacks.Zeta.mem_rrSpace X.f).1 hxi).resolve_left
    (hx.linearIndependent.ne_zero i) Q
  rw [hD'Q] at h0 ⊢
  exact lt_of_le_of_ne h0 (Ne.symm (hne i))

attribute [local instance] MvPolynomial.gradedAlgebra in
open Stacks.ProjectiveFromSections in
/-- On the `j`-th chart of the morphism `g = φ_{(L, b)}` given by global sections `b` of `L`
whose generic coordinates are `ρ(b_a) = h x_a`, the pullback of `T_ν / T_j` is `x_ν / x_j` in
the function field. -/
private theorem germ_app_awayToSection_eq_div {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    [Stacks.Ample.IsInvertibleModule X L]
    (s₀ : MeromorphicSection X.sheaf L) (hs₀ : IsRegularMeromorphicSection X.sheaf L s₀)
    {n : ℕ} (b : Fin (n + 1) → Γ(L, ⊤)) (hb : GeneratesStalks b) {h : X.functionField}
    (hh : h ≠ 0) {x : Fin (n + 1) → X.functionField} (hx0 : ∀ a, x a ≠ 0)
    (hbx : ∀ a, Stacks.Zeta.genericCoord X L s₀ hs₀ (b a) = h * x a)
    (g : X ⟶ projectiveSpaceAtUniverse.{u} n) (hg : g = toProjectiveSpaceAtUniverse b hb)
    (j ν : Fin (n + 1))
    (hU : genericPoint X ∈ g ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen
      (Stacks.SectionsToProjectiveSpace.coordGrading.{u} n) (MvPolynomial.X j)) :
    X.presheaf.germ _ (genericPoint X) hU (g.app _
      ((AlgebraicGeometry.Proj.awayToSection (Stacks.SectionsToProjectiveSpace.coordGrading.{u} n)
        (MvPolynomial.X j)).hom (Stacks.TwistPullbackPinned.coordFrac.{u} j ν))) =
      x ν / x j := by
  subst hg
  have hpin := ι_toProjectiveSpaceAtUniverse b hb j
  have hle := Stacks.TwistPullbackPinned.nvCover_le_preimage_basicOpen b _ j hpin
  have hη : genericPoint X ∈ nvCover b j := by
    rw [← preimage_basicOpen_eq_nvCover_canonical b hb j]
    exact hU
  rw [← X.presheaf.germ_res_apply (homOfLE hle) _ hη]
  have happ := Stacks.TwistPullbackPinned.appLE_coordFrac_chart b _ j ν hpin
  change X.presheaf.germ _ (genericPoint X) hη
    ((toProjectiveSpaceAtUniverse b hb).appLE _ _ hle _) = _
  rw [happ, eq_div_iff (hx0 j)]
  have hr := germ_ratio_mul_genericCoord L s₀ hs₀ b j ν hη
  rw [hbx, hbx] at hr
  exact mul_left_cancel₀ hh (by rw [← hr]; ring)

/-- **The embedding `φ_{NP}` given by a generic basis.** Let `x₀, …, xₙ` be a generic basis of
`L(N P)` with `N ≥ 2g + 1`. There are an invertible module `L ≅ 𝒪(N P)` and a `k`-basis `b` of
`Γ(C, L)` generating `L` such that `φ_{NP} = φ_{(L, b)} : C ⟶ ℙⁿ_k` is a closed immersion over
`k` whose coordinate functions on every chart `φ_{NP}⁻¹ D₊(T_j)` are `x_ν / x_j`. The
isomorphism `φ_{NP}^* 𝒪(1) ≅ L` is
`Faltings.CurveWithDegreeOneDivisor.isClosedImmersion_toProjectiveSpaceOver` for `(L, b)`. -/
public theorem exists_basis_toProjectiveSpaceOver_germ_eq_div {k : Type u} [Field k]
    [NumberField k] (X : CurveWithDegreeOneDivisor k) [IsLocallyNoetherian X.C] (N : ℕ)
    (hN : 2 * genus X.f + 1 ≤ N) {n : ℕ} (x : Fin (n + 1) → X.C.functionField)
    (hx : haveI : IsCurve k X.f := Stacks.Chow.isCurve_of_smoothOfRelativeDimension_one X.f
      IsGenericBasis k X.f ((N : ℤ) • X.P.mapDomain Subtype.val) x) :
    letI : X.C.Over (Spec (.of k)) := ⟨X.f⟩
    ∃ (L : X.C.Modules) (hLinv : Stacks.Ample.IsInvertibleModule X.C L)
      (_ : Stacks.SheafOfModules.picardClass X.C.presheaf
          (Stacks.RingedSpace.structureIsSheaf X.C.toRingedSpace) L
          (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hLinv) =
        (N : ℤ) • X.P.sum (fun x n =>
          haveI : Smooth X.f := SmoothOfRelativeDimension.smooth 1 X.f
          haveI : IsCurve k X.f := Stacks.Chow.isCurve_of_smoothOfRelativeDimension_one X.f
          haveI := Stacks.Zeta.isEffectiveCartierDivisor_pointIdeal X.f x
          n • Stacks.Divisors.picardClass (Stacks.Zeta.pointIdeal x)))
      (b : Module.Basis (Fin (n + 1)) k Γ(L, ⊤))
      (hb : Stacks.ProjectiveFromSections.GeneratesStalks ⇑b),
      IsClosedImmersion (Stacks.ProjectiveFromSections.toProjectiveSpaceOver ⇑b hb X.f) ∧
      Stacks.ProjectiveFromSections.toProjectiveSpaceOver ⇑b hb X.f ≫
          (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) = X.f ∧
      (letI : ∀ r : ℕ,
          GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) (ULift.{u} ℤ)) :=
          fun _ => MvPolynomial.gradedAlgebra
        let φNP := Stacks.ProjectiveFromSections.toProjectiveSpaceOver ⇑b hb X.f
        -- the chart `φNP⁻¹ D₊(T_j)` of `C`
        let U : Fin (n + 1) → X.C.Opens := fun j =>
          φNP ⁻¹ᵁ (projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k)) ⁻¹ᵁ
            Proj.basicOpen _ (MvPolynomial.X j))
        ∀ (j ν : Fin (n + 1)) [Nonempty (U j)],
          (X.C.germToFunctionField (U j)).hom
            (φNP.app _ ((projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k))).app _
              (Proj.awayToSection _ (MvPolynomial.X j)
                (HomogeneousLocalization.Away.mk
                  (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
                  (MvPolynomial.isHomogeneous_X _ j) 1 (MvPolynomial.X ν)
                  (by simpa using MvPolynomial.isHomogeneous_X _ ν))))) =
            x ν / x j) := by
  let : X.C.Over (Spec (.of k)) := ⟨X.f⟩
  have : IsCurve k X.f := Stacks.Chow.isCurve_of_smoothOfRelativeDimension_one X.f
  obtain ⟨L, hLinv, hL, s₀, hs₀, h, b, hh, hbx⟩ := exists_basis_genericCoord_eq X N x hx
  obtain ⟨-, hb, hci, -⟩ := X.isClosedImmersion_toProjectiveSpaceOver N hN L hL b
  have : AlgebraicGeometry.SheafOfModules.IsInvertible X.C.sheaf.obj
      X.C.ringCatSheaf.property L :=
    (show Stacks.SheafOfModules.IsInvertible X.C.presheaf X.C.ringCatSheaf.2 L
      from hLinv).toAlgebraicGeometry
  refine ⟨L, hLinv, hL, b, hb, hci,
    Stacks.ProjectiveFromSections.toProjectiveSpaceOver_fst ⇑b hb X.f, ?_⟩
  dsimp only
  intro j ν _
  let := functionFieldAlgebra k X.f
  obtain ⟨⟨p, hp⟩⟩ := ‹Nonempty _›
  exact germ_app_awayToSection_eq_div L s₀ hs₀ ⇑b hb hh
    (fun a => hx.linearIndependent.ne_zero a) hbx _
    (Stacks.ProjectiveFromSections.toProjectiveSpaceOver_snd ⇑b hb X.f) j ν
    (((genericPoint_spec X.C).mem_open_set_iff (TopologicalSpace.Opens.isOpen _)).2
      ⟨p, trivial, hp⟩)

end PhiNP

