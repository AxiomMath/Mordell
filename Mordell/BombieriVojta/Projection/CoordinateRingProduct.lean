module
public import Mordell.BombieriVojta.Projection.CoordinateRing

/-!
# The coordinate ring of `U × U` over `k[ξ_a, ξ'_b]`

In Bombieri's setting, `C` is a smooth projective geometrically irreducible curve of genus
`g ≥ 2` over a number field `k`, `P` is a rational point, `N ≥ 2g + 1`, `L ≅ 𝒪(NP)`, and
`x₀, …, xₙ` is a `k`-basis of `H⁰(C, L)` whose morphism `φ_{NP}` is a closed immersion. Let
`U = {x₀ ≠ 0}` with coordinate ring `k[U] = 𝒪_C(U)`, and for `a ∈ {1, …, n}` let
`ξ_a = x_a / x₀ ∈ k[U]`. If `x₀` and `x_a` have no common zero for every `a ≠ 0` (condition (G1)),
then for all `a, b ∈ {1, …, n}` the coordinate ring `k[U × U] = k[U] ⊗_k k[U]` is a free module
of rank `N²` over its subalgebra `k[ξ_a, ξ'_b]` generated by `ξ_a ⊗ 1` and `1 ⊗ ξ_b`.

## Main results

* `Faltings.free_and_finrank_tensor_adjoin_eq_sq`: `k[U] ⊗_k k[U]` is free of rank `N²` over
  `k[ξ_a ⊗ 1, 1 ⊗ ξ_b]`.

## Implementation notes

`U` is the nonvanishing open `Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0)` of the section
`x₀`, and `k[U]` is `Γ(C, U)`, a `k`-algebra through the structure morphism `f`. The coordinate
ring of `U × U` is written as `k[U] ⊗_k k[U]`, the form the source gives it. The function
`ξ_a ∈ Γ(C, U)` is described by the property that defines it, `x_a|_U = ξ_a • x₀|_U`; since `x₀`
generates `L` on `U`, this property determines `ξ_a`. Condition (G1) is stated for the sections
themselves: for every `a ≠ 0`, the nonvanishing opens of `x₀` and `x_a` together cover `C`.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Section 8, pp. 629–630
-/

namespace Faltings

open CategoryTheory AlgebraicGeometry TensorProduct

universe u

/-- Let `f : P → B` and `g : Q → B'` be `k`-algebra maps making `B` free of rank `m > 0` over
the domain `P` and `B'` free of rank `m' > 0` over the domain `Q`. Then `B ⊗_k B'` is free of rank
`m * m'` over the image of `P ⊗_k Q`, with basis the products of the two bases. -/
public theorem free_finrank_tensor_range {k P Q B B' : Type*} [Field k] [CommRing P] [CommRing Q]
    [IsDomain P] [IsDomain Q] [CommRing B] [CommRing B'] [Algebra k P] [Algebra k Q]
    [Algebra k B] [Algebra k B'] (f : P →ₐ[k] B) (g : Q →ₐ[k] B') {m m' : ℕ}
    (hm : 0 < m) (hm' : 0 < m')
    (hf : letI := f.toRingHom.toAlgebra; Module.Free P B ∧ Module.finrank P B = m)
    (hg : letI := g.toRingHom.toAlgebra; Module.Free Q B' ∧ Module.finrank Q B' = m')
    (A : Subalgebra k (B ⊗[k] B')) (hA : (Algebra.TensorProduct.map f g).range = A) :
    Module.Free A (B ⊗[k] B') ∧ Module.finrank A (B ⊗[k] B') = m * m' := by
  subst hA
  let : Algebra P B := f.toRingHom.toAlgebra
  let : Algebra Q B' := g.toRingHom.toAlgebra
  have : IsScalarTower k P B := IsScalarTower.of_algebraMap_eq fun r => (f.commutes r).symm
  have : IsScalarTower k Q B' := IsScalarTower.of_algebraMap_eq fun r => (g.commutes r).symm
  obtain ⟨_, hfr⟩ := hf
  obtain ⟨_, hgr⟩ := hg
  have : Module.Finite P B := Module.finite_of_finrank_pos (hfr ▸ hm)
  have : Module.Finite Q B' := Module.finite_of_finrank_pos (hgr ▸ hm')
  have : Nontrivial B := Module.nontrivial_of_finrank_pos (R := P) (hfr ▸ hm)
  have : Nontrivial B' := Module.nontrivial_of_finrank_pos (R := Q) (hgr ▸ hm')
  let e := Module.Free.chooseBasis P B
  let d := Module.Free.chooseBasis Q B'
  set φ := Algebra.TensorProduct.map f g
  have hφ : Function.Injective φ :=
    TensorProduct.map_injective_of_flat_flat f.toLinearMap g.toLinearMap
      (FaithfulSMul.algebraMap_injective P B) (FaithfulSMul.algebraMap_injective Q B')
  let : Algebra (P ⊗[k] Q) (B ⊗[k] B') := φ.toRingHom.toAlgebra
  -- the `k`-linear identification of `B ⊗ B'` with `ι × κ →₀ P ⊗ Q`
  let E₀ : B ⊗[k] B' ≃ₗ[k] _ :=
    (TensorProduct.congr (e.repr.restrictScalars k) (d.repr.restrictScalars k)).trans
      (finsuppTensorFinsupp k k P Q _ _)
  have hE₀ : ∀ (p : P) (q : Q) (z : B ⊗[k] B'), E₀ ((p ⊗ₜ[k] q) • z) = (p ⊗ₜ[k] q) • E₀ z := by
    intro p q z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => rw [smul_add, map_add, hx, hy, map_add, smul_add]
    | tmul b b' =>
      have h1 : (p ⊗ₜ[k] q) • (b ⊗ₜ[k] b') = (p • b) ⊗ₜ[k] (q • b') := by
        rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def]
        simp [φ, RingHom.algebraMap_toAlgebra]
      rw [h1]
      ext ⟨i, j⟩
      simp [E₀, finsuppTensorFinsupp_apply]
  let E : B ⊗[k] B' ≃ₗ[P ⊗[k] Q] _ :=
    { E₀ with
      map_smul' := fun c z => by
        induction c using TensorProduct.induction_on with
        | zero => simp
        | add x y hx hy =>
          simp only [RingHom.id_apply, add_smul] at hx hy ⊢
          rw [← hx, ← hy]
          exact E₀.map_add _ _
        | tmul p q => exact hE₀ p q z }
  let bas := Module.Basis.ofRepr E
  let ψ : P ⊗[k] Q ≃+* φ.range := (AlgEquiv.ofInjective φ hφ).toRingEquiv
  let bas' := bas.mapCoeffs ψ (fun c z => rfl)
  refine ⟨Module.Free.of_basis bas', ?_⟩
  rw [Module.finrank_eq_card_basis bas', Fintype.card_prod,
    ← Module.finrank_eq_card_chooseBasisIndex,
    ← Module.finrank_eq_card_chooseBasisIndex, hfr, hgr]

/-- The image of `k[X] ⊗_k k[Y] → B ⊗_k B'`, `X ↦ u ⊗ 1`, `Y ↦ 1 ⊗ v`, is the subalgebra
generated by `u ⊗ 1` and `1 ⊗ v`. -/
private theorem range_map_aeval {k B B' : Type*} [CommRing k] [CommRing B] [CommRing B']
    [Algebra k B] [Algebra k B'] (u : B) (v : B') :
    (Algebra.TensorProduct.map (Polynomial.aeval u) (Polynomial.aeval v)).range =
      Algebra.adjoin k {u ⊗ₜ[k] (1 : B'), (1 : B) ⊗ₜ[k] v} := by
  apply le_antisymm
  · rintro _ ⟨c, rfl⟩
    induction c using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => rw [map_add]; exact Subalgebra.add_mem _ hx hy
    | tmul p q =>
      have h : (Polynomial.aeval u p ⊗ₜ[k] Polynomial.aeval v q) =
          Polynomial.aeval (u ⊗ₜ[k] (1 : B')) p * Polynomial.aeval ((1 : B) ⊗ₜ[k] v) q := by
        rw [← Algebra.TensorProduct.includeLeft_apply (S := k),
          ← Algebra.TensorProduct.includeRight_apply,
          Polynomial.aeval_algHom_apply, Polynomial.aeval_algHom_apply,
          Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      change Algebra.TensorProduct.map _ _ (p ⊗ₜ[k] q) ∈ _
      rw [Algebra.TensorProduct.map_tmul, h]
      refine Subalgebra.mul_mem _ ?_ ?_
      · exact Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))
          (Polynomial.aeval_mem_adjoin_singleton k _)
      · exact Algebra.adjoin_mono
          (Set.singleton_subset_iff.mpr (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
          (Polynomial.aeval_mem_adjoin_singleton k _)
  · refine Algebra.adjoin_le ?_
    rintro _ (rfl | rfl)
    · exact ⟨Polynomial.X ⊗ₜ 1, by simp⟩
    · exact ⟨1 ⊗ₜ Polynomial.X, by simp⟩

/-- **Bombieri, Section 8.** Assume the `k`-basis `x₀, …, xₙ` of `H⁰(C, L)`, `L ≅ 𝒪(NP)`,
satisfies (G1): for every `a ≠ 0`, the sections `x₀` and `x_a` have no common zero. Let
`U = {x₀ ≠ 0}`, and for `a, b ≠ 0` let `ξ_a, ξ_b ∈ k[U] = Γ(C, U)` satisfy `x_a|_U = ξ_a • x₀|_U`
and `x_b|_U = ξ_b • x₀|_U`. Then `k[U] ⊗_k k[U]` is a free module of rank `N²` over its subalgebra
generated by `ξ_a ⊗ 1` and `1 ⊗ ξ_b`.

The proof applies `Faltings.BombieriSiegel.free_and_finrank_affineOpen` at `a` and at `b`: `k[U]`
is free of rank `N` over `k[ξ_a]` and over `k[ξ_b]`, so `k[U] ⊗_k k[U]` is free of rank `N²` over
the image of `k[X] ⊗_k k[Y]`, which is `k[ξ_a ⊗ 1, 1 ⊗ ξ_b]`. -/
@[faltings "lem_bvs_projection_consequences"]
public theorem free_and_finrank_tensor_adjoin_eq_sq (k : Type u) [Field k] [NumberField k]
    {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) [IsCurve k f] [GeometricallyIrreducible f] [Smooth f] [IsProper f]
    [IsProjectiveVariety k f] (hg : 2 ≤ genus f)
    (σ : Spec (.of k) ⟶ C) (hσ : σ ≫ f = 𝟙 _)
    [Stacks.Divisors.IsEffectiveCartierDivisor σ.ker]
    (N : ℕ) (hN : 2 * genus f + 1 ≤ N)
    (L : C.Modules) [Stacks.Ample.IsInvertibleModule C L]
    (hL : Stacks.SheafOfModules.picardClass C.presheaf (Stacks.RingedSpace.structureIsSheaf _) L
      ‹_› = (N : ℤ) • Stacks.Divisors.picardClass σ.ker)
    {n : ℕ} (x : Fin (n + 1) → Γ(L, ⊤))
    (hxb : letI : Module k Γ(L, ⊤) := (Module.compHom _
        ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom)
      LinearIndependent k x ∧ Submodule.span k (Set.range x) = ⊤)
    (hx : Stacks.ProjectiveFromSections.GeneratesStalks x)
    [IsClosedImmersion (Stacks.ProjectiveFromSections.toProjectiveSpaceAtUniverse x hx)]
    (hG1 : ∀ a : Fin (n + 1), a ≠ 0 →
      Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0) ⊔
        Stacks.NonvanishingOpen.nonvanishingOpen C L (x a) = ⊤)
    (a b : Fin (n + 1)) (ha : a ≠ 0) (hb : b ≠ 0)
    (ξa ξb : Γ(C, Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0)))
    (hξa : L.presheaf.map
        (homOfLE (le_top : Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0) ≤ ⊤)).op (x a) =
      ξa • L.presheaf.map
        (homOfLE (le_top : Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0) ≤ ⊤)).op (x 0))
    (hξb : L.presheaf.map
        (homOfLE (le_top : Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0) ≤ ⊤)).op (x b) =
      ξb • L.presheaf.map
        (homOfLE (le_top : Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0) ≤ ⊤)).op (x 0)) :
    letI : Algebra k Γ(C, Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0)) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
        C.presheaf.map
          (homOfLE (le_top : Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0) ≤ ⊤)).op
          ).hom.toAlgebra
    let A : Subalgebra k (Γ(C, Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0)) ⊗[k]
        Γ(C, Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0))) :=
      Algebra.adjoin k {ξa ⊗ₜ 1, 1 ⊗ₜ ξb}
    Module.Free A (Γ(C, Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0)) ⊗[k]
        Γ(C, Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0))) ∧
      Module.finrank A (Γ(C, Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0)) ⊗[k]
        Γ(C, Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0))) = N ^ 2 := by
  let : Algebra k Γ(C, Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
      C.presheaf.map
        (homOfLE (le_top : Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0) ≤ ⊤)).op
        ).hom.toAlgebra
  intro A
  obtain ⟨a', rfl⟩ := Fin.exists_succ_eq.mpr ha
  obtain ⟨b', rfl⟩ := Fin.exists_succ_eq.mpr hb
  have hG1' : ∀ c : Fin n, Stacks.NonvanishingOpen.nonvanishingOpen C L (x 0) ⊔
      Stacks.NonvanishingOpen.nonvanishingOpen C L (x c.succ) = ⊤ :=
    fun c => hG1 c.succ (Fin.succ_ne_zero c)
  have hfa := BombieriSiegel.free_and_finrank_affineOpen k f hg σ hσ N hN L hL x hxb hx hG1'
    a' ξa hξa
  have hfb := BombieriSiegel.free_and_finrank_affineOpen k f hg σ hσ N hN L hL x hxb hx hG1'
    b' ξb hξb
  have hN0 : 0 < N := by omega
  obtain ⟨h1, h2⟩ := free_finrank_tensor_range (Polynomial.aeval ξa) (Polynomial.aeval ξb) hN0 hN0
    hfa hfb A (range_map_aeval ξa ξb)
  exact ⟨h1, h2.trans (sq N).symm⟩

end Faltings
