/-!
# The dimension of `U₂ ∩ U₁`

Let `C` be a smooth projective geometrically integral curve of genus `g ≥ 2` over a number field
`k`, `P` a divisor of degree one, `N ≥ 2g + 1`, `n = N - g`, and `x = (x₀, …, xₙ)` a `k`-basis
of `H⁰(C, 𝒪(NP))` satisfying (G1) and (G2), defining the closed immersion `φ_{NP} : C → ℙⁿ`, with
`ψ = φ_{NP} × φ_{NP}`. Let `s ≥ 1` and `φ_B : C × C → ℙᵐ` a closed immersion with
`φ_B^*𝒪(1) ≅ 𝒪(B)`, `B = s (P × C) + s (C × P) - Δ'`, with coordinates `y₀, …, y_m`, and write
`η_i = y_i / y₀ = P_i / Q_i` in `k(C × C)` with `Q_i ≠ 0`. Let `d₁, d₂, d` be positive integers
with `δᵢ = (dᵢ + s d) / N` integers. Let `U₀` be the space of tuples `(F_i(ξ, ξ'))_{i=0}^m` of
values of bihomogeneous forms of bidegree `(δ₁, δ₂)` over `k`, `U₁ ⊆ U₀` the tuples of `k`-linear
combinations of the monomials `ξ_a^l ξ_a'^{l'} b_ν`, and `U₂ ⊆ U₀` the solutions of the basic
system `(P_i Q_j)^d u_j = (P_j Q_i)^d u_i`.

Suppose `γ > 0`, `δ₁, δ₂ ≥ max(δ₀, N - 1)`, `N δᵢ > 2g - 2`, `d₁ + d₂ > 4g - 4` and
`d₁ d₂ - g d² > γ d₁ d₂`. Then
`dim (U₂ ∩ U₁) ≥ γ d₁ d₂ - ((g - 1) N + (m + 1) N³ / 2)(δ₁ + δ₂) - (m + 1)(g - 1)²`.

Indeed `U₂ ≅ H⁰(C × C, 𝒪(V))` with `V = d₁ P × C + d₂ C × P + d Δ'`, whose dimension is at least
`γ d₁ d₂ - (g - 1) N (δ₁ + δ₂)` by Riemann–Roch on `C × C`; and
`dim (U₂ ∩ U₁) ≥ dim U₂ - (dim U₀ - dim U₁)`, the codimension of `U₁` in `U₀` being bounded by
`Faltings.BombieriVojta.finrank_affineEvaluationTuples_sub_finrank_monomial_le`.

## Main results

* `Faltings.BombieriVojta.le_finrank_affineEvaluationTuplesBasicSystem_inf_monomial`: the lower
  bound for `dim (U₂ ∩ U₁)`.

## Implementation notes

* The setting is that of
  `Faltings.BombieriVojta.finrank_affineEvaluationTuples_sub_finrank_monomial_le` and of
  `Faltings.exists_isVojtaRepresentative_iff`: `C × C` is `pullback f f` over `Spec k`,
  `pr₁^*, pr₂^*` are `AlgebraicGeometry.functionFieldMapAlgHom` of the two projections, and `δ₀`
  enters only through its defining property at `(δ₁, δ₂)`, the surjectivity of
  `Faltings.vojtaFormRestriction`, which `δᵢ ≥ δ₀` implies.
* The condition that `φ_B` is defined by the divisor `B` is stated on Picard classes:
  `[φ_B^*𝒪(1)] = (s + 1)(pr₁^*[P] + pr₂^*[P]) - [Δ]`, which is `B` since
  `Δ' = Δ - P × C - C × P`.
* The values `P_i, Q_i` are arbitrary elements of `k(C × C)` with `Q_i ≠ 0` and
  `η_i = P_i / Q_i`; the source takes them to be values of polynomials in `ξ₁, ξ₂, ξ'₁, ξ'₂`,
  but only the values enter.
* The coordinates `ξ₁, ξ₂` of the source are `x a / x₀`, `x b / x₀` for arbitrary distinct
  nonzero indices `a`, `b`; the source's case is `a = 1`, `b = 2`.
* The bound is compared in `ℝ`, `γ` being real.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Section 8, p. 631
-/

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Module Faltings
open Faltings.BombieriVojta

namespace Faltings.BombieriVojta

universe u

/-- A space of bihomogeneous forms of a fixed bidegree in finitely many variables is
finite-dimensional. -/
private theorem finite_weightedHomogeneousSubmodule (k ι : Type*) [Field k] [Finite ι]
    (δ : ℕ × ℕ) :
    FiniteDimensional k (MvPolynomial.weightedHomogeneousSubmodule k
      (Sum.elim (fun _ => ((1 : ℕ), (0 : ℕ))) (fun _ => ((0 : ℕ), (1 : ℕ))) : ι ⊕ ι → ℕ × ℕ)
        δ) := by
  have := Fintype.ofFinite ι
  refine Submodule.finiteDimensional_of_le
    (S₂ := MvPolynomial.restrictTotalDegree _ k (δ.1 + δ.2)) ?_
  intro p hp
  rw [MvPolynomial.mem_restrictTotalDegree, MvPolynomial.totalDegree]
  refine Finset.sup_le fun s hs => ?_
  have h := hp (MvPolynomial.mem_support_iff.mp hs)
  rw [Finsupp.weight_apply] at h
  rw [← h, Finsupp.sum, Finsupp.sum, Prod.fst_sum, Prod.snd_sum, ← Finset.sum_add_distrib]
  refine le_of_eq (Finset.sum_congr rfl fun i _ => ?_)
  rcases i with i | i <;> simp

/-- `U₀`, the space of tuples of values of forms, is finite-dimensional. -/
private theorem finiteDimensional_affineEvaluationTuples {k K L ι : Type*} [Field k] [Field K]
    [Field L] [Algebra k K] [Algebra k L] (pr₁ pr₂ : K →ₐ[k] L) (x : ι → K) (j : ι)
    (δ : ℕ × ℕ) (σ : Type*) [Finite σ]
    [FiniteDimensional k (MvPolynomial.weightedHomogeneousSubmodule k
      (Sum.elim (fun _ => ((1 : ℕ), (0 : ℕ))) (fun _ => ((0 : ℕ), (1 : ℕ))) : ι ⊕ ι → ℕ × ℕ)
        δ)] :
    FiniteDimensional k (affineEvaluationTuples pr₁ pr₂ x j δ σ) := by
  refine Submodule.finiteDimensional_of_le (S₂ := LinearMap.range
    (LinearMap.pi fun i : σ => (affineEvaluation pr₁ pr₂ x j δ).comp (LinearMap.proj i))) ?_
  intro u hu
  choose F hF using fun i => hu i trivial
  exact ⟨F, funext hF⟩

/-- Two subspaces `U₁, U₂` of a finite-dimensional `U₀` meet in dimension at least
`dim U₂ - (dim U₀ - dim U₁)`. -/
private theorem finrank_add_finrank_le_finrank_add_finrank_inf {k V : Type*} [DivisionRing k]
    [AddCommGroup V] [Module k V] {U₀ U₁ U₂ : Submodule k V} [FiniteDimensional k U₀]
    (h₁ : U₁ ≤ U₀) (h₂ : U₂ ≤ U₀) :
    finrank k U₂ + finrank k U₁ ≤ finrank k U₀ + finrank k ↥(U₂ ⊓ U₁) := by
  have := Submodule.finiteDimensional_of_le h₁
  have := Submodule.finiteDimensional_of_le h₂
  have := Submodule.finrank_sup_add_finrank_inf_eq U₂ U₁
  have := Submodule.finrank_mono (sup_le h₂ h₁)
  omega

/-- `U₂` does not change when the coordinates `x` are replaced by `x / x j`. -/
private theorem affineEvaluationTuplesBasicSystem_div {k K L ι : Type*} [Field k] [Field K]
    [Field L] [Algebra k K] [Algebra k L] [Finite ι] (pr₁ pr₂ : K →ₐ[k] L) (x : ι → K) (j : ι)
    (hj : x j ≠ 0) (δ : ℕ × ℕ) (σ : Type*) (P Q : σ → L) (d : ℕ) :
    affineEvaluationTuplesBasicSystem pr₁ pr₂ (fun ν => x ν / x j) j δ σ P Q d =
      affineEvaluationTuplesBasicSystem pr₁ pr₂ x j δ σ P Q d := by
  have := Fintype.ofFinite ι
  simp only [affineEvaluationTuplesBasicSystem, affineEvaluationTuples,
    affineEvaluation_div _ _ _ _ hj]

/-! ### Riemann–Roch on a smooth projective surface -/

section SurfaceBasics

variable {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [IsProjectiveVariety k f] [GeometricallyIntegral f] [SmoothOfRelativeDimension 2 f]

/-- `K_X ⊗ 𝓛⁻¹`. -/
private noncomputable abbrev adj (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L] : X.Modules :=
  twistedSheaf (Scheme.Modules.exteriorPower f.relativeDifferentials 2)
    (fun _ : Fin 1 => L) (fun _ => -1)

omit [IsProjectiveVariety k f] [GeometricallyIntegral f] in
private theorem isInvertible_canonical :
    SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2
      (Scheme.Modules.exteriorPower f.relativeDifferentials 2) :=
  Stacks.Discriminant.isInvertible_relativeDifferentialForms f 2

omit [IsProjectiveVariety k f] [GeometricallyIntegral f] in
private theorem isInvertible_adj (L : X.Modules)
    [SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L] :
    SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 (adj f L) :=
  @Stacks.Chow.isInvertible_tensorObj X _ _ (isInvertible_canonical f)
    (Stacks.SheafOfModules.Invertible.tensorPower_isInvertible X.presheaf
      X.ringCatSheaf.2 L (-1))

omit [GeometricallyIntegral f] in
include f in
private theorem dim_le_two : topologicalKrullDim X ≤ (2 : ℕ) := by
  rw [topologicalKrullDim_eq_of_smoothOfRelativeDimension_over_field 2 f]

end SurfaceBasics

/-- `H⁰(X, M)` and `Γ(M, ⊤)` have the same dimension over `k`. -/
private lemma finrank_cohomologyOverField_zero {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (M : X.Modules) :
    letI : Module k Γ(M, ⊤) :=
      Module.compHom _ (f.appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom)
    Module.finrank k (cohomologyOverField k f M 0) = Module.finrank k Γ(M, ⊤) := by
  letI : X.Over (Spec (.of k)) := ⟨f⟩
  letI : Module k Γ(M, ⊤) := Module.compHom _ (f.appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom)
  let e : (restrictScalarsOverBase k f).obj
      ((SheafOfModules.evaluation X.ringCatSheaf (Opposite.op ⊤)).obj M) ≃ₗ[k] Γ(M, ⊤) :=
    { toFun := fun a => a
      invFun := fun a => a
      map_add' := fun _ _ => rfl
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_smul' := fun c a =>
        congrArg (fun r => (((Scheme.ΓSpecIso (.of k)).inv ≫ r).hom c) •
          (show Γ(M, ⊤) from a)) (appLE_top_top_eq_appTop f _) }
  exact ((cohomologyOverFieldZeroLinearIso k f M).toLinearEquiv.trans e).finrank_eq

/-! ### The intersection pairing on `Pic` of a surface -/

section Pairing

variable (k : Type u) [Field k] {X : Scheme.{u}} (pX : X ⟶ Spec (.of k)) [IsProper pX]
  (hX : topologicalKrullDim X ≤ (2 : ℕ))

/-- The intersection pairing on `Pic(X)` of a surface. -/
private noncomputable def β (x y : Stacks.Picard.ofScheme X) : ℤ :=
  picardIntersection k pX (𝟙 X) 2 hX ![x, y]

private theorem update_vec_zero {α : Type*} (a b c : α) :
    Function.update ![a, b] 0 c = ![c, b] := by
  ext j; fin_cases j <;> rfl

private theorem update_vec_one {α : Type*} (a b c : α) :
    Function.update ![a, b] 1 c = ![a, c] := by
  ext j; fin_cases j <;> rfl

private theorem β_add_left (x x' y : Stacks.Picard.ofScheme X) :
    β k pX hX (x + x') y = β k pX hX x y + β k pX hX x' y := by
  have h := (picardIntersection k pX (𝟙 X) 2 hX).map_update_add ![x, y] 0 x x'
  simpa only [update_vec_zero, β] using h

private theorem β_add_right (x y y' : Stacks.Picard.ofScheme X) :
    β k pX hX x (y + y') = β k pX hX x y + β k pX hX x y' := by
  have h := (picardIntersection k pX (𝟙 X) 2 hX).map_update_add ![x, y] 1 y y'
  simpa only [update_vec_one, β] using h

private theorem β_zsmul_left (n : ℤ) (x y : Stacks.Picard.ofScheme X) :
    β k pX hX (n • x) y = n * β k pX hX x y := by
  have h := (picardIntersection k pX (𝟙 X) 2 hX).map_update_smul ![x, y] 0 n x
  simpa only [update_vec_zero, smul_eq_mul, β] using h

private theorem β_zsmul_right (n : ℤ) (x y : Stacks.Picard.ofScheme X) :
    β k pX hX x (n • y) = n * β k pX hX x y := by
  have h := (picardIntersection k pX (𝟙 X) 2 hX).map_update_smul ![x, y] 1 n y
  simpa only [update_vec_one, smul_eq_mul, β] using h

private theorem β_neg_right (x y : Stacks.Picard.ofScheme X) :
    β k pX hX x (-y) = - β k pX hX x y := by
  have := β_zsmul_right k pX hX (-1) x y
  rwa [neg_one_zsmul, neg_one_mul] at this

private theorem β_sub_right (x y y' : Stacks.Picard.ofScheme X) :
    β k pX hX x (y - y') = β k pX hX x y - β k pX hX x y' := by
  rw [sub_eq_add_neg, β_add_right, β_neg_right, ← sub_eq_add_neg]

/-- `β` on classes of modules is their intersection number. -/
private theorem β_cls (A B : X.Modules)
    [hA : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 A]
    [hB : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 B] :
    β k pX hX (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf A hA)
        (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf B hB) =
      @intersectionNumber k _ X X pX _ (𝟙 X) _ 2 hX ![A, B] (Fin.forall_fin_two.2 ⟨hA, hB⟩) :=
  picardIntersection_picardClass_pair k pX hX A B

/-- `β` is symmetric. -/
private theorem β_comm (x y : Stacks.Picard.ofScheme X) : β k pX hX x y = β k pX hX y x := by
  simp only [β, picardIntersection_apply]
  have : ∀ q : Fin 2, SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2
      (picardRep (![y, x] q)) := fun q => (isInvertible_picardRep _).toAlgebraicGeometry
  have h := intersectionNumber_comp_perm k pX (𝟙 X) 2 hX (fun q => picardRep (![y, x] q))
    (Equiv.swap 0 1)
  refine Eq.trans ?_ h
  congr 1
  funext j
  fin_cases j <;> rfl

end Pairing

/-! ### Values of the pairing on `C × C` -/

section ValuesCurve

variable {k : Type u} [Field k] {C : Scheme.{u}} (f : C ⟶ Spec (.of k))
  (hX : topologicalKrullDim (pullback f f : Scheme.{u}) ≤ (2 : ℕ))
  (hC : topologicalKrullDim C ≤ 1)

/-- Pullback of the class of an invertible module is the class of its pullback, with the
invertibility proofs explicit so that it can be used to rewrite. -/
private theorem schemePullbackClass_picardClass {Y Z : Scheme.{u}} (q : Y ⟶ Z) (A : Z.Modules)
    (hA : Stacks.SheafOfModules.IsInvertible Z.presheaf Z.ringCatIsSheaf A)
    (hqA : Stacks.SheafOfModules.IsInvertible Y.presheaf Y.ringCatIsSheaf
      ((Scheme.Modules.pullback q).obj A)) :
    Stacks.Picard.schemePullbackClass q
        (Stacks.SheafOfModules.picardClass Z.presheaf Z.ringCatIsSheaf A hA) =
      Stacks.SheafOfModules.picardClass Y.presheaf Y.ringCatIsSheaf
        ((Scheme.Modules.pullback q).obj A) hqA :=
  @AlgebraicGeometry.ExceptionalCurveContraction.schemePullbackClass_cls Z Y q A hA hqA

/-- `Ω_{C/k}` is invertible. -/
private theorem isInvertible_relativeDifferentials [SmoothOfRelativeDimension 1 f] :
    SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 f.relativeDifferentials :=
  have := Stacks.Discriminant.isFiniteLocallyFreeOfRank_relativeDifferentials f 1
  Stacks.ModuleDescent.isInvertible_of_isFiniteLocallyFreeOfRank_one C _ this

/-- `β(pr₁^*x, pr₂^*y) = deg x · deg y`, by
`Faltings.intersectionNumber_pullback_curve_prod_self`. -/
private theorem β_fst_snd [IsSmoothProjectiveCurve k f] (x y : Stacks.Picard.ofScheme C) :
    β k (pullback.fst f f ≫ f) hX (Stacks.Picard.schemePullbackClass (pullback.fst f f) x)
        (Stacks.Picard.schemePullbackClass (pullback.snd f f) y) =
      Stacks.Picard.picardDegree f hC x * Stacks.Picard.picardDegree f hC y := by
  have hA : SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 (picardRep x) :=
    (isInvertible_picardRep x).toAlgebraicGeometry
  have hB : SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 (picardRep y) :=
    (isInvertible_picardRep y).toAlgebraicGeometry
  have h1 := Stacks.AmpleRestrict.isInvertible_pullback (pullback.fst f f) (picardRep x)
  have h2 := Stacks.AmpleRestrict.isInvertible_pullback (pullback.snd f f) (picardRep y)
  have := (isEffectiveCartierDivisor_ker_diagonal k f).1
  have hD := Stacks.Divisors.isInvertible_invertibleSheaf (pullback.diagonal f).ker
  conv_lhs => rw [← picardClass_picardRep x, ← picardClass_picardRep y,
    schemePullbackClass_picardClass _ _ _
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ h1),
    schemePullbackClass_picardClass _ _ _
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ h2)]
  rw [β_cls]
  exact (intersectionNumber_pullback_curve_prod_self k f (picardRep x) (picardRep y)
    (Stacks.Divisors.invertibleSheaf (pullback.diagonal f).ker) (Iso.refl _)).1

/-- `β(q^*x, q^*y) = 0` for a projection `q`, by
`Faltings.intersectionNumber_pullback_curve_prod_self`. -/
private theorem β_pullback_pullback [IsSmoothProjectiveCurve k f] (i : Fin 2)
    (x y : Stacks.Picard.ofScheme C) :
    β k (pullback.fst f f ≫ f) hX
        (Stacks.Picard.schemePullbackClass (![pullback.fst f f, pullback.snd f f] i) x)
        (Stacks.Picard.schemePullbackClass (![pullback.fst f f, pullback.snd f f] i) y) = 0 := by
  have hA : SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 (picardRep x) :=
    (isInvertible_picardRep x).toAlgebraicGeometry
  have hB : SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 (picardRep y) :=
    (isInvertible_picardRep y).toAlgebraicGeometry
  have h1 := Stacks.AmpleRestrict.isInvertible_pullback
    (![pullback.fst f f, pullback.snd f f] i) (picardRep x)
  have h2 := Stacks.AmpleRestrict.isInvertible_pullback
    (![pullback.fst f f, pullback.snd f f] i) (picardRep y)
  have := (isEffectiveCartierDivisor_ker_diagonal k f).1
  have hD := Stacks.Divisors.isInvertible_invertibleSheaf (pullback.diagonal f).ker
  conv_lhs => rw [← picardClass_picardRep x, ← picardClass_picardRep y,
    schemePullbackClass_picardClass _ _ _
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ h1),
    schemePullbackClass_picardClass _ _ _
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ h2)]
  rw [β_cls]
  exact ((intersectionNumber_pullback_curve_prod_self k f (picardRep x) (picardRep y)
    (Stacks.Divisors.invertibleSheaf (pullback.diagonal f).ker) (Iso.refl _)).2 i).1

/-- `β([Δ], q^*x) = deg x` for a projection `q`, by
`Faltings.intersectionNumber_pullback_curve_prod_self`. -/
private theorem β_diagonal_pullback [IsSmoothProjectiveCurve k f]
    [Stacks.Divisors.IsEffectiveCartierDivisor (pullback.diagonal f).ker] (i : Fin 2)
    (x : Stacks.Picard.ofScheme C) :
    β k (pullback.fst f f ≫ f) hX (Stacks.Divisors.picardClass (pullback.diagonal f).ker)
        (Stacks.Picard.schemePullbackClass (![pullback.fst f f, pullback.snd f f] i) x) =
      Stacks.Picard.picardDegree f hC x := by
  have hA : SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 (picardRep x) :=
    (isInvertible_picardRep x).toAlgebraicGeometry
  have h1 := Stacks.AmpleRestrict.isInvertible_pullback
    (![pullback.fst f f, pullback.snd f f] i) (picardRep x)
  conv_lhs => rw [← picardClass_picardRep x,
    schemePullbackClass_picardClass _ _ _
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ h1)]
  have hD := Stacks.Divisors.isInvertible_invertibleSheaf (pullback.diagonal f).ker
  have e := @β_cls k _ _ (pullback.fst f f ≫ f) _ hX
    (Stacks.Divisors.invertibleSheaf (pullback.diagonal f).ker : (pullback f f).Modules)
    ((Scheme.Modules.pullback (![pullback.fst f f, pullback.snd f f] i)).obj (picardRep x)) hD h1
  refine Eq.trans ?_ (e.trans ?_)
  · rfl
  exact (intersectionNumber_pair_swap k _ hX
    (Stacks.Divisors.invertibleSheaf (pullback.diagonal f).ker : (pullback f f).Modules)
    ((Scheme.Modules.pullback (![pullback.fst f f, pullback.snd f f] i)).obj (picardRep x))).trans
    (((intersectionNumber_pullback_curve_prod_self k f (picardRep x) (picardRep x)
      (Stacks.Divisors.invertibleSheaf (pullback.diagonal f).ker) (Iso.refl _)).2 i).2)

/-- `[K_{C × C}] = pr₁^*[Ω_C] + pr₂^*[Ω_C]`, by
`Faltings.nonempty_exteriorPower_relativeDifferentials_pullback_iso_tensorObj`. -/
private theorem picardClass_canonical [IsSmoothProjectiveCurve k f]
    (hK : Stacks.SheafOfModules.IsInvertible (pullback f f).presheaf (pullback f f).ringCatIsSheaf
      (Scheme.Modules.exteriorPower (pullback.fst f f ≫ f).relativeDifferentials 2)) :
    Stacks.SheafOfModules.picardClass (pullback f f).presheaf (pullback f f).ringCatIsSheaf
        (Scheme.Modules.exteriorPower (pullback.fst f f ≫ f).relativeDifferentials 2) hK =
      Stacks.Picard.schemePullbackClass (pullback.fst f f)
          (Stacks.SheafOfModules.picardClass C.presheaf C.ringCatIsSheaf f.relativeDifferentials
            (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _
              (isInvertible_relativeDifferentials f))) +
        Stacks.Picard.schemePullbackClass (pullback.snd f f)
          (Stacks.SheafOfModules.picardClass C.presheaf C.ringCatIsSheaf f.relativeDifferentials
            (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _
              (isInvertible_relativeDifferentials f))) := by
  have := isInvertible_relativeDifferentials f
  have h1 := Stacks.AmpleRestrict.isInvertible_pullback (pullback.fst f f) f.relativeDifferentials
  have h2 := Stacks.AmpleRestrict.isInvertible_pullback (pullback.snd f f) f.relativeDifferentials
  have h12 : Stacks.SheafOfModules.IsInvertible (pullback f f).presheaf
      (pullback f f).ringCatIsSheaf (Scheme.Modules.tensorObj
        ((Scheme.Modules.pullback (pullback.fst f f)).obj f.relativeDifferentials)
        ((Scheme.Modules.pullback (pullback.snd f f)).obj f.relativeDifferentials)) :=
    Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _
      (Stacks.Chow.isInvertible_tensorObj _ _)
  rw [schemePullbackClass_picardClass _ _ _
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ h1),
    schemePullbackClass_picardClass _ _ _
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ h2),
    Stacks.SheafOfModules.picardClass_tensorSheaf _ _ _ _ _ _ h12]
  exact (Stacks.SheafOfModules.picardClass_eq_iff _ _ _ _ _ _).2
    (nonempty_exteriorPower_relativeDifferentials_pullback_iso_tensorObj k f)

/-- **Self-intersection of the diagonal**: `(Δ · Δ) = 2 - 2g`, the last value of
`Faltings.CurveWithDegreeOneDivisor.picardIntersection_vojtaClass` for any divisor of degree
one on `C`. -/
private theorem β_diagonal_self [IsSmoothProjectiveCurve k f]
    [Stacks.Divisors.IsEffectiveCartierDivisor (pullback.diagonal f).ker]
    (hP₁ : ∃ P : {x : C // IsClosed ({x} : Set C)} →₀ ℤ,
      (P.sum fun x n => n * (f.residueDegree x.1 : ℤ)) = 1) :
    β k (pullback.fst f f ≫ f) hX (Stacks.Divisors.picardClass (pullback.diagonal f).ker)
      (Stacks.Divisors.picardClass (pullback.diagonal f).ker) = 2 - 2 * genus f := by
  obtain ⟨P, hP⟩ := hP₁
  let X : CurveWithDegreeOneDivisor k := { C := C, f := f, P := P, degree_P := hP }
  obtain ⟨-, -, -, -, -, h⟩ := CurveWithDegreeOneDivisor.picardIntersection_vojtaClass X
  rw [CurveWithDegreeOneDivisor.vojtaClass_one_one_one X] at h
  exact h

end ValuesCurve

section Values

variable {k : Type u} [Field k] {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsProper f]
  [IsCurve k f] [IsProper (pullback.fst f f ≫ f)]
  (hX : topologicalKrullDim (pullback f f : Scheme.{u}) ≤ (2 : ℕ))
  (hC : topologicalKrullDim C ≤ 1)

/-- The degree of a class on the curve `C`. -/
private noncomputable abbrev degC (x : Stacks.Picard.ofScheme C) : ℤ :=
  Stacks.Picard.picardDegree f hC x

/-- `[K ⊗ 𝓛⁻¹] = [K] - [𝓛]`. -/
private theorem picardClass_adj {Y : Scheme.{u}} (pY : Y ⟶ Spec (.of k))
    [IsProjectiveVariety k pY] [GeometricallyIntegral pY] [SmoothOfRelativeDimension 2 pY]
    (L : Y.Modules) [hL : SheafOfModules.IsInvertible Y.presheaf Y.ringCatSheaf.2 L]
    (h₁ : Stacks.SheafOfModules.IsInvertible Y.presheaf Y.ringCatIsSheaf (adj pY L)) :
    Stacks.SheafOfModules.picardClass Y.presheaf Y.ringCatIsSheaf (adj pY L) h₁ =
      Stacks.SheafOfModules.picardClass Y.presheaf Y.ringCatIsSheaf
          (Scheme.Modules.exteriorPower pY.relativeDifferentials 2)
          (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _
            (isInvertible_canonical pY)) -
        Stacks.SheafOfModules.picardClass Y.presheaf Y.ringCatIsSheaf L
          (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL) := by
  have hm : SheafOfModules.IsInvertible Y.presheaf Y.ringCatSheaf.2
      (Stacks.SheafOfModules.Invertible.tensorPower Y.presheaf Y.ringCatSheaf.2 L (-1)) :=
    Stacks.SheafOfModules.Invertible.tensorPower_isInvertible Y.presheaf Y.ringCatSheaf.2 L (-1)
  rw [sub_eq_add_neg]
  refine (Stacks.SheafOfModules.picardClass_tensorSheaf Y.presheaf Y.ringCatIsSheaf
    (Scheme.Modules.exteriorPower pY.relativeDifferentials 2)
    (Stacks.SheafOfModules.Invertible.tensorPower Y.presheaf Y.ringCatSheaf.2 L (-1))
    (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ (isInvertible_canonical pY))
    (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ hm) h₁).symm.trans ?_
  congr 1
  exact Stacks.SheafOfModules.picardClass_tensorPower_neg_one Y.presheaf Y.ringCatIsSheaf L
    (hL := Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL)

omit [IsProper (pullback.fst f f ≫ f)] in
/-- `deg [Ω_C] = 2g - 2`. -/
private theorem degC_relativeDifferentials [SmoothOfRelativeDimension 1 f] [Smooth f]
    [GeometricallyIntegral f] :
    degC f hC (Stacks.SheafOfModules.picardClass C.presheaf C.ringCatIsSheaf f.relativeDifferentials
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _
        (isInvertible_relativeDifferentials f))) = 2 * genus f - 2 := by
  have := isIso_globalSections_of_geometricallyIntegral k f
  have := isInvertible_relativeDifferentials f
  refine (Stacks.Picard.picardDegreeFun_picardClass f hC _ _).trans ?_
  exact invertibleCurveDegree_relativeDifferentials_eq_two_mul_genus_sub_two f

/-- **The intersection pairing on the span of `pr₁^* Pic C`, `pr₂^* Pic C` and `[Δ]`**. -/
private theorem β_pr_pr_diagonal [IsProjectiveVariety k f] [Smooth f] [GeometricallyIntegral f]
    [IsIntegral (pullback f f)] [IsProjectiveVariety k (pullback.fst f f ≫ f)]
    [GeometricallyIntegral (pullback.fst f f ≫ f)]
    [SmoothOfRelativeDimension 2 (pullback.fst f f ≫ f)]
    [Stacks.Divisors.IsEffectiveCartierDivisor (pullback.diagonal f).ker]
    (hP₁ : ∃ P : {x : C // IsClosed ({x} : Set C)} →₀ ℤ,
      (P.sum fun x n => n * (f.residueDegree x.1 : ℤ)) = 1)
    (x y x' y' : Stacks.Picard.ofScheme C) (c c' : ℤ) :
    β k (pullback.fst f f ≫ f) hX
        (Stacks.Picard.schemePullbackClassHom (pullback.fst f f) x +
          Stacks.Picard.schemePullbackClassHom (pullback.snd f f) y +
          c • Stacks.Divisors.picardClass (pullback.diagonal f).ker)
        (Stacks.Picard.schemePullbackClassHom (pullback.fst f f) x' +
          Stacks.Picard.schemePullbackClassHom (pullback.snd f f) y' +
          c' • Stacks.Divisors.picardClass (pullback.diagonal f).ker) =
      degC f hC x * degC f hC y' + degC f hC y * degC f hC x' +
        c * (degC f hC x' + degC f hC y') + c' * (degC f hC x + degC f hC y) +
        c * c' * (2 - 2 * genus f) := by
  have := Stacks.Curves.smoothOfRelativeDimension_one_of_isCurve f
  have : IsSmoothProjectiveCurve k f := {}
  set q₁ := Stacks.Picard.schemePullbackClassHom (pullback.fst f f)
  set q₂ := Stacks.Picard.schemePullbackClassHom (pullback.snd f f)
  set D : Stacks.Picard.ofScheme (pullback f f) :=
    Stacks.Divisors.picardClass (pullback.diagonal f).ker
  have tDD : β k _ hX D D = 2 - 2 * genus f := β_diagonal_self f hX hP₁
  have t11 : ∀ x y, β k _ hX (q₁ x) (q₁ y) = 0 := β_pullback_pullback f hX 0
  have t22 : ∀ x y, β k _ hX (q₂ x) (q₂ y) = 0 := β_pullback_pullback f hX 1
  have t12 : ∀ x y, β k _ hX (q₁ x) (q₂ y) = degC f hC x * degC f hC y := β_fst_snd f hX hC
  have t21 : ∀ x y, β k _ hX (q₂ y) (q₁ x) = degC f hC x * degC f hC y := fun x y =>
    (β_comm k _ hX _ _).trans (t12 x y)
  have tD1 : ∀ x, β k _ hX D (q₁ x) = degC f hC x := β_diagonal_pullback f hX hC 0
  have tD2 : ∀ x, β k _ hX D (q₂ x) = degC f hC x := β_diagonal_pullback f hX hC 1
  have t1D : ∀ x, β k _ hX (q₁ x) D = degC f hC x := fun x => (β_comm k _ hX _ _).trans (tD1 x)
  have t2D : ∀ x, β k _ hX (q₂ x) D = degC f hC x := fun x => (β_comm k _ hX _ _).trans (tD2 x)
  simp only [β_add_left, β_add_right, β_zsmul_left, β_zsmul_right, t11, t22, t12, t21, tD1, tD2,
    t1D, t2D, tDD]
  ring

end Values

/-! ### Riemann–Roch on a smooth projective surface, in terms of the pairing -/

section SurfaceRR

variable {k : Type u} [Field k] {X : Scheme.{u}} (pX : X ⟶ Spec (.of k))
  [IsProjectiveVariety k pX] [GeometricallyIntegral pX] [SmoothOfRelativeDimension 2 pX]

/-- The canonical class `[K_X] = [⋀² Ω_{X/k}]`. -/
private noncomputable abbrev canonicalClass : Stacks.Picard.ofScheme X :=
  Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf
    (Scheme.Modules.exteriorPower pX.relativeDifferentials 2)
    (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ (isInvertible_canonical pX))

/-- **Riemann–Roch inequality on a surface**, `Faltings.riemannRoch_inequality_surface` in terms
of the pairing: `2 h⁰(𝓛) ≥ 2 χ(𝒪_X) + (𝓛 · 𝓛) - (𝓛 · K) - 2 h⁰(K ⊗ 𝓛⁻¹)`. -/
private theorem riemannRoch_le_two_mul_finrank (L : X.Modules)
    [hL : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L] :
    2 * @eulerCharacteristic k _ X pX _ (SheafOfModules.unit X.ringCatSheaf)
          (Stacks.AlgebraicGeometry.CurveEulerBridge.isCoherent_unit k pX) +
        β k pX (dim_le_two pX)
          (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf L
            (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL))
          (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf L
            (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL)) -
        β k pX (dim_le_two pX)
          (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf L
            (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL))
          (canonicalClass pX) -
        2 * Module.finrank k (cohomologyOverField k pX (adj pX L) 0) ≤
      2 * Module.finrank k (cohomologyOverField k pX L 0) := by
  have hX2 : topologicalKrullDim X = 2 := by
    rw [topologicalKrullDim_eq_of_smoothOfRelativeDimension_over_field 2 pX]; rfl
  have := isInvertible_canonical pX
  have RR := riemannRoch_inequality_surface k pX hX2 L
  rw [← β_cls k pX (dim_le_two pX) L L,
    ← β_cls k pX (dim_le_two pX) L (Scheme.Modules.exteriorPower pX.relativeDifferentials 2)]
    at RR
  have key : ((2 * @eulerCharacteristic k _ X pX _ (SheafOfModules.unit X.ringCatSheaf)
          (Stacks.AlgebraicGeometry.CurveEulerBridge.isCoherent_unit k pX) +
        β k pX (dim_le_two pX)
          (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf L
            (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL))
          (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf L
            (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL)) -
        β k pX (dim_le_two pX)
          (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf L
            (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL))
          (canonicalClass pX) -
        2 * Module.finrank k (cohomologyOverField k pX (adj pX L) 0) : ℤ) : ℚ) ≤
      ((2 * Module.finrank k (cohomologyOverField k pX L 0) : ℤ) : ℚ) := by
    push_cast
    linarith
  exact_mod_cast key

/-- **Vanishing of `H⁰(K ⊗ 𝓛⁻¹)`** when an ample `H` has `(H · K) < (H · 𝓛)`. -/
private theorem finrank_cohomology_adj_eq_zero (L H : X.Modules)
    [hL : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 L]
    [hH : SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 H]
    (hHa : Scheme.Modules.IsAmple X H)
    (hlt : β k pX (dim_le_two pX)
        (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf H
          (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ H hH))
        (canonicalClass pX) <
      β k pX (dim_le_two pX)
        (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf H
          (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ H hH))
        (Stacks.SheafOfModules.picardClass X.presheaf X.ringCatIsSheaf L
          (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL))) :
    Module.finrank k (cohomologyOverField k pX (adj pX L) 0) = 0 := by
  have hdim2 : topologicalKrullDim X = 2 := by
    rw [topologicalKrullDim_eq_of_smoothOfRelativeDimension_over_field 2 pX]; rfl
  have := isInvertible_adj pX L
  have hneg : @intersectionNumber k _ _ _ pX _ (𝟙 _) _ 2 (by simp [hdim2]) ![H, adj pX L]
      (Fin.forall_fin_two.2 ⟨hH, isInvertible_adj pX L⟩) < 0 := by
    refine lt_of_eq_of_lt (β_cls k pX (dim_le_two pX) H (adj pX L)).symm ?_
    rw [picardClass_adj pX L, β_sub_right]
    linarith
  letI : Module k Γ(adj pX L, ⊤) :=
    Module.compHom _ (pX.appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom)
  have : Subsingleton Γ(adj pX L, ⊤) :=
    subsingleton_sections_of_intersectionNumber_neg k pX hdim2 H (adj pX L) hHa hneg
  rw [finrank_cohomologyOverField_zero pX (adj pX L)]
  exact Module.finrank_zero_of_subsingleton

end SurfaceRR

open Stacks.ProjectiveFromSections (resT resO resM)
open Opposite MonoidalCategory

/-! ### Coordinates against a regular meromorphic section -/

section GenericCoord

/-- The coordinate `ρ(t)` of a global section `t` against a regular meromorphic section is
nonzero as soon as `t` does not vanish at some point. -/
private theorem genericCoord_ne_zero {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    [Stacks.Ample.IsInvertibleModule X L]
    (s : MeromorphicSection X.sheaf L) (hs : IsRegularMeromorphicSection X.sheaf L s)
    {t : Γ(L, ⊤)} {x : X} (ht : x ∈ Stacks.NonvanishingOpen.nonvanishingOpen X L t) :
    Stacks.Zeta.genericCoord X L s hs t ≠ 0 := by
  intro h0
  have h00 := Stacks.Zeta.genericCoord_add X L s hs 0 0
  rw [add_zero, left_eq_add] at h00
  have ht0 : t = 0 := Stacks.Zeta.genericCoord_injective X L s hs (h0.trans h00.symm)
  obtain ⟨w, hw⟩ := Stacks.SectionProduct.exists_notMem_maximalSmul L x
  obtain ⟨r, hr⟩ := (Stacks.SectionProduct.mem_nonvanishingLocus_iff_generates L t x).1 ht w
  apply hw
  rw [hr, ht0, map_zero, smul_zero]
  exact zero_mem _

open Stacks.AlgebraicGeometry.ReflexiveModules in
/-- At a point of codimension one where the global section `t` of the invertible module `L` does
not vanish, the coordinate `ρ(t)` of `t` against a regular meromorphic section `s` has order
`-ord_Z(s)`. -/
private theorem ord_genericCoord_add_eq_zero {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    [Stacks.Ample.IsInvertibleModule X L]
    (s : MeromorphicSection X.sheaf L) (hs : IsRegularMeromorphicSection X.sheaf L s)
    (Z : PrimeDivisor X) [IsDiscreteValuationRing (X.presheaf.stalk Z.genericPoint)]
    (t : Γ(L, ⊤)) (ht : Z.genericPoint ∈ Stacks.NonvanishingOpen.nonvanishingOpen X L t) :
    X.ord (Stacks.Zeta.genericCoord X L s hs t) Z.genericPoint +
      orderOfVanishingMeromorphic X L s hs Z = 0 := by
  have hx1 := PrimeDivisor.coheight_genericPoint Z
  have hgen := (Stacks.SectionProduct.mem_nonvanishingLocus_iff_generates L t
    Z.genericPoint).1 ht
  have ha0 := genericCoord_ne_zero L s hs ht
  have hge := (Stacks.Zeta.genericCoord_mem X L s hs t Z).resolve_left ha0
  refine le_antisymm ?_ hge
  by_contra hlt
  push Not at hlt
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible (X.presheaf.stalk Z.genericPoint)
  have hπ0 : algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField ϖ ≠ 0 := by
    simpa using hϖ.ne_zero
  have hπ1 := Stacks.BombieriStepanov.ord_algebraMap_irreducible hx1 hϖ
  set πK := algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField ϖ with hπK
  set a := Stacks.Zeta.genericCoord X L s hs t with ha
  set b := a * πK⁻¹ with hb
  have hb0 : b ≠ 0 := mul_ne_zero ha0 (inv_ne_zero hπ0)
  have hab : a = b * πK := by rw [hb, inv_mul_cancel_right₀ hπ0]
  have hordb : X.ord a Z.genericPoint = X.ord b Z.genericPoint + 1 := by
    rw [hab, Scheme.ord_mul hb0 hπ0, hπ1]
  obtain ⟨m, hm⟩ := (Stacks.Zeta.mem_range_stalkSpecializes_iff X L s hs Z hb0).2 (by omega)
  obtain ⟨r, hr⟩ := hgen m
  have hsp : L.presheaf.stalkSpecializes ((genericPoint_spec X).specializes
      (Set.mem_univ Z.genericPoint)) ((L.presheaf.Γgerm Z.genericPoint).hom t) =
      a • Stacks.Zeta.genericValue X L s := by
    rw [ha, ← Stacks.Zeta.genericCoord_spec X L s hs t]
    exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
  rw [hr, Stacks.ModuleStalkSpecialization.stalkSpecializes_smul L _ r _, hsp, smul_smul] at hm
  have hrb : algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField r * a = b :=
    smul_left_injective X.functionField (Stacks.Zeta.genericValue_ne_zero X L s hs) hm
  have h1 : algebraMap (X.presheaf.stalk Z.genericPoint) X.functionField (r * ϖ) = 1 := by
    rw [map_mul, ← hπK]
    rw [hab] at hrb
    exact mul_right_cancel₀ hb0 (by linear_combination hrb)
  have h2 : r * ϖ = 1 :=
    (IsFractionRing.injective (X.presheaf.stalk Z.genericPoint) X.functionField)
      (h1.trans (map_one _).symm)
  exact hϖ.not_isUnit (IsUnit.of_mul_eq_one r (by rw [mul_comm]; exact h2))

/-- If `t = a t₀` on an open `U` containing the generic point, then `ρ(t) = a ρ(t₀)`. -/
private theorem genericCoord_eq_of_resT {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    (L : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : MeromorphicSection X.sheaf L) (hs : IsRegularMeromorphicSection X.sheaf L s)
    {U : X.Opens} (hU : genericPoint X ∈ U) {t t₀ : Γ(L, ⊤)} {a : Γ(X, U)}
    (h : Stacks.ProjectiveFromSections.resT U t = a • Stacks.ProjectiveFromSections.resT U t₀) :
    Stacks.Zeta.genericCoord X L s hs t =
      X.presheaf.germ U (genericPoint X) hU a * Stacks.Zeta.genericCoord X L s hs t₀ := by
  have hg : ∀ x : Γ(L, ⊤), L.presheaf.germ ⊤ (genericPoint X) trivial x =
      L.presheaf.germ U (genericPoint X) hU (Stacks.ProjectiveFromSections.resT U x) := fun x =>
    (TopCat.Presheaf.germ_res_apply _ _ _ _ x).symm
  have e1 : Stacks.Zeta.genericCoord X L s hs t = (Stacks.Zeta.genericBasisEquiv X L s hs).symm
      (L.presheaf.germ ⊤ (genericPoint X) trivial t) := rfl
  have e2 : Stacks.Zeta.genericCoord X L s hs t₀ = (Stacks.Zeta.genericBasisEquiv X L s hs).symm
      (L.presheaf.germ ⊤ (genericPoint X) trivial t₀) := rfl
  rw [e1, e2, hg t, h, Stacks.ModuleStalk.germ_smul L _ U hU a, map_smul, ← hg]
  rfl

end GenericCoord

/-! ### Riemann–Roch spaces of multiples of `P` -/

section RiemannRoch

variable {k : Type u} [Field k] {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f]
  [IsProjectiveVariety k f] [Smooth f] [GeometricallyIntegral f] [IsLocallyNoetherian C]

/-- The divisor `D` read on the closed points. -/
private noncomputable def closedDivisor (D : C →₀ ℤ) : Stacks.Zeta.ClosedPoint C →₀ ℤ :=
  Finsupp.comapDomain Subtype.val D Subtype.val_injective.injOn

omit [IsLocallyNoetherian C] in
private theorem closedDivisor_apply (D : C →₀ ℤ) (x : Stacks.Zeta.ClosedPoint C) :
    closedDivisor D x = D x.1 := rfl

omit [GeometricallyIntegral f] [IsLocallyNoetherian C] in
/-- The degree of the class of a closed point is its residue degree. -/
private theorem picardDegree_pointClass_eq (x : Stacks.Zeta.ClosedPoint C) :
    Stacks.Picard.picardDegree f (Stacks.Zeta.topologicalKrullDim_le_one f)
      (Stacks.Zeta.pointClass f x) = f.residueDegree x.1 := by
  have := Stacks.Zeta.isEffectiveCartierDivisor_pointIdeal f x
  have hdeg := Stacks.Picard.picardDegree_divisorPicardClass f
    (Stacks.Zeta.topologicalKrullDim_le_one f) (Stacks.Zeta.pointIdeal x)
  have hI : IsIntegral (Stacks.Zeta.pointIdeal x).subscheme :=
    isIntegral_subscheme_vanishingIdeal x.2
  have hS : Subsingleton (Stacks.Zeta.pointIdeal x).subscheme :=
    subsingleton_subscheme_vanishingIdeal x.2
  obtain ⟨η⟩ : Nonempty (Stacks.Zeta.pointIdeal x).subscheme :=
    nonempty_subscheme_vanishingIdeal x.2
  have hres := Stacks.Chow.residueDegree_eq_finrank_globalSections k
    ((Stacks.Zeta.pointIdeal x).subschemeι ≫ f) η
  rw [residueDegree_comp,
    Stacks.Chow.residueDegree_eq_one_of_isPreimmersion (Stacks.Zeta.pointIdeal x).subschemeι,
    mul_one] at hres
  have hpt : (Stacks.Zeta.pointIdeal x).subschemeι η = x.1 :=
    (Scheme.IdealSheafData.range_subschemeι_vanishingIdeal
      (⟨{x.1}, x.2⟩ : TopologicalSpace.Closeds C)).subset ⟨η, rfl⟩
  rw [hpt] at hres
  change Stacks.Picard.picardDegree f _ (Stacks.Divisors.picardClass _) = _
  rw [hdeg, ← hres]

omit [GeometricallyIntegral f] [IsLocallyNoetherian C] in
/-- `deg [P] = 1` for a divisor `P` of degree one. -/
private theorem picardDegree_divisor (P : C →₀ ℤ)
    (hPclosed : ∀ Q ∈ P.support, IsClosed ({Q} : Set C))
    (hP : ∑ᶠ Q : C, P Q * (f.residueDegree Q : ℤ) = 1) :
    Stacks.Picard.picardDegree f (Stacks.Zeta.topologicalKrullDim_le_one f)
      (∑ Q ∈ P.support.attach, P Q • Stacks.Zeta.pointClass f ⟨Q, hPclosed Q Q.2⟩) = 1 := by
  rw [map_sum, Finset.sum_congr rfl fun Q _ => by
    rw [AddMonoidHom.map_zsmul, picardDegree_pointClass_eq, smul_eq_mul]]
  rw [← hP, finsum_eq_sum_of_support_subset (s := P.support)]
  · exact Finset.sum_attach P.support (fun Q => P Q * (f.residueDegree Q : ℤ))
  · intro Q hQ
    simp only [Function.mem_support, ne_eq] at hQ
    simp only [Finset.mem_coe, Finsupp.mem_support_iff]
    intro h; exact hQ (by rw [h, zero_mul])

omit [GeometricallyIntegral f] [IsLocallyNoetherian C] in
/-- The degree of the class of a divisor on the closed points. -/
private theorem picardDegree_divisorClass_eq (D : Stacks.Zeta.ClosedPoint C →₀ ℤ) :
    Stacks.Picard.picardDegree f (Stacks.Zeta.topologicalKrullDim_le_one f)
      (Stacks.Zeta.divisorClass f D) = D.sum fun x n => n * (f.residueDegree x.1 : ℤ) := by
  rw [Stacks.Zeta.divisorClass_apply, map_finsuppSum]
  refine Finsupp.sum_congr fun x _ => ?_
  rw [map_zsmul, picardDegree_pointClass_eq, smul_eq_mul]

omit [GeometricallyIntegral f] in
/-- Membership in `L(D)` for a divisor `D` on `C`, in the form of the statement. -/
private theorem mem_rrSpace_closedDivisor {D : C →₀ ℤ} {g : C.functionField} :
    letI := functionFieldAlgebra k f
    g ∈ Stacks.Zeta.rrSpace f (closedDivisor D) ↔
      g = 0 ∨ ∀ Q : C, IsClosed ({Q} : Set C) → 0 ≤ C.ord g Q + D Q := by
  let := functionFieldAlgebra k f
  rw [Stacks.Zeta.mem_rrSpace]
  simp only [Subtype.forall, closedDivisor_apply]

omit [IsCurve k f] [IsLocallyNoetherian C] [GeometricallyIntegral f] [IsProjectiveVariety k f]
  [Smooth f] in
/-- The degree of `e • P` is `e` when `P` has degree one. -/
private theorem sum_closedDivisor_smul (P : C →₀ ℤ)
    (hPclosed : ∀ Q ∈ P.support, IsClosed ({Q} : Set C))
    (hP : ∑ᶠ Q : C, P Q * (f.residueDegree Q : ℤ) = 1) (e : ℤ) :
    ((closedDivisor (e • P)).sum fun x m => m * (f.residueDegree x.1 : ℤ)) = e := by
  classical
  have hsupp : ∀ Q ∈ (e • P).support, IsClosed ({Q} : Set C) := fun Q hQ =>
    hPclosed Q (Finsupp.support_smul hQ)
  have h1 : ((closedDivisor (e • P)).sum fun x m => m * (f.residueDegree x.1 : ℤ)) =
      ∑ Q ∈ (e • P).support, (e • P) Q * (f.residueDegree Q : ℤ) := by
    rw [Finsupp.sum, closedDivisor, Finsupp.comapDomain_support]
    refine Finset.sum_preimage Subtype.val _ _
      (fun Q => (e • P) Q * (f.residueDegree Q : ℤ)) fun Q hQ hQr => ?_
    exact absurd ⟨⟨Q, hsupp Q hQ⟩, rfl⟩ hQr
  have h2 : ∑ᶠ Q : C, (e • P) Q * (f.residueDegree Q : ℤ) =
      ∑ Q ∈ (e • P).support, (e • P) Q * (f.residueDegree Q : ℤ) := by
    refine finsum_eq_sum_of_support_subset _ fun Q hQ => ?_
    simp only [Function.mem_support, ne_eq] at hQ
    simp only [Finset.mem_coe, Finsupp.mem_support_iff]
    intro h0
    exact hQ (by rw [h0, zero_mul])
  have h3 : ∑ᶠ Q : C, (e • P) Q * (f.residueDegree Q : ℤ) =
      e * ∑ᶠ Q : C, P Q * (f.residueDegree Q : ℤ) := by
    rw [mul_finsum]
    · refine finsum_congr fun Q => ?_
      rw [Finsupp.smul_apply, smul_eq_mul, mul_assoc]
  rw [h1, ← h2, h3, hP, mul_one]

/-- The sections of `𝒪(D)` vanishing at the closed point `Q`. -/
private noncomputable def vanishingSpace (D : Stacks.Zeta.ClosedPoint C →₀ ℤ)
    (Q : Stacks.Zeta.ClosedPoint C) :
    letI := functionFieldAlgebra k f
    Submodule k C.functionField :=
  Stacks.Zeta.rrSpace f (D - Finsupp.single Q 1)

omit [GeometricallyIntegral f] in
/-- A section of `𝒪(D)` with a zero at `Q` lies in `vanishingSpace f D Q`. -/
private theorem mem_vanishingSpace_of (D : Stacks.Zeta.ClosedPoint C →₀ ℤ)
    {Q : Stacks.Zeta.ClosedPoint C} {g : C.functionField}
    (hg : letI := functionFieldAlgebra k f; g ∈ Stacks.Zeta.rrSpace f D)
    (hQ : 0 < C.ord g Q.1 + D Q) :
    letI := functionFieldAlgebra k f
    g ∈ vanishingSpace f D Q := by
  let := functionFieldAlgebra k f
  rcases (Stacks.Zeta.mem_rrSpace f).1 hg with h0 | hall
  · exact (Stacks.Zeta.mem_rrSpace f).2 (Or.inl h0)
  refine (Stacks.Zeta.mem_rrSpace f).2 (Or.inr fun x => ?_)
  by_cases hx : x = Q
  · subst hx
    simp only [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_eq_same]
    omega
  · simp only [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_eq_of_ne hx, sub_zero]
    exact hall x

omit [GeometricallyIntegral f] in
/-- If `D` has the class of the invertible module `L` and `s` is a regular meromorphic section of
`L`, then `D = div s + div h` for some `h ≠ 0`, and `h⁻¹ ρ(u) ∈ L(D)` for every global section
`u` of `L`. -/
private theorem exists_eq_sectionDivisor_add_divOf (D : Stacks.Zeta.ClosedPoint C →₀ ℤ)
    (L : C.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible C.sheaf.obj C.ringCatSheaf.property L]
    (hL : Stacks.SheafOfModules.IsInvertible C.sheaf.obj C.ringCatSheaf.property L)
    (hc : Stacks.SheafOfModules.picardClass C.sheaf.obj C.ringCatSheaf.property L hL =
      Stacks.Zeta.divisorClass f D)
    (s : MeromorphicSection C.sheaf L) (hs : IsRegularMeromorphicSection C.sheaf L s) :
    letI := functionFieldAlgebra k f
    ∃ (h : C.functionField) (hh : h ≠ 0),
      D = Stacks.Zeta.sectionDivisor f L s hs + Stacks.Zeta.divOf f hh ∧
      ∀ u : Γ(L, ⊤), h⁻¹ * Stacks.Zeta.genericCoord C L s hs u ∈ Stacks.Zeta.rrSpace f D := by
  let := functionFieldAlgebra k f
  obtain ⟨h, hh, hhD⟩ := Stacks.Zeta.exists_divOf_eq_of_divisorClass_eq_zero f
    (D := D - Stacks.Zeta.sectionDivisor f L s hs)
    (by rw [map_sub, Stacks.Zeta.divisorClass_sectionDivisor f L s hs hL, hc, sub_self])
  have hD : D = Stacks.Zeta.sectionDivisor f L s hs + Stacks.Zeta.divOf f hh := by
    rw [hhD]; abel
  refine ⟨h, hh, hD, fun u => ?_⟩
  rw [hD, Stacks.Zeta.mem_rrSpace_add_divOf_iff f hh, mul_inv_cancel_left₀ hh,
    ← Stacks.Zeta.range_coordLinear f L s hs]
  exact ⟨u, rfl⟩

/-- **Global generation.** If `deg D ≥ 2g`, then for every closed point `Q` some section of
`𝒪(D)` does not vanish at `Q`. -/
private theorem exists_mem_rrSpace_notMem_vanishingSpace (D : Stacks.Zeta.ClosedPoint C →₀ ℤ)
    (hD : 2 * (genus f : ℤ) ≤ D.sum fun x n => n * (f.residueDegree x.1 : ℤ))
    (Q : Stacks.Zeta.ClosedPoint C) :
    letI := functionFieldAlgebra k f
    ¬ Stacks.Zeta.rrSpace f D ≤ vanishingSpace f D Q := by
  let := functionFieldAlgebra k f
  rw [← picardDegree_divisorClass_eq f D] at hD
  set c := Stacks.Zeta.divisorClass f D
  have hL := (Stacks.Picard.picardRepresentative C.toRingedSpace c).property
  set L : C.Modules := (Stacks.Picard.picardRepresentative C.toRingedSpace c).obj
  have : SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 L := hL
  have : AlgebraicGeometry.SheafOfModules.IsInvertible C.sheaf.obj C.ringCatSheaf.property L :=
    hL.toAlgebraicGeometry
  have : Stacks.Ample.IsInvertibleModule C L := hL
  have : IsIso ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop) :=
    isIso_globalSections_of_geometricallyIntegral k f
  -- `L` is generated by its global sections, so some section does not vanish at `Q`
  let S : CohenMacaulayCurveSituation :=
    { k := k, X := C, f := f
      dimension_one := IsCurve.topologicalKrullDim_eq_one (k := k) (f := f) }
  have hgg := S.isGeneratedByGlobalSections_of_two_mul_genus_le L hD
  have hgen := generatesStalks_id_of_isGeneratedByGlobalSections L hgg
  obtain ⟨t, ht⟩ := Stacks.ProjectiveFromSections.exists_mem_nvCover_of_generatesStalks id hgen Q.1
  -- a regular meromorphic section `s` of `L`, and `D = div s + div h`
  obtain ⟨s, hs⟩ := exists_isRegularMeromorphicSection_of_isIntegral C L
  obtain ⟨h, hh, hD', hmem⟩ := exists_eq_sectionDivisor_add_divOf f D L hL
    (Stacks.Picard.classOf_picardRepresentative C.toRingedSpace c) s hs
  -- the coordinate of `t` has the exact order `-ord(s)` at `Q`
  set Z := Stacks.Zeta.primeDivisorOfClosedPoint f Q
  have hZ : Z.genericPoint = Q.1 := PrimeDivisor.genericPoint_ofCoheightOne _ _
  have : IsDiscreteValuationRing (C.presheaf.stalk Z.genericPoint) :=
    Stacks.BombieriStepanov.isDiscreteValuationRing_stalk_of_coheight_eq_one f _
      (PrimeDivisor.coheight_genericPoint Z)
  have hord := ord_genericCoord_add_eq_zero L s hs Z t (by rw [hZ]; exact ht)
  rw [hZ] at hord
  set a := Stacks.Zeta.genericCoord C L s hs t
  have ha0 : a ≠ 0 := genericCoord_ne_zero L s hs ht
  -- the section `v = a / h` of `𝒪(D)` does not vanish at `Q`
  intro hle
  have hvmem : h⁻¹ * a ∈ Stacks.Zeta.rrSpace f D := hmem t
  have hv0 : h⁻¹ * a ≠ 0 := mul_ne_zero (inv_ne_zero hh) ha0
  have hvan := ((Stacks.Zeta.mem_rrSpace f).1 (hle hvmem)).resolve_left hv0 Q
  have hmul : C.ord a Q.1 = C.ord h Q.1 + C.ord (h⁻¹ * a) Q.1 := by
    have := Stacks.Zeta.dvr_closedPoint f Q
    rw [← Scheme.ord_mul hh hv0, mul_inv_cancel_left₀ hh]
  have hDQ : D Q = Stacks.Zeta.sectionDivisor f L s hs Q + C.ord h Q.1 := by
    rw [hD', Finsupp.add_apply, Stacks.Zeta.divOf_apply]
  rw [Stacks.Zeta.sectionDivisor_apply] at hDQ
  change D Q = orderOfVanishingMeromorphic C L s hs Z + C.ord h Q.1 at hDQ
  simp only [Finsupp.coe_sub, Pi.sub_apply, Finsupp.single_eq_same] at hvan
  linarith

end RiemannRoch

/-! ### Orders of rational functions -/

section Products

variable {C : Scheme.{u}} [IsIntegral C] [IsLocallyNoetherian C]

private theorem ord_one (Q : C) : C.ord (1 : C.functionField) Q = 0 := by
  have h := Scheme.ord_mul (x := Q) (one_ne_zero (α := C.functionField))
    (one_ne_zero (α := C.functionField))
  rw [mul_one] at h
  omega

private theorem ord_pow_eq {g : C.functionField} (hg : g ≠ 0) (Q : C) (e : ℕ) :
    C.ord (g ^ e) Q = e * C.ord g Q := by
  induction e with
  | zero => simp
  | succ e ih =>
    rw [pow_succ, Scheme.ord_mul (pow_ne_zero e hg) hg, ih]
    push_cast
    ring

private theorem ord_inv_eq {g : C.functionField} (hg : g ≠ 0) (Q : C) :
    C.ord g⁻¹ Q = - C.ord g Q := by
  have h := Scheme.ord_mul (x := Q) hg (inv_ne_zero hg)
  rw [mul_inv_cancel₀ hg, ord_one] at h
  omega

private theorem ord_div_eq {g g' : C.functionField} (hg : g ≠ 0) (hg' : g' ≠ 0) (Q : C) :
    C.ord (g / g') Q = C.ord g Q - C.ord g' Q := by
  rw [div_eq_mul_inv, Scheme.ord_mul hg (inv_ne_zero hg'), ord_inv_eq hg']
  ring

end Products

/-! ### The lower bound -/

section LowerBound

attribute [local instance] Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.TensorSectionNonvanishing.isInvertibleModule_tensorObj
  Stacks.InvertiblePullback.isInvertibleModule_pullback
  Stacks.AlgebraicGeometry.ProjectiveSpaceGeneratingSections.globalSectionsModule

/-- At a closed point, a nonzero `k`-combination of the `ℓ_μ` has order at least any common
lower bound of the orders of the `ℓ_μ`. -/
private theorem le_ord_of_mem_span (k : Type u) [Field k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
    [IsLocallyNoetherian C] {ι : Type*} [Finite ι] (ℓ : ι → C.functionField)
    (hℓ0 : ∀ μ, ℓ μ ≠ 0) (Q : Stacks.Zeta.ClosedPoint C) {m : ℤ}
    (hm : ∀ μ, m ≤ C.ord (ℓ μ) Q.1) {g : C.functionField}
    (hg : letI := functionFieldAlgebra k f; g ∈ Submodule.span k (Set.range ℓ)) (hg0 : g ≠ 0) :
    m ≤ C.ord g Q.1 := by
  have := Fintype.ofFinite ι
  let := functionFieldAlgebra k f
  have := Stacks.Zeta.dvr_closedPoint f Q
  obtain ⟨a, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun k).mp hg
  refine (Finset.sum_induction _ (fun x => x = 0 ∨ m ≤ C.ord x Q.1) ?_ (Or.inl rfl)
    fun i _ => ?_).resolve_left hg0
  · rintro x y (rfl | hx) (rfl | hy)
    · exact Or.inl (add_zero 0)
    · rw [zero_add]; exact Or.inr hy
    · rw [add_zero]; exact Or.inr hx
    · by_cases hxy : x + y = 0
      · exact Or.inl hxy
      · exact Or.inr ((le_min hx hy).trans (Scheme.ord_add hxy))
  · by_cases hai : a i = 0
    · exact Or.inl (by rw [hai, zero_smul])
    have ha0 : algebraMap k C.functionField (a i) ≠ 0 :=
      (map_ne_zero_iff _ (algebraMap k C.functionField).injective).mpr hai
    have hc0 : C.ord (algebraMap k C.functionField (a i)) Q.1 = 0 :=
      Stacks.Zeta.ord_algebraMap_const f hai Q
    rw [Algebra.smul_def, Scheme.ord_mul ha0 (hℓ0 i), hc0, zero_add]
    exact Or.inr (hm i)

/-- **`|NP|` is base point free.** If `ℓ` spans `L(NP)` with `N ≥ 2g`, and `ℓ_ν` has the least
order among the `ℓ_μ` at the closed point `Q`, then `ord_Q ℓ_ν = -N P(Q)`. -/
private theorem ord_eq_neg_of_forall_ord_le (k : Type u) [Field k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
    [GeometricallyIntegral f] [IsLocallyNoetherian C]
    (P : C →₀ ℤ) (hPclosed : ∀ Q ∈ P.support, IsClosed ({Q} : Set C))
    (hP : ∑ᶠ Q : C, P Q * (f.residueDegree Q : ℤ) = 1) (N : ℕ) (hN : 2 * genus f ≤ N)
    {ι : Type*} [Finite ι] (ℓ : ι → C.functionField) (hℓ0 : ∀ μ, ℓ μ ≠ 0)
    (hspan : letI := functionFieldAlgebra k f
      ((Submodule.span k (Set.range ℓ) : Submodule k C.functionField) : Set C.functionField) =
        {g | g = 0 ∨ ∀ Q : C, IsClosed ({Q} : Set C) → 0 ≤ C.ord g Q + ((N : ℤ) • P) Q})
    (Q : Stacks.Zeta.ClosedPoint C) (ν : ι) (hmin : ∀ μ, C.ord (ℓ ν) Q.1 ≤ C.ord (ℓ μ) Q.1) :
    C.ord (ℓ ν) Q.1 = -(N * P Q.1) := by
  let := functionFieldAlgebra k f
  have hlow := ((Set.ext_iff.mp hspan _).1 (Submodule.subset_span ⟨ν, rfl⟩)).resolve_left
    (hℓ0 ν) Q.1 Q.2
  rw [Finsupp.smul_apply, smul_eq_mul] at hlow
  -- a section `g` of `𝒪(NP)` not vanishing at `Q`
  obtain ⟨g, hgL, hgv⟩ := SetLike.not_le_iff_exists.mp
    (exists_mem_rrSpace_notMem_vanishingSpace f (closedDivisor ((N : ℤ) • P))
      (by rw [sum_closedDivisor_smul f P hPclosed hP]; omega) Q)
  have hg0 : g ≠ 0 := by rintro rfl; exact hgv (zero_mem _)
  have hup : C.ord g Q.1 + N * P Q.1 ≤ 0 := by
    by_contra hcon
    refine hgv (mem_vanishingSpace_of f _ hgL ?_)
    rw [closedDivisor_apply, Finsupp.smul_apply, smul_eq_mul]
    omega
  have hcomb := le_ord_of_mem_span k f ℓ hℓ0 Q hmin
    ((Set.ext_iff.mp hspan g).2 ((mem_rrSpace_closedDivisor f).1 hgL)) hg0
  omega

private theorem picardDegree_twistPb (k : Type u) [Field k] [NumberField k]
    {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
    [GeometricallyIntegral f] [IsLocallyNoetherian C] (hg : 2 ≤ genus f)
    (P : C →₀ ℤ) (hPclosed : ∀ Q ∈ P.support, IsClosed ({Q} : Set C))
    (hP : ∑ᶠ Q : C, P Q * (f.residueDegree Q : ℤ) = 1)
    (N : ℕ) (hN : 2 * genus f + 1 ≤ N) {n : ℕ}
    (ℓ : Fin (n + 1) → C.functionField)
    (hli : letI := functionFieldAlgebra k f; LinearIndependent k ℓ)
    (hspan : letI := functionFieldAlgebra k f
      ((Submodule.span k (Set.range ℓ) : Submodule k C.functionField) : Set C.functionField) =
        {g | g = 0 ∨ ∀ Q : C, IsClosed ({Q} : Set C) → 0 ≤ C.ord g Q + ((N : ℤ) • P) Q})
    (φNP : C ⟶ projectiveSpaceOver n (Spec (.of k)))
    (hφℓ :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ)) :=
        MvPolynomial.gradedAlgebra
      ∀ ν j : Fin (n + 1),
        ∃ h : genericPoint C ∈ (φNP ≫ projectiveSpaceOver.toIntegralAtUniverse n _) ⁻¹ᵁ
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
              (MvPolynomial.X j),
          C.presheaf.germ _ (genericPoint C) h
            ((φNP ≫ projectiveSpaceOver.toIntegralAtUniverse n _).app _
              (Proj.awayToSection
                (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
                (MvPolynomial.X j)
                (HomogeneousLocalization.Away.mk _
                  (MvPolynomial.isHomogeneous_X (ULift.{u} ℤ) j) 1 (MvPolynomial.X ν)
                  (by simpa using MvPolynomial.isHomogeneous_X (ULift.{u} ℤ) ν)))) =
            ℓ ν / ℓ j)
    (d : ℕ) (hd : 2 * (genus f : ℤ) - 2 < N * d) :
    letI : C.Over (Spec (.of k)) := ⟨f⟩
    Stacks.Picard.picardDegree f (Stacks.Zeta.topologicalKrullDim_le_one f)
      (AlgebraicGeometry.ExceptionalCurveContraction.cls (twistPb φNP d)) = N * d := by
  let : C.Over (Spec (.of k)) := ⟨f⟩
  let := functionFieldAlgebra k f
  set M := twistPb φNP d with hM
  have hMinv : Stacks.SheafOfModules.IsInvertible C.presheaf C.ringCatSheaf.2 M :=
    (inferInstance : Stacks.Ample.IsInvertibleModule C M)
  have : AlgebraicGeometry.SheafOfModules.IsInvertible C.sheaf.obj C.ringCatSheaf.property M :=
    hMinv.toAlgebraicGeometry
  obtain ⟨s, hs⟩ := exists_isRegularMeromorphicSection_of_isIntegral C M
  have hg2 : (2 : ℤ) ≤ genus f := by exact_mod_cast hg
  have hd0 : (0 : ℤ) < d := by
    rcases Nat.eq_zero_or_pos d with h | h
    · subst h; push_cast at hd; omega
    · exact_mod_cast h
  -- the coordinates `cᵥ` of the sections `φ^* T_ν^d`
  set cf : Fin (n + 1) → C.functionField := fun ν =>
    Stacks.Zeta.genericCoord C M s hs (vojtaCoordinatePow φNP d ν) with hcf
  obtain ⟨hη, -⟩ := hφℓ 0 0
  have hηU : genericPoint C ∈ chartOne φNP 0 := hη
  have hℓ0 : ∀ ν, ℓ ν ≠ 0 := hli.ne_zero
  have hc : ∀ ν, cf ν = (ℓ ν / ℓ 0) ^ d * cf 0 := fun ν => by
    rw [hcf]
    dsimp only
    rw [genericCoord_eq_of_resT M s hs hηU (resT_vojtaCoordinatePow_eq_app_pow_smul φNP d 0 ν)]
    congr 1
    obtain ⟨_, h⟩ := hφℓ ν 0
    rw [← h]
    exact map_pow ((projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k))).app
      (projChart.{u} n 0) ≫ φNP.app _ ≫
        C.presheaf.germ (chartOne φNP 0) (genericPoint C) hηU).hom _ d
  have hcf0 : cf 0 ≠ 0 := genericCoord_ne_zero M s hs (chartOne_le_nvOpen φNP 0 d hηU)
  have hcfν : ∀ ν, cf ν ≠ 0 := fun ν => by
    rw [hc ν]; exact mul_ne_zero (pow_ne_zero _ (div_ne_zero (hℓ0 ν) (hℓ0 0))) hcf0
  have hordc : ∀ ν (Q : C), C.ord (cf ν) Q =
      d * (C.ord (ℓ ν) Q - C.ord (ℓ 0) Q) + C.ord (cf 0) Q := fun ν Q => by
    rw [hc ν, Scheme.ord_mul (pow_ne_zero _ (div_ne_zero (hℓ0 ν) (hℓ0 0))) hcf0,
      ord_pow_eq (div_ne_zero (hℓ0 ν) (hℓ0 0)), ord_div_eq (hℓ0 ν) (hℓ0 0)]
  set h := ℓ 0 ^ d * (cf 0)⁻¹ with hh_def
  have hh : h ≠ 0 := mul_ne_zero (pow_ne_zero _ (hℓ0 0)) (inv_ne_zero hcf0)
  have hordh : ∀ Q : C, C.ord h Q = d * C.ord (ℓ 0) Q - C.ord (cf 0) Q := fun Q => by
    rw [hh_def, Scheme.ord_mul (pow_ne_zero _ (hℓ0 0)) (inv_ne_zero hcf0),
      ord_pow_eq (hℓ0 0), ord_inv_eq hcf0]
    ring
  have hD : Stacks.Zeta.sectionDivisor f M s hs =
      closedDivisor (((N * d : ℕ) : ℤ) • P) + Stacks.Zeta.divOf f hh := by
    ext Q
    rw [Finsupp.add_apply, Stacks.Zeta.divOf_apply, closedDivisor_apply,
      Stacks.Zeta.sectionDivisor_apply]
    obtain ⟨ν, hν⟩ := exists_mem_nonvanishingLocus_vojtaCoordinatePow φNP d Q.1
    set Z := Stacks.Zeta.primeDivisorOfClosedPoint f Q
    have hZ : Z.genericPoint = Q.1 := PrimeDivisor.genericPoint_ofCoheightOne _ _
    have : IsDiscreteValuationRing (C.presheaf.stalk Z.genericPoint) :=
      Stacks.BombieriStepanov.isDiscreteValuationRing_stalk_of_coheight_eq_one f _
        (PrimeDivisor.coheight_genericPoint Z)
    have hord := ord_genericCoord_add_eq_zero M s hs Z (vojtaCoordinatePow φNP d ν)
      (by rw [hZ]; exact (Stacks.NonvanishingOpen.mem_nonvanishingOpen _ _ _ _).mpr hν)
    rw [hZ] at hord
    -- `ord_Q ℓ_ν = -N P(Q)`, as `ℓ_ν` has the least order at `Q`
    have key := ord_eq_neg_of_forall_ord_le k f P hPclosed hP N (by omega) ℓ hℓ0 hspan Q ν
      fun μ => by
        have hm := (Stacks.Zeta.genericCoord_mem C M s hs (vojtaCoordinatePow φNP d μ)
          Z).resolve_left (hcfν μ)
        rw [hZ] at hm
        have e1 := hordc μ Q.1
        have e2 := hordc ν Q.1
        change 0 ≤ C.ord (cf μ) Q.1 + _ at hm
        change C.ord (cf ν) Q.1 + _ = 0 at hord
        exact le_of_mul_le_mul_left (by linarith) hd0
    have e1 := hordc ν Q.1
    have e2 := hordh Q.1
    change orderOfVanishingMeromorphic C M s hs Z = _
    rw [e2, Finsupp.smul_apply, smul_eq_mul]
    push_cast
    have : orderOfVanishingMeromorphic C M s hs Z = - C.ord (cf ν) Q.1 := by
      change C.ord (cf ν) Q.1 + _ = 0 at hord
      omega
    rw [this, e1, key]
    ring
  have hcl := Stacks.Zeta.divisorClass_sectionDivisor f M s hs hMinv
  rw [hD, map_add, Stacks.Zeta.divisorClass_divOf, add_zero] at hcl
  refine (congrArg (Stacks.Picard.picardDegree f (Stacks.Zeta.topologicalKrullDim_le_one f))
    hcl).symm.trans ?_
  rw [picardDegree_divisorClass_eq, sum_closedDivisor_smul f P hPclosed hP]
  push_cast
  ring

end LowerBound

/-! ### `𝒪(V)` is invertible -/

section Invertible

open MonoidalCategory
open Stacks.Ample (IsInvertibleModule)

attribute [local instance]
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.TensorSectionNonvanishing.isInvertibleModule_tensorObj

open Stacks.AlgebraicGeometry.ProjTwistTensorPow (twistOver) in
/-- `φ^*𝒪(a)` is invertible. -/
private theorem isInvertibleModule_pullback_twistOver {Y S : Scheme.{u}} {n : ℕ}
    (φ : Y ⟶ projectiveSpaceOver n S) (a : ℤ) :
    IsInvertibleModule Y ((Scheme.Modules.pullback φ).obj (twistOver n S a)) := by
  infer_instance

end Invertible

/-! ### `h⁰(C × C, 𝒪(V))` -/

/-- **Riemann–Roch for `𝒪(V)` on `C × C`**:
`h⁰(𝒪(V)) ≥ d₁ d₂ - g d² - (g - 1)(d₁ + d₂) + (g - 1)²`. The class of `𝒪(V)` is
`pr₁^*x + pr₂^*y + d [Δ]` with `deg x = d₁ - d`, `deg y = d₂ - d`, so
`(V · V) = 2 (d₁ d₂ - g d²)` and `(V · K) = (2g - 2)(d₁ + d₂)`; the term `h⁰(K - V)` vanishes
because the ample class `H = (s_B + 1)(pr₁^*P + pr₂^*P) - Δ` has
`(H · V) - (H · K) = s_B (d₁ + d₂ - 4g + 4) + 2 g d > 0`. -/
private theorem le_finrank_cohomology_vojtaLineBundle (k : Type u) [Field k] [NumberField k]
    {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
    [GeometricallyIntegral f] [IsLocallyNoetherian C] (hg : 2 ≤ genus f)
    (P : C →₀ ℤ) (hPclosed : ∀ Q ∈ P.support, IsClosed ({Q} : Set C))
    (hP : ∑ᶠ Q : C, P Q * (f.residueDegree Q : ℤ) = 1)
    (sB : ℕ) (hsB : 1 ≤ sB) (N : ℕ) (hN : 2 * genus f + 1 ≤ N) {n m : ℕ}
    (ℓ : Fin (n + 1) → C.functionField)
    (hli : letI := functionFieldAlgebra k f; LinearIndependent k ℓ)
    (hspan : letI := functionFieldAlgebra k f
      ((Submodule.span k (Set.range ℓ) : Submodule k C.functionField) : Set C.functionField) =
        {g | g = 0 ∨ ∀ Q : C, IsClosed ({Q} : Set C) → 0 ≤ C.ord g Q + ((N : ℤ) • P) Q})
    (φNP : C ⟶ projectiveSpaceOver n (Spec (.of k)))
    (hφNP : φNP ≫ (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) = f)
    (hφℓ :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ)) :=
        MvPolynomial.gradedAlgebra
      ∀ ν j : Fin (n + 1),
        ∃ h : genericPoint C ∈ (φNP ≫ projectiveSpaceOver.toIntegralAtUniverse n _) ⁻¹ᵁ
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
              (MvPolynomial.X j),
          C.presheaf.germ _ (genericPoint C) h
            ((φNP ≫ projectiveSpaceOver.toIntegralAtUniverse n _).app _
              (Proj.awayToSection
                (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
                (MvPolynomial.X j)
                (HomogeneousLocalization.Away.mk _
                  (MvPolynomial.isHomogeneous_X (ULift.{u} ℤ) j) 1 (MvPolynomial.X ν)
                  (by simpa using MvPolynomial.isHomogeneous_X (ULift.{u} ℤ) ν)))) =
            ℓ ν / ℓ j)
    (φB : pullback f f ⟶ projectiveSpaceOver m (Spec (.of k))) [IsClosedImmersion φB]
    [IsIntegral (pullback f f)]
    [Stacks.Divisors.IsEffectiveCartierDivisor (pullback.diagonal f).ker]
    [Stacks.Ample.IsInvertibleModule (pullback f f)
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
          MvPolynomial.gradedAlgebra
       (Scheme.Modules.pullback φB).obj
          ((Scheme.Modules.pullback (projectiveSpaceOver.toIntegralAtUniverse m _)).obj
            (ProjectiveSpectrum.Proj.twistingSheaf
              (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 1)))]
    (hφBB : Stacks.SheafOfModules.picardClass (pullback f f).presheaf
        (Stacks.RingedSpace.structureIsSheaf _)
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
            MvPolynomial.gradedAlgebra
         (Scheme.Modules.pullback φB).obj
            ((Scheme.Modules.pullback (projectiveSpaceOver.toIntegralAtUniverse m _)).obj
              (ProjectiveSpectrum.Proj.twistingSheaf
                (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 1))) ‹_› =
      ((sB : ℤ) + 1) • ∑ Q ∈ P.support.attach, P Q •
          (Stacks.Picard.schemePullbackClass (pullback.fst f f)
              (Stacks.Zeta.pointClass f ⟨Q, hPclosed Q Q.2⟩) +
            Stacks.Picard.schemePullbackClass (pullback.snd f f)
              (Stacks.Zeta.pointClass f ⟨Q, hPclosed Q Q.2⟩)) -
        Stacks.Divisors.picardClass (pullback.diagonal f).ker)
    (d₁ d₂ : ℤ) (δ₁ δ₂ d : ℕ) (hd : 1 ≤ d)
    (hδd₁ : d₁ + sB * d = N * δ₁) (hδd₂ : d₂ + sB * d = N * δ₂)
    (hd₁₂ : 4 * (genus f : ℤ) - 4 < d₁ + d₂) :
    d₁ * d₂ - genus f * (d : ℤ) ^ 2 - ((genus f : ℤ) - 1) * (d₁ + d₂) + ((genus f : ℤ) - 1) ^ 2 ≤
      Module.finrank k (cohomologyOverField k (pullback.fst f f ≫ f)
        (vojtaLineBundle (pullback.map f f _ _ φNP φNP (𝟙 _) (by simp [hφNP]) (by simp [hφNP]))
          φB δ₁ δ₂ d) 0) := by
  have := Stacks.Curves.smoothOfRelativeDimension_one_of_isCurve f
  have : IsSmoothProjectiveCurve k f := {}
  obtain ⟨_, _, _⟩ := IsSmoothProjectiveCurve.surface_pullback k f f
  have hP₁ : ∃ P' : {x : C // IsClosed ({x} : Set C)} →₀ ℤ,
      (P'.sum fun x n => n * (f.residueDegree x.1 : ℤ)) = 1 := by
    refine ⟨P.subtypeDomain fun x => IsClosed ({x} : Set C),
      (Finsupp.sum_subtypeDomain_index (h := fun Q n => n * (f.residueDegree Q : ℤ))
        hPclosed).trans ?_⟩
    rw [Finsupp.sum, ← hP, finsum_eq_sum_of_support_subset _ fun Q hQ => Finset.mem_coe.2 <|
      Finsupp.mem_support_iff.2 (left_ne_zero_of_mul (Function.mem_support.1 hQ))]
  have hC : topologicalKrullDim C ≤ 1 := (IsCurve.topologicalKrullDim_eq_one (k := k) (f := f)).le
  set pX := pullback.fst f f ≫ f
  set L := vojtaLineBundle (pullback.map f f _ _ φNP φNP (𝟙 _) (by simp [hφNP])
    (by simp [hφNP])) φB (δ₁ : ℤ) δ₂ d
  have hLinv : SheafOfModules.IsInvertible (pullback f f).presheaf
      (pullback f f).ringCatSheaf.2 L :=
    isInvertible_vojtaLineBundle _ _ _ _ _
  have := isInvertibleModule_vojtaLineBundle (pullback.map f f _ _ φNP φNP (𝟙 _)
    (by simp [hφNP]) (by simp [hφNP])) φB (δ₁ : ℤ) δ₂ d
  have := isInvertibleModule_pullback_twistOver φB 1
  set H := (Scheme.Modules.pullback φB).obj
    (Stacks.AlgebraicGeometry.ProjTwistTensorPow.twistOver m (Spec (.of k)) 1)
  have hHinv : SheafOfModules.IsInvertible (pullback f f).presheaf
      (pullback f f).ringCatSheaf.2 H :=
    (isInvertibleModule_pullback_twistOver φB 1 :
      Stacks.SheafOfModules.IsInvertible _ _ _).toAlgebraicGeometry
  -- the classes in play, in the basis `pr₁^*(-)`, `pr₂^*(-)`, `[Δ]`
  set q₁ := Stacks.Picard.schemePullbackClassHom (pullback.fst f f)
  set q₂ := Stacks.Picard.schemePullbackClassHom (pullback.snd f f)
  set ω := Stacks.SheafOfModules.picardClass C.presheaf C.ringCatIsSheaf
    f.relativeDifferentials (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _
      (isInvertible_relativeDifferentials f))
  have := isInvertibleModule_pullback_twistOver φNP 1
  set a : Stacks.Picard.ofScheme C := AlgebraicGeometry.ExceptionalCurveContraction.cls
    ((Scheme.Modules.pullback φNP).obj
      (Stacks.AlgebraicGeometry.ProjTwistTensorPow.twistOver n (Spec (.of k)) 1))
  set pt : Stacks.Picard.ofScheme C :=
    ∑ Q ∈ P.support.attach, P Q • Stacks.Zeta.pointClass f ⟨Q, hPclosed Q Q.2⟩ with hpt
  set D : Stacks.Picard.ofScheme (pullback f f) :=
    Stacks.Divisors.picardClass (pullback.diagonal f).ker
  have hH : Stacks.SheafOfModules.picardClass (pullback f f).presheaf
      (pullback f f).ringCatIsSheaf H
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ hHinv) =
        q₁ (((sB : ℤ) + 1) • pt) + q₂ (((sB : ℤ) + 1) • pt) + (-1 : ℤ) • D := by
    refine (Eq.trans ?_ hφBB).trans ?_
    · rfl
    · rw [map_zsmul, map_zsmul, hpt, map_sum, map_sum, ← smul_add, ← Finset.sum_add_distrib,
        neg_one_zsmul, ← sub_eq_add_neg]
      congr 2
      refine Finset.sum_congr rfl fun Q _ => ?_
      rw [map_zsmul, map_zsmul, ← smul_add]
      rfl
  have hL : Stacks.SheafOfModules.picardClass (pullback f f).presheaf
      (pullback f f).ringCatIsSheaf L
      (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _ hLinv) =
        q₁ ((δ₁ : ℤ) • a + (-((d : ℤ) * (sB + 1))) • pt) +
          q₂ ((δ₂ : ℤ) • a + (-((d : ℤ) * (sB + 1))) • pt) + (d : ℤ) • D := by
    refine (cls_vojtaLineBundle (pullback.map f f _ _ φNP φNP (𝟙 _) _ _) φB φNP
      (pullback.fst f f) (pullback.snd f f) (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _)
      (δ₁ : ℤ) δ₂ d).trans ?_
    rw [show AlgebraicGeometry.ExceptionalCurveContraction.cls H = _ from hH]
    rw [map_add, map_add]
    repeat rw [map_zsmul]
    change (δ₁ : ℤ) • q₁ a + (δ₂ : ℤ) • q₂ a - _ = _
    module
  have hK : canonicalClass pX = q₁ ω + q₂ ω + (0 : ℤ) • D := by
    rw [zero_smul, add_zero]; exact picardClass_canonical f _
  have hdω : degC f hC ω = 2 * genus f - 2 := degC_relativeDifferentials f hC
  have hda : degC f hC a = N := by
    have h := picardDegree_twistPb k f hg P hPclosed hP N hN ℓ hli hspan φNP hφℓ 1
      (by push_cast; linarith)
    rw [Nat.cast_one, mul_one] at h
    exact h
  have hdp : degC f hC pt = 1 := picardDegree_divisor f P hPclosed hP
  simp only [degC] at hda hdp
  have hdeg : ∀ e c : ℤ, degC f hC (e • a + c • pt) = e * N + c := fun e c => by
    rw [degC, AddMonoidHom.map_add, AddMonoidHom.map_zsmul, AddMonoidHom.map_zsmul, hda, hdp,
      smul_eq_mul, smul_eq_mul, mul_one]
  have hdeg' : ∀ c : ℤ, degC f hC (c • pt) = c := fun c => by
    rw [degC, AddMonoidHom.map_zsmul, hdp, smul_eq_mul, mul_one]
  have e₁ : (d₁ : ℤ) = N * δ₁ - sB * d := by linarith
  have e₂ : (d₂ : ℤ) = N * δ₂ - sB * d := by linarith
  have hg2 : (2 : ℤ) ≤ genus f := by exact_mod_cast hg
  have hsB' : (1 : ℤ) ≤ sB := by exact_mod_cast hsB
  have hd' : (1 : ℤ) ≤ d := by exact_mod_cast hd
  -- `h⁰(K ⊗ 𝓛⁻¹) = 0`
  have hvan := finrank_cohomology_adj_eq_zero pX L H
    (Scheme.Modules.isAmple_pullback_of_isClosedImmersion φB _
      ((Stacks.AmpleBridge.isAmple_iff_isAmple _ _).1
        (Stacks.ProjectiveSpace.isAmple_projectiveSpaceTwistingSheaf m (Spec (.of k))))) (by
      rw [hH, hK, hL, β_pr_pr_diagonal f (dim_le_two pX) hC hP₁,
        β_pr_pr_diagonal f (dim_le_two pX) hC hP₁]
      simp only [hdeg, hdeg', hdω]
      rw [e₁, e₂] at hd₁₂
      nlinarith [mul_le_mul_of_nonneg_left hd' (by linarith : (0 : ℤ) ≤ genus f),
        mul_lt_mul_of_pos_left hd₁₂ (by linarith : (0 : ℤ) < sB)])
  have hRR := riemannRoch_le_two_mul_finrank pX L
  rw [hvan, eulerCharacteristic_unit_pullback k f, hK, hL,
    β_pr_pr_diagonal f (dim_le_two pX) hC hP₁, β_pr_pr_diagonal f (dim_le_two pX) hC hP₁] at hRR
  simp only [hdeg, hdω] at hRR
  refine le_of_mul_le_mul_left (?_ : (2 : ℤ) * _ ≤ 2 * _) two_pos
  convert hRR using 1
  first | rfl | (rw [e₁, e₂]; push_cast; ring)

end Faltings.BombieriVojta

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Module

namespace Faltings.BombieriVojta

universe u

/-- **The dimension of `U₂ ∩ U₁`.** In the setting of
`Faltings.BombieriVojta.finrank_affineEvaluationTuples_sub_finrank_monomial_le` (a generic-enough
basis `ℓ` of `L(NP)` satisfying (G1) and (G2), `δ₁, δ₂ ≥ N - 1`, `N δᵢ > 2g - 2`, every global
section of `ψ^*𝒪(δ₁, δ₂)` the restriction of a form over `k`), let `φB : C ×_k C ⟶ ℙᵐ_k` be a
closed immersion with `[φB^*𝒪(1)] = (sB + 1)(pr₁^*[P] + pr₂^*[P]) - [Δ]` in `Pic(C ×_k C)`, let
`η_i = T_i / T_0` pulled back along `φB` be `Pη i / Qη i` with `Qη i ≠ 0`, and let `d₁, d₂, d`
be positive integers with `dᵢ + sB d = N δᵢ`. If `γ > 0`, `d₁ + d₂ > 4g - 4` and
`d₁ d₂ - g d² > γ d₁ d₂`, then
`dim (U₂ ⊓ U₁) ≥ γ d₁ d₂ - ((g - 1) N + (m + 1) N³ / 2)(δ₁ + δ₂) - (m + 1)(g - 1)²`, where
`U₂ = affineEvaluationTuplesBasicSystem pr₁ pr₂ ℓ 0 (δ₁, δ₂) (Fin (m + 1)) Pη Qη d` and
`U₁ = affineEvaluationTuplesMonomial pr₁ pr₂ ℓ 0 a b N (δ₁, δ₂) (Fin (m + 1))`. -/
@[faltings "lem_bvs_dim_u2_cap_u1"]
public theorem le_finrank_affineEvaluationTuplesBasicSystem_inf_monomial
    (k : Type u) [Field k] [NumberField k]
    {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
    [GeometricallyIntegral f] [IsLocallyNoetherian C] (hg : 2 ≤ genus f)
    (P : C →₀ ℤ) (hPclosed : ∀ Q ∈ P.support, IsClosed ({Q} : Set C))
    (hP : ∑ᶠ Q : C, P Q * (f.residueDegree Q : ℤ) = 1)
    (sB : ℕ) (hsB : 1 ≤ sB) (N : ℕ) (hN : 2 * genus f + 1 ≤ N) {n m : ℕ}
    (hn : n = N - genus f)
    (ℓ : Fin (n + 1) → C.functionField)
    (hli : letI := functionFieldAlgebra k f; LinearIndependent k ℓ)
    (hspan : letI := functionFieldAlgebra k f
      ((Submodule.span k (Set.range ℓ) : Submodule k C.functionField) : Set C.functionField) =
        {g | g = 0 ∨ ∀ Q : C, IsClosed ({Q} : Set C) → 0 ≤ C.ord g Q + ((N : ℤ) • P) Q})
    (hG1 : Faltings.BombieriSiegel.SatisfiesG1 k f ((N : ℤ) • P) ℓ)
    (hG2 : Faltings.BombieriSiegel.SatisfiesG2 k f ℓ)
    (φNP : C ⟶ projectiveSpaceOver n (Spec (.of k)))
    (hφNP : φNP ≫ (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) = f)
    [IsClosedImmersion φNP]
    (hφℓ :
      letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ)) :=
        MvPolynomial.gradedAlgebra
      ∀ ν j : Fin (n + 1),
        ∃ h : genericPoint C ∈ (φNP ≫ projectiveSpaceOver.toIntegralAtUniverse n _) ⁻¹ᵁ
            Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
              (MvPolynomial.X j),
          C.presheaf.germ _ (genericPoint C) h
            ((φNP ≫ projectiveSpaceOver.toIntegralAtUniverse n _).app _
              (Proj.awayToSection
                (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
                (MvPolynomial.X j)
                (HomogeneousLocalization.Away.mk _
                  (MvPolynomial.isHomogeneous_X (ULift.{u} ℤ) j) 1 (MvPolynomial.X ν)
                  (by simpa using MvPolynomial.isHomogeneous_X (ULift.{u} ℤ) ν)))) =
            ℓ ν / ℓ j)
    (φB : pullback f f ⟶ projectiveSpaceOver m (Spec (.of k)))
    (hφB : φB ≫ (projectiveSpaceOver m (Spec (.of k)) ↘ Spec (.of k)) = pullback.fst f f ≫ f)
    [IsClosedImmersion φB]
    [IsIntegral (pullback f f)]
    [Stacks.Divisors.IsEffectiveCartierDivisor (pullback.diagonal f).ker]
    [Stacks.Ample.IsInvertibleModule (pullback f f)
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
          MvPolynomial.gradedAlgebra
       (Scheme.Modules.pullback φB).obj
          ((Scheme.Modules.pullback (projectiveSpaceOver.toIntegralAtUniverse m _)).obj
            (ProjectiveSpectrum.Proj.twistingSheaf
              (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 1)))]
    (hφBB : Stacks.SheafOfModules.picardClass (pullback f f).presheaf
        (Stacks.RingedSpace.structureIsSheaf _)
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
            MvPolynomial.gradedAlgebra
         (Scheme.Modules.pullback φB).obj
            ((Scheme.Modules.pullback (projectiveSpaceOver.toIntegralAtUniverse m _)).obj
              (ProjectiveSpectrum.Proj.twistingSheaf
                (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) 1))) ‹_› =
      ((sB : ℤ) + 1) • ∑ Q ∈ P.support.attach, P Q •
          (Stacks.Picard.schemePullbackClass (pullback.fst f f)
              (Stacks.Zeta.pointClass f ⟨Q, hPclosed Q Q.2⟩) +
            Stacks.Picard.schemePullbackClass (pullback.snd f f)
              (Stacks.Zeta.pointClass f ⟨Q, hPclosed Q Q.2⟩)) -
        Stacks.Divisors.picardClass (pullback.diagonal f).ker)
    (hy₀ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
        MvPolynomial.gradedAlgebra
      ((φB ≫ projectiveSpaceOver.toIntegralAtUniverse m (Spec (.of k))) ⁻¹ᵁ
        Proj.basicOpen _ (MvPolynomial.X 0) : Set (pullback f f : Scheme.{u})).Nonempty)
    (Pη Qη : Fin (m + 1) → (pullback f f : Scheme.{u}).functionField) (hQη : ∀ i, Qη i ≠ 0)
    (hPη : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ)) :=
        MvPolynomial.gradedAlgebra
      haveI : Nonempty ((φB ≫ projectiveSpaceOver.toIntegralAtUniverse m (Spec (.of k))) ⁻¹ᵁ
          Proj.basicOpen _ (MvPolynomial.X 0)) := hy₀.to_subtype
      -- `η_i = T_i / T_0` pulled back along `φB`
      ∀ i, (pullback f f : Scheme.{u}).germToFunctionField _
        ((φB ≫ projectiveSpaceOver.toIntegralAtUniverse m (Spec (.of k))).app _
          (Proj.awayToSection _ (MvPolynomial.X 0)
            (HomogeneousLocalization.Away.mk
              (MvPolynomial.homogeneousSubmodule (Fin (m + 1)) (ULift.{u} ℤ))
              (MvPolynomial.isHomogeneous_X _ 0) 1 (MvPolynomial.X i)
              (by simpa using MvPolynomial.isHomogeneous_X _ i)))) = Pη i / Qη i)
    (d₁ d₂ : ℤ) (δ₁ δ₂ d : ℕ) (hd₁ : 0 < d₁) (hd₂ : 0 < d₂) (hd : 1 ≤ d)
    (hδd₁ : d₁ + sB * d = N * δ₁) (hδd₂ : d₂ + sB * d = N * δ₂)
    (hδ₀ : Function.Surjective fun G : MvPolynomial.weightedHomogeneousSubmodule k
        (Sum.elim (fun _ => ((1 : ℕ), (0 : ℕ))) (fun _ => ((0 : ℕ), (1 : ℕ))) :
          Fin (n + 1) ⊕ Fin (n + 1) → ℕ × ℕ) (δ₁, δ₂) =>
      vojtaFormRestriction
        (pullback.map f f _ _ φNP φNP (𝟙 _) (by simp [hφNP]) (by simp [hφNP])) δ₁ δ₂
        (G.1.map (Scheme.ΓSpecIso (.of k)).inv.hom))
    (hδ₁ : N - 1 ≤ δ₁) (hδ₂ : N - 1 ≤ δ₂)
    (hNδ₁ : 2 * (genus f : ℤ) - 2 < N * δ₁) (hNδ₂ : 2 * (genus f : ℤ) - 2 < N * δ₂)
    (hd₁₂ : 4 * (genus f : ℤ) - 4 < d₁ + d₂)
    (γ : ℝ) (hγ : 0 < γ) (hγd : γ * (d₁ * d₂ : ℝ) < (d₁ * d₂ : ℝ) - genus f * (d : ℝ) ^ 2)
    (a b : Fin (n + 1)) (ha : a ≠ 0) (hb : b ≠ 0) (hab : a ≠ b) :
    letI := stalkAlgebraOver k f (genericPoint C)
    letI := stalkAlgebraOver k (pullback.fst f f ≫ f) (genericPoint (pullback f f : Scheme.{u}))
    let pr₁ := functionFieldMapAlgHom k f (pullback.fst f f) (pullback.fst f f ≫ f) rfl
    let pr₂ := functionFieldMapAlgHom k f (pullback.snd f f) (pullback.fst f f ≫ f)
      pullback.condition.symm
    γ * (d₁ * d₂ : ℝ) - (((genus f : ℝ) - 1) * N + (m + 1) * (N : ℝ) ^ 3 / 2) * (δ₁ + δ₂) -
        (m + 1) * ((genus f : ℝ) - 1) ^ 2 ≤
      finrank k (affineEvaluationTuplesBasicSystem pr₁ pr₂ ℓ 0 (δ₁, δ₂) (Fin (m + 1)) Pη Qη d ⊓
        affineEvaluationTuplesMonomial pr₁ pr₂ ℓ 0 a b N (δ₁, δ₂) (Fin (m + 1)) :
          Submodule k (Fin (m + 1) → (pullback f f : Scheme.{u}).functionField)) := by
  -- `γ > 0` is a standing hypothesis of the source that the bound does not use
  have _hγ : 0 < γ := hγ
  letI := stalkAlgebraOver k f (genericPoint C)
  letI := stalkAlgebraOver k (pullback.fst f f ≫ f) (genericPoint (pullback f f : Scheme.{u}))
  intro pr₁ pr₂
  have hcod := finrank_affineEvaluationTuples_sub_finrank_monomial_le k f hg P hPclosed hP N hN
    hn ℓ hli hspan φNP hφNP hφℓ δ₁ δ₂ hδ₀ hNδ₁ hNδ₂ hG1 hG2 hδ₁ hδ₂ m a b ha hb hab
  set U₀ := affineEvaluationTuples pr₁ pr₂ ℓ 0 (δ₁, δ₂) (Fin (m + 1))
  set U₁ := affineEvaluationTuplesMonomial pr₁ pr₂ ℓ 0 a b N (δ₁, δ₂) (Fin (m + 1))
  set U₂ := affineEvaluationTuplesBasicSystem pr₁ pr₂ ℓ 0 (δ₁, δ₂) (Fin (m + 1)) Pη Qη d
  have := finite_weightedHomogeneousSubmodule k (Fin (n + 1)) (δ₁, δ₂)
  have : FiniteDimensional k U₀ := finiteDimensional_affineEvaluationTuples _ _ _ _ _ _
  have hinf : (finrank k U₂ : ℝ) + finrank k U₁ ≤ finrank k U₀ + finrank k ↥(U₂ ⊓ U₁) := by
    exact_mod_cast finrank_add_finrank_le_finrank_add_finrank_inf
      (inf_le_left : U₁ ≤ U₀) (inf_le_left : U₂ ≤ U₀)
  -- `dim U₂ = h⁰(C × C, 𝒪(V))` and Riemann–Roch on `C × C`
  have hRR : (d₁ * d₂ : ℝ) - genus f * (d : ℝ) ^ 2 - ((genus f : ℝ) - 1) * (d₁ + d₂) +
      ((genus f : ℝ) - 1) ^ 2 ≤ finrank k U₂ := by
    have hℓ0 : ℓ 0 ≠ 0 := by
      letI := functionFieldAlgebra k f
      exact hli.ne_zero 0
    have hx₀ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1))
          (ULift.{u} ℤ)) := MvPolynomial.gradedAlgebra
        ((φNP ≫ projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k))) ⁻¹ᵁ
          Proj.basicOpen _ (MvPolynomial.X 0) : Set C).Nonempty := by
      obtain ⟨h, -⟩ := hφℓ 0 0
      exact ⟨_, h⟩
    obtain ⟨e, -⟩ := exists_linearEquiv_affineEvaluationTuplesBasicSystem_of_surjective k f hg P
      hPclosed hP sB hsB N hN hn φNP hφNP φB hφB d₁ d₂ δ₁ δ₂ d hd₁ hd₂ hd hδd₁ hδd₂ hδ₀ hx₀ hy₀
      Pη Qη hQη hPη
    have key : ∀ x : Fin (n + 1) → C.functionField, (∀ ν, x ν = ℓ ν / ℓ 0) →
        affineEvaluationTuplesBasicSystem pr₁ pr₂ x 0 (δ₁, δ₂) (Fin (m + 1)) Pη Qη d = U₂ := by
      intro x hx
      rw [show x = fun ν => ℓ ν / ℓ 0 from funext hx,
        affineEvaluationTuplesBasicSystem_div _ _ _ _ hℓ0]
    letI : Module k Γ(vojtaLineBundle (pullback.map f f _ _ φNP φNP (𝟙 _) (by simp [hφNP])
        (by simp [hφNP])) φB δ₁ δ₂ d, ⊤) := Module.compHom _
      ((pullback.fst f f ≫ f).appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom)
    have hfin := e.finrank_eq
    rw [key _ fun ν => (hφℓ ν 0).choose_spec] at hfin
    rw [hfin, ← finrank_cohomologyOverField_zero]
    exact_mod_cast le_finrank_cohomology_vojtaLineBundle k f hg P hPclosed hP sB hsB N hN ℓ hli
      hspan φNP hφNP hφℓ φB hφBB d₁ d₂ δ₁ δ₂ d hd hδd₁ hδd₂ hd₁₂
  have hcodR : (finrank k U₀ : ℝ) - finrank k U₁ ≤
      (m + 1) * ((N : ℝ) ^ 3 / 2 * (δ₁ + δ₂) + ((genus f : ℝ) - 1) ^ 2) := by
    simpa using (Rat.cast_le (K := ℝ)).mpr hcod
  have hg1 : (1 : ℝ) ≤ genus f := by exact_mod_cast (show 1 ≤ genus f by omega)
  have hdδ₁ : (d₁ : ℝ) ≤ N * δ₁ := by
    have : (d₁ : ℤ) ≤ N * δ₁ := by rw [← hδd₁]; exact le_add_of_nonneg_right (by positivity)
    exact_mod_cast this
  have hdδ₂ : (d₂ : ℝ) ≤ N * δ₂ := by
    have : (d₂ : ℤ) ≤ N * δ₂ := by rw [← hδd₂]; exact le_add_of_nonneg_right (by positivity)
    exact_mod_cast this
  have h₁ : 0 ≤ ((genus f : ℝ) - 1) * (N * δ₁ - d₁) := mul_nonneg (by linarith) (by linarith)
  have h₂ : 0 ≤ ((genus f : ℝ) - 1) * (N * δ₂ - d₂) := mul_nonneg (by linarith) (by linarith)
  have h₃ : 0 ≤ ((genus f : ℝ) - 1) ^ 2 := sq_nonneg _
  linarith

end Faltings.BombieriVojta
