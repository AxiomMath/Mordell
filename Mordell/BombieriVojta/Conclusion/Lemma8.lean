/-- **Reduced representations exist.** If every element of the field `E` is a quotient of
elements of the factorial domain `R`, then the norms `Norm_{L/E} η_i` have a family of reduced
representations `U_i / V_i`, normalised by `U_0 = V_0 = 1` when `η_0 = 1`. -/
private theorem exists_isReducedNormRepresentation_of_forall_eq_div {R E L : Type*} [CommRing R]
    [IsDomain R] [UniqueFactorizationMonoid R] [Field E] [Field L] [Algebra R E] [Algebra E L]
    (hdiv : ∀ z : E, ∃ r s : R, algebraMap R E s ≠ 0 ∧ z = algebraMap R E r / algebraMap R E s)
    {m : ℕ} (η : Fin (m + 1) → L) (hη : η 0 = 1) :
    ∃ U V : Fin (m + 1) → R, IsReducedNormRepresentation (K := E) R η U V := by
  classical
  have key : ∀ z : E, ∃ u v : R, v ≠ 0 ∧ IsRelPrime u v ∧
      z = algebraMap R E u / algebraMap R E v := by
    intro z
    obtain ⟨r, s, hs, rfl⟩ := hdiv z
    have hs' : s ≠ 0 := fun h => hs (by rw [h, map_zero])
    obtain ⟨a', b', c', hrel, hc₁, hc₂⟩ := UniqueFactorizationMonoid.exists_reduced_factors s hs' r
    have hc : algebraMap R E c' ≠ 0 := fun h => hs (by rw [← hc₁, map_mul, h, zero_mul])
    refine ⟨b', a', fun h => hs' (by rw [← hc₁, h, mul_zero]), hrel.symm, ?_⟩
    rw [← hc₁, ← hc₂, map_mul, map_mul, mul_div_mul_left _ _ hc]
  choose u v hv hrel huv using key
  refine ⟨fun i => if i = 0 then 1 else u (Algebra.norm E (η i)),
    fun i => if i = 0 then 1 else v (Algebra.norm E (η i)), ?_⟩
  refine ⟨fun i => ?_, fun i => ?_, fun i => ?_, by simp, by simp⟩
  · by_cases hi : i = 0 <;> simp [hi, hv]
  · by_cases hi : i = 0
    · simp [hi, isRelPrime_one_left]
    · simpa [hi] using hrel _
  · by_cases hi : i = 0
    · simp [hi, hη]
    · simpa [hi] using huv _

/-- The algebra structure on `K⟮t, u⟯` over `K[X₀, X₁]` sending `X₀ ↦ t`, `X₁ ↦ u`. -/
private noncomputable abbrev pairAlgebra (K : Type*) {L : Type*} [Field K] [Field L]
    [Algebra K L] (t u : L) :
    Algebra (MvPolynomial (Fin 2) K) (IntermediateField.adjoin K {t, u}) :=
  (MvPolynomial.aeval ![(⟨t, IntermediateField.subset_adjoin K _ (by simp)⟩ :
    IntermediateField.adjoin K {t, u}),
      ⟨u, IntermediateField.subset_adjoin K _ (by simp)⟩]).toRingHom.toAlgebra

private theorem pairAlgebra_apply (K : Type*) {L : Type*} [Field K] [Field L] [Algebra K L]
    (t u : L) (p : MvPolynomial (Fin 2) K) :
    letI := pairAlgebra K t u
    (algebraMap (MvPolynomial (Fin 2) K) (IntermediateField.adjoin K {t, u}) p : L) =
      MvPolynomial.aeval ![t, u] p := by
  change (IntermediateField.adjoin K {t, u}).val (MvPolynomial.aeval _ p) = _
  rw [MvPolynomial.comp_aeval_apply]
  congr 2
  funext i
  fin_cases i <;> rfl

/-- Every element of `K⟮t, u⟯` is a quotient of polynomials in `t, u`. -/
private theorem exists_eq_div_pairAlgebra (K : Type*) {L : Type*} [Field K] [Field L]
    [Algebra K L] (t u : L) (z : IntermediateField.adjoin K {t, u}) :
    letI := pairAlgebra K t u
    ∃ r s : MvPolynomial (Fin 2) K,
      algebraMap _ (IntermediateField.adjoin K {t, u}) s ≠ 0 ∧
      z = algebraMap _ (IntermediateField.adjoin K {t, u}) r /
        algebraMap _ (IntermediateField.adjoin K {t, u}) s := by
  letI := pairAlgebra K t u
  by_cases hz : z = 0
  · exact ⟨0, 1, by simp, by simp [hz]⟩
  have hset : ({t, u} : Set L) = Set.range ![t, u] := by
    rw [Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty,
      Set.singleton_union]
  obtain ⟨r, hr, s, hs, hzrs⟩ := IntermediateField.mem_adjoin_iff_div.mp z.2
  rw [hset, Algebra.adjoin_range_eq_range_aeval] at hr hs
  obtain ⟨p, rfl⟩ := hr
  obtain ⟨q, rfl⟩ := hs
  have hq : (MvPolynomial.aeval ![t, u] q : L) ≠ 0 := by
    intro h
    apply hz
    apply Subtype.ext
    simp [hzrs, h]
  refine ⟨p, q, fun h => hq ?_, Subtype.ext ?_⟩
  · rw [← pairAlgebra_apply K t u q, h]; rfl
  · rw [hzrs, IntermediateField.coe_div, pairAlgebra_apply, pairAlgebra_apply]
    rfl

/-- The absolute height of a point of `ℙ(K^ι)` with coordinates in a number field `F ⊆ K` is the
logarithmic height of the coordinates over `F`, divided by `[F : ℚ]`. -/
private theorem weilHeight_mk_algebraMap_comp {K : Type*} [Field K] [Algebra ℚ K]
    [Algebra.IsAlgebraic ℚ K] {F : Type*} [Field F] [NumberField F] [Algebra F K]
    {ι : Type*} [Fintype ι] [LinearOrder ι] (v : ι → F) (hv : algebraMap F K ∘ v ≠ 0) :
    weilHeight (Projectivization.mk K (algebraMap F K ∘ v) hv) =
      Height.logHeight v / Module.finrank ℚ F := by
  rw [weilHeight_eq_sumLocalHeight hv rfl, sumLocalHeight_eq_logHeight]
  rintro rfl
  exact hv (by ext; simp)

/-- A subfield of an algebraic extension of `ℚ` generated by finitely many elements is a number
field. -/
private theorem numberField_adjoin_of_finite {K : Type*} [Field K] [Algebra ℚ K]
    [Algebra.IsAlgebraic ℚ K] {S : Set K} (hS : S.Finite) :
    NumberField (IntermediateField.adjoin ℚ S) :=
  have : Finite S := hS.to_subtype
  have hfin : FiniteDimensional ℚ (IntermediateField.adjoin ℚ S) :=
    IntermediateField.finiteDimensional_adjoin fun r _ =>
      (Algebra.IsAlgebraic.isAlgebraic r).isIntegral
  { to_finiteDimensional := by convert hfin; exact Subsingleton.elim _ _ }

/-- **A large affine coordinate**, with absolute heights: if `c 0 = 1`, some affine coordinate
`c a` (`1 ≤ a ≤ n`) has height at least `h(c) / n`. -/
private theorem exists_weilHeight_div_le {K : Type*} [Field K] [Algebra ℚ K]
    [Algebra.IsAlgebraic ℚ K] {n : ℕ} [NeZero n] (c : Fin (n + 1) → K) (hc : c 0 = 1) :
    ∃ a : Fin n,
      weilHeight (Projectivization.mk K c fun h => by simpa [hc] using congrFun h 0) / n ≤
        weilHeight (Projectivization.mk K ![c a.succ, 1] fun h => by simpa using congrFun h 1) := by
  have hS : (Set.range c).Finite := Set.finite_range c
  letI := numberField_adjoin_of_finite hS
  let F := IntermediateField.adjoin ℚ (Set.range c)
  let v : Fin (n + 1) → F := fun i => ⟨c i, IntermediateField.subset_adjoin ℚ _ ⟨i, rfl⟩⟩
  have hv0 : v 0 = 1 := Subtype.ext hc
  obtain ⟨a, ha⟩ := exists_logHeight_div_le_logHeight₁_div v (by rw [hv0]; exact one_ne_zero)
  refine ⟨a, ?_⟩
  have e1 : (Projectivization.mk K c fun h => by simpa [hc] using congrFun h 0) =
      Projectivization.mk K (algebraMap F K ∘ v) (fun h => by simpa [v, hc] using congrFun h 0) :=
    rfl
  have e2 : (Projectivization.mk K ![c a.succ, 1] fun h => by simpa using congrFun h 1) =
      Projectivization.mk K (algebraMap F K ∘ ![v a.succ, 1])
        (fun h => by simpa using congrFun h 1) := by
    congr 1
    funext i
    fin_cases i <;> rfl
  rw [e1, e2, weilHeight_mk_algebraMap_comp, weilHeight_mk_algebraMap_comp, div_right_comm]
  rw [hv0, div_one, Height.logHeight₁_eq_logHeight] at ha
  exact div_le_div_of_nonneg_right ha (Nat.cast_nonneg _)

private lemma iSup_abv_finsupp_eq {K α : Type*} [Field K] (v : AbsoluteValue K ℝ) (x : α →₀ K)
    (hx : x ≠ 0) : (⨆ i, v (x i)) = ⨆ i : x.support, v (x i) := by
  obtain ⟨i₀, hi₀⟩ : ∃ i, x i ≠ 0 := by
    by_contra h; push Not at h; exact hx (Finsupp.ext h)
  have : Nonempty α := ⟨i₀⟩
  have : Nonempty x.support := ⟨⟨i₀, Finsupp.mem_support_iff.mpr hi₀⟩⟩
  have hbdd : BddAbove (Set.range fun i : x.support => v (x i)) := (Set.finite_range _).bddAbove
  have hnn : 0 ≤ ⨆ i : x.support, v (x i) :=
    (v.nonneg _).trans (le_ciSup hbdd (⟨i₀, Finsupp.mem_support_iff.mpr hi₀⟩ : x.support))
  have hle : ∀ i, v (x i) ≤ ⨆ i : x.support, v (x i) := fun i => by
    by_cases hi : x i = 0
    · rw [hi, map_zero]; exact hnn
    · exact le_ciSup hbdd (⟨i, Finsupp.mem_support_iff.mpr hi⟩ : x.support)
  have hbdd' : BddAbove (Set.range fun i => v (x i)) := ⟨_, by rintro _ ⟨j, rfl⟩; exact hle j⟩
  exact le_antisymm (ciSup_le hle) (ciSup_le fun i => le_ciSup hbdd' (i : α))

/-- The multiplicative height of a finitely supported function, read as a function on its
(possibly infinite) domain, is the height of its restriction to its support. -/
private theorem mulHeight_coe_finsupp {K α : Type*} [Field K] [Height.AdmissibleAbsValues K]
    (x : α →₀ K) : Height.mulHeight ⇑x = Height.mulHeight (fun i : x.support => x i) := by
  by_cases hx : x = 0
  · subst hx
    haveI : Subsingleton (↥(0 : α →₀ K).support) := by
      rw [Finsupp.support_zero]; infer_instance
    rw [Finsupp.coe_zero, Height.mulHeight_zero]
    exact (Height.mulHeight_eq_one_of_subsingleton _).symm
  have hx1 : (⇑x : α → K) ≠ 0 := fun h => hx (Finsupp.ext (congrFun h))
  obtain ⟨i₀, hi₀⟩ : ∃ i, x i ≠ 0 := Function.ne_iff.mp hx1
  have hx2 : (fun i : x.support => x i) ≠ 0 :=
    Function.ne_iff.mpr ⟨⟨i₀, Finsupp.mem_support_iff.mpr hi₀⟩, hi₀⟩
  simp [Height.mulHeight_eq hx1, Height.mulHeight_eq hx2, iSup_abv_finsupp_eq _ x hx]

/-- The absolute height of a polynomial with coefficients in a number field `F ⊆ K` is the
height of its coefficients over `F`, divided by `[F : ℚ]`. -/
private theorem mvPolynomialHeight_map_eq {K F σ : Type*} [Field K] [Algebra ℚ K]
    [Algebra.IsAlgebraic ℚ K] [Field F] [NumberField F] [Algebra F K] (P : MvPolynomial σ F)
    (hP : MvPolynomial.map (algebraMap F K) P ≠ 0) :
    mvPolynomialHeight (MvPolynomial.map (algebraMap F K) P) hP =
      Finsupp.logHeight (AddMonoidAlgebra.coeff P) / Module.finrank ℚ F := by
  unfold mvPolynomialHeight polynomialFamilyHeight
  letI : LinearOrder (Σ _ : Unit, (MvPolynomial.map (algebraMap F K) P).support) :=
    IsWellOrder.linearOrder WellOrderingRel
  let y : (Σ _ : Unit, (MvPolynomial.map (algebraMap F K) P).support) → F :=
    fun p => P.coeff p.2.1
  have hy : algebraMap F K ∘ y = fun p => (MvPolynomial.map (algebraMap F K) P).coeff p.2.1 := by
    funext p; simp [y, MvPolynomial.coeff_map]
  obtain ⟨J, hJ⟩ := MvPolynomial.ne_zero_iff.mp hP
  have hy0 : algebraMap F K ∘ y ≠ 0 := by
    rw [hy]
    exact Function.ne_iff.mpr ⟨⟨(), J, MvPolynomial.mem_support_iff.mpr hJ⟩, hJ⟩
  rw [weilHeight_eq_sumLocalHeight hy0 (by simp only [hy]),
    sumLocalHeight_eq_logHeight (fun h => hy0 (by rw [h]; ext; simp))]
  congr 1
  have hinj : Function.Injective (algebraMap F K) := (algebraMap F K).injective
  have hsupp := MvPolynomial.support_map_of_injective P hinj
  let e : (Σ _ : Unit, (MvPolynomial.map (algebraMap F K) P).support) ≃
      (AddMonoidAlgebra.coeff P).support :=
    { toFun := fun p => ⟨p.2.1, show _ ∈ P.support from (Finset.ext_iff.1 hsupp _).1 p.2.2⟩
      invFun := fun J => ⟨(), J.1, (Finset.ext_iff.1 hsupp _).2 J.2⟩
      left_inv := fun p => rfl
      right_inv := fun J => rfl }
  unfold Finsupp.logHeight
  rw [mulHeight_coe_finsupp, ← Height.mulHeight_comp_equiv e, Height.logHeight_eq_log_mulHeight]
  rfl

/-- Divided derivatives commute with a change of coefficients. -/
private theorem hasseDeriv_map {R S σ : Type*} [CommSemiring R] [CommSemiring S] (f : R →+* S)
    (I : σ →₀ ℕ) (p : MvPolynomial σ R) :
    Faltings.MvPolynomial.hasseDeriv I (MvPolynomial.map f p) =
      MvPolynomial.map f (Faltings.MvPolynomial.hasseDeriv I p) := by
  induction p using MvPolynomial.induction_on' with
  | add p q hp hq => simp only [map_add, hp, hq]
  | monomial J r =>
    rw [MvPolynomial.map_monomial, Faltings.MvPolynomial.hasseDeriv_monomial,
      Faltings.MvPolynomial.hasseDeriv_monomial, MvPolynomial.smul_monomial,
      MvPolynomial.smul_monomial, MvPolynomial.map_monomial]
    simp

section Taylor

open _root_.MvPolynomial

variable {R : Type*} [CommRing R]

private theorem C_add_X_pow_eq_sum (μ : Fin 2) (a : R) (j : ℕ) :
    (C a + X μ : MvPolynomial (Fin 2) R) ^ j =
      ∑ k ∈ Finset.range (j + 1),
        monomial (Finsupp.single μ k) (a ^ (j - k) * (j.choose k : R)) := by
  rw [add_comm, add_pow]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [X_pow_eq_monomial, ← C_pow, ← map_natCast C, mul_assoc, ← map_mul, mul_comm,
    C_mul_monomial, mul_one]

private theorem single_add_single_eq_iff (k l : ℕ) (I : Fin 2 →₀ ℕ) :
    Finsupp.single (0 : Fin 2) k + Finsupp.single 1 l = I ↔ k = I 0 ∧ l = I 1 := by
  constructor
  · rintro rfl; simp
  · rintro ⟨rfl, rfl⟩
    ext μ; fin_cases μ <;> simp

/-- **Taylor coefficients in two variables**: the coefficient of `τ^I` in `Q(x + τ)` is the
value at `x` of the divided derivative `∂_I Q`. -/
private theorem coeff_aeval_C_add_X_two (Q : MvPolynomial (Fin 2) R) (x : Fin 2 → R)
    (I : Fin 2 →₀ ℕ) :
    (aeval (fun μ => C (x μ) + X μ) Q).coeff I = eval x (Faltings.MvPolynomial.hasseDeriv I Q) := by
  induction Q using MvPolynomial.induction_on' with
  | add p q hp hq => simp only [map_add, MvPolynomial.coeff_add, hp, hq]
  | monomial J r =>
    rw [Faltings.MvPolynomial.hasseDeriv_monomial, aeval_monomial, Finsupp.prod_fintype _ _
      (fun _ => pow_zero _), Fin.prod_univ_two, C_add_X_pow_eq_sum, C_add_X_pow_eq_sum,
      Finset.sum_mul_sum, Finset.mul_sum, coeff_sum]
    simp only [Finset.mul_sum, coeff_sum, monomial_mul_monomial, algebraMap_eq, C_mul_monomial,
      coeff_monomial, single_add_single_eq_iff]
    have hprod : (∏ μ ∈ I.support, (J μ).choose (I μ)) =
        (J 0).choose (I 0) * (J 1).choose (I 1) := by
      rw [Finset.prod_subset (Finset.subset_univ _) (fun μ _ hμ => by
        rw [Finsupp.notMem_support_iff.mp hμ, Nat.choose_zero_right]), Fin.prod_univ_two]
    rw [hprod, smul_eval, eval_monomial, Finsupp.prod_fintype _ _
      (fun _ => pow_zero _), Fin.prod_univ_two]
    simp only [Finsupp.coe_tsub, Pi.sub_apply]
    rw [Finset.sum_eq_single (I 0), Finset.sum_eq_single (I 1)]
    · simp only [and_self, ite_true]
      push_cast; ring
    · intro l _ hl; rw [ite_eq_right fun h => hl h.2]
    · intro hl; rw [Finset.mem_range, not_lt] at hl
      simp [Nat.choose_eq_zero_of_lt (show J 1 < I 1 by omega)]
    · intro k _ hk; exact Finset.sum_eq_zero fun l _ => ite_eq_right fun h => hk h.1
    · intro hk; rw [Finset.mem_range, not_lt] at hk
      simp [Nat.choose_eq_zero_of_lt (show J 0 < I 0 by omega)]

end Taylor

/-- **Roth's Lemma in two variables**, for a polynomial with coefficients in a number field
`F ⊆ K`, with heights read in `K`. -/
private theorem exists_eval_hasseDeriv_ne_zero_of_roth_map {K F : Type*} [Field K]
    [Algebra ℚ K] [Algebra.IsAlgebraic ℚ K] [Field F] [NumberField F] [Algebra F K]
    (T : MvPolynomial (Fin 2) F) (hT : MvPolynomial.map (algebraMap F K) T ≠ 0) (r₁ r₂ : ℕ)
    (hr₁ : 0 < r₁) (hr₂ : 0 < r₂) (h₁ : T.degreeOf 0 ≤ r₁) (h₂ : T.degreeOf 1 ≤ r₂)
    (ς : Fin 2 → F) {ε : ℝ} (hε : 0 < ε) (hratio : (r₂ : ℝ) / r₁ ≤ ε ^ 2)
    (hZ : ∀ μ : Fin 2, (ε ^ 2)⁻¹ * (mvPolynomialHeight _ hT + 4 * r₁) ≤
      ![r₁, r₂] μ * weilHeight (Projectivization.mk K (algebraMap F K ∘ ![ς μ, 1])
        fun h => one_ne_zero ((algebraMap F K).injective
          ((congrFun h 1).trans (map_zero _).symm)))) :
    ∃ i : ℕ × ℕ, MvPolynomial.eval ς (Faltings.MvPolynomial.hasseDeriv
        (Finsupp.single 0 i.1 + Finsupp.single 1 i.2) T) ≠ 0 ∧
      (i.1 : ℝ) / r₁ + i.2 / r₂ ≤ 4 * ε := by
  classical
  have hT₀ : T ≠ 0 := fun h => hT (by rw [h, map_zero])
  have hdeg : ∀ μ, T.degreeOf μ ≤ ![r₁, r₂] μ := by
    intro μ; fin_cases μ
    · exact h₁
    · exact h₂
  obtain ⟨I, hI, hIε⟩ := exists_eval_dividedDeriv_ne_zero_of_roth (m := 2) T hT₀ ![r₁, r₂]
    (fun μ => by fin_cases μ <;> assumption) hdeg ς hε
    (fun μ hμ => by
      have hμ0 : μ = 0 := by ext; simp at hμ ⊢; omega
      subst hμ0
      simpa using hratio)
    (fun μ => by
      have := hZ μ
      rw [mvPolynomialHeight_map_eq, weilHeight_mk_algebraMap_comp,
        ← Height.logHeight₁_eq_logHeight] at this
      convert this using 4 <;> simp <;> norm_num)
  refine ⟨(I 0, I 1), ?_, ?_⟩
  · let I' : Fin 2 →₀ ℕ := Finsupp.equivFunOnFinite.symm I
    have hI' : I' = Finsupp.single 0 (I 0) + Finsupp.single 1 (I 1) := by
      ext μ; fin_cases μ <;> simp [I']
    have key := Faltings.MvPolynomial.coeff_aeval_C_add_X T ς I'
    change MvPolynomial.eval ς (Faltings.MvPolynomial.hasseDeriv
      (Finsupp.single 0 (I 0) + Finsupp.single 1 (I 1)) T) ≠ 0
    rw [← hI', ← coeff_aeval_C_add_X_two, key]
    simpa [I'] using hI
  · simp only [Fin.sum_univ_two] at hIε
    norm_num at hIε ⊢
    linarith

/-- **Roth's Lemma in two variables over an algebraic extension `K` of `ℚ`**, with absolute
heights: if `T ≠ 0` has degrees at most `r₁, r₂`, `r₂ / r₁ ≤ ε²` and
`r_μ h(ς_μ) ≥ ε⁻² (h(T) + 4 r₁)`, then some divided derivative `∂_{(i₁, i₂)} T` does not vanish
at `ς`, with `i₁ / r₁ + i₂ / r₂ ≤ 4 ε`. -/
private theorem exists_eval_hasseDeriv_ne_zero_of_roth {K : Type*} [Field K] [Algebra ℚ K]
    [Algebra.IsAlgebraic ℚ K] (T : MvPolynomial (Fin 2) K) (hT : T ≠ 0) (r₁ r₂ : ℕ)
    (hr₁ : 0 < r₁) (hr₂ : 0 < r₂) (h₁ : T.degreeOf 0 ≤ r₁) (h₂ : T.degreeOf 1 ≤ r₂)
    (ς : Fin 2 → K) {ε : ℝ} (hε : 0 < ε) (hratio : (r₂ : ℝ) / r₁ ≤ ε ^ 2)
    (hZ : ∀ μ : Fin 2, (ε ^ 2)⁻¹ * (mvPolynomialHeight T hT + 4 * r₁) ≤
      ![r₁, r₂] μ * weilHeight (Projectivization.mk K ![ς μ, 1]
        fun h => one_ne_zero (congrFun h 1 : (1 : K) = 0))) :
    ∃ i : ℕ × ℕ, MvPolynomial.eval ς (Faltings.MvPolynomial.hasseDeriv
        (Finsupp.single 0 i.1 + Finsupp.single 1 i.2) T) ≠ 0 ∧
      (i.1 : ℝ) / r₁ + i.2 / r₂ ≤ 4 * ε := by
  classical
  let S : Set K := (Set.range fun J : T.support => T.coeff J) ∪ Set.range ς
  have hS : S.Finite := (Set.finite_range _).union (Set.finite_range _)
  letI := numberField_adjoin_of_finite hS
  obtain ⟨T₀, hTT⟩ : T ∈ Set.range
      (MvPolynomial.map (algebraMap (IntermediateField.adjoin ℚ S) K)) := by
    rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
    intro c hc
    obtain ⟨J, hJ, rfl⟩ : ∃ J, ¬ T.coeff J = 0 ∧ T.coeff J = c := by
      simpa [MvPolynomial.coeffs] using hc
    exact ⟨⟨_, IntermediateField.subset_adjoin ℚ S
      (Or.inl ⟨⟨J, MvPolynomial.mem_support_iff.mpr hJ⟩, rfl⟩)⟩, rfl⟩
  let ς₀ : Fin 2 → IntermediateField.adjoin ℚ S :=
    fun μ => ⟨ς μ, IntermediateField.subset_adjoin ℚ S (Or.inr ⟨μ, rfl⟩)⟩
  have hς : ς = algebraMap _ K ∘ ς₀ := rfl
  have hinj : Function.Injective (algebraMap (IntermediateField.adjoin ℚ S) K) :=
    RingHom.injective (algebraMap (IntermediateField.adjoin ℚ S) K)
  have hdeg : ∀ μ, T₀.degreeOf μ = T.degreeOf μ := fun μ => by
    rw [← hTT]; simp only [MvPolynomial.degreeOf, MvPolynomial.degrees_map_of_injective _ hinj]
  rw [hς] at hZ ⊢
  have key : ∀ (T' : MvPolynomial (Fin 2) K) (hT' : T' ≠ 0),
      MvPolynomial.map (algebraMap (IntermediateField.adjoin ℚ S) K) T₀ = T' →
      (∀ μ : Fin 2, (ε ^ 2)⁻¹ * (mvPolynomialHeight T' hT' + 4 * r₁) ≤
        ![r₁, r₂] μ * weilHeight (Projectivization.mk K ![(algebraMap _ K ∘ ς₀) μ, 1]
          fun h => one_ne_zero (congrFun h 1 : (1 : K) = 0))) →
      ∃ i : ℕ × ℕ, MvPolynomial.eval (algebraMap _ K ∘ ς₀) (Faltings.MvPolynomial.hasseDeriv
        (Finsupp.single 0 i.1 + Finsupp.single 1 i.2) T') ≠ 0 ∧
      (i.1 : ℝ) / r₁ + i.2 / r₂ ≤ 4 * ε := by
    rintro _ hT' rfl hZ'
    obtain ⟨i, hi, hiε⟩ := exists_eval_hasseDeriv_ne_zero_of_roth_map T₀ hT' r₁ r₂ hr₁ hr₂
      ((hdeg 0).trans_le h₁) ((hdeg 1).trans_le h₂) ς₀ hε hratio (fun μ => by
        convert hZ' μ using 4
        funext j; fin_cases j <;> simp)
    refine ⟨i, ?_, hiε⟩
    rw [hasseDeriv_map, ← MvPolynomial.map_eval]
    exact (map_ne_zero_iff _ hinj).mpr hi
  exact key T hT hTT hZ

section IntegralityHelpers

open IntermediateField

variable {k : Type u} [Field k] {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f]

variable [IsLocallyNoetherian C]

/-- Under (G1), every affine coordinate `x_ν / x_0` is integral over `k[x_a / x_0]`, `a ≠ 0`:
it is regular wherever `x_a / x_0` is, since `x_0` and `x_a` have no common zero. -/
private lemma isIntegral_adjoin_div_div [CharZero k] [Smooth f] [IsProper f]
    [GeometricallyIrreducible f] (D : C →₀ ℤ) {n : ℕ} (x : Fin (n + 1) → C.functionField)
    (hli : letI := functionFieldAlgebra k f; LinearIndependent k x)
    (hxD : ∀ j Q, 0 ≤ C.ord (x j) Q + D Q) (hG1 : SatisfiesG1 k f D x) {a : Fin (n + 1)}
    (ha : a ≠ 0) (ν : Fin (n + 1)) :
    letI := functionFieldAlgebra k f
    IsIntegral (Algebra.adjoin k {x a / x 0}) (x ν / x 0) := by
  letI := functionFieldAlgebra k f
  have hx : ∀ j, x j ≠ 0 := hli.ne_zero
  have : GeometricallyReduced f := geometricallyReduced_of_smooth f
  have : GeometricallyIntegral f := .of_geometricallyReduced_of_geometricallyIrreducible _
  refine isIntegral_adjoin_of_ord_nonneg f (FunctionField.transcendental_of_notMem_range f
    (div_notMem_range_algebraMap hli ha)) fun Q hQ hξ => ?_
  have hG := hG1 a ha Q hQ
  have h0 := hxD 0 Q
  have ha' := hxD a Q
  have hν := hxD ν Q
  rw [Faltings.ord_div (hx a) (hx 0)] at hξ
  rw [Faltings.ord_div (hx ν) (hx 0)]
  omega

end IntegralityHelpers

section Bidegree

open Faltings.BombieriVojta

open Classical in
/-- **The bidegree of `T_i`** (Bombieri). In the setting of
`Faltings.BombieriRoth.exists_aeval_eq_formNorm_of_isVojtaRepresentative`, let `s ≠ 0` be a
global section of `𝒪(V) = Faltings.vojtaLineBundle ψ φB δ₁ δ₂ d` with a representative `F` with
coefficients in `k`, where `N δᵢ = dᵢ + sB d`. Let `1 ≤ a, b ≤ n`, let `R = k[X₀, X₁]` map to
`k⟮ξ_a, ξ'_b⟯` by `X₀ ↦ ξ_a`, `X₁ ↦ ξ'_b`, and let `(U, V)` be a family of reduced
representations of the norms of `ηᵢ = y i / y 0`. Then for `i ≠ 0`,
`T_i = Faltings.BombieriRoth.polynomialT … i` is the image of a non-zero polynomial `T` of degree
at most `N d₁` in `X₀` and at most `N d₂` in `X₁`. -/
private theorem exists_degreeOf_le_algebraMap_eq_polynomialT_of_charZero (k : Type u) [Field k]
    [CharZero k] {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f]
    [IsProjectiveVariety k f] [Smooth f] [GeometricallyIntegral f] [IsLocallyNoetherian C]
    (hg : 2 ≤ AlgebraicGeometry.genus f) (P₁ : C →₀ ℤ)
    (hP₁cl : ∀ Q ∈ P₁.support, IsClosed ({Q} : Set C))
    (hP₁ : ∑ᶠ Q : C, P₁ Q * (f.residueDegree Q : ℤ) = 1) (N : ℕ)
    (hN : 2 * AlgebraicGeometry.genus f + 1 ≤ N)
    {n : ℕ} (hn : n = N - AlgebraicGeometry.genus f) (x : Fin (n + 1) → C.functionField)
    (hli : letI := functionFieldAlgebra k f; LinearIndependent k x)
    (hspan : letI := functionFieldAlgebra k f
      ((Submodule.span k (Set.range x) : Submodule k C.functionField) : Set C.functionField) =
        {g | g = 0 ∨ ∀ Q : C, IsClosed ({Q} : Set C) → 0 ≤ C.ord g Q + ((N : ℤ) • P₁) Q})
    -- (N): the basis `x` is generic
    (hG1 : SatisfiesG1 k f ((N : ℤ) • P₁) x) (hG2 : SatisfiesG2 k f x)
    (hG3 : SatisfiesG3 k f x)
    -- the product `X = C ×_k C` with its projections and diagonal
    {X : Scheme.{u}} {pr₁ pr₂ : X ⟶ C} (hX : IsPullback pr₁ pr₂ f f) [IsIntegral X]
    [IsLocallyNoetherian X] (Δ : C ⟶ X) (hΔ₁ : Δ ≫ pr₁ = 𝟙 C) (hΔ₂ : Δ ≫ pr₂ = 𝟙 C)
    -- the embedding `φ_{NP}` given by `x`, and `ψ = φ_{NP} × φ_{NP}`
    (φNP : C ⟶ projectiveSpaceOver n (Spec (.of k))) [IsClosedImmersion φNP]
    (hφNP : φNP ≫ (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) = f)
    (hφNPx : letI : ∀ r : ℕ,
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) (ULift.{u} ℤ)) :=
        fun _ => MvPolynomial.gradedAlgebra
      -- the chart `φNP⁻¹ D₊(T_j)` of `C`
      let U : Fin (n + 1) → C.Opens := fun j =>
        φNP ⁻¹ᵁ (projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k)) ⁻¹ᵁ
          Proj.basicOpen _ (MvPolynomial.X j))
      ∀ (j ν : Fin (n + 1)) [Nonempty (U j)],
        (C.germToFunctionField (U j)).hom
          (φNP.app _ ((projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k))).app _
            (Proj.awayToSection _ (MvPolynomial.X j)
              (HomogeneousLocalization.Away.mk
                (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
                (MvPolynomial.isHomogeneous_X _ j) 1 (MvPolynomial.X ν)
                (by simpa using MvPolynomial.isHomogeneous_X _ ν))))) =
          x ν / x j)
    (ψ : X ⟶ pullback (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k))
      (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)))
    (hψ₁ : ψ ≫ pullback.fst _ _ = pr₁ ≫ φNP)
    (hψ₂ : ψ ≫ pullback.snd _ _ = pr₂ ≫ φNP)
    -- the `k`-structures of `k(C)`, `k(C × C)` and the pull-backs `pr₁^*`, `pr₂^*`
    [Algebra k C.functionField] (hkC : ‹Algebra k C.functionField› = functionFieldAlgebra k f)
    [Algebra k X.functionField]
    (hkX : ∀ c : k, algebraMap k X.functionField c =
      X.presheaf.germ ⊤ (genericPoint X) trivial
        ((pr₁ ≫ f).appTop ((Scheme.ΓSpecIso (.of k)).inv c)))
    (ι₁ ι₂ : C.functionField →ₐ[k] X.functionField)
    (hι₁ : ∀ (U : C.Opens) [Nonempty U] [Nonempty (pr₁ ⁻¹ᵁ U)] (t : Γ(C, U)),
      ι₁ (C.germToFunctionField U t) = X.germToFunctionField (pr₁ ⁻¹ᵁ U) (pr₁.app U t))
    (hι₂ : ∀ (U : C.Opens) [Nonempty U] [Nonempty (pr₂ ⁻¹ᵁ U)] (t : Γ(C, U)),
      ι₂ (C.germToFunctionField U t) = X.germToFunctionField (pr₂ ⁻¹ᵁ U) (pr₂.app U t))
    -- the very ample divisor `B` on `C × C`, and the basis `y` of `H⁰(𝒪(B))` giving `φ_B`
    (sB : ℕ) (hsB : 1 ≤ sB) {eΔ : X} (heΔ : IsGenericPoint eΔ (Set.range Δ.base))
    (B : X → ℤ) (hB : ∀ w : X, B w =
      (sB + 1 : ℤ) * P₁.sum (fun c a => if IsGenericPoint w (pr₁.base ⁻¹' {c}) then a else 0) +
      (sB + 1 : ℤ) * P₁.sum (fun c a => if IsGenericPoint w (pr₂.base ⁻¹' {c}) then a else 0) -
      (if w = eΔ then 1 else 0))
    {m : ℕ} (y : Fin (m + 1) → X.functionField) (hy : ∀ i, y i ≠ 0)
    (hD : ∀ i (w : X), 0 ≤ X.ord (y i) w + B w)
    (hyli : LinearIndependent k y)
    (hyspan : ∀ h : X.functionField, (∀ w : X, 0 ≤ X.ord h w + B w) →
      h ∈ Submodule.span k (Set.range y))
    (hybpf : ∀ w : X, Order.coheight w = 1 → ∃ i, X.ord (y i) w + B w = 0)
    (φB : X ⟶ projectiveSpaceOver m (Spec (.of k))) [IsClosedImmersion φB]
    (hφB : X.fromSpecStalk (genericPoint X) ≫ φB =
      Stacks.SectionsToProjectiveSpace.toProjectiveSpaceOver
        (fun i => (Scheme.ΓSpecIso (.of X.functionField)).inv (y i))
        (Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨0, rfl⟩)
          ((Ne.isUnit (hy 0)).map (Scheme.ΓSpecIso (.of X.functionField)).inv.hom))
        (X.fromSpecStalk _ ≫ pr₁ ≫ f))
    -- (B): the coordinates `y` are generic for every projection `π_{a'b'}`
    (hBG1 : ∀ a' b' : Fin (n + 1), a' ≠ 0 → b' ≠ 0 → ∀ i : Fin (m + 1), i ≠ 0 → ∀ w w' : X,
      0 < X.ord (y i) w + B w → 0 < X.ord (y 0) w' + B w' →
      ∃ r ∈ IntermediateField.adjoin k {ι₁ (x a' / x 0), ι₂ (x b' / x 0)},
        0 ≤ X.ord r w ∧ X.ord r w' < 0)
    (hBG1' : ∀ a' b' : Fin (n + 1), a' ≠ 0 → b' ≠ 0 → ∀ i j : Fin (m + 1),
      i.val = 1 → j.val = 2 → ∀ w w' : X, 0 < X.ord (y i) w + B w →
      0 < X.ord (y j) w' + B w' →
      ∃ r ∈ IntermediateField.adjoin k {ι₁ (x a' / x 0), ι₂ (x b' / x 0)},
        0 ≤ X.ord r w ∧ X.ord r w' < 0)
    (hBG2 : ∀ a' b' : Fin (n + 1), a' ≠ 0 → b' ≠ 0 → ∀ i : Fin (m + 1), i ≠ 0 → ∀ w : X,
      0 < X.ord (y i) w + B w →
      0 ≤ X.ord (ι₁ (x a' / x 0)) w ∧ 0 ≤ X.ord (ι₂ (x b' / x 0)) w)
    (hBG3 : ∀ a' b' : Fin (n + 1), a' ≠ 0 → b' ≠ 0 →
      ∀ 𝔪 : Ideal (MvPolynomial (Fin 2) k), 𝔪.IsMaximal →
      ∃ i : Fin (m + 1), i ≠ 0 ∧ ∀ q : X,
        (∀ r ∈ 𝔪,
          (∀ w : X, w ⤳ q → Order.coheight w = 1 → 0 ≤ X.ord
            (MvPolynomial.aeval ![ι₁ (x a' / x 0), ι₂ (x b' / x 0)] r) w) ∧
          ∃ w : X, w ⤳ q ∧ Order.coheight w = 1 ∧ 0 < X.ord
            (MvPolynomial.aeval ![ι₁ (x a' / x 0), ι₂ (x b' / x 0)] r) w) →
        ∀ w : X, w ⤳ q → Order.coheight w = 1 → X.ord (y i) w + B w = 0)
    -- the Vojta data: `d₁, d₂, d` positive integers with `δᵢ = (dᵢ + sB d) / N` integers
    (d₁ d₂ d δ₁ δ₂ : ℕ) (hd₁ : 0 < d₁) (hd₂ : 0 < d₂) (hd : 0 < d)
    (hδ₁N : N * δ₁ = d₁ + sB * d) (hδ₂N : N * δ₂ = d₂ + sB * d)
    -- the section `s ≠ 0` of `𝒪(V)` and its representative with coefficients in `k`
    (s : Γ(vojtaLineBundle ψ φB δ₁ δ₂ d, ⊤)) (hs : s ≠ 0)
    (F : Fin (m + 1) → MvPolynomial.weightedHomogeneousSubmodule k
      (Sum.elim (fun _ => ((1 : ℕ), (0 : ℕ))) (fun _ => ((0 : ℕ), (1 : ℕ))) :
        Fin (n + 1) ⊕ Fin (n + 1) → ℕ × ℕ) (δ₁, δ₂))
    (hF : IsVojtaRepresentative ψ φB δ₁ δ₂ d s
      (fun i => MvPolynomial.map (Scheme.ΓSpecIso (.of k)).inv.hom (F i).1))
    (a b : Fin n)
    -- the ring `R = k[ξ_a, ξ'_b]` and a family of reduced representations of the `Norm ηᵢ`
    [Algebra (MvPolynomial (Fin 2) k)
      (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)})]
    (hR : ∀ p : MvPolynomial (Fin 2) k,
      (algebraMap (MvPolynomial (Fin 2) k)
        (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)}) p :
          X.functionField) =
        MvPolynomial.aeval ![ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)] p)
    (U V : Fin (m + 1) → MvPolynomial (Fin 2) k)
    (hUV : IsReducedNormRepresentation
      (K := IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)})
      (MvPolynomial (Fin 2) k) (fun i => y i / y 0) U V)
    (i : Fin (m + 1)) (hi : i ≠ 0) :
    ∃ T : MvPolynomial (Fin 2) k, T ≠ 0 ∧ T.degreeOf 0 ≤ N * d₁ ∧ T.degreeOf 1 ≤ N * d₂ ∧
      algebraMap (MvPolynomial (Fin 2) k)
        (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)}) T =
        polynomialT ι₁ ι₂ x 0 a.succ b.succ (δ₁, δ₂) F (fun i => y i / y 0) U V hUV d i := by
  subst hkC
  let : Algebra k C.functionField := functionFieldAlgebra k f
  -- the representative identity `F_j(ξ, ξ') = g η_jᵈ` with `g ≠ 0`
  obtain ⟨g, hg0, hgF⟩ := exists_ne_zero_affineEvaluation_eq_mul_pow hX x hli.ne_zero φNP
    hφNP hφNPx ψ hψ₁ hψ₂ hkX ι₁ ι₂ hι₁ hι₂ y hy _ φB hφB δ₁ δ₂ d s hs F hF
  -- `R → k⟮ξ_a, ξ'_b⟯` is injective, `ξ_a` and `ξ'_b` being algebraically independent
  have hNcl := isClosed_of_mem_support_smul hP₁cl (N : ℤ)
  have hdeg := finsum_smul_mul_residueDegree f hP₁ (N : ℤ)
  have hv : ![ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)] =
      ![ι₁ (x a.succ / x 0), ι₂ (x b.succ / x 0)] := by
    rw [map_div₀, map_div₀]
  have hinj : Function.Injective (algebraMap (MvPolynomial (Fin 2) k)
      (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)})) :=
    fun p q hpq => injective_aeval_of_transcendental f hX (fun _ => rfl) ι₁ ι₂ hι₁ hι₂
      (transcendental_div k f hg _ hNcl N hN hdeg x hli hspan hG1 a.succ_ne_zero)
      (transcendental_div k f hg _ hNcl N hN hdeg x hli hspan hG1 b.succ_ne_zero)
      (by have h := congrArg Subtype.val hpq; rwa [hR, hR, hv] at h)
  have := (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  -- `deg U_i = N s_B`, `T_i` is a polynomial `T`, and `G_i` is a polynomial `G` of bidegree
  -- at most `(N² δ₁, N² δ₂)`
  obtain ⟨hU₀, hU₁⟩ := degreeOf_num_eq_of_isReducedNormRepresentation k f hg P₁ hP₁cl hP₁ N hN
    hn x hli hspan hG1 hG2 hG3 hX Δ hΔ₁ hΔ₂ φNP hφNP hφNPx ψ hψ₁ hψ₂ rfl hkX ι₁ ι₂ hι₁ hι₂ sB hsB
    heΔ B hB y hy hD hyli hyspan hybpf φB hφB hBG1 hBG1' hBG2 hBG3 a b hR hUV i hi
  obtain ⟨T, hT⟩ := polynomialT_mem_range_algebraMap k f hg P₁ hP₁cl hP₁ N hN hn x hli hspan hG1
    hG2 hG3 hX Δ hΔ₁ hΔ₂ φNP hφNP hφNPx ψ hψ₁ hψ₂ rfl hkX ι₁ ι₂ hι₁ hι₂ sB hsB heΔ B hB y hy hD hyli
    hyspan hybpf φB hφB hBG1 hBG1' hBG2 hBG3 d₁ d₂ d δ₁ δ₂ hd₁ hd₂ hd hδ₁N hδ₂N s hs F hF a b hR
    U V hUV i
  obtain ⟨G, hG₀, hG₁, hGe⟩ := exists_aeval_eq_formNorm_of_isVojtaRepresentative k f hg P₁ hP₁cl
    hP₁ N hN hn x hli hspan hG1 hG2 hG3 hX Δ hΔ₁ hΔ₂ φNP hφNP hφNPx ψ hψ₁ hψ₂ rfl hkX ι₁ ι₂ hι₁ hι₂
    sB hsB heΔ B hB y hy hD hyli hyspan hybpf φB hφB hBG1 hBG1' hBG2 hBG3 d₁ d₂ d δ₁ δ₂
    hd₁ hd₂ hd hδ₁N hδ₂N s hs F hF a b i
  have hV0 : algebraMap (MvPolynomial (Fin 2) k)
      (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)})
        (V i) ^ d ≠ 0 :=
    pow_ne_zero d ((map_ne_zero_iff _ hinj).mpr (hUV.ne_zero i))
  -- the norm relation `G_0 U_iᵈ = G_i V_iᵈ` gives `T U_iᵈ = G` in `R`
  have hTG : T * U i ^ d = G := hinj <| by
    rw [map_mul, map_pow, hT, polynomialT, div_mul_eq_mul_div,
      IsReducedNormRepresentation.formNorm_mul_num_pow_eq ι₁ ι₂ x 0 a.succ b.succ
        (Fin.succ_ne_zero a) (Fin.succ_ne_zero b) (δ₁, δ₂) F g hg0 (fun j => y j / y 0)
        (div_self (hy 0)) hgF hUV i,
      mul_div_cancel_right₀ _ hV0]
    exact Subtype.ext (by rw [hR, hv]; exact hGe.symm)
  -- `T ≠ 0`, because `G_0 = Norm g ≠ 0`
  have hT0 : T ≠ 0 := by
    rintro rfl
    rw [map_zero, polynomialT, eq_comm, div_eq_zero_iff, or_iff_left hV0, formNorm, hgF 0,
      div_self (hy 0), one_pow, mul_one] at hT
    exact ((Ne.isUnit hg0).map (Algebra.norm _)).ne_zero hT
  have hU : U i ≠ 0 := by
    rintro h0
    rw [h0, MvPolynomial.degreeOf_zero] at hU₀
    exact (Nat.mul_pos (by omega) hsB).ne hU₀
  exact ⟨T, hT0, degreeOf_le_of_mul_pow_eq hT0 hU hTG 0 hG₀ hU₀ hδ₁N,
    degreeOf_le_of_mul_pow_eq hT0 hU hTG 1 hG₁ hU₁ hδ₂N, hT⟩

end Bidegree

section PointValues

/-- A `k`-point `q` of `C` over `k` evaluates the constant `c` on the local ring at its image to
`c`. -/
private theorem stalkMap_const_eq {k : Type u} [Field k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) (q : Spec (.of k) ⟶ C) (hq : q ≫ f = 𝟙 _) (c : k) :
    (q.stalkMap (closedPoint (CommRingCat.of k)) ≫ (stalkClosedPointIso (.of k)).hom).hom
      (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ C.presheaf.germ ⊤ _ trivial).hom c) = c := by
  have h2 := germ_stalkClosedPointIso_hom (CommRingCat.of k)
  have h1 := Scheme.Hom.germ_stalkMap q ⊤ (closedPoint (CommRingCat.of k)) trivial
  have e : f.appTop ≫ q.app ⊤ = 𝟙 _ := by
    change f.appTop ≫ q.appTop = _
    rw [← Scheme.Hom.comp_appTop, hq]
    rfl
  set y := (Scheme.ΓSpecIso (.of k)).inv.hom c
  have hy : q.app ⊤ (f.appTop y) = y := by
    rw [← CommRingCat.comp_apply, e]; rfl
  change (stalkClosedPointIso (.of k)).hom.hom
    ((q.stalkMap (closedPoint (CommRingCat.of k))).hom
      (C.presheaf.germ ⊤ _ trivial (f.appTop y))) = c
  have := congrArg (fun F => F.hom (f.appTop y)) h1
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
  rw [this, hy]
  have := congrArg (fun F => F.hom y) h2
  simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
  erw [this]
  simp [y]

/-- **The value of a pulled-back section at a `k`-point.** For a `k`-point `q` of `C` and a
section `t` of `𝒪_Z` over `U`, with `q` landing in `v⁻¹ U`, the germ of `v^* t` at `q` differs
from the constant `t(v(q))` by an element of the maximal ideal. -/
private theorem sub_const_mem_maximalIdeal {k : Type u} [Field k] {C Z : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) (v : C ⟶ Z) (q : Spec (.of k) ⟶ C) (hq : q ≫ f = 𝟙 _) (U : Z.Opens)
    (hQ : q (closedPoint k) ∈ v ⁻¹ᵁ U) (hp : ⊤ ≤ q ⁻¹ᵁ (v ⁻¹ᵁ U)) (t : Γ(Z, U)) :
    C.presheaf.germ _ _ hQ (v.app _ t) -
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ C.presheaf.germ ⊤ _ trivial).hom
        ((Scheme.ΓSpecIso (.of k)).hom (q.appLE _ ⊤ hp (v.appLE _ (v ⁻¹ᵁ U) le_rfl t))) ∈
      maximalIdeal (C.presheaf.stalk (q (closedPoint k))) := by
  set ev := q.stalkMap (closedPoint (CommRingCat.of k)) ≫ (stalkClosedPointIso (.of k)).hom
  have h2 := germ_stalkClosedPointIso_hom (CommRingCat.of k)
  have e1 : ev.hom (C.presheaf.germ _ _ hQ (v.app _ t)) =
      (Scheme.ΓSpecIso (.of k)).hom (q.appLE _ ⊤ hp (v.appLE _ (v ⁻¹ᵁ U) le_rfl t)) := by
    have h1 := Scheme.Hom.germ_stalkMap q (v ⁻¹ᵁ U) (closedPoint (CommRingCat.of k)) hQ
    have h3 : (Spec (.of k)).presheaf.germ (q ⁻¹ᵁ (v ⁻¹ᵁ U)) (closedPoint (CommRingCat.of k))
        hQ = (Spec (.of k)).presheaf.map (homOfLE hp).op ≫
          (Spec (.of k)).presheaf.germ ⊤ _ trivial :=
      ((Spec (.of k)).presheaf.germ_res (homOfLE hp) _ trivial).symm
    have key : C.presheaf.germ _ _ hQ ≫ ev =
        q.appLE _ ⊤ hp ≫ (Scheme.ΓSpecIso (.of k)).hom := by
      rw [← Category.assoc, h1, Category.assoc, h3, Category.assoc, h2, Scheme.Hom.appLE,
        Category.assoc]
    have := congrArg (fun F => F.hom (v.app _ t)) key
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    rw [this]
    congr 2
    simp [Scheme.Hom.appLE]
  rw [← stalkMap_const_eq f q hq ((Scheme.ΓSpecIso (.of k)).hom
    (q.appLE _ ⊤ hp (v.appLE _ (v ⁻¹ᵁ U) le_rfl t)))] at e1
  by_contra hmem
  have hu := (IsLocalRing.notMem_maximalIdeal.mp hmem).map ev.hom
  rw [map_sub, e1, sub_self] at hu
  exact not_isUnit_zero hu

end PointValues

section ChartCoordinates

open Stacks.AlgebraicGeometry.ProjPolyChart Stacks.AlgebraicGeometry.ProjBaseChange
open scoped LinearAlgebra.Projectivization

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **The affine coordinates of a `k`-point outside `Z`.** Let `q` be a `k`-point of the curve
`C` outside the exceptional set `Z` of non-zero rational functions `x₀, …, xₙ`, and let
`φ : C ⟶ ℙⁿ_k` have chart functions `T_ν / T_j ↦ x_ν / x_j`. Then the affine coordinates
`ξ_ν = x_ν / x_0` are regular at `q` with values `c_ν ∈ k`, and `φ(q) = (1 : c_1 : ⋯ : c_n)`. -/
private theorem exists_coords_of_notMem_exceptionalSet {k : Type u} [Field k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) [IsCurve k f] [IsLocallyNoetherian C] [IsIntegral C] (D : C →₀ ℤ)
    {n : ℕ} (x : Fin (n + 1) → C.functionField) (hx : ∀ j, x j ≠ 0)
    (ht : letI := functionFieldAlgebra k f; Transcendental k (x 1 / x 0))
    (φ : C ⟶ projectiveSpaceOver n (Spec (.of k)))
    (hφ : φ ≫ (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) = f)
    (hφx : letI : ∀ r : ℕ,
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) (ULift.{u} ℤ)) :=
        fun _ => MvPolynomial.gradedAlgebra
      -- the chart `φ⁻¹ D₊(T_j)` of `C`
      let U : Fin (n + 1) → C.Opens := fun j =>
        φ ⁻¹ᵁ (projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k)) ⁻¹ᵁ
          Proj.basicOpen _ (MvPolynomial.X j))
      ∀ (j ν : Fin (n + 1)) [Nonempty (U j)],
        (C.germToFunctionField (U j)).hom
          (φ.app _ ((projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k))).app _
            (Proj.awayToSection _ (MvPolynomial.X j)
              (HomogeneousLocalization.Away.mk
                (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
                (MvPolynomial.isHomogeneous_X _ j) 1 (MvPolynomial.X ν)
                (by simpa using MvPolynomial.isHomogeneous_X _ ν))))) =
          x ν / x j)
    (q : Spec (.of k) ⟶ C) (hq : q ≫ f = 𝟙 _)
    (hZ : q ∉ exceptionalSet k f D x ht) :
    ∃ c : Fin (n + 1) → k, ∃ hc0 : c 0 = 1,
      (∀ ν, ∃ g : C.presheaf.stalk (q (closedPoint k)),
        algebraMap _ C.functionField g = x ν / x 0 ∧
        g - ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
          C.presheaf.germ ⊤ _ trivial).hom (c ν) ∈ maximalIdeal _) ∧
      kPointProjectivization (q ≫ φ) (by rw [Category.assoc, hφ, hq]) =
        Projectivization.mk k c fun h => by simpa [hc0] using congrFun h 0 := by
  classical
  obtain ⟨hη, hgerm⟩ := exists_germ_app_ratio_eq_div_of_chart φ x hx hφx 0
  set Q := q (closedPoint k) with hQdef
  -- `q` lies in the chart `D₊(T₀)`, read on the integral model `ℙⁿ_ℤ`
  set v : C ⟶ projectiveSpaceAtUniverse.{u} n :=
    φ ≫ projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k)) with hvdef
  have hQW : Q ∈ v ⁻¹ᵁ Proj.basicOpen (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X 0) :=
    VanishingTransfer.Charts.mem_chart_zero_of_notMem_exceptionalSet f D x hx ht φ hφx q hq hZ
  have hi : ⊤ ≤ (q ≫ v) ⁻¹ᵁ Proj.basicOpen (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X 0) := by
    intro a _
    have : a = closedPoint k := Subsingleton.elim _ _
    subst this
    exact hQW
  have hp : ⊤ ≤ q ⁻¹ᵁ (v ⁻¹ᵁ Proj.basicOpen (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X 0)) :=
    hi
  have hy : (q ≫ φ) ≫ projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k) = 𝟙 _ := by
    rw [Category.assoc, hφ, hq]
  have hi' : ⊤ ≤ ((q ≫ φ) ≫ projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k))) ⁻¹ᵁ
      Proj.basicOpen (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X 0) := by
    rw [Category.assoc]; exact hi
  obtain ⟨hne, hpt⟩ := kPointProjectivization_eq_mk_intVal (q ≫ φ) hy 0 hi'
  have hcongr : intVal _ 0 hi' = intVal (q ≫ v) 0 hi := intVal_congr (Category.assoc _ _ _) rfl _ _
  -- the chart values of `q` are the values of the affine coordinates at `q`
  have hval : ∀ ν, intVal (q ≫ v) 0 hi ν = (Scheme.ΓSpecIso (.of k)).hom (q.appLE _ ⊤ hp
      (v.appLE _ (v ⁻¹ᵁ Proj.basicOpen (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X 0)) le_rfl
        ((Proj.awayToSection (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X 0)).hom
          (Stacks.ProjectiveSpaceChartRatio.coordFracAt (ULift.{u} ℤ) n 0 ν)))) := fun ν => by
    unfold intVal
    rw [← Scheme.Hom.appLE_comp_appLE q v _ _ ⊤ le_rfl hp]
    rfl
  have hone : Stacks.ProjectiveSpaceChartRatio.coordFracAt (ULift.{u} ℤ) n 0 0 = 1 := by
    rw [HomogeneousLocalization.ext_iff_val, Stacks.ProjectiveSpaceChartRatio.coordFracAt,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
    simp
  have hc0 : intVal (q ≫ v) 0 hi 0 = 1 := by
    unfold intVal
    rw [hone, map_one]
    erw [map_one, map_one]
  refine ⟨intVal (q ≫ v) 0 hi, hc0, fun ν => ?_, ?_⟩
  · refine ⟨C.presheaf.germ _ Q hQW (v.app _
      ((Proj.awayToSection (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X 0)).hom
        (Stacks.ProjectiveSpaceChartRatio.coordFracAt (ULift.{u} ℤ) n 0 ν))), ?_, ?_⟩
    · rw [← hgerm ν]
      change C.presheaf.stalkSpecializes (genericPoint_specializes Q) _ = _
      exact TopCat.Presheaf.germ_stalkSpecializes_apply _ _ _ _
    · rw [hval ν]
      exact sub_const_mem_maximalIdeal f _ q hq _ hQW hp _
  · refine hpt.trans ?_
    congr 1

end ChartCoordinates

/-- Condition (G3) in its form without the `= 0` disjunct holds for every index `i ≠ 0`: the
premise fails at `r = 0 ∈ 𝔪`, since `ord 0 = 0`. -/
private theorem exists_ne_zero_forall_of_ord_pos {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] {K : Type*} [CommRing K] {m : ℕ}
    (φ : MvPolynomial (Fin 2) K →+* X.functionField)
    (𝔪 : Ideal (MvPolynomial (Fin 2) K)) (Q : Fin (m + 1) → X → Prop) {i : Fin (m + 1)}
    (hi : i ≠ 0) :
    ∃ i : Fin (m + 1), i ≠ 0 ∧ ∀ q : X,
      (∀ r ∈ 𝔪, (∀ w, w ⤳ q → Order.coheight w = 1 → 0 ≤ X.ord (φ r) w) ∧
        ∃ w, w ⤳ q ∧ Order.coheight w = 1 ∧ 0 < X.ord (φ r) w) → Q i q := by
  refine ⟨i, hi, fun q hq => ?_⟩
  obtain ⟨-, w, -, -, hw⟩ := hq 0 (Ideal.zero_mem _)
  simp [Scheme.ord_zero] at hw

section Arithmetic

/-- An error term `o(t)` is eventually at most `t`. -/
private lemma exists_forall_le_of_isLittleO {f : ℕ → ℝ}
    (hf : f =o[Filter.atTop] (fun t : ℕ => (t : ℝ))) : ∃ D : ℕ, ∀ t, D ≤ t → f t ≤ t := by
  obtain ⟨D, hD⟩ := Filter.eventually_atTop.mp (hf.bound one_pos)
  exact ⟨D, fun t ht => (le_abs_self _).trans (by simpa using hD t ht)⟩

/-- **The height bound for `T` in Roth's form.** If `h(T) ≤ c₁₅ N² (d₁ + d₂) / γ +
2 N (d₁ + d₂ + 2 s d) + e` with `e ≤ d₁ + d₂`, `d, d₂ ≤ d₁` and `0 < γ < 1`, then
`h(T) + 4 N d₁ ≤ c₁₆ d₁ / γ` with `c₁₆ = 2 max(c₁₅, 0) N² + 2 N (4 + 2 s) + 2`. -/
private lemma height_add_le_div {c₁₅ γ h e : ℝ} {N sB d₁ d₂ d : ℕ} (hγ : 0 < γ) (hγ1 : γ < 1)
    (hd₂ : d₂ ≤ d₁) (hd : d ≤ d₁)
    (hh : h ≤ c₁₅ * N ^ 2 * (d₁ + d₂) / γ + 2 * N * (d₁ + d₂ + 2 * sB * d) + e)
    (he : e ≤ d₁ + d₂) :
    h + 4 * (N * d₁ : ℕ) ≤ (2 * max c₁₅ 0 * N ^ 2 + 2 * N * (4 + 2 * sB) + 2) * d₁ / γ := by
  have hd₂' : (d₂ : ℝ) ≤ d₁ := by exact_mod_cast hd₂
  have hd' : (d : ℝ) ≤ d₁ := by exact_mod_cast hd
  have h1 : c₁₅ * N ^ 2 * (d₁ + d₂) ≤ 2 * max c₁₅ 0 * N ^ 2 * d₁ := by
    nlinarith [mul_nonneg (le_max_right c₁₅ 0) (sq_nonneg (N : ℝ)),
      mul_le_mul_of_nonneg_right (le_max_left c₁₅ 0) (by positivity : (0 : ℝ) ≤ N ^ 2 * (d₁ + d₂))]
  have h2 : 2 * (N : ℝ) * (d₁ + d₂ + 2 * sB * d) + 4 * (N * d₁ : ℕ) + (d₁ + d₂) ≤
      (2 * N * (4 + 2 * sB) + 2) * d₁ := by
    push_cast
    nlinarith [mul_le_mul_of_nonneg_left hd' (by positivity : (0 : ℝ) ≤ N * sB),
      mul_le_mul_of_nonneg_left hd₂' (by positivity : (0 : ℝ) ≤ N)]
  have h3 : (2 * N * (4 + 2 * sB) + 2) * (d₁ : ℝ) ≤ (2 * N * (4 + 2 * sB) + 2) * d₁ / γ :=
    le_div_self (by positivity) hγ hγ1.le
  rw [show (2 * max c₁₅ 0 * N ^ 2 + 2 * N * (4 + 2 * sB) + 2) * (d₁ : ℝ) / γ =
    2 * max c₁₅ 0 * N ^ 2 * d₁ / γ + (2 * N * (4 + 2 * sB) + 2) * d₁ / γ by ring]
  linarith [div_le_div_of_nonneg_right h1 hγ.le]

/-- From `A ≤ d H` and `H / n ≤ h`, with `h ≥ 0` and `N ≥ 1`: `A / n ≤ (N d) h`. This turns the
lower bound on `d h_{NP}(z)` into Roth's lower bound on `r₁ h(ξ_a(z))`. -/
private lemma div_le_natCast_mul_of_le_mul {A H h : ℝ} {N d n : ℕ} (hN : 0 < N) (hn : 0 < n)
    (hA : A ≤ d * H) (hH : H / n ≤ h) (h0 : 0 ≤ h) : A / n ≤ ((N * d : ℕ) : ℝ) * h := by
  have hN' : (1 : ℝ) ≤ N := by exact_mod_cast hN
  calc A / n ≤ d * (H / n) := by rw [← mul_div_assoc]; gcongr
    _ ≤ d * h := by gcongr
    _ ≤ N * d * h := by
      have : (0 : ℝ) ≤ d * h := by positivity
      nlinarith
    _ = _ := by push_cast; ring

end Arithmetic

end Helpers

section Choice

open Classical in
/-- **Choice of `i₀`** in the setting of
`Faltings.BombieriRoth.exists_isAdmissiblePair_div_add_div_le`: for a point `p₀` of `Ω²`, `Ω` an
algebraic closure of `k`, some numerator `U_{i₀}`, `i₀ ≠ 0`, of the reduced representations of
the norms of `η_i = y_i / y_0` does not vanish at `p₀`. This is
`Faltings.exists_aeval_num_ne_zero_of_isReducedNormRepresentation`, with condition (G3) read in
the form of the main inequality (for the non-zero `r ∈ 𝔪`). -/
private theorem exists_eval_num_ne_zero (k : Type u) [Field k] [CharZero k]
    {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f]
    [IsProjectiveVariety k f] [Smooth f] [GeometricallyIntegral f] [IsLocallyNoetherian C]
    (hg : 2 ≤ AlgebraicGeometry.genus f) (P₁ : C →₀ ℤ)
    (hP₁cl : ∀ Q ∈ P₁.support, IsClosed ({Q} : Set C))
    (hP₁ : ∑ᶠ Q : C, P₁ Q * (f.residueDegree Q : ℤ) = 1) (N : ℕ)
    (hN : 2 * AlgebraicGeometry.genus f + 1 ≤ N)
    {n : ℕ} (hn : n = N - AlgebraicGeometry.genus f) (x : Fin (n + 1) → C.functionField)
    (hli : letI := functionFieldAlgebra k f; LinearIndependent k x)
    (hspan : letI := functionFieldAlgebra k f
      ((Submodule.span k (Set.range x) : Submodule k C.functionField) : Set C.functionField) =
        {g | g = 0 ∨ ∀ Q : C, IsClosed ({Q} : Set C) → 0 ≤ C.ord g Q + ((N : ℤ) • P₁) Q})
    -- (N): the basis `x` is generic
    (hG1 : SatisfiesG1 k f ((N : ℤ) • P₁) x) (hG2 : SatisfiesG2 k f x)
    (hG3 : SatisfiesG3 k f x)
    -- the product `X = C ×_k C` with its projections and diagonal
    {X : Scheme.{u}} {pr₁ pr₂ : X ⟶ C} (hX : IsPullback pr₁ pr₂ f f) [IsIntegral X]
    [IsLocallyNoetherian X] (Δ : C ⟶ X) (hΔ₁ : Δ ≫ pr₁ = 𝟙 C) (hΔ₂ : Δ ≫ pr₂ = 𝟙 C)
    -- the embedding `φ_{NP}` given by `x`
    (φNP : C ⟶ projectiveSpaceOver n (Spec (.of k))) [IsClosedImmersion φNP]
    (hφNP : φNP ≫ (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) = f)
    (hφNPx : letI : ∀ r : ℕ,
        GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) (ULift.{u} ℤ)) :=
        fun _ => MvPolynomial.gradedAlgebra
      -- the chart `φNP⁻¹ D₊(T_j)` of `C`
      let U : Fin (n + 1) → C.Opens := fun j =>
        φNP ⁻¹ᵁ (projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k)) ⁻¹ᵁ
          Proj.basicOpen _ (MvPolynomial.X j))
      ∀ (j ν : Fin (n + 1)) [Nonempty (U j)],
        (C.germToFunctionField (U j)).hom
          (φNP.app _ ((projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k))).app _
            (Proj.awayToSection _ (MvPolynomial.X j)
              (HomogeneousLocalization.Away.mk
                (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ))
                (MvPolynomial.isHomogeneous_X _ j) 1 (MvPolynomial.X ν)
                (by simpa using MvPolynomial.isHomogeneous_X _ ν))))) =
          x ν / x j)
    -- the `k`-structures of `k(C)`, `k(C × C)` and the pull-backs `pr₁^*`, `pr₂^*`
    [Algebra k C.functionField] (hkC : ‹Algebra k C.functionField› = functionFieldAlgebra k f)
    [Algebra k X.functionField]
    (hkX : ∀ c : k, algebraMap k X.functionField c =
      X.presheaf.germ ⊤ (genericPoint X) trivial
        ((pr₁ ≫ f).appTop ((Scheme.ΓSpecIso (.of k)).inv c)))
    (ι₁ ι₂ : C.functionField →ₐ[k] X.functionField)
    (hι₁ : ∀ (U : C.Opens) [Nonempty U] [Nonempty (pr₁ ⁻¹ᵁ U)] (t : Γ(C, U)),
      ι₁ (C.germToFunctionField U t) = X.germToFunctionField (pr₁ ⁻¹ᵁ U) (pr₁.app U t))
    (hι₂ : ∀ (U : C.Opens) [Nonempty U] [Nonempty (pr₂ ⁻¹ᵁ U)] (t : Γ(C, U)),
      ι₂ (C.germToFunctionField U t) = X.germToFunctionField (pr₂ ⁻¹ᵁ U) (pr₂.app U t))
    -- the very ample divisor `B` on `C × C`, and the basis `y` of `H⁰(𝒪(B))` giving `φ_B`
    (sB : ℕ) (hsB : 1 ≤ sB) {eΔ : X} (heΔ : IsGenericPoint eΔ (Set.range Δ.base))
    (B : X → ℤ) (hB : ∀ w : X, B w =
      (sB + 1 : ℤ) * P₁.sum (fun c a => if IsGenericPoint w (pr₁.base ⁻¹' {c}) then a else 0) +
      (sB + 1 : ℤ) * P₁.sum (fun c a => if IsGenericPoint w (pr₂.base ⁻¹' {c}) then a else 0) -
      (if w = eΔ then 1 else 0))
    {m : ℕ} (y : Fin (m + 1) → X.functionField) (hy : ∀ i, y i ≠ 0)
    (hD : ∀ i (w : X), 0 ≤ X.ord (y i) w + B w)
    (hyli : LinearIndependent k y)
    (hyspan : ∀ h : X.functionField, (∀ w : X, 0 ≤ X.ord h w + B w) →
      h ∈ Submodule.span k (Set.range y))
    (hybpf : ∀ w : X, Order.coheight w = 1 → ∃ i, X.ord (y i) w + B w = 0)
    (φB : X ⟶ projectiveSpaceOver m (Spec (.of k))) [IsClosedImmersion φB]
    (hφB : X.fromSpecStalk (genericPoint X) ≫ φB =
      Stacks.SectionsToProjectiveSpace.toProjectiveSpaceOver
        (fun i => (Scheme.ΓSpecIso (.of X.functionField)).inv (y i))
        (Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨0, rfl⟩)
          ((Ne.isUnit (hy 0)).map (Scheme.ΓSpecIso (.of X.functionField)).inv.hom))
        (X.fromSpecStalk _ ≫ pr₁ ≫ f))
    -- (B): the coordinates `y` are generic for every projection `π_{a'b'}`
    (hBG1 : ∀ a' b' : Fin (n + 1), a' ≠ 0 → b' ≠ 0 → ∀ i : Fin (m + 1), i ≠ 0 → ∀ w w' : X,
      0 < X.ord (y i) w + B w → 0 < X.ord (y 0) w' + B w' →
      ∃ r ∈ IntermediateField.adjoin k {ι₁ (x a' / x 0), ι₂ (x b' / x 0)},
        0 ≤ X.ord r w ∧ X.ord r w' < 0)
    (hBG1' : ∀ a' b' : Fin (n + 1), a' ≠ 0 → b' ≠ 0 → ∀ i j : Fin (m + 1),
      i.val = 1 → j.val = 2 → ∀ w w' : X, 0 < X.ord (y i) w + B w →
      0 < X.ord (y j) w' + B w' →
      ∃ r ∈ IntermediateField.adjoin k {ι₁ (x a' / x 0), ι₂ (x b' / x 0)},
        0 ≤ X.ord r w ∧ X.ord r w' < 0)
    (hBG2 : ∀ a' b' : Fin (n + 1), a' ≠ 0 → b' ≠ 0 → ∀ i : Fin (m + 1), i ≠ 0 → ∀ w : X,
      0 < X.ord (y i) w + B w →
      0 ≤ X.ord (ι₁ (x a' / x 0)) w ∧ 0 ≤ X.ord (ι₂ (x b' / x 0)) w)
    (hBG3 : ∀ a' b' : Fin (n + 1), a' ≠ 0 → b' ≠ 0 →
      ∀ 𝔪 : Ideal (MvPolynomial (Fin 2) k), 𝔪.IsMaximal →
      ∃ i : Fin (m + 1), i ≠ 0 ∧ ∀ p : X,
        (∀ r ∈ 𝔪, r ≠ 0 →
          (∀ q, q ⤳ p → Order.coheight q = 1 →
            0 ≤ X.ord (MvPolynomial.aeval ![ι₁ (x a' / x 0), ι₂ (x b' / x 0)] r) q) ∧
          ∃ q, q ⤳ p ∧ Order.coheight q = 1 ∧
            0 < X.ord (MvPolynomial.aeval ![ι₁ (x a' / x 0), ι₂ (x b' / x 0)] r) q) →
        ∀ q, q ⤳ p → Order.coheight q = 1 → X.ord (y i) q + B q = 0)
    (a b : Fin n)
    -- the ring `R = k[ξ_a, ξ'_b]` and a family of reduced representations of the `Norm ηᵢ`
    [Algebra (MvPolynomial (Fin 2) k)
      (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)})]
    (hR : ∀ p : MvPolynomial (Fin 2) k,
      (algebraMap (MvPolynomial (Fin 2) k)
        (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)}) p :
          X.functionField) =
        MvPolynomial.aeval ![ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)] p)
    (U V : Fin (m + 1) → MvPolynomial (Fin 2) k)
    (hUV : IsReducedNormRepresentation
      (K := IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)})
      (MvPolynomial (Fin 2) k) (fun i => y i / y 0) U V)
    {Ω : Type*} [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (p₀ : Fin 2 → Ω) :
    ∃ i₀ : Fin (m + 1), i₀ ≠ 0 ∧ MvPolynomial.aeval p₀ (U i₀) ≠ 0 := by
  classical
  subst hkC
  letI := functionFieldAlgebra k f
  have hkC' : ∀ c : k, algebraMap k C.functionField c =
      C.presheaf.germ ⊤ (genericPoint C) trivial
        (f.appTop ((Scheme.ΓSpecIso (.of k)).inv c)) := fun c => rfl
  have htr : ∀ a' : Fin (n + 1), a' ≠ 0 → Transcendental k (x a' / x 0) := fun a' ha' =>
    FunctionField.transcendental_of_notMem_range f (div_notMem_range_algebraMap hli ha')
  -- condition (G3) with the `= 0` disjunct: `aeval r = 0` only for `r = 0`
  have hBG3' : ∀ a' b' : Fin (n + 1), a' ≠ 0 → b' ≠ 0 →
      ∀ 𝔪 : Ideal (MvPolynomial (Fin 2) k), 𝔪.IsMaximal →
      ∃ i : Fin (m + 1), i ≠ 0 ∧ ∀ q : X,
        (∀ r ∈ 𝔪,
          (∀ w, w ⤳ q → Order.coheight w = 1 →
            0 ≤ X.ord (MvPolynomial.aeval ![ι₁ (x a' / x 0), ι₂ (x b' / x 0)] r) w) ∧
          (MvPolynomial.aeval ![ι₁ (x a' / x 0), ι₂ (x b' / x 0)] r = 0 ∨
            ∃ w, w ⤳ q ∧ Order.coheight w = 1 ∧
              0 < X.ord (MvPolynomial.aeval ![ι₁ (x a' / x 0), ι₂ (x b' / x 0)] r) w)) →
        ∀ w, w ⤳ q → Order.coheight w = 1 → X.ord (y i) w + B w = 0 := by
    intro a' b' ha' hb' 𝔪 h𝔪
    obtain ⟨i, hi, hiq⟩ := hBG3 a' b' ha' hb' 𝔪 h𝔪
    refine ⟨i, hi, fun q hq => hiq q fun r hr hr0 => ⟨(hq r hr).1, ?_⟩⟩
    refine (hq r hr).2.resolve_left fun h0 => hr0 ?_
    exact injective_aeval_of_transcendental f hX hkC' ι₁ ι₂ hι₁ hι₂ (htr a' ha') (htr b' hb')
      (h0.trans (map_zero _).symm)
  have hv : ![ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)] =
      ![ι₁ (x a.succ / x 0), ι₂ (x b.succ / x 0)] := by
    rw [map_div₀, map_div₀]
  have hinj : Function.Injective (algebraMap (MvPolynomial (Fin 2) k)
      (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)})) := by
    intro p q hpq
    apply injective_aeval_of_transcendental f hX hkC' ι₁ ι₂ hι₁ hι₂ (htr _ a.succ_ne_zero)
      (htr _ b.succ_ne_zero)
    have h := congrArg Subtype.val hpq
    rwa [hR, hR, hv] at h
  let : Algebra (MvPolynomial (Fin 2) k) X.functionField :=
    ((algebraMap
        (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)})
        X.functionField).comp
      (algebraMap (MvPolynomial (Fin 2) k)
        (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)})))
      |>.toAlgebra
  have : IsScalarTower (MvPolynomial (Fin 2) k)
        (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)})
      X.functionField :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsFractionRing (MvPolynomial (Fin 2) k)
        (IntermediateField.adjoin k {ι₁ (x a.succ) / ι₁ (x 0), ι₂ (x b.succ) / ι₂ (x 0)}) :=
    isFractionRing_adjoin_pair _ _ hR hinj
  have hRL : ∀ p, algebraMap (MvPolynomial (Fin 2) k) X.functionField p =
      MvPolynomial.aeval ![ι₁ (x a.succ / x 0), ι₂ (x b.succ / x 0)] p := fun p =>
    (hR p).trans (by rw [hv])
  have hRL₀ : ∀ c : k, algebraMap (MvPolynomial (Fin 2) k) X.functionField (MvPolynomial.C c) =
      algebraMap k X.functionField c := fun c => by
    rw [hRL, MvPolynomial.aeval_C]
  have hRLa : algebraMap (MvPolynomial (Fin 2) k) X.functionField (MvPolynomial.X 0) =
      ι₁ (x a.succ / x 0) := by
    rw [hRL, MvPolynomial.aeval_X]; rfl
  have hRLb : algebraMap (MvPolynomial (Fin 2) k) X.functionField (MvPolynomial.X 1) =
      ι₂ (x b.succ / x 0) := by
    rw [hRL, MvPolynomial.aeval_X]; rfl
  exact Faltings.exists_aeval_num_ne_zero_of_isReducedNormRepresentation k f hg P₁ hP₁cl hP₁ N
    hN hn x hli hspan hG1 hG2 hG3 hX Δ hΔ₁ hΔ₂ φNP hφNP hφNPx rfl hkX ι₁ ι₂ hι₁ hι₂ sB hsB heΔ B
    hB y hy hD hyli hyspan hybpf φB hφB hBG1 hBG1' hBG2 hBG3' a.succ b.succ a.succ_ne_zero
    b.succ_ne_zero hRL₀ hRLa hRLb hUV p₀

end Choice

section Steps

/-- The size hypotheses of Bombieri's Lemma 8 force `d₂ ≤ d₁`, `d ≤ d₁` and `γ < 1`. -/
private lemma le_and_lt_one_of_size {γ ε : ℝ} {g d₁ d₂ d : ℕ} (hg : 2 ≤ g) (hd₁pos : 0 < d₁)
    (hd₂pos : 0 < d₂) (hε : 0 < ε) (hε1 : ε < 1) (hratio : (d₂ : ℝ) / d₁ ≤ ε ^ 2)
    (hγd : γ * d₁ * d₂ < (d₁ * d₂ - g * d ^ 2 : ℝ)) (hgd : g * d ^ 2 < d₁ * d₂) :
    d₂ ≤ d₁ ∧ d ≤ d₁ ∧ γ < 1 := by
  have hd₁R : (0 : ℝ) < d₁ := by exact_mod_cast hd₁pos
  have hd₂R : (0 : ℝ) < d₂ := by exact_mod_cast hd₂pos
  have hd₂d₁ : d₂ ≤ d₁ := by
    have h1 : (d₂ : ℝ) / d₁ < 1 := hratio.trans_lt (by nlinarith)
    rw [div_lt_one hd₁R] at h1
    exact_mod_cast h1.le
  have hdd₁ : d ≤ d₁ := by
    by_contra h
    push Not at h
    have : d₁ * d₂ ≤ d * d := Nat.mul_le_mul h.le (hd₂d₁.trans h.le)
    nlinarith
  refine ⟨hd₂d₁, hdd₁, ?_⟩
  have h0 : (0 : ℝ) ≤ g * d ^ 2 := by positivity
  have : γ * d₁ * d₂ < 1 * d₁ * d₂ := by linarith
  have hpos : (0 : ℝ) < d₁ * d₂ := by positivity
  nlinarith

/-- **The degree of `k(C ×_k C)` over `k(pr₁^* ξ, pr₂^* ξ')`.** If `ξ = u₁ / v₁` and
`ξ' = u₂ / v₂` both have degree `N` over `k(C)`, then
`[k(C ×_k C) : k(pr₁^* ξ, pr₂^* ξ')] ≤ N²`. -/
private theorem finrank_adjoin_pair_le_sq {k : Type u} [Field k] {C X : Scheme.{u}}
    [IsIntegral C] [IsIntegral X] (f : C ⟶ Spec (.of k)) {pr₁ pr₂ : X ⟶ C}
    (hX : IsPullback pr₁ pr₂ f f) [Algebra k C.functionField] [Algebra k X.functionField]
    (ι₁ ι₂ : C.functionField →ₐ[k] X.functionField)
    (hι₁ : ∀ (U : C.Opens) [Nonempty U] [Nonempty (pr₁ ⁻¹ᵁ U)] (t : Γ(C, U)),
      ι₁ (C.germToFunctionField U t) = X.germToFunctionField (pr₁ ⁻¹ᵁ U) (pr₁.app U t))
    (hι₂ : ∀ (U : C.Opens) [Nonempty U] [Nonempty (pr₂ ⁻¹ᵁ U)] (t : Γ(C, U)),
      ι₂ (C.germToFunctionField U t) = X.germToFunctionField (pr₂ ⁻¹ᵁ U) (pr₂.app U t))
    {N : ℕ} (hN : 0 < N) (u₁ v₁ u₂ v₂ : C.functionField)
    (h₁ : Module.finrank (IntermediateField.adjoin k {u₁ / v₁}) C.functionField = N)
    (h₂ : Module.finrank (IntermediateField.adjoin k {u₂ / v₂}) C.functionField = N) :
    Module.finrank (IntermediateField.adjoin k {ι₁ u₁ / ι₁ v₁, ι₂ u₂ / ι₂ v₂})
      X.functionField ≤ N ^ 2 := by
  have : FiniteDimensional (IntermediateField.adjoin k {u₁ / v₁}) C.functionField :=
    .of_finrank_pos (by rw [h₁]; exact hN)
  have : FiniteDimensional (IntermediateField.adjoin k {u₂ / v₂}) C.functionField :=
    .of_finrank_pos (by rw [h₂]; exact hN)
  have hE : ∀ (ι : C.functionField →ₐ[k] X.functionField) (t : C.functionField),
      ι t ∈ IntermediateField.adjoin k {ι₁ u₁ / ι₁ v₁, ι₂ u₂ / ι₂ v₂} →
      ∀ c ∈ IntermediateField.adjoin k {t},
        ι c ∈ IntermediateField.adjoin k {ι₁ u₁ / ι₁ v₁, ι₂ u₂ / ι₂ v₂} := by
    intro ι t ht c hc
    have hle : (IntermediateField.adjoin k {t}).map ι ≤
        IntermediateField.adjoin k {ι₁ u₁ / ι₁ v₁, ι₂ u₂ / ι₂ v₂} := by
      rwa [IntermediateField.adjoin_map, Set.image_singleton,
        IntermediateField.adjoin_simple_le_iff]
    exact hle ⟨c, hc, rfl⟩
  have h := finrank_le_mul_of_isPullback f hX ι₁ ι₂ hι₁ hι₂
    (IntermediateField.adjoin k {u₁ / v₁}) (IntermediateField.adjoin k {u₂ / v₂})
    (IntermediateField.adjoin k {ι₁ u₁ / ι₁ v₁, ι₂ u₂ / ι₂ v₂})
    (hE ι₁ _ (by rw [map_div₀]; exact IntermediateField.subset_adjoin _ _ (by simp)))
    (hE ι₂ _ (by rw [map_div₀]; exact IntermediateField.subset_adjoin _ _ (by simp)))
  rwa [h₁, h₂, ← sq] at h

/-- Rescaling the bound `A ≤ c d₁ / γ` into Roth's form `ε⁻² A ≤ (n c / (γ ε²)) d₁ / n`. -/
private lemma inv_sq_mul_le_div_of_le {A c γ ε : ℝ} {n d₁ : ℕ} (hγ : 0 < γ) (hε : 0 < ε)
    (hn : 0 < n) (hA : A ≤ c * d₁ / γ) : (ε ^ 2)⁻¹ * A ≤ n * c / (γ * ε ^ 2) * d₁ / n := by
  have hnR : (n : ℝ) ≠ 0 := by positivity
  have hγ0 : γ ≠ 0 := hγ.ne'
  have hε0 : ε ≠ 0 := hε.ne'
  rw [show n * c / (γ * ε ^ 2) * d₁ / n = (ε ^ 2)⁻¹ * (c * d₁ / γ) by field_simp]
  exact mul_le_mul_of_nonneg_left hA (by positivity)

/-- From `i ≤ I` and `I₁ / (N d₁) + I₂ / (N d₂) ≤ 4 ε`: `i₁ / d₁ + i₂ / d₂ ≤ 4 N ε`. -/
private lemma div_add_div_le_of_le_of_le {N d₁ d₂ : ℕ} {ε : ℝ} (hNpos : 0 < N) (hd₁pos : 0 < d₁)
    (hd₂pos : 0 < d₂) {i istar : ℕ × ℕ} (hile₁ : i.1 ≤ istar.1) (hile₂ : i.2 ≤ istar.2)
    (hIε : (istar.1 : ℝ) / ((N * d₁ : ℕ) : ℝ) + istar.2 / ((N * d₂ : ℕ) : ℝ) ≤ 4 * ε) :
    (i.1 : ℝ) / d₁ + (i.2 : ℝ) / d₂ ≤ 4 * N * ε := by
  have hNR : (0 : ℝ) < N := by exact_mod_cast hNpos
  have hd₁R : (0 : ℝ) < d₁ := by exact_mod_cast hd₁pos
  have hd₂R : (0 : ℝ) < d₂ := by exact_mod_cast hd₂pos
  calc (i.1 : ℝ) / d₁ + i.2 / d₂ ≤ istar.1 / d₁ + istar.2 / d₂ := by
        gcongr
    _ = N * ((istar.1 : ℝ) / ((N * d₁ : ℕ) : ℝ) + istar.2 / ((N * d₂ : ℕ) : ℝ)) := by
        push_cast
        field_simp
    _ ≤ N * (4 * ε) := mul_le_mul_of_nonneg_left hIε hNR.le
    _ = 4 * N * ε := by ring

end Steps

attribute [local instance] MvPolynomial.gradedAlgebra in
open Classical in
/-- **Bombieri's Lemma 8.** Let `X = (C, P)` be a curve of genus `g ≥ 2` over a number field `k`
with a divisor `P` of degree one and the standing data of Bombieri's Sections 9–10 over `k` (a
generic basis `x` of `L(N P)` giving `φNP`, `ψ = φNP × φNP`, and a basis `y` of
`H⁰(C × C, 𝒪(B))` generic for the projections giving `φB`). For every `c₁₀` there is
`c₁₄ > 0` such that for `γ > 0`, any `e = o(t)`, and `d₁, d₂, d` large enough with
`d₁ d₂ - g d² > γ d₁ d₂`, `g d² < d₁ d₂ < g² d²`, `N δᵢ = dᵢ + s d`, every section `s ≠ 0` of
`Faltings.vojtaLineBundle ψ φB δ₁ δ₂ d` with a representative `F` over `k` of height
`h(F) ≤ c₁₀ (d₁ + d₂) / γ + e (d₁ + d₂)`, every `k̄`-point `p = (z, w)` of `C × C` and every
`0 < ε < 1` with `d₂ / d₁ ≤ ε²` and `min (d₁ h_{NP}(z)) (d₂ h_{NP}(w)) ≥ c₁₄ d₁ / (γ ε²)` the
following holds: over every number field `K ⊆ k̄` of definition of `p` at which `z, w` lie outside
`Faltings.BombieriSiegel.exceptionalSet`, there is a pair `i` admissible for `s` at `(z, w)`
(`Faltings.BombieriRoth.IsAdmissiblePair`) with `i₁ / d₁ + i₂ / d₂ ≤ 4 N ε`. -/
@[faltings "lem_bvr_lemma8"]
public theorem exists_isAdmissiblePair_div_add_div_le {k : Type u} [Field k]
    [NumberField k] (X : CurveWithDegreeOneDivisor k) (hg : 2 ≤ genus X.f)
    (kbar : Type u) [Field kbar] [Algebra k kbar] [IsAlgClosure k kbar]
    [IsIntegral X.C] [IsLocallyNoetherian X.C]
    -- (N): the generic basis `x` of `L(N P)`
    (N : ℕ) (hN : 2 * genus X.f + 1 ≤ N) {n : ℕ} (hn : n = N - genus X.f)
    (x : Fin (n + 1) → X.C.functionField)
    (hx : haveI : IsCurve k X.f := Stacks.Chow.isCurve_of_smoothOfRelativeDimension_one X.f
      IsGenericBasis k X.f ((N : ℤ) • X.P.mapDomain Subtype.val) x)
    (hxbpf : ∀ c, Order.coheight c = 1 →
      ∃ i, X.C.ord (x i) c + ((N : ℤ) • X.P.mapDomain Subtype.val) c = 0)
    -- the product `C × C` and its diagonal
    [IsIntegral (pullback X.f X.f)] [IsLocallyNoetherian (pullback X.f X.f)]
    (Δ : X.C ⟶ pullback X.f X.f)
    (hΔ₁ : Δ ≫ pullback.fst X.f X.f = 𝟙 X.C) (hΔ₂ : Δ ≫ pullback.snd X.f X.f = 𝟙 X.C)
    -- the embedding `φ_{NP}` given by `x`, and `ψ = φ_{NP} × φ_{NP}`
    (φNP : X.C ⟶ projectiveSpaceOver n (Spec (.of k)))
    (hφNP : φNP ≫ (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) = X.f)
    [IsClosedImmersion φNP]
    [Stacks.Ample.IsInvertibleModule X.C
      (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ)) :=
          MvPolynomial.gradedAlgebra
       (Scheme.Modules.pullback φNP).obj
          ((Scheme.Modules.pullback (projectiveSpaceOver.toIntegralAtUniverse n _)).obj
            (ProjectiveSpectrum.Proj.twistingSheaf
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ)) 1)))]
    (hφNPL : Stacks.SheafOfModules.picardClass X.C.presheaf
        (Stacks.RingedSpace.structureIsSheaf X.C.toRingedSpace)
        (letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ)) :=
            MvPolynomial.gradedAlgebra
         (Scheme.Modules.pullback φNP).obj
            ((Scheme.Modules.pullback (projectiveSpaceOver.toIntegralAtUniverse n _)).obj
              (ProjectiveSpectrum.Proj.twistingSheaf
