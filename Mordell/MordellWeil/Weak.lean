module

public import Mathlib
public import Mordell.Attr
public import Mordell.AlgebraicGeometry.GroupScheme.Points
public import Mordell.MordellWeil.Kummer.Injection
public import Mordell.MordellWeil.TorsionLifting
public import Mordell.MordellWeil.TorsionField
public import Mordell.MordellWeil.Kummer.Finite

/-!
# The weak Mordell–Weil theorem

Let `A` be an abelian variety over a number field `k` and `m` a positive integer. Then the
quotient `A(k) / m A(k)` is finite.

## Main results

* `Faltings.finiteIndex_closure_range_pow_of_numberField`: for an abelian variety `A` over a
  number field `k` and `m ≠ 0`, the subgroup `m A(k)` has finite index in `A(k)`.

## Implementation notes

An abelian variety over `k` is a group object `A` in `Over (Spec k)` whose structure morphism
is proper and geometrically integral. The `k`-points `A(k)` are the morphisms
`Over.mk (𝟙 (Spec k)) ⟶ A`, a group under `CategoryTheory.Hom.group`, written
multiplicatively. The subgroup `m A(k)` is the subgroup generated by the `m`-th powers; since
`A(k)` is commutative it is the set of `m`-th powers, and finiteness of `A(k) / m A(k)` is
`Subgroup.FiniteIndex`, which does not need the commutativity of `A(k)` as an instance.

The statement is made for every `m ≠ 0`; the case `m = 1` is trivial, and the source states
`m ≥ 2`.

The proof passes to the field of `m`-torsion `L = k(A[m])`, over which all `m`-torsion of `A_L`
is rational; there the Kummer field is finite, so `A_L(L) / m A_L(L)` is finite, and the
finiteness descends from `L` to `k`.

## References

* X. Wu, *Diophantine geometry*, Theorem 2.1
* J. H. Silverman, *The Arithmetic of Elliptic Curves*, Theorem VIII.1.1
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped MonObj

universe u

namespace Faltings

/-- A group isomorphism carries the subgroup generated by `m`-th powers onto the subgroup
generated by `m`-th powers, so finiteness of its index transfers along the isomorphism. -/
private lemma finiteIndex_closure_range_pow_of_mulEquiv {G H : Type*} [Group G] [Group H]
    (e : G ≃* H) (m : ℕ)
    (h : (Subgroup.closure (Set.range fun P : G => P ^ m)).FiniteIndex) :
    (Subgroup.closure (Set.range fun P : H => P ^ m)).FiniteIndex := by
  have hc : (Subgroup.closure (Set.range fun P : G => P ^ m)).map (e : G →* H) =
      Subgroup.closure (Set.range fun P : H => P ^ m) := by
    rw [MonoidHom.map_closure, ← Set.range_comp]
    simp_rw [Function.comp_def, MonoidHom.coe_coe, map_pow]
    exact congrArg _ (e.surjective.range_comp (· ^ m))
  exact ⟨by rw [← hc, Subgroup.index_map_equiv]; exact h.index_ne_zero⟩

/-- Over the field of `m`-torsion `L = k(A[m])`, every `m`-torsion `k̄`-point of the base change
`A_L` is `L`-rational: it is the composite of `Spec k̄ ⟶ Spec L` with an `L`-point of `A_L`. -/
private lemma exists_comp_eq_of_pow_eq_one_pullback_torsionField (k : Type u) [Field k]
    [NumberField k] (kbar : Type u) [Field kbar] [Algebra k kbar] [IsAlgClosure k kbar]
    (A : Over (Spec (CommRingCat.of k))) [GrpObj A] [IsProper A.hom]
    [GeometricallyIntegral A.hom] (m : ℕ) (hm : 1 ≤ m) :
    letI : GrpObj ((Over.pullback (Spec.map (CommRingCat.ofHom
        (algebraMap k (torsionField k kbar A m hm))))).obj A) :=
      @Over.grpObjMkPullbackSnd _ _ _ _ _ _ A.hom _ ‹GrpObj A›
    ∀ T : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap (torsionField k kbar A m hm) kbar))) ⟶
      (Over.pullback (Spec.map (CommRingCat.ofHom
        (algebraMap k (torsionField k kbar A m hm))))).obj A, T ^ m = 1 →
      ∃ P : Over.mk (𝟙 (Spec (CommRingCat.of (torsionField k kbar A m hm)))) ⟶
          (Over.pullback (Spec.map (CommRingCat.ofHom
            (algebraMap k (torsionField k kbar A m hm))))).obj A,
        Over.homMk (U := Over.mk (Spec.map (CommRingCat.ofHom
            (algebraMap (torsionField k kbar A m hm) kbar))))
          (V := Over.mk (𝟙 (Spec (CommRingCat.of (torsionField k kbar A m hm)))))
          (Spec.map (CommRingCat.ofHom (algebraMap (torsionField k kbar A m hm) kbar)))
          (by simp) ≫ P = T := by
  intro T hT
  obtain ⟨e₁, he₁, -⟩ := exists_mulEquiv_points_pullback k (torsionField k kbar A m hm) kbar A
  obtain ⟨e₂, he₂, -⟩ := exists_mulEquiv_points_pullback k (torsionField k kbar A m hm)
    (torsionField k kbar A m hm) A
  obtain ⟨P₀, hP₀⟩ := mem_range_of_pow_eq_one_torsionField k kbar A m hm (e₁ T)
    (by rw [← map_pow, hT, map_one])
  obtain ⟨Q, rfl⟩ := e₂.surjective P₀
  refine ⟨Over.homMk Q.left (by simpa using Over.w Q), e₁.injective ?_⟩
  simp only at hP₀
  apply Over.OverMorphism.ext
  rw [← hP₀, he₁]
  simp [he₂]

/-- **Weak Mordell–Weil theorem.** Let `A` be an abelian variety over a number field `k` and
`m ≠ 0`. Then `m A(k)` has finite index in `A(k)`, i.e. `A(k) / m A(k)` is finite. -/
@[faltings "thm_mw_weak_mordell_weil"]
theorem finiteIndex_closure_range_pow_of_numberField
    (k : Type u) [Field k] [NumberField k]
    (A : Over (Spec (CommRingCat.of k))) [GrpObj A] [IsProper A.hom]
    [GeometricallyIntegral A.hom] {m : ℕ} (hm : m ≠ 0) :
    (Subgroup.closure
      (Set.range fun P : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ A => P ^ m)).FiniteIndex := by
  have hm1 : 1 ≤ m := Nat.one_le_iff_ne_zero.2 hm
  let kbar := AlgebraicClosure k
  let L := torsionField k kbar A m hm1
  obtain ⟨_, _⟩ := finiteDimensional_and_isGalois_torsionField k kbar A m hm1
  haveI : NumberField L := NumberField.of_module_finite k L
  haveI : IsAlgClosure L kbar :=
    have := IsAlgClosure.isAlgebraic (R := k) (K := kbar)
    ⟨IsAlgClosure.isAlgClosed k, .tower_top (K := k) L⟩
  letI : GrpObj ((Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k L)))).obj A) :=
    @Over.grpObjMkPullbackSnd _ _ _ _ _ _ A.hom _ ‹GrpObj A›
  haveI : IsProper ((Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k L)))).obj A).hom :=
    inferInstanceAs (IsProper (pullback.snd A.hom _))
  haveI : GeometricallyIntegral
      ((Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k L)))).obj A).hom :=
    inferInstanceAs (GeometricallyIntegral (pullback.snd A.hom _))
  have htors := exists_comp_eq_of_pow_eq_one_pullback_torsionField k kbar A m hm1
  have hfi := finiteIndex_closure_range_pow_of_finiteDimensional_kummerField L kbar _ m hm1 htors
    (finiteDimensional_kummerField L kbar _ m hm1 htors)
  obtain ⟨e, -, -⟩ := exists_mulEquiv_points_pullback k L L A
  exact finiteIndex_closure_range_pow_of_isGalois A hm1
    (finiteIndex_closure_range_pow_of_mulEquiv e m
      ((show Spec.map (CommRingCat.ofHom (algebraMap L L)) = 𝟙 _ by simp) ▸ hfi))

end Faltings
