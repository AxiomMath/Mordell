module

public import Mordell.AlgebraicGeometry.GeometricPoint.FieldOfDefinition
public import StacksFrontier.AlgebraicGeometry.GroupScheme.AbelianVariety.TorsionPoints
public import Mordell.AlgebraicGeometry.GroupScheme.BaseChange

/-!
# Weak Mordell–Weil descends along finite Galois extensions

Let `A` be an abelian variety over a number field `k`, let `m ≥ 1` and let `L / k` be a finite
Galois extension. If `A(L) / m A(L)` is finite, then so is `A(k) / m A(k)`.

Here `A(L)` is the group `Mor_k(Spec L, A)` of `L`-valued points of `A`, and `A(k)` the group
`Mor_k(Spec k, A)`, both with the group law induced from the group-object structure of `A` over
`Spec k` and written multiplicatively.

## Main definitions

* `Faltings.pointsToBaseChange`: for a tower `k ⊆ L ⊆ K`, the injective group hom
  `A(L) → A_K(K)` (`Faltings.pointsToBaseChange_injective`).

## Main results

* `Faltings.finiteIndex_closure_range_pow_of_isGalois`: if `m A(L)` has finite index in `A(L)`
  for a finite Galois extension `L / k`, then `m A(k)` has finite index in `A(k)`.
* `Faltings.finite_setOf_pow_eq_one`: for any field `L ⊇ k`, the `m`-torsion of `A(L)` is
  finite.

The inclusion `A(k) → A(L)` induces `A(k)/mA(k) → A(L)/mA(L)`, and its kernel
`N = (A(k) ∩ mA(L))/mA(k)` injects into the finite set of maps `Gal(L/k) → A(L)[m]`: to
`P = m Q_P` one attaches the cocycle `σ ↦ σ Q_P - Q_P`, and two classes with the same cocycle
differ by `m` times a `Gal(L/k)`-invariant point of `A(L)`, that is, a point of `A(k)`.

## Implementation notes

The extension `L` is an abstract field with a `k`-algebra structure rather than a subfield of a
fixed algebraic closure `k̄` of `k`: every finite extension of `k` is `k`-isomorphic to a
subfield of `k̄`, and the group of `L`-points depends only on the `k`-isomorphism class of `L`;
a subfield `L' : IntermediateField k k̄` is the case `L := L'`.

The point groups carry no commutative group instance, so `m A(-)` is the subgroup generated by
the `m`-th powers (which, the group being commutative, is the image of `[m]`), and finiteness of
the quotient is `Subgroup.FiniteIndex`.

The group-theoretic part of the argument is isolated in a statement about an injective
homomorphism `B →* C` into a commutative group with a finite family of endomorphisms whose
common fixed points are its image. The two geometric inputs are Galois descent for `L`-points (a
point `Spec L ⟶ A` fixed by `Gal(L/k)` has its residue field embedding with values in
`L^{Gal(L/k)} = k`) and finiteness of `A(L)[m]`, which injects into `A_{L̄}(L̄)[m]`, finite by
`Stacks.Groupoids.finite_torsionBy_of_isUnit` ([Stacks, Tag 03RP]).

## References

* [X. Wu, *Diophantine geometry*, weeks 9–10], Lemma 3.1
* [J. H. Silverman, *The Arithmetic of Elliptic Curves*], Lemma VIII.1.1.1
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory AlgebraicGeometry
open scoped MonObj

universe u

namespace Faltings

/-- `Spec` of a field extension is an epimorphism of schemes. -/
lemma epi_spec_map_algebraMap (k L : Type u) [Field k] [Field L] [Algebra k L] :
    Epi (Spec.map (CommRingCat.ofHom (algebraMap k L))) :=
  Flat.epi_of_flat_of_surjective _

/-- The cocycle argument: let `i : B →* C` be an injective homomorphism into a commutative group
and `s` a family of endomorphisms of `C` fixing the image of `i`, whose common fixed points lie
in the image of `i`. If `q ^ m = i P` and `q' ^ m = i P'`, and the cocycles `τ ↦ s τ q / q` and
`τ ↦ s τ q' / q'` agree, then `P⁻¹ * P'` is an `m`-th power in `B`. -/
private lemma exists_pow_eq_inv_mul_of_cocycle_eq {B C Γ : Type*} [Group B] [CommGroup C]
    {i : B →* C} (hi : Function.Injective i) {s : Γ → C →* C}
    (hfix : ∀ c, (∀ τ, s τ c = c) → ∃ b, i b = c) {m : ℕ} {P P' : B} {q q' : C}
    (hq : q ^ m = i P) (hq' : q' ^ m = i P') (h : ∀ τ, s τ q * q⁻¹ = s τ q' * q'⁻¹) :
    ∃ R, R ^ m = P⁻¹ * P' := by
  obtain ⟨R, hR⟩ := hfix (q⁻¹ * q') fun τ => by
    rw [map_mul, map_inv, inv_mul_eq_inv_mul_iff_mul_eq_mul,
      ← mul_inv_eq_mul_inv_iff_mul_eq_mul.1 (h τ), mul_comm]
  exact ⟨R, hi (by rw [map_pow, hR, mul_pow, inv_pow, hq, hq', map_mul, map_inv])⟩

/-- Let `i : B →* C` be an injective homomorphism into a commutative group and `s` a finite
family of endomorphisms of `C` fixing the image of `i`, whose common fixed points lie in the
image of `i`. If `C` has finitely many `m`-torsion elements and its `m`-th powers generate a
subgroup of finite index, then so do the `m`-th powers of `B`. -/
private theorem finiteIndex_closure_range_pow_of_injective {B C Γ : Type*} [Group B]
    [CommGroup C] [Finite Γ] (i : B →* C) (hi : Function.Injective i) (s : Γ → C →* C)
    (hs : ∀ τ b, s τ (i b) = i b) (hfix : ∀ c, (∀ τ, s τ c = c) → ∃ b, i b = c) {m : ℕ}
    (htors : {c : C | c ^ m = 1}.Finite)
    (hC : (Subgroup.closure (Set.range fun c : C => c ^ m)).FiniteIndex) :
    (Subgroup.closure (Set.range fun b : B => b ^ m)).FiniteIndex := by
  set HB := Subgroup.closure (Set.range fun b : B => b ^ m)
  set HC := Subgroup.closure (Set.range fun c : C => c ^ m)
  set K := HC.comap i
  have hle : HB ≤ K := (Subgroup.closure_le _).2 <| by
    rintro _ ⟨b, rfl⟩
    exact Subgroup.subset_closure ⟨i b, (map_pow i b m).symm⟩
  have hK : K.FiniteIndex := by
    rw [show K = ((QuotientGroup.mk' HC).comp i).ker by ext; simp [K]]
    infer_instance
  choose Q hQ using fun P : K => show ∃ q, q ^ m = i P from
    (Subgroup.closure_le (powMonoidHom m : C →* C).range).2
      (by rintro _ ⟨q, rfl⟩; exact ⟨q, rfl⟩) P.2
  let lam : K → Γ → {c : C // c ^ m = 1} := fun P τ =>
    ⟨s τ (Q P) * (Q P)⁻¹, by rw [mul_pow, inv_pow, ← map_pow, hQ, hs, mul_inv_cancel]⟩
  have : Finite {c : C // c ^ m = 1} := htors.to_subtype
  have : Finite (K ⧸ HB.subgroupOf K) := by
    refine Finite.of_injective (fun q => lam q.out) fun q q' h => ?_
    rw [← QuotientGroup.out_eq' q, ← QuotientGroup.out_eq' q', QuotientGroup.eq,
      Subgroup.mem_subgroupOf]
    obtain ⟨R, hR⟩ := exists_pow_eq_inv_mul_of_cocycle_eq hi hfix (hQ _) (hQ _)
      fun τ => congrArg Subtype.val (congrFun h τ)
    rw [Subgroup.coe_mul, Subgroup.coe_inv, ← hR]
    exact Subgroup.subset_closure ⟨R, rfl⟩
  have : (HB.subgroupOf K).FiniteIndex := Subgroup.finiteIndex_of_finite_quotient
  refine ⟨?_⟩
  rw [← Subgroup.relIndex_mul_index hle]
  exact mul_ne_zero Subgroup.FiniteIndex.index_ne_zero hK.index_ne_zero

section Points

variable {k L : Type u} [Field k] [Field L] [Algebra k L]
  (A : Over (Spec (CommRingCat.of k))) [GrpObj A]

/-- The inclusion `A(k) → A(L)`, precomposition with `Spec L ⟶ Spec k`, as a group hom. -/
private noncomputable def pointsInclusion : (Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ A) →*
    (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))) ⟶ A) where
  toFun P := Over.homMk (U := Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))))
    (V := Over.mk (𝟙 (Spec (CommRingCat.of k)))) (Spec.map (CommRingCat.ofHom (algebraMap k L)))
    (Category.comp_id _) ≫ P
  map_one' := MonObj.comp_one _
  map_mul' _ _ := MonObj.comp_mul _ _ _

omit [GrpObj A] in
/-- `Spec σ` for `σ ∈ Gal(L/k)` lies over `Spec k`. -/
private lemma spec_map_algEquiv_comp (σ : L ≃ₐ[k] L) :
    Spec.map (CommRingCat.ofHom (σ : L →+* L)) ≫ Spec.map (CommRingCat.ofHom (algebraMap k L)) =
      Spec.map (CommRingCat.ofHom (algebraMap k L)) := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  ext x
  exact σ.commutes x

/-- The action of `σ ∈ Gal(L/k)` on `A(L)`, precomposition with `Spec σ`, as a group hom. -/
private noncomputable def galoisAction (σ : L ≃ₐ[k] L) :
    (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))) ⟶ A) →*
      (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))) ⟶ A) where
  toFun Q := Over.homMk (U := Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))))
    (V := Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))))
    (Spec.map (CommRingCat.ofHom (σ : L →+* L))) (spec_map_algEquiv_comp σ) ≫ Q
  map_one' := MonObj.comp_one _
  map_mul' _ _ := MonObj.comp_mul _ _ _

/-- Points coming from `A(k)` are fixed by `Gal(L/k)`. -/
private lemma galoisAction_pointsInclusion (σ : L ≃ₐ[k] L)
    (P : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ A) :
    galoisAction A σ (pointsInclusion A P) = pointsInclusion A P := by
  simp only [galoisAction, pointsInclusion, MonoidHom.coe_mk, OneHom.coe_mk, ← Category.assoc]
  congr 1
  ext1
  exact spec_map_algEquiv_comp σ

/-- The inclusion `A(k) → A(L)` is injective. -/
private lemma pointsInclusion_injective : Function.Injective (pointsInclusion (L := L) A) := by
  intro P₁ P₂ h
  have := epi_spec_map_algebraMap k L
  have h' := congrArg CommaMorphism.left h
  simp only [pointsInclusion, MonoidHom.coe_mk, OneHom.coe_mk, Over.comp_left,
    Over.homMk_left] at h'
  exact Over.OverMorphism.ext ((cancel_epi _).1 h')

/-- Galois descent for `L`-points: a point of `A(L)` fixed by `Gal(L/k)` comes from `A(k)`. -/
private lemma exists_pointsInclusion_eq_of_forall [FiniteDimensional k L] [IsGalois k L]
    (Q : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))) ⟶ A)
    (hQ : ∀ σ, galoisAction A σ Q = Q) : ∃ P, pointsInclusion A P = Q := by
  obtain ⟨⟨x, f⟩, hxf⟩ : ∃ p, Scheme.SpecToEquivOfField L A.left Q.left = p := ⟨_, rfl⟩
  have hfix : ∀ (σ : L ≃ₐ[k] L) (a), σ (f.hom a) = f.hom a := by
    intro σ a
    have h := congrArg (fun R => Scheme.SpecToEquivOfField L A.left R.left) (hQ σ)
    simp only [galoisAction, MonoidHom.coe_mk, OneHom.coe_mk, Over.comp_left,
      Over.homMk_left] at h
    rw [specToEquivOfField_specMap_comp, hxf] at h
    have h2 := eq_of_heq (Sigma.mk.inj_iff.1 h).2
    exact congrArg (fun g => g.hom a) h2
  have hbot : ∀ a, f.hom a ∈ (⊥ : IntermediateField k L) := fun a =>
    (IsGalois.mem_bot_iff_fixed _).2 fun σ => hfix σ a
  let j : A.left.residueField x →+* k :=
    (IntermediateField.botEquiv k L).toRingEquiv.toRingHom.comp
      (f.hom.codRestrict (⊥ : IntermediateField k L) hbot)
  have hj : (algebraMap k L).comp j = f.hom := by
    ext a
    have := congrArg (fun y : (⊥ : IntermediateField k L) => (y : L))
      ((IntermediateField.botEquiv k L).symm_apply_apply ⟨f.hom a, hbot a⟩)
    simp only [IntermediateField.botEquiv_symm] at this
    exact this
  let P' : Spec (.of k) ⟶ A.left := Spec.map (CommRingCat.ofHom j) ≫ A.left.fromSpecResidueField x
  have hQ' : Spec.map (CommRingCat.ofHom (algebraMap k L)) ≫ P' = Q.left := by
    rw [← (Scheme.SpecToEquivOfField L A.left).symm_apply_apply Q.left, hxf,
      Scheme.SpecToEquivOfField_symm_apply, ← Category.assoc, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, hj]
    rfl
  have hover : P' ≫ A.hom = 𝟙 _ := by
    have := epi_spec_map_algebraMap k L
    apply (cancel_epi (Spec.map (CommRingCat.ofHom (algebraMap k L)))).1
    rw [reassoc_of% hQ', Over.w Q]
    simp
  refine ⟨Over.homMk P' hover, ?_⟩
  ext1
  simpa [pointsInclusion] using hQ'

end Points

section Torsion

variable {k L K : Type u} [Field k] [Field L] [Field K] [Algebra k L] [Algebra k K]
  [Algebra L K] [IsScalarTower k L K] (A : Over (Spec (CommRingCat.of k))) [GrpObj A]

/-- For a tower `k ⊆ L ⊆ K`, the group hom `A(L) → A_K(K)` sending a point to the section
`(Q', 1)` of the base change along `Spec K ⟶ Spec k` (`Faltings.GroupScheme.toBaseChange`), where
`Q'` is its composite with `Spec K ⟶ Spec L`. -/
noncomputable def pointsToBaseChange :
    (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))) ⟶ A) →*
      (𝟙_ (Over (Spec (CommRingCat.of K))) ⟶
        (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj A) :=
  (GroupScheme.toBaseChangeHom (Spec.map (CommRingCat.ofHom (algebraMap k K))) A).comp
    { toFun := fun Q => Over.homMk (U := Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k K))))
        (V := Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))))
        (Spec.map (CommRingCat.ofHom (algebraMap L K))) (by
          change Spec.map _ ≫ Spec.map _ = Spec.map _
          rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]) ≫ Q
      map_one' := MonObj.comp_one _
      map_mul' _ _ := MonObj.comp_mul _ _ _ }

/-- The `A`-component of `pointsToBaseChange A Q` is `Q` restricted along `Spec K ⟶ Spec L`. -/
lemma pointsToBaseChange_left_fst
    (Q : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))) ⟶ A) :
    (pointsToBaseChange (K := K) A Q).left ≫
        pullback.fst A.hom (Spec.map (CommRingCat.ofHom (algebraMap k K))) =
      Spec.map (CommRingCat.ofHom (algebraMap L K)) ≫ Q.left :=
  GroupScheme.toBaseChange_left_fst (Spec.map (CommRingCat.ofHom (algebraMap k K))) A _

/-- The map `A(L) → A_K(K)` is injective, `Spec K ⟶ Spec L` being an epimorphism. -/
lemma pointsToBaseChange_injective :
    Function.Injective (pointsToBaseChange (L := L) (K := K) A) := by
  intro Q₁ Q₂ h
  have := epi_spec_map_algebraMap L K
  have h' := congrArg (fun R => R.left ≫
    pullback.fst A.hom (Spec.map (CommRingCat.ofHom (algebraMap k K)))) h
  simp only [pointsToBaseChange_left_fst] at h'
  exact Over.OverMorphism.ext ((cancel_epi _).1 h')

end Torsion

/-- For an abelian variety `A` over a number field `k`, a field `L ⊇ k` and `m ≥ 1`, the group
`A(L)` has finitely many `m`-torsion points: `A(L)[m]` injects into `A_{L̄}(L̄)[m]`, which is
finite. -/
theorem finite_setOf_pow_eq_one {k L : Type u} [Field k] [NumberField k] [Field L]
    [Algebra k L] (A : Over (Spec (CommRingCat.of k))) [GrpObj A] [IsProper A.hom]
    [GeometricallyIntegral A.hom] {m : ℕ} (hm : 1 ≤ m) :
    {Q : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))) ⟶ A | Q ^ m = 1}.Finite := by
  have : IsIntegral A.left := GeometricallyIntegral.geometrically_isIntegral (f := A.hom)
    (𝟙 _) (𝟙 _) A.hom (IsPullback.of_horiz_isIso ⟨by simp⟩)
  have : IsAbelianVariety k A := .mk (toIsProperVariety := .mk (toIsVariety := .mk))
  let K := AlgebraicClosure L
  have : CharZero L := charZero_of_injective_algebraMap (algebraMap k L).injective
  have : CharZero K := charZero_of_injective_algebraMap (algebraMap L K).injective
  have hunit : IsUnit (m : K) := isUnit_iff_ne_zero.2 (Nat.cast_ne_zero.2 (by omega))
  have hfin := Stacks.Groupoids.finite_torsionBy_of_isUnit
    ((Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj A) m hunit
  let F : {Q : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))) ⟶ A | Q ^ m = 1} →
      Submodule.torsionBy ℤ (Additive (𝟙_ (Over (Spec (CommRingCat.of K))) ⟶
        (Over.pullback (Spec.map (CommRingCat.ofHom (algebraMap k K)))).obj A)) (m : ℤ) :=
    fun Q => ⟨Additive.ofMul (pointsToBaseChange (L := L) (K := K) A Q.1), by
      rw [Submodule.mem_torsionBy_iff, ← ofMul_zpow, zpow_natCast,
        ← map_pow (pointsToBaseChange (L := L) (K := K) A) Q.1 m, show Q.1 ^ m = 1 from Q.2,
        map_one, ofMul_one]⟩
  refine Set.finite_coe_iff.1 (Finite.of_injective F fun a b h => Subtype.ext ?_)
  exact pointsToBaseChange_injective A (by simpa [F] using congrArg Subtype.val h)

/-- Let `A` be an abelian variety over a number field `k`, let `m ≥ 1`, and let `L / k` be a
finite Galois extension. If `m A(L)` has finite index in `A(L) = Mor_k(Spec L, A)`, then
`m A(k)` has finite index in `A(k)`. -/
@[faltings "lem_mw_reduce_to_full_torsion"]
theorem finiteIndex_closure_range_pow_of_isGalois
    {k L : Type u} [Field k] [NumberField k] [Field L] [Algebra k L]
    [FiniteDimensional k L] [IsGalois k L]
    (A : Over (Spec (CommRingCat.of k))) [GrpObj A] [IsProper A.hom]
    [GeometricallyIntegral A.hom] {m : ℕ} (hm : 1 ≤ m)
    (hL : (Subgroup.closure (Set.range fun P :
      Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k L))) ⟶ A => P ^ m)).FiniteIndex) :
    (Subgroup.closure
      (Set.range fun P : Over.mk (𝟙 (Spec (CommRingCat.of k))) ⟶ A => P ^ m)).FiniteIndex := by
  have := isCommMonObj_of_isProper_of_geometricallyIntegral A
  exact finiteIndex_closure_range_pow_of_injective (pointsInclusion A)
    (pointsInclusion_injective A) (galoisAction A) (galoisAction_pointsInclusion A)
    (exists_pointsInclusion_eq_of_forall A) (finite_setOf_pow_eq_one A hm) hL

end Faltings
