module
public import Mathlib
public import Mordell.Attr

/-!
# A norm is divisible by its local factor

Let `K` be a field, `B` and `B'` commutative `K`-algebras (the coordinate rings of an affine
open `U` of a smooth curve, taken twice) with elements `ξ ∈ B`, `ξ' ∈ B'`, and let
`A = B ⊗[K] B'`, made an algebra over `R = K[X₀, X₁]` by `X₀ ↦ ξ ⊗ 1`, `X₁ ↦ 1 ⊗ ξ'`, finite and
free as an `R`-module. Let `z : B →ₐ[K] K`, `w : B' →ₐ[K] K` be `K`-points with
`z ξ = t₀`, `w ξ' = t₀'`, at which the local rings are discrete valuation rings with
uniformizers `ξ - t₀` and `ξ' - t₀'`, and let `q₀ ⊆ A` be the maximal ideal of the point
`(z, w)`. Then the completion `Â_{q₀}` is the power series ring `K⟦t, t'⟧` with
`t = ξ ⊗ 1 - t₀`, `t' = 1 ⊗ ξ' - t₀'`, and for every `f ∈ A` the norm `Norm_{A/R} f ∈ R`,
read in `K⟦t, t'⟧` by `X₀ ↦ t₀ + t`, `X₁ ↦ t₀' + t'`, is divisible by the image of `f`.

The completion is computed through its finite levels. Since `B_{ker z}` is a discrete valuation
ring with residue field `K` and uniformizer `u = ξ - t₀`, the map `K[X] → B ⧸ (ker z) ^ n`,
`X ↦ u`, is surjective with kernel `(X ^ n)`. Hence `A ⧸ q₀ ^ n` is generated by the images of
`t` and `t'`, and the truncated Taylor expansions of `B` and `B'` multiply to an inverse of
`K[X₀, X₁] ⧸ (X₀, X₁) ^ n → A ⧸ q₀ ^ n`. So the completions of `K[X₀, X₁]` at `(X₀, X₁)` and of
`A` at `q₀` agree, and the first one is `K⟦X₀, X₁⟧`. The divisibility is Cayley–Hamilton: `f`
divides `Norm f = ± χ_f(0)` already in `A`.

## Main results

* `Faltings.exists_algEquiv_adicCompletion_dvd_norm`: the identification
  `K⟦t, t'⟧ ≃ₐ[K] Â_{q₀}` and the divisibility of the norm by the local factor.

## Implementation notes

The source decomposes `A ⊗ K⟦t, t'⟧` into the product of the completed local rings over
`(t₀, t₀')`, the norm being the product of the local determinants. We use only that `f` divides
its norm in `A` and the identification of one completed local ring, which gives the same
divisibility without the other factors.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Section 9.
-/

open Polynomial TensorProduct

namespace Faltings

/-! ### Units modulo powers of a maximal ideal -/

private lemma exists_mul_sub_one_mem_pow {R : Type*} [CommRing R] {m : Ideal R}
    (hm : m.IsMaximal) {s : R} (hs : s ∉ m) (k : ℕ) : ∃ v, v * s - 1 ∈ m ^ k := by
  obtain ⟨y, i, hi, hyi⟩ := hm.exists_inv hs
  have : IsCoprime (m ^ k) (Ideal.span {s}) :=
    IsCoprime.pow_left (Ideal.isCoprime_iff_exists.mpr ⟨i, hi, y * s,
      Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self s), by rw [← hyi]; ring⟩)
  obtain ⟨a, ha, b, hb, hab⟩ := Ideal.isCoprime_iff_exists.mp this
  obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton'.mp hb
  exact ⟨v, by rw [show v * s - 1 = -a by linear_combination hab]; exact neg_mem ha⟩

/-! ### Local expansions at a point with a uniformizer -/

private lemma exists_sub_mul_mem_pow {R : Type*} [CommRing R] (m : Ideal R) [m.IsPrime]
    (hm : m.IsMaximal) (u : R)
    [IsDomain (Localization.AtPrime m)] [IsDiscreteValuationRing (Localization.AtPrime m)]
    (hu : Irreducible (algebraMap R (Localization.AtPrime m) u)) {b : R} (hb : b ∈ m) (k : ℕ) :
    ∃ c, b - u * c ∈ m ^ k := by
  set L := Localization.AtPrime m
  have hbL : algebraMap R L b ∈ IsLocalRing.maximalIdeal L := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]; exact Ideal.mem_map_of_mem _ hb
  rw [(IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hu,
    Ideal.mem_span_singleton'] at hbL
  obtain ⟨y, hy⟩ := hbL
  obtain ⟨⟨c, s⟩, rfl⟩ := IsLocalization.mk'_surjective m.primeCompl y
  have h : algebraMap R L (c * u) = algebraMap R L (s * b) := by
    rw [map_mul, map_mul, ← hy, ← IsLocalization.mk'_spec L c s]; ring
  obtain ⟨w, hw⟩ := (IsLocalization.eq_iff_exists m.primeCompl L).mp h
  have hws : (w * s : R) ∉ m := fun h' => (‹m.IsPrime›.mem_or_mem h').elim w.2 s.2
  obtain ⟨v, hv⟩ := exists_mul_sub_one_mem_pow hm hws k
  refine ⟨v * w * c, ?_⟩
  rw [show b - u * (v * w * c) = -((v * (w * s) - 1) * b) by linear_combination (-v) * hw]
  exact neg_mem (Ideal.mul_mem_right _ _ hv)

section Expansion

variable {K : Type*} [Field K]

private lemma exists_sub_aeval_mem_pow {R : Type*} [CommRing R] [Algebra K R] (z : R →ₐ[K] K)
    [(RingHom.ker z).IsPrime] [IsDomain (Localization.AtPrime (RingHom.ker z))]
    [IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker z))]
    (u : R) (hzu : z u = 0)
    (hu : Irreducible (algebraMap R (Localization.AtPrime (RingHom.ker z)) u)) (n : ℕ) (b : R) :
    ∃ p : K[X], b - aeval u p ∈ RingHom.ker z ^ n := by
  have hm : (RingHom.ker z).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective z (fun c => ⟨algebraMap K R c, by simp⟩)
  have key : ∀ j, ∃ (p : K[X]) (c : R), b - aeval u p - u ^ j * c ∈ RingHom.ker z ^ n := by
    intro j
    induction j with
    | zero => exact ⟨0, b, by simp⟩
    | succ j ih =>
      obtain ⟨p, c, h⟩ := ih
      have hc : c - algebraMap K R (z c) ∈ RingHom.ker z := by simp [RingHom.mem_ker]
      obtain ⟨d, hd⟩ := exists_sub_mul_mem_pow _ hm u hu hc n
      refine ⟨p + C (z c) * X ^ j, d, ?_⟩
      have : b - aeval u (p + C (z c) * X ^ j) - u ^ (j + 1) * d =
          (b - aeval u p - u ^ j * c) + u ^ j * (c - algebraMap K R (z c) - u * d) := by
        simp only [map_add, map_mul, aeval_C, aeval_X_pow]
        ring
      rw [this]
      exact add_mem h (Ideal.mul_mem_left _ _ hd)
  obtain ⟨p, c, h⟩ := key n
  refine ⟨p, ?_⟩
  have hu' : u ^ n * c ∈ RingHom.ker z ^ n :=
    Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow (by simpa [RingHom.mem_ker] using hzu) n)
  simpa using add_mem h hu'

/-- Pushed along `j : R → S`, the expansion of `exists_sub_aeval_mem_pow` holds modulo `Q ^ n`
for any ideal `Q` containing the image of `ker z`. -/
private lemma exists_sub_aeval_mem_pow_of_map_le {R : Type*} [CommRing R] [Algebra K R]
    (z : R →ₐ[K] K) [(RingHom.ker z).IsPrime] [IsDomain (Localization.AtPrime (RingHom.ker z))]
    [IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker z))]
    (u : R) (hzu : z u = 0)
    (hu : Irreducible (algebraMap R (Localization.AtPrime (RingHom.ker z)) u)) (n : ℕ)
    {S : Type*} [CommRing S] [Algebra K S] (j : R →ₐ[K] S) {Q : Ideal S}
    (hQ : (RingHom.ker z).map j ≤ Q) (b : R) :
    ∃ p : K[X], j b - aeval (j u) p ∈ Q ^ n := by
  obtain ⟨p, hp⟩ := exists_sub_aeval_mem_pow z u hzu hu n b
  refine ⟨p, ?_⟩
  rw [aeval_algHom_apply, ← map_sub]
  exact Ideal.pow_right_mono hQ n (Ideal.map_pow j _ n ▸ Ideal.mem_map_of_mem j hp)

/-- Two `K`-algebra maps out of `R` killing `(ker z) ^ n` agree as soon as they agree on the
uniformizer `u`. -/
private lemma algHom_ext_of_pow_ker {R : Type*} [CommRing R] [Algebra K R]
    (z : R →ₐ[K] K) [(RingHom.ker z).IsPrime] [IsDomain (Localization.AtPrime (RingHom.ker z))]
    [IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker z))]
    (u : R) (hzu : z u = 0)
    (hu : Irreducible (algebraMap R (Localization.AtPrime (RingHom.ker z)) u)) (n : ℕ)
    {S : Type*} [CommRing S] [Algebra K S] {φ ψ : R →ₐ[K] S}
    (hφ : ∀ r ∈ RingHom.ker z ^ n, φ r = 0) (hψ : ∀ r ∈ RingHom.ker z ^ n, ψ r = 0)
    (h : φ u = ψ u) : φ = ψ := by
  ext b
  obtain ⟨p, hp⟩ := exists_sub_aeval_mem_pow z u hzu hu n b
  have hφb : φ b = φ (aeval u p) := by rw [← sub_eq_zero, ← map_sub, hφ _ hp]
  have hψb : ψ b = ψ (aeval u p) := by rw [← sub_eq_zero, ← map_sub, hψ _ hp]
  rw [hφb, hψb, ← aeval_algHom_apply, ← aeval_algHom_apply, h]

private lemma X_pow_dvd_of_aeval_mem_pow {R : Type*} [CommRing R] [Algebra K R]
    (z : R →ₐ[K] K)
    [(RingHom.ker z).IsPrime] [IsDomain (Localization.AtPrime (RingHom.ker z))]
    [IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker z))]
    (u : R) (hu : Irreducible (algebraMap R (Localization.AtPrime (RingHom.ker z)) u)) (n : ℕ)
    (p : K[X]) (hp : aeval u p ∈ RingHom.ker z ^ n) : X ^ n ∣ p := by
  set L := Localization.AtPrime (RingHom.ker z)
  set ϖ := algebraMap R L u
  have hmax := (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mp hu
  have h1 : aeval ϖ p ∈ Ideal.span {ϖ ^ n} := by
    rw [← Ideal.span_singleton_pow, ← hmax, ← Localization.AtPrime.map_eq_maximalIdeal,
      ← Ideal.map_pow]
    have := Ideal.mem_map_of_mem (algebraMap R L) hp
    rwa [← aeval_algebraMap_apply] at this
  rw [Ideal.mem_span_singleton] at h1
  classical
  by_contra hcon
  rw [X_pow_dvd_iff] at hcon
  push Not at hcon
  obtain ⟨j, hjn, hj, hmin⟩ : ∃ j < n, p.coeff j ≠ 0 ∧ ∀ d < j, p.coeff d = 0 :=
    ⟨Nat.find hcon, (Nat.find_spec hcon).1, (Nat.find_spec hcon).2, fun d hd =>
      by_contra fun h => Nat.find_min hcon hd ⟨hd.trans (Nat.find_spec hcon).1, h⟩⟩
  obtain ⟨q, rfl⟩ := X_pow_dvd_iff.mpr hmin
  have hq0 : q.coeff 0 ≠ 0 := by simpa [coeff_X_pow_mul'] using hj
  have hunit : IsUnit (aeval ϖ q) := by
    by_contra hnu
    have hmem : aeval ϖ q ∈ IsLocalRing.maximalIdeal L := hnu
    rw [← X_mul_divX_add q] at hmem
    simp only [map_add, map_mul, aeval_X, aeval_C] at hmem
    have hϖ : ϖ ∈ IsLocalRing.maximalIdeal L := hu.not_isUnit
    have := (Ideal.add_mem_iff_right _ (Ideal.mul_mem_right _ _ hϖ)).mp hmem
    exact this ((IsUnit.mk0 _ hq0).map (algebraMap K L))
  rw [map_mul, map_pow, aeval_X] at h1
  have h2 : ϖ ^ n ∣ ϖ ^ j := (IsUnit.dvd_mul_right hunit).mp h1
  have := (pow_dvd_pow_iff hu.ne_zero hu.not_isUnit).mp h2
  omega

/-- The truncated Taylor expansion at a point with a uniformizer `u`: every `K`-algebra map out
of `K[X]` killing `X ^ n` factors through `R` along `X ↦ u`, killing `(ker z) ^ n`. -/
private lemma exists_algHom_aeval_eq {R : Type*} [CommRing R] [Algebra K R] (z : R →ₐ[K] K)
    [(RingHom.ker z).IsPrime] [IsDomain (Localization.AtPrime (RingHom.ker z))]
    [IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker z))]
    (u : R) (hzu : z u = 0)
    (hu : Irreducible (algebraMap R (Localization.AtPrime (RingHom.ker z)) u)) (n : ℕ)
    {S : Type*} [CommRing S] [Algebra K S] (g : K[X] →ₐ[K] S) (hg : ∀ p, X ^ n ∣ p → g p = 0) :
    ∃ β : R →ₐ[K] S, (∀ p, β (aeval u p) = g p) ∧ ∀ r ∈ RingHom.ker z ^ n, β r = 0 := by
  let φ : K[X] →ₐ[K] R ⧸ RingHom.ker z ^ n := (Ideal.Quotient.mkₐ K _).comp (aeval u)
  have hφ : Function.Surjective φ := by
    intro y
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨p, hp⟩ := exists_sub_aeval_mem_pow z u hzu hu n b
    exact ⟨p, (Ideal.Quotient.eq.mpr hp).symm⟩
  have hker : ∀ p ∈ RingHom.ker φ, g p = 0 := fun p hp => hg p
    (X_pow_dvd_of_aeval_mem_pow z u hu n p
      (Ideal.Quotient.eq_zero_iff_mem.mp (RingHom.mem_ker.mp hp)))
  let e := Ideal.quotientKerAlgEquivOfSurjective hφ
  refine ⟨((Ideal.Quotient.liftₐ _ g hker).comp e.symm.toAlgHom).comp
    (Ideal.Quotient.mkₐ K _), fun p => ?_, fun r hr => ?_⟩
  · have : e.symm (Ideal.Quotient.mk _ (aeval u p)) = Ideal.Quotient.mk _ p :=
      e.symm_apply_eq.mpr rfl
    change Ideal.Quotient.liftₐ (RingHom.ker φ) g hker
      (e.symm (Ideal.Quotient.mk _ (aeval u p))) = g p
    rw [this]
    exact AlgHom.congr_fun (Ideal.Quotient.liftₐ_comp _ g hker) p
  · simp [Ideal.Quotient.eq_zero_iff_mem.mpr hr]

/-! ### Adic completions along maps inducing isomorphisms on the quotients -/

private lemma factor_evalₐ {S : Type*} [CommRing S] (I : Ideal S) {m n : ℕ} (h : m ≤ n)
    (x : AdicCompletion I S) :
    Ideal.Quotient.factor (Ideal.pow_le_pow_right h) (AdicCompletion.evalₐ I n x) =
      AdicCompletion.evalₐ I m x := by
  obtain ⟨x, rfl⟩ := AdicCompletion.mk_surjective I S x
  simp only [AdicCompletion.evalₐ_mk, Ideal.Quotient.factor_mk]
  exact AdicCompletion.Ideal.mk_eq_mk I h x

/-- A map `ι : P → A` with `ι (J ^ n) ⊆ q ^ n` inducing isomorphisms `P ⧸ J ^ n ≃ A ⧸ q ^ n` for
all `n` induces an isomorphism of adic completions. -/
private lemma exists_algEquiv_adicCompletion {R P A : Type*} [CommRing R] [CommRing P]
    [CommRing A] [Algebra R P] [Algebra R A] (J : Ideal P) (q : Ideal A) (ι : P →ₐ[R] A)
    (hι : ∀ n, J ^ n ≤ (q ^ n).comap ι)
    (hbij : ∀ n, Function.Bijective (Ideal.quotientMapₐ (q ^ n) ι (hι n))) :
    ∃ e : AdicCompletion J P ≃ₐ[R] AdicCompletion q A,
      ∀ p, e (AdicCompletion.of J P p) = AdicCompletion.of q A (ι p) := by
  let en n := AlgEquiv.ofBijective _ (hbij n)
  have hen : ∀ n p, en n (Ideal.Quotient.mk _ p) = Ideal.Quotient.mk _ (ι p) := fun n p => rfl
  have nat : ∀ {m n} (h : m ≤ n) y, Ideal.Quotient.factor (Ideal.pow_le_pow_right h) (en n y) =
      en m (Ideal.Quotient.factor (Ideal.pow_le_pow_right h) y) := by
    intro m n h y
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    simp only [hen, Ideal.Quotient.factor_mk]
  have nat' : ∀ {m n} (h : m ≤ n) y,
      Ideal.Quotient.factor (Ideal.pow_le_pow_right h) ((en n).symm y) =
        (en m).symm (Ideal.Quotient.factor (Ideal.pow_le_pow_right h) y) := by
    intro m n h y
    apply (en m).injective
    rw [AlgEquiv.apply_symm_apply, ← nat h, AlgEquiv.apply_symm_apply]
  let Φ : AdicCompletion J P →ₐ[R] AdicCompletion q A :=
    AdicCompletion.liftAlgHom q
      (fun n => (en n).toAlgHom.comp ((AdicCompletion.evalₐ J n).restrictScalars R))
      (fun h => AlgHom.ext fun x => (nat h _).trans (congrArg (en _) (factor_evalₐ J h x)))
  let Ψ : AdicCompletion q A →ₐ[R] AdicCompletion J P :=
    AdicCompletion.liftAlgHom J
      (fun n => (en n).symm.toAlgHom.comp ((AdicCompletion.evalₐ q n).restrictScalars R))
      (fun h => AlgHom.ext fun x =>
        (nat' h _).trans (congrArg (en _).symm (factor_evalₐ q h x)))
  have hΦ : ∀ n x, AdicCompletion.evalₐ q n (Φ x) = en n (AdicCompletion.evalₐ J n x) :=
    fun n x => AdicCompletion.evalₐ_liftAlgHom _ _ _ n x
  have hΨ : ∀ n x, AdicCompletion.evalₐ J n (Ψ x) = (en n).symm (AdicCompletion.evalₐ q n x) :=
    fun n x => AdicCompletion.evalₐ_liftAlgHom _ _ _ n x
  refine ⟨AlgEquiv.ofAlgHom Φ Ψ
    (AlgHom.ext fun x => AdicCompletion.ext_evalₐ fun n => by
      simp only [AlgHom.comp_apply, AlgHom.id_apply, hΦ, hΨ, AlgEquiv.apply_symm_apply])
    (AlgHom.ext fun x => AdicCompletion.ext_evalₐ fun n => by
      simp only [AlgHom.comp_apply, AlgHom.id_apply, hΦ, hΨ, AlgEquiv.symm_apply_apply]),
    fun p => AdicCompletion.ext_evalₐ fun n => ?_⟩
  change AdicCompletion.evalₐ q n (Φ (AdicCompletion.of J P p)) = _
  rw [hΦ, AdicCompletion.evalₐ_of, AdicCompletion.evalₐ_of, hen]

/-! ### The quotients of the tensor product by powers of the point -/

private lemma mem_idealOfVars_of_aeval_zero_eq_zero {p : MvPolynomial (Fin 2) K}
    (hp : MvPolynomial.aeval (0 : Fin 2 → K) p = 0) : p ∈ MvPolynomial.idealOfVars (Fin 2) K := by
  rw [← pow_one (MvPolynomial.idealOfVars (Fin 2) K), MvPolynomial.mem_pow_idealOfVars_iff']
  intro x hx
  obtain rfl : x = 0 := (Finsupp.degree_eq_zero_iff x).mp (by omega)
  simpa [← MvPolynomial.constantCoeff_eq] using hp

section TensorProduct

variable {B B' : Type*} [CommRing B] [Algebra K B] [CommRing B'] [Algebra K B']
  (z : B →ₐ[K] K) (w : B' →ₐ[K] K)

private lemma map_includeLeft_ker_le :
    (RingHom.ker z).map (Algebra.TensorProduct.includeLeft : B →ₐ[K] B ⊗[K] B') ≤
      RingHom.ker (Algebra.TensorProduct.productMap z w) := by
  rw [Ideal.map_le_iff_le_comap]
  intro b hb
  simp [RingHom.mem_ker.mp hb]

private lemma map_includeRight_ker_le :
    (RingHom.ker w).map (Algebra.TensorProduct.includeRight : B' →ₐ[K] B ⊗[K] B') ≤
      RingHom.ker (Algebra.TensorProduct.productMap z w) := by
  rw [Ideal.map_le_iff_le_comap]
  intro b hb
  simp [RingHom.mem_ker.mp hb]

private lemma idealOfVars_pow_le_comap {u : B} {u' : B'} (hzu : z u = 0) (hwu' : w u' = 0)
    (n : ℕ) :
    MvPolynomial.idealOfVars (Fin 2) K ^ n ≤
      (RingHom.ker (Algebra.TensorProduct.productMap z w) ^ n).comap
        (MvPolynomial.aeval ![u ⊗ₜ 1, 1 ⊗ₜ u']) := by
  rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
  refine Ideal.pow_right_mono ?_ n
  rw [Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
  fin_cases i <;> simp [RingHom.mem_ker, hzu, hwu']

variable
  [(RingHom.ker z).IsPrime] [IsDomain (Localization.AtPrime (RingHom.ker z))]
  [IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker z))]
  [(RingHom.ker w).IsPrime] [IsDomain (Localization.AtPrime (RingHom.ker w))]
  [IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker w))]
  (u : B) (u' : B') (hzu : z u = 0) (hwu' : w u' = 0)
  (hu : Irreducible (algebraMap B (Localization.AtPrime (RingHom.ker z)) u))
  (hu' : Irreducible (algebraMap B' (Localization.AtPrime (RingHom.ker w)) u'))

include hzu hwu' hu hu' in
private lemma exists_sub_aeval_mem_pow_ker_productMap (n : ℕ) (a : B ⊗[K] B') :
    ∃ p : MvPolynomial (Fin 2) K, a - MvPolynomial.aeval ![u ⊗ₜ 1, 1 ⊗ₜ u'] p ∈
      RingHom.ker (Algebra.TensorProduct.productMap z w) ^ n := by
  set q := RingHom.ker (Algebra.TensorProduct.productMap z w)
  set ι : MvPolynomial (Fin 2) K →ₐ[K] B ⊗[K] B' := MvPolynomial.aeval ![u ⊗ₜ 1, 1 ⊗ₜ u']
  let S : Subalgebra K (B ⊗[K] B') :=
    (((Ideal.Quotient.mkₐ K (q ^ n)).comp ι).range).comap (Ideal.Quotient.mkₐ K (q ^ n))
  have hS : ∀ a, a ∈ S ↔ ∃ p, a - ι p ∈ q ^ n := fun a => by
    simp only [S, Subalgebra.mem_comap, AlgHom.mem_range, AlgHom.comp_apply,
      Ideal.Quotient.mkₐ_eq_mk]
    exact exists_congr fun p => by rw [Ideal.Quotient.eq, ← neg_mem_iff, neg_sub]
  suffices a ∈ S from (hS a).mp this
  induction a using TensorProduct.induction_on with
  | zero => exact S.zero_mem
  | tmul b b' =>
    rw [show b ⊗ₜ[K] b' = (b ⊗ₜ 1) * (1 ⊗ₜ b') by simp]
    obtain ⟨p, hp⟩ := exists_sub_aeval_mem_pow_of_map_le z u hzu hu n
      (Algebra.TensorProduct.includeLeft : B →ₐ[K] B ⊗[K] B') (map_includeLeft_ker_le z w) b
    obtain ⟨p', hp'⟩ := exists_sub_aeval_mem_pow_of_map_le w u' hwu' hu' n
      (Algebra.TensorProduct.includeRight : B' →ₐ[K] B ⊗[K] B') (map_includeRight_ker_le z w) b'
    refine S.mul_mem ((hS _).mpr ⟨Polynomial.aeval (MvPolynomial.X 0) p, ?_⟩)
      ((hS _).mpr ⟨Polynomial.aeval (MvPolynomial.X 1) p', ?_⟩)
    · rwa [← Polynomial.aeval_algHom_apply, MvPolynomial.aeval_X]
    · rwa [← Polynomial.aeval_algHom_apply, MvPolynomial.aeval_X]
  | add x y hx hy => exact S.add_mem hx hy

include hzu hwu' hu hu' in
private lemma mem_pow_idealOfVars_of_aeval_mem_pow_ker_productMap (n : ℕ)
    (p : MvPolynomial (Fin 2) K)
    (hp : MvPolynomial.aeval ![u ⊗ₜ 1, 1 ⊗ₜ u'] p ∈
      RingHom.ker (Algebra.TensorProduct.productMap z w) ^ n) :
    p ∈ MvPolynomial.idealOfVars (Fin 2) K ^ n := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  set J := MvPolynomial.idealOfVars (Fin 2) K
  set ι : MvPolynomial (Fin 2) K →ₐ[K] B ⊗[K] B' := MvPolynomial.aeval ![u ⊗ₜ 1, 1 ⊗ₜ u']
  have hXJ : ∀ i, MvPolynomial.X i ∈ J := fun i => Ideal.subset_span ⟨i, rfl⟩
  have hg : ∀ i : Fin 2, ∀ r : K[X], X ^ n ∣ r →
      (Ideal.Quotient.mkₐ K (J ^ n)).comp (Polynomial.aeval (MvPolynomial.X i)) r = 0 := by
    rintro i _ ⟨c, rfl⟩
    rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem, map_mul,
      map_pow, Polynomial.aeval_X]
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow (hXJ i) n)
  obtain ⟨β, hβ, hβ0⟩ := exists_algHom_aeval_eq z u hzu hu n _ (hg 0)
  obtain ⟨β', hβ', hβ0'⟩ := exists_algHom_aeval_eq w u' hwu' hu' n _ (hg 1)
  let θ := Algebra.TensorProduct.productMap β β'
  have hβu : β u = Ideal.Quotient.mk _ (MvPolynomial.X 0) := by simpa using hβ Polynomial.X
  have hβu' : β' u' = Ideal.Quotient.mk _ (MvPolynomial.X 1) := by simpa using hβ' Polynomial.X
  have hθι : ∀ r, θ (ι r) = Ideal.Quotient.mk _ r := by
    refine AlgHom.congr_fun
      (MvPolynomial.algHom_ext fun i => ?_ : θ.comp ι = Ideal.Quotient.mkₐ K (J ^ n))
    fin_cases i <;> simp [θ, ι, hβu, hβu']
  have hJ : J ≤ RingHom.ker (MvPolynomial.aeval (0 : Fin 2 → K)) :=
    Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; simp)
  have hJn : ∀ a ∈ J ^ n, MvPolynomial.aeval (0 : Fin 2 → K) a = 0 :=
    fun a ha => hJ (Ideal.pow_le_self hn.ne' ha)
  let ε := Ideal.Quotient.liftₐ (J ^ n) (MvPolynomial.aeval (0 : Fin 2 → K)) hJn
  have hεβ : ε.comp β = z := algHom_ext_of_pow_ker z u hzu hu n
    (fun r hr => by simp [hβ0 r hr]) (fun r hr => Ideal.pow_le_self hn.ne' hr)
    (by simp [ε, hβu, hzu])
  have hεβ' : ε.comp β' = w := algHom_ext_of_pow_ker w u' hwu' hu' n
    (fun r hr => by simp [hβ0' r hr]) (fun r hr => Ideal.pow_le_self hn.ne' hr)
    (by simp [ε, hβu', hwu'])
  have hεθ : ε.comp θ = Algebra.TensorProduct.productMap z w :=
    Algebra.TensorProduct.ext' fun b b' => by
      simp [θ, ← AlgHom.comp_apply ε β, ← AlgHom.comp_apply ε β', hεβ, hεβ']
  have hq : RingHom.ker (Algebra.TensorProduct.productMap z w) ≤
      (J.map (Ideal.Quotient.mk (J ^ n))).comap θ := by
    intro x hx
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (θ x)
    have hr0 := AlgHom.congr_fun hεθ x
    rw [AlgHom.comp_apply, ← hr, RingHom.mem_ker.mp hx] at hr0
    rw [Ideal.mem_comap, ← hr]
    exact Ideal.mem_map_of_mem _ (mem_idealOfVars_of_aeval_zero_eq_zero (by simpa [ε] using hr0))
  have h1 : θ (ι p) ∈ (RingHom.ker (Algebra.TensorProduct.productMap z w) ^ n).map θ :=
    Ideal.mem_map_of_mem _ hp
  rw [Ideal.map_pow] at h1
  have h2 := Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr hq) n h1
  rw [← Ideal.map_pow, Ideal.map_quotient_self, hθι] at h2
  exact Ideal.Quotient.eq_zero_iff_mem.mp h2

include hzu hwu' hu hu' in
/-- The finite levels of the completion: `K[X₀, X₁] ⧸ (X₀, X₁) ^ n ≃ (B ⊗[K] B') ⧸ q ^ n` along
`X₀ ↦ u ⊗ 1`, `X₁ ↦ 1 ⊗ u'`. -/
private lemma bijective_quotientMapₐ_aeval (n : ℕ) :
    Function.Bijective (Ideal.quotientMapₐ _ _ (idealOfVars_pow_le_comap z w hzu hwu' n)) := by
  refine ⟨fun x y hxy => ?_, fun y => ?_⟩
  · obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨p', rfl⟩ := Ideal.Quotient.mk_surjective y
    refine Ideal.Quotient.eq.mpr
      (mem_pow_idealOfVars_of_aeval_mem_pow_ker_productMap z w u u' hzu hwu' hu hu' n _ ?_)
    rw [map_sub]
    exact Ideal.Quotient.eq.mp hxy
  · obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨p, hp⟩ := exists_sub_aeval_mem_pow_ker_productMap z w u u' hzu hwu' hu hu' n a
    exact ⟨Ideal.Quotient.mk _ p, (Ideal.Quotient.eq.mpr hp).symm⟩

include hzu hwu' hu hu' in
/-- The completion of `B ⊗[K] B'` at the kernel of `z ⊗ w` is `K⟦X₀, X₁⟧`, with `X₀ ↦ u ⊗ 1` and
`X₁ ↦ 1 ⊗ u'`. -/
private lemma exists_algEquiv_mvPowerSeries :
    ∃ e : MvPowerSeries (Fin 2) K ≃ₐ[K]
        AdicCompletion (RingHom.ker (Algebra.TensorProduct.productMap z w)) (B ⊗[K] B'),
      ∀ p : MvPolynomial (Fin 2) K,
        e p = algebraMap (B ⊗[K] B') _ (MvPolynomial.aeval ![u ⊗ₜ 1, 1 ⊗ₜ u'] p) := by
  obtain ⟨e₀, he₀⟩ := exists_algEquiv_adicCompletion _ _ _ _
    (bijective_quotientMapₐ_aeval z w u u' hzu hwu' hu hu')
  refine ⟨((MvPowerSeries.toAdicCompletionAlgEquiv (Fin 2) K).restrictScalars K).trans e₀,
    fun p => ?_⟩
  have : MvPowerSeries.toAdicCompletionAlgEquiv (Fin 2) K p =
      AdicCompletion.of (MvPolynomial.idealOfVars (Fin 2) K) _ p := by
    simp [MvPowerSeries.toAdicCompletion_coe]
  rw [AlgEquiv.trans_apply, AlgEquiv.restrictScalars_apply, this, he₀,
    AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]

end TensorProduct

end Expansion

/-! ### The norm is a multiple -/

/-- By Cayley–Hamilton, an element of a finite free algebra divides its norm. -/
private lemma dvd_algebraMap_norm {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [Module.Free R S] [Module.Finite R S] (f : S) : f ∣ algebraMap R S (Algebra.norm R f) := by
  set χ := (Algebra.lmul R S f).charpoly
  have h0 : aeval f χ = 0 := Algebra.aeval_self_charpoly_lmul f
  rw [← X_mul_divX_add χ, map_add, map_mul, aeval_X, aeval_C] at h0
  refine ⟨-(-1) ^ Module.finrank R S * aeval f χ.divX, ?_⟩
  rw [Algebra.norm_apply, LinearMap.det_eq_sign_charpoly_coeff, map_mul, map_pow, map_neg,
    map_one]
  linear_combination (-1) ^ Module.finrank R S * h0

/-! ### The norm is divisible by its local factor -/

/-- Let `A = B ⊗[K] B'` be finite free over `R = K[X₀, X₁]` via `X₀ ↦ ξ ⊗ 1`, `X₁ ↦ 1 ⊗ ξ'`,
and let `(z, w)` be a `K`-point of `A` over `(t₀, t₀')` at which `ξ - t₀` and `ξ' - t₀'` are
uniformizers of the local rings of `B` and `B'`. Then the adic completion of `A` at the point is
`K⟦t, t'⟧` with `t ↦ ξ ⊗ 1 - t₀`, `t' ↦ 1 ⊗ ξ' - t₀'`, and in `K⟦t, t'⟧` the norm
`Algebra.norm R f` (with `X₀ ↦ t₀ + t`, `X₁ ↦ t₀' + t'`) is divisible by the image of `f`. -/
@[faltings "lem_bvr_norm_local_factor"]
public theorem exists_algEquiv_adicCompletion_dvd_norm {K B B' : Type*} [Field K]
    [CommRing B] [Algebra K B] [CommRing B'] [Algebra K B']
    [Algebra (MvPolynomial (Fin 2) K) (B ⊗[K] B')]
    [IsScalarTower K (MvPolynomial (Fin 2) K) (B ⊗[K] B')]
    [Module.Free (MvPolynomial (Fin 2) K) (B ⊗[K] B')]
    [Module.Finite (MvPolynomial (Fin 2) K) (B ⊗[K] B')]
    (ξ : B) (ξ' : B')
    (hX : algebraMap (MvPolynomial (Fin 2) K) (B ⊗[K] B') (MvPolynomial.X 0) = ξ ⊗ₜ 1)
    (hY : algebraMap (MvPolynomial (Fin 2) K) (B ⊗[K] B') (MvPolynomial.X 1) = 1 ⊗ₜ ξ')
    (t₀ t₀' : K) (z : B →ₐ[K] K) (w : B' →ₐ[K] K) (hzξ : z ξ = t₀) (hwξ' : w ξ' = t₀')
    (hz : letI := RingHom.ker_isPrime z
      ∃ _ : IsDomain (Localization.AtPrime (RingHom.ker z)),
        IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker z)) ∧
        Irreducible (algebraMap B (Localization.AtPrime (RingHom.ker z)) (ξ - algebraMap K B t₀)))
    (hw : letI := RingHom.ker_isPrime w
      ∃ _ : IsDomain (Localization.AtPrime (RingHom.ker w)),
        IsDiscreteValuationRing (Localization.AtPrime (RingHom.ker w)) ∧
        Irreducible
          (algebraMap B' (Localization.AtPrime (RingHom.ker w)) (ξ' - algebraMap K B' t₀')))
    (f : B ⊗[K] B') :
    ∃ e : MvPowerSeries (Fin 2) K ≃ₐ[K]
        AdicCompletion (RingHom.ker (Algebra.TensorProduct.productMap z w)) (B ⊗[K] B'),
      e (MvPowerSeries.X 0) = algebraMap (B ⊗[K] B') _ (ξ ⊗ₜ 1 - algebraMap K _ t₀) ∧
      e (MvPowerSeries.X 1) = algebraMap (B ⊗[K] B') _ (1 ⊗ₜ ξ' - algebraMap K _ t₀') ∧
      ∃ h : MvPowerSeries (Fin 2) K,
        MvPolynomial.aeval
            ![algebraMap K _ t₀ + MvPowerSeries.X 0, algebraMap K _ t₀' + MvPowerSeries.X 1]
            (Algebra.norm (MvPolynomial (Fin 2) K) f) =
          e.symm (algebraMap (B ⊗[K] B') _ f) * h := by
  have := RingHom.ker_isPrime z
  have := RingHom.ker_isPrime w
  obtain ⟨_, _, hu⟩ := hz
  obtain ⟨_, _, hu'⟩ := hw
  obtain ⟨e, he⟩ := exists_algEquiv_mvPowerSeries z w _ _ (by simp [hzξ]) (by simp [hwξ']) hu hu'
  have heX : ∀ i, e (MvPowerSeries.X i) = algebraMap (B ⊗[K] B') _
      (![ξ ⊗ₜ 1 - algebraMap K _ t₀, 1 ⊗ₜ ξ' - algebraMap K _ t₀'] i) := by
    intro i
    rw [← MvPolynomial.coe_X, he]
    fin_cases i
    · simp [sub_tmul, Algebra.TensorProduct.algebraMap_apply]
    · simp [tmul_sub, Algebra.TensorProduct.tmul_one_eq_one_tmul]
  obtain ⟨g, hg⟩ := dvd_algebraMap_norm (R := MvPolynomial (Fin 2) K) f
  refine ⟨e, heX 0, heX 1, e.symm (algebraMap (B ⊗[K] B') _ g), ?_⟩
  rw [← map_mul, ← map_mul, ← hg, eq_comm, e.symm_apply_eq]
  have key : (IsScalarTower.toAlgHom K (B ⊗[K] B') (AdicCompletion _ (B ⊗[K] B'))).comp
      (IsScalarTower.toAlgHom K (MvPolynomial (Fin 2) K) (B ⊗[K] B')) =
      e.toAlgHom.comp (MvPolynomial.aeval
        ![algebraMap K _ t₀ + MvPowerSeries.X 0, algebraMap K _ t₀' + MvPowerSeries.X 1]) := by
    refine MvPolynomial.algHom_ext fun i => ?_
    fin_cases i <;> simp [heX, hX, hY,
      IsScalarTower.algebraMap_apply K (B ⊗[K] B') (AdicCompletion _ (B ⊗[K] B'))]
  exact AlgHom.congr_fun key _

end Faltings
