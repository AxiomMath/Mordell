module

public import Mathlib
public import Mordell.Attr

/-!
# The local ring at the zero of a transcendental element

Let `F/K` be an algebraic function field and let `z ∈ F` be transcendental over `K`. The local
ring at the zero of `z` is the `K`-subalgebra
`R_z = {f(z) / g(z) : f, g ∈ K[Z], g(0) ≠ 0}` of `K(z) ⊆ F`.
Since `z` is transcendental, `g(z) ≠ 0` for every nonzero polynomial `g`, in particular when
`g(0) ≠ 0`, so these quotients are honest quotients. Abstractly, `R_z` is the image in `F` of the
localization of `K[Z]` at the maximal ideal `(Z)`.

## Main definitions

* `Faltings.FunctionField.localRingAtZero`: the `K`-subalgebra `R_z` of `F`.

## Implementation notes

The function field is Mathlib's `FunctionField K F` (that is, `FiniteDimensional (RatFunc K) F`)
with `IsScalarTower K (RatFunc K) F` expressing that `K → K(X) → F` is the structure map.
The condition `g(0) ≠ 0` is written `g.coeff 0 ≠ 0`, which is the same condition
(`Polynomial.coeff_zero_eq_eval_zero`).

## References

* [H. Stichtenoth, *Algebraic Function Fields and Codes*][stichtenoth2009], cf. Proposition 1.1.6
-/

@[expose] public section

namespace Faltings.FunctionField

open Polynomial

/-- The local ring `R_z = {f(z)/g(z) : f, g ∈ K[Z], g(0) ≠ 0}` at the zero of an element `z` of a
function field `F/K` transcendental over `K`, as a `K`-subalgebra of `F`. -/
@[faltings "def_ff_local_ring_at_zero"]
def localRingAtZero {K F : Type*} [Field K] [Field F] [Algebra K F]
    [Algebra (RatFunc K) F] [IsScalarTower K (RatFunc K) F] [FunctionField K F] {z : F}
    (hz : Transcendental K z) : Subalgebra K F where
  carrier := {x | ∃ f g : K[X], g.coeff 0 ≠ 0 ∧ x = aeval z f / aeval z g}
  mul_mem' := by
    rintro _ _ ⟨f₁, g₁, hg₁, rfl⟩ ⟨f₂, g₂, hg₂, rfl⟩
    refine ⟨f₁ * f₂, g₁ * g₂, ?_, ?_⟩
    · simp [hg₁, hg₂]
    · rw [map_mul, map_mul, div_mul_div_comm]
  add_mem' := by
    have ne : ∀ g : K[X], g.coeff 0 ≠ 0 → aeval z g ≠ 0 := fun g hg h =>
      hz ⟨g, fun h0 => hg (by simp [h0]), h⟩
    rintro _ _ ⟨f₁, g₁, hg₁, rfl⟩ ⟨f₂, g₂, hg₂, rfl⟩
    refine ⟨f₁ * g₂ + g₁ * f₂, g₁ * g₂, ?_, ?_⟩
    · simp [hg₁, hg₂]
    · rw [div_add_div _ _ (ne g₁ hg₁) (ne g₂ hg₂)]
      simp
  algebraMap_mem' r := ⟨C r, 1, by simp, by simp⟩

end Faltings.FunctionField

end


/-!
# The local ring at the zero of a transcendental element is a discrete valuation ring

Let `F/K` be a field extension and `z ∈ F` transcendental over `K`. The `K`-subalgebra
`R_z = {f(z)/g(z) : g(0) ≠ 0}` of `F` (`Faltings.FunctionField.localRingAtZero`) is the
localization of `K[z] ≅ K[Z]` at the maximal ideal `(z)`. It is a discrete valuation ring whose
maximal ideal is generated by `z`, and its fraction field is `K(z)`, embedded by the inclusion
`R_z ⊆ K(z)`.

## Main results

* `Faltings.FunctionField.isDiscreteValuationRing_localRingAtZero`: `R_z` is a discrete
  valuation ring, `z ∈ R_z` generates its maximal ideal, and `K(z)` is its fraction field.

## Implementation notes

"The maximal ideal is `z R_z`" is stated as `(Ideal.span {z}).IsMaximal`; in the local ring
`R_z` this says exactly that `Ideal.span {z}` is the maximal ideal, without requiring an
`IsLocalRing` instance in the statement. "The fraction field is `K(z)`" is stated as
`IsFractionRing R_z K⟮z⟯` for the algebra structure given by the inclusion `R_z ≤ K⟮z⟯`.

## References

* [H. Stichtenoth, *Algebraic Function Fields and Codes*][stichtenoth2009], cf. Proposition 1.1.6
* [The Stacks Project, Tag 00PD][stacks-project]
-/

public section

namespace Faltings.FunctionField

open Polynomial IntermediateField

variable {K F : Type*} [Field K] [Field F]
    [Algebra K F] [Algebra (RatFunc K) F] [IsScalarTower K (RatFunc K) F] [FunctionField K F]
    {z : F}

private lemma aeval_ne_zero (hz : Transcendental K z) {g : K[X]} (hg : g.coeff 0 ≠ 0) :
    aeval z g ≠ 0 := fun h => hz ⟨g, fun h0 => hg (by simp [h0]), h⟩

private lemma aeval_mem (hz : Transcendental K z) (f : K[X]) : aeval z f ∈ localRingAtZero hz :=
  ⟨f, 1, by simp, by simp⟩

/-- Evaluation at `z`, as a ring map `K[X] → R_z`. -/
private noncomputable def evalHom (hz : Transcendental K z) : K[X] →+* localRingAtZero hz :=
  ((aeval z : K[X] →ₐ[K] F).codRestrict (localRingAtZero hz) (aeval_mem hz)).toRingHom

private lemma not_mem_span_X_iff {g : K[X]} : g ∉ Ideal.span {(X : K[X])} ↔ g.coeff 0 ≠ 0 := by
  rw [Ideal.mem_span_singleton, X_dvd_iff]

private lemma isPrime_span_X : (Ideal.span {(X : K[X])}).IsPrime :=
  (Ideal.span_singleton_prime X_ne_zero).mpr irreducible_X.prime

/-- Evaluation at `z` exhibits `R_z` as the localization of `K[X]` at the prime `(X)`: the
elements `g` with `g(0) ≠ 0` become units, every `f(z)/g(z)` is a fraction, and evaluation is
injective because `z` is transcendental. -/
private lemma isLocalization (hz : Transcendental K z) :
    letI := (evalHom hz).toAlgebra
    haveI := isPrime_span_X (K := K)
    IsLocalization.AtPrime (localRingAtZero hz) (Ideal.span {(X : K[X])}) := by
  let := (evalHom hz).toAlgebra
  have := isPrime_span_X (K := K)
  refine ⟨fun ⟨g, hg⟩ => ?_, fun ⟨x, f, g, hg, hx⟩ => ?_, fun {a b} h => ⟨1, ?_⟩⟩
  · have hg' := aeval_ne_zero hz (not_mem_span_X_iff.mp hg)
    exact isUnit_iff_exists_inv.mpr
      ⟨⟨(aeval z g)⁻¹, 1, g, not_mem_span_X_iff.mp hg, by simp⟩, Subtype.ext (mul_inv_cancel₀ hg')⟩
  · exact ⟨⟨f, ⟨g, not_mem_span_X_iff.mpr hg⟩⟩,
      Subtype.ext (by subst hx; exact div_mul_cancel₀ _ (aeval_ne_zero hz hg))⟩
  · simp [transcendental_iff_injective.mp hz (congrArg Subtype.val h)]

private lemma le_adjoin (hz : Transcendental K z) : localRingAtZero hz ≤ K⟮z⟯.toSubalgebra := by
  rintro _ ⟨f, g, -, rfl⟩
  have h : ∀ p : K[X], aeval z p ∈ K⟮z⟯ := fun p =>
    IntermediateField.algebra_adjoin_le_adjoin K {z} (aeval_mem_adjoin_singleton K z)
  exact (K⟮z⟯).div_mem (h f) (h g)

/-- `K(z)` is the fraction field of `R_z`: every `r(z)/s(z) ∈ K(z)` is already a quotient of
the elements `r(z), s(z)` of `R_z`. -/
private lemma isFractionRing_adjoin (hz : Transcendental K z) :
    letI := (Subalgebra.inclusion (le_adjoin hz)).toRingHom.toAlgebra
    IsFractionRing (localRingAtZero hz) K⟮z⟯ := by
  let := (Subalgebra.inclusion (le_adjoin hz)).toRingHom.toAlgebra
  have : FaithfulSMul (localRingAtZero hz) K⟮z⟯ :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (Subalgebra.inclusion_injective _)
  refine IsFractionRing.of_field _ _ fun ⟨w, hw⟩ => ?_
  obtain ⟨r, s, rfl⟩ := (mem_adjoin_simple_iff K w).mp hw
  exact ⟨⟨_, aeval_mem hz r⟩, ⟨_, aeval_mem hz s⟩, Subtype.ext rfl⟩

private lemma mem_localRingAtZero (hz : Transcendental K z) : z ∈ localRingAtZero hz := by
  simpa using aeval_mem hz X

/-- `R_z` is a DVR: it is the localization of the PID `K[X]` at the nonzero prime `(X)`. -/
private lemma isDiscreteValuationRing (hz : Transcendental K z) :
    IsDiscreteValuationRing (localRingAtZero hz) := by
  let := (evalHom hz).toAlgebra
  have := isPrime_span_X (K := K)
  have := isLocalization hz
  exact IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain K[X]
    (by simp [X_ne_zero] : Ideal.span {(X : K[X])} ≠ ⊥) (localRingAtZero hz)

/-- The maximal ideal of `R_z` is generated by `z`, the image of the generator `X` of `(X)`. -/
private lemma isMaximal_span (hz : Transcendental K z) :
    (Ideal.span {(⟨z, mem_localRingAtZero hz⟩ : localRingAtZero hz)}).IsMaximal := by
  let := (evalHom hz).toAlgebra
  have := isPrime_span_X (K := K)
  have := isLocalization hz
  have := isDiscreteValuationRing hz
  have h := IsLocalization.AtPrime.map_eq_maximalIdeal (Ideal.span {(X : K[X])})
    (localRingAtZero hz)
  rw [Ideal.map_span, Set.image_singleton,
    show algebraMap K[X] (localRingAtZero hz) X = ⟨z, mem_localRingAtZero hz⟩ from
      Subtype.ext (aeval_X z)] at h
  rw [h]
  exact IsLocalRing.maximalIdeal.isMaximal _

/-- For `z ∈ F` transcendental over `K`, the local ring `R_z` at the zero of `z` is a discrete
valuation ring, its maximal ideal is generated by `z`, and its fraction field is `K⟮z⟯`, via the
inclusion `R_z ⊆ K⟮z⟯`. -/
@[faltings "lem_ff_local_ring_at_zero_dvr"]
theorem isDiscreteValuationRing_localRingAtZero {K F : Type*} [Field K] [Field F]
    [Algebra K F] [Algebra (RatFunc K) F] [IsScalarTower K (RatFunc K) F] [FunctionField K F]
    {z : F} (hz : Transcendental K z) :
    IsDiscreteValuationRing (localRingAtZero hz) ∧
    (∃ h : z ∈ localRingAtZero hz,
      (Ideal.span {(⟨z, h⟩ : localRingAtZero hz)}).IsMaximal) ∧
    ∃ h : localRingAtZero hz ≤ K⟮z⟯.toSubalgebra,
      letI := (Subalgebra.inclusion h).toRingHom.toAlgebra
      IsFractionRing (localRingAtZero hz) K⟮z⟯ :=
  ⟨isDiscreteValuationRing hz, ⟨mem_localRingAtZero hz, isMaximal_span hz⟩,
    le_adjoin hz, isFractionRing_adjoin hz⟩

end Faltings.FunctionField

end
