module

public import Mordell.Height.Weil.LocalHeight
public import Mordell.Height.Weil.PointField

/-!
# The absolute logarithmic Weil height on projective space

Let `x` be a point of `ℙⁿ(ℚ̄)` with homogeneous coordinates `(x_0, …, x_n)`, let `j₀` be the least
index with `x_{j₀} ≠ 0`, and let `x̃ = (x_0 / x_{j₀}, …, x_n / x_{j₀})`, a vector with entries in
the field of definition `ℚ(x)`, which depends only on `x`. The (absolute logarithmic Weil)
height of `x` is the sum of the local heights of `x̃` over the places of the number field `ℚ(x)`:
`h(x) = S_{ℚ(x)}(x̃) = ∑_{v ∈ M_{ℚ(x)}} max_j log |x̃_j|_v`.

## Main definitions

* `Faltings.weilHeight x`: the height `h(x) = S_{ℚ(x)}(x̃)` of `x : ℙ K (ι → K)`.

## Implementation notes

The point lives in `ℙ K (ι → K)` for an arbitrary algebraic extension `K / ℚ` and a finite,
linearly ordered index type `ι`; `K = AlgebraicClosure ℚ` and `ι = Fin (n + 1)` give `ℙⁿ(ℚ̄)`.
The field `ℚ(x)` is `Faltings.pointField ℚ x`; it is generated by finitely many algebraic
elements, hence is a number field, and this instance is supplied inside the definition. The
normalized vector `x̃` is computed from the representative `Projectivization.rep x`; it does not
depend on that choice.

Mathlib's `Projectivization.logHeight` is the height of a point of `ℙ K (ι → K)` for a fixed
number field `K`, relative to `K`; the height here is absolute, computed over `ℚ(x)` inside an
arbitrary algebraic extension of `ℚ`.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Sec. 2.
* [Z. Gao, *Heights*][gao2022], Def. 1.2.7.
-/

@[expose] public section

open scoped LinearAlgebra.Projectivization

namespace Faltings

open Classical in
/-- The absolute logarithmic Weil height `h(x) = S_{ℚ(x)}(x̃)` of a point `x` of `ℙ K (ι → K)`,
`K / ℚ` algebraic: with `j₀` the least index such that `x_{j₀} ≠ 0`, it is the sum of local
heights `Faltings.sumLocalHeight` over the number field `ℚ(x) = Faltings.pointField ℚ x`
of the vector `x̃ = (x_i / x_{j₀})_i`, whose entries lie in `ℚ(x)`. -/
@[faltings "def_ht_weil_height_projective"]
public noncomputable def weilHeight {K : Type*} [Field K] [Algebra ℚ K] [Algebra.IsAlgebraic ℚ K]
    {ι : Type*} [Fintype ι] [LinearOrder ι] (x : ℙ K (ι → K)) : ℝ :=
  have hne : (Finset.univ.filter fun j => x.rep j ≠ 0).Nonempty := by
    obtain ⟨j, hj⟩ := Function.ne_iff.mp x.rep_nonzero
    exact ⟨j, by simpa using hj⟩
  let j₀ : ι := (Finset.univ.filter fun j => x.rep j ≠ 0).min' hne
  have hj₀ : x.rep j₀ ≠ 0 := by
    simpa using Finset.min'_mem _ hne
  have hfin : FiniteDimensional ℚ (pointField ℚ x) := by
    have : Finite {r : K | ∃ i j, x.rep j ≠ 0 ∧ r = x.rep i / x.rep j} :=
      ((Set.finite_range fun p : ι × ι => x.rep p.1 / x.rep p.2).subset
        (by rintro r ⟨i, j, -, rfl⟩; exact ⟨(i, j), rfl⟩)).to_subtype
    exact IntermediateField.finiteDimensional_adjoin fun r _ =>
      (Algebra.IsAlgebraic.isAlgebraic r).isIntegral
  letI : NumberField (pointField ℚ x) :=
    { to_finiteDimensional := by convert hfin; exact Subsingleton.elim _ _ }
  sumLocalHeight fun i : ι => (⟨x.rep i / x.rep j₀,
    IntermediateField.subset_adjoin ℚ _ ⟨i, j₀, hj₀, rfl⟩⟩ : pointField ℚ x)

end Faltings

/-!
# The height of an affine point

For `ξ = (ξ_1, …, ξ_n) ∈ ℚ̄ⁿ` the (affine) height is the Weil height of the projective point
`(1 : ξ_1 : … : ξ_n)`, that is `h(ξ) = h(1 : ξ_1 : … : ξ_n)`. In particular, for `α ∈ ℚ̄`,
`h(α) = h(1 : α)` is the height of the vector `![α]`.

## Main definitions

* `Faltings.affineWeilHeight ξ`: the height `h(ξ) = h(1 : ξ_1 : … : ξ_n)` of `ξ : Fin n → K`.

## Implementation notes

The coordinates lie in an arbitrary algebraic extension `K / ℚ`; `K = AlgebraicClosure ℚ` gives
`ℚ̄ⁿ`. The point `(1 : ξ)` is `Fin.cons 1 ξ : Fin (n + 1) → K`, which is nonzero because its first
coordinate is `1`. The height of a single algebraic number `α` is `affineWeilHeight ![α]`.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Sec. 2.
-/

@[expose] public section

namespace Faltings

/-- The height `h(ξ) = h(1 : ξ_1 : … : ξ_n)` of an affine point `ξ ∈ Kⁿ`, `K / ℚ` algebraic:
the Weil height `Faltings.weilHeight` of the projective point with homogeneous coordinates
`(1, ξ_1, …, ξ_n)`. For `α ∈ K`, `h(α) = h(1 : α)` is `affineWeilHeight ![α]`. -/
@[faltings "def_ht_affine_height"]
public noncomputable def affineWeilHeight {K : Type*} [Field K] [Algebra ℚ K]
    [Algebra.IsAlgebraic ℚ K] {n : ℕ} (ξ : Fin n → K) : ℝ :=
  weilHeight (Projectivization.mk K (Fin.cons 1 ξ : Fin (n + 1) → K)
    fun h => one_ne_zero (congr_fun h 0))

end Faltings
