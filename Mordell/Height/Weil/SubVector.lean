module

public import Mordell.Height.Weil.Representative

/-!
# The height of a sub-vector

Let `x = (x_0 : ⋯ : x_n)` be a point of projective space over an algebraic extension of `ℚ` and
let `S` be a set of indices with `x_S = (x_j)_{j ∈ S} ≠ 0`. Then the point `x_S` has height at
most that of `x`: `h(x_S) ≤ h(x)`. At each place `v`, `max_{j ∈ S} |x_j|_v ≤ max_j |x_j|_v`.

## Main results

* `Faltings.weilHeight_mk_comp_le`: for `v : ι → K` and any map `f : κ → ι` with `v ∘ f ≠ 0`,
  `h(v ∘ f) ≤ h(v)`.

## Implementation notes

The selection of coordinates is an arbitrary map `f : κ → ι` of finite linearly ordered index
types, and the points are given through homogeneous coordinates with `Projectivization.mk`.
The sub-vector `x_S` is the case `κ = S`, `f = Subtype.val` (for instance `S : Finset ι`);
repeating coordinates (a non-injective `f`) does not change any of the local maxima.

Both heights are computed over the number field `F = ℚ(v_i : i ∈ ι)` generated by the
coordinates, through `Faltings.weilHeight_eq_sumLocalHeight`, and compared place by place.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Sec. 2.
* [Z. Gao, *Heights*][gao2022].
-/

@[expose] public section

open scoped LinearAlgebra.Projectivization

namespace Faltings

/-- At every place, the local height of a sub-vector is at most that of the vector. -/
private theorem localHeight_comp_le {F : Type*} [Field F] [NumberField F] {ι κ : Type*}
    [Finite ι] [Finite κ] (w : NumberFieldPlace F) (y : ι → F) (f : κ → ι) (hf : y ∘ f ≠ 0) :
    w.localHeight (y ∘ f) ≤ w.localHeight y := by
  obtain ⟨k, -⟩ := Function.ne_iff.mp hf
  have : Nonempty κ := ⟨k⟩
  unfold NumberFieldPlace.localHeight
  exact Real.log_le_log (w.vectorAbv_pos hf)
    (ciSup_le fun k => w.normalizedAbv_le_vectorAbv y (f k))

/-- The height of a sub-vector is at most the height of the vector: if `v : ι → K` and
`f : κ → ι` is such that `v ∘ f ≠ 0`, then the point `(v (f k))_k` has Weil height
`Faltings.weilHeight` at most that of the point `(v i)_i`. -/
@[faltings "lem_ht_height_elementary_projective"]
public theorem weilHeight_mk_comp_le {K : Type*} [Field K] [Algebra ℚ K]
    [Algebra.IsAlgebraic ℚ K] {ι κ : Type*} [Fintype ι] [LinearOrder ι] [Fintype κ]
    [LinearOrder κ] (v : ι → K) (f : κ → ι) (hf : v ∘ f ≠ 0) :
    weilHeight (Projectivization.mk K (v ∘ f) hf) ≤
      weilHeight (Projectivization.mk K v fun h => hf (by simp [h])) := by
  let F := IntermediateField.adjoin ℚ (Set.range v)
  have hfin : FiniteDimensional ℚ F :=
    IntermediateField.finiteDimensional_adjoin fun r _ =>
      (Algebra.IsAlgebraic.isAlgebraic r).isIntegral
  let : NumberField F :=
    { to_finiteDimensional := by convert hfin; exact Subsingleton.elim _ _ }
  let y : ι → F := fun i => ⟨v i, IntermediateField.subset_adjoin ℚ _ ⟨i, rfl⟩⟩
  have hy : algebraMap F K ∘ y = v := rfl
  have hyf : y ∘ f ≠ 0 := fun h => hf (by rw [← hy, Function.comp_assoc, h]; ext; simp)
  have hy0 : y ≠ 0 := fun h => hyf (by rw [h]; rfl)
  rw [weilHeight_eq_sumLocalHeight (x := Projectivization.mk K (v ∘ f) hf) (y := y ∘ f) hf rfl,
    weilHeight_eq_sumLocalHeight (x := Projectivization.mk K v _) (y := y)
      (fun h => hf (by simp [hy ▸ h])) rfl]
  exact finsum_le_finsum' (NumberFieldPlace.finite_support_localHeight hyf)
    (NumberFieldPlace.finite_support_localHeight hy0) fun w => localHeight_comp_le w y f hyf

end Faltings
