module

public import Mathlib
public import Mordell.Attr

/-!
# The field of definition of a point of projective space

For a field extension `K / k` and a point `x` of the projective space `ℙ K (ι → K)`, the field
of definition `k(x)` of `x` is the intermediate field of `K / k` generated by the ratios
`x_i / x_j` (with `x_j ≠ 0`) of homogeneous coordinates of `x`; its degree `[k(x) : k]` is the
degree of `x`. The case of interest is `k = ℚ`, `K = ℚ̄` and `ι = Fin (n + 1)`, i.e. points of
`ℙⁿ(ℚ̄)`, where `ℚ(x)` is a number field.

## Main definitions

* `Faltings.pointField k x`: the field of definition of `x : ℙ K (ι → K)` over `k`.
* `Faltings.degreeOfPoint k x`: the degree `[k(x) : k]` of `x`.

## Implementation notes

The ratios are taken of the chosen representative `Projectivization.rep x`; since any two
representatives differ by a nonzero scalar, the ratios `x_i / x_j` do not depend on this choice.
The definitions are stated for an arbitrary extension `K / k` and an arbitrary index type `ι`;
`ℙⁿ(ℚ̄)` is `ℙ (AlgebraicClosure ℚ) (Fin (n + 1) → AlgebraicClosure ℚ)`. That `ℚ(x)` is a
number field (finite-dimensionality when `ι` is finite and `K / k` algebraic) is a lemma, not
part of the definition.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][Bombieri1990], Sec. 2
* [Z. Gao, *Lecture notes on heights*][Gao2022], Def. 1.2.7
-/

@[expose] public section

open scoped LinearAlgebra.Projectivization

namespace Faltings

variable (k : Type*) {K : Type*} [Field k] [Field K] [Algebra k K] {ι : Type*}

/-- The field of definition `k(x)` of a point `x` of `ℙ K (ι → K)` over `k`: the intermediate
field of `K / k` generated by the ratios `x_i / x_j`, `x_j ≠ 0`, of homogeneous coordinates
of `x`. -/
@[faltings "def_ht_point_field"]
noncomputable def pointField (x : ℙ K (ι → K)) : IntermediateField k K :=
  IntermediateField.adjoin k {r | ∃ i j, x.rep j ≠ 0 ∧ r = x.rep i / x.rep j}

/-- The degree `[k(x) : k]` of a point `x` of `ℙ K (ι → K)` over `k`. -/
@[faltings "def_ht_point_field"]
noncomputable abbrev degreeOfPoint (x : ℙ K (ι → K)) : ℕ :=
  Module.finrank k (pointField k x)

end Faltings


/-!
# Coordinates in the field of definition

Every point `x` of the projective space `ℙ K (ι → K)` over a field extension `K / k` has
homogeneous coordinates lying in its field of definition `k(x)`, one of which is equal to `1`:
if `x_j ≠ 0`, the coordinates `x_i / x_j` do. For `k = ℚ`, `K = ℚ̄` and `ι = Fin (n + 1)` this
is the statement for points of `ℙⁿ(ℚ̄)`.

## Main results

* `Faltings.exists_coords_fieldOfDefinition_eq_one`: a representative of `x` with all
  coordinates in `Faltings.pointField k x` and one coordinate equal to `1`.

## References

* [Z. Gao, *Lecture notes on heights*][Gao2022], Sec. 1.2
-/

@[expose] public section

open scoped LinearAlgebra.Projectivization

namespace Faltings

/-- Every point `x` of `ℙ K (ι → K)` has homogeneous coordinates `v` in its field of definition
`Faltings.pointField k x`, one of which, `v j`, is equal to `1`: dehomogenise at a nonzero
coordinate `x_j`, so that `v i = x_i / x_j` and `v = x_j⁻¹ • x`. -/
@[faltings "lem_ht_coordinates_in_point_field"]
theorem exists_coords_fieldOfDefinition_eq_one (k : Type*) {K : Type*} [Field k] [Field K]
    [Algebra k K] {ι : Type*} (x : ℙ K (ι → K)) :
    ∃ (v : ι → pointField k x) (j : ι) (hv : (fun i => (v i : K)) ≠ 0),
      v j = 1 ∧ Projectivization.mk K (fun i => (v i : K)) hv = x := by
  obtain ⟨j, hj⟩ := Function.ne_iff.mp x.rep_nonzero
  let v : ι → pointField k x := fun i =>
    ⟨x.rep i / x.rep j, IntermediateField.subset_adjoin _ _ ⟨i, j, hj, rfl⟩⟩
  have hv : (fun i => (v i : K)) = (x.rep j)⁻¹ • x.rep :=
    funext fun i => by simp [v, div_eq_inv_mul]
  refine ⟨v, j, hv ▸ smul_ne_zero (inv_ne_zero hj) x.rep_nonzero, Subtype.ext (div_self hj), ?_⟩
  conv_rhs => rw [← x.mk_rep]
  exact (Projectivization.mk_eq_mk_iff' K _ _ _ _).2 ⟨_, hv.symm⟩

end Faltings
