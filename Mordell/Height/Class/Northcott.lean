module

public import Mordell.AlgebraicGeometry.Ample
public import Mordell.Height.Class.Uniqueness
public import Mordell.Height.Machine.Northcott
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.CohomologicalDimension.FieldExtensionTorsionBound
public import StacksFrontier.AlgebraicGeometry.PicardGroup.TensorPower
public import Mordell.AlgebraicGeometry.PointResidueField

/-!
# Northcott's theorem for heights associated to ample classes

Let `X` be a smooth projective variety over a field `K` algebraic over `ℚ` (in the source
`K = ℚ̄`), let `k` be a number field of definition of `X`, let `c ∈ Pic(X) ⊗ ℚ` be an ample
class and let `h` be a height associated to `c`. Then for every `δ ≥ 1` and every `B ∈ ℝ`
there are only finitely many `K`-points `p` of `X` with `[k(p) : k] ≤ δ` and `h(p) ≤ B`.

Write `e • c = [L] ⊗ 1` with `L^{⊗ e'} ≅ φ^* 𝒪(1)` for a projective embedding `φ`; then
`m⁻¹ h_φ`, `m = e e'`, is a height associated to `c`, so `h_φ ≤ m (B + C)` on the set. The
embedding `φ` is defined over a finite extension `k' = k(s) ⊆ K` of `k`: the field `K` is the
filtered union of the `k(s)` for finite `s ⊆ K`, so `X_k ×_k K` is the limit of the
`X_k ×_k k(s)`, and the morphism `X_k ×_k K ⟶ ℙⁿ_k` factors through one of them, `ℙⁿ_k` being of
finite presentation over `k`. The base change `X_k ×_k k'` is a model of `X` over `k'`; it is
integral because it receives the flat surjective morphism `X ⟶ X_k ×_k k'`. The residue field
`k'(p)` is the compositum `k' k(p)`, so `[k'(p) : k'] ≤ [k(p) : k]`, and Weil's theorem over
`k'` applies.

## Main results

* `Faltings.IsHeightOfClass.finite_setOf_pointDegree_le_and_le`: Northcott's finiteness
  theorem for a height associated to an ample class.
* `Faltings.isIntegral_of_flat_of_surjective`: a scheme receiving a flat surjective morphism
  from an integral scheme is integral.
* `Faltings.fieldRange_descResidueField_le`: the residue field of a `K`-point factoring through
  `Spec M`, for a subfield `M ⊆ K`, lies in `M`.

## Implementation notes

A `K`-point of `X` is a section `p` of the structure morphism `f : X ⟶ Spec K`, as in
`Faltings.IsHeightOfClass`. The degree `[k(p) : k]` is
`Faltings.FieldOfDefinition.pointDegree`. The base field is an algebraic extension `K / ℚ`;
the source's case is `K = ℚ̄`.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Sec. 2.
* [Hindry, Silverman, *Diophantine Geometry*, B.3][hindrysilverman2000]
* [Z. Gao, *Heights*][gao2022], Prop. 5.1.3(v).
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TensorProduct

universe u

namespace Faltings

/-- Base change along `g ≫ h` of `T` is the base change along `g` of the base change of `T`
along `h`. -/
private lemma isPullback_map_snd {C : Type*} [Category C] [HasPullbacks C] {Z S₀ S₁ S₂ : C}
    (T : Z ⟶ S₀) (h : S₁ ⟶ S₀) (g : S₂ ⟶ S₁) (h' : S₂ ⟶ S₀) (hgh : g ≫ h = h') :
    IsPullback (pullback.map T h' T h (𝟙 _) g (𝟙 _) (by simp) (by simp [hgh]))
      (pullback.snd T h') (pullback.snd T h) g := by
  subst hgh
  refine IsPullback.of_right ?_ (by simp) (IsPullback.of_hasPullback T h)
  convert IsPullback.of_hasPullback T (g ≫ h) using 1
  simp

section SpreadingOut

open Stacks.EtaleCohomology

variable {K : Type u} [Field K] {k : Type u} [Field k] [Algebra k K]

/-- The structure map `k ⟶ k(s)` of the subfield of `K` generated by a finite set `s`. -/
private noncomputable abbrev stageAlgebraMap (s : Finset K) :
    CommRingCat.of k ⟶ (finsetIntermediateFieldDiagram k K).obj s :=
  CommRingCat.ofHom (algebraMap k (IntermediateField.adjoin k (s : Set K)))

private lemma stageAlgebraMap_comp_map {s t : Finset K} (g : s ⟶ t) :
    stageAlgebraMap (K := K) (k := k) s ≫ (finsetIntermediateFieldDiagram k K).map g =
      stageAlgebraMap t :=
  rfl

/-- The inclusion `k(s) ⟶ K` of the subfield of `K` generated by a finite set `s`. -/
private noncomputable abbrev stageι (s : Finset K) :
    (finsetIntermediateFieldDiagram k K).obj s ⟶ CommRingCat.of K :=
  (finsetIntermediateFieldCocone k K).ι.app s

private lemma stageAlgebraMap_comp_ι (s : Finset K) :
    stageAlgebraMap (K := K) (k := k) s ≫ stageι s = CommRingCat.ofHom (algebraMap k K) :=
  rfl

private lemma map_comp_stageι {s t : Finset K} (g : s ⟶ t) :
    (finsetIntermediateFieldDiagram k K).map g ≫ stageι t = stageι s :=
  rfl

private lemma Spec_map_algebraMap_eq (s : Finset K) :
    Spec.map (CommRingCat.ofHom (algebraMap k K)) =
      Spec.map (stageι s) ≫ Spec.map (stageAlgebraMap s) := by
  rw [← Spec.map_comp]
  rfl

/-- Base change of a `k`-scheme `Z` along `Spec k(s) ⟶ Spec k`, for the subfields `k(s) ⊆ K`
generated by finite subsets `s ⊆ K`: the inverse system `s ↦ Z ×_k k(s)`. -/
private noncomputable abbrev baseChangeDiagram {Z : Scheme.{u}} (T : Z ⟶ Spec (.of k)) :
    (Finset K)ᵒᵖ ⥤ Scheme.{u} where
  obj s := pullback T (Spec.map (stageAlgebraMap s.unop))
  map {s t} g := pullback.map _ _ _ _ (𝟙 _)
    (Spec.map ((finsetIntermediateFieldDiagram k K).map g.unop)) (𝟙 _) (by simp)
    (by rw [Category.comp_id, ← Spec.map_comp, stageAlgebraMap_comp_map])
  map_id s := by
    apply pullback.hom_ext <;> simp
  map_comp f g := by
    apply pullback.hom_ext <;> simp [← Spec.map_comp]

/-- The cone over `baseChangeDiagram T` with vertex `Z ×_k K`. -/
private noncomputable abbrev baseChangeCone {Z : Scheme.{u}} (T : Z ⟶ Spec (.of k)) :
    Cone (baseChangeDiagram (K := K) T) where
  pt := pullback T (Spec.map (CommRingCat.ofHom (algebraMap k K)))
  π :=
    { app s := pullback.map _ _ _ _ (𝟙 _)
        (Spec.map (stageι s.unop)) (𝟙 _) (by simp)
        (by rw [Category.comp_id, ← Spec.map_comp, stageAlgebraMap_comp_ι])
      naturality s t g := by
        apply pullback.hom_ext
        · simp [baseChangeDiagram]
        · simp only [baseChangeDiagram, Functor.const_obj_obj, Functor.const_obj_map,
            Category.id_comp, Category.assoc, pullback.lift_snd, pullback.lift_snd_assoc,
            ← Spec.map_comp]
          rw [map_comp_stageι] }

/-- **`Z ×_k K` is the limit of the `Z ×_k k(s)`.** The field `K` is the filtered colimit of its
subfields `k(s)` generated by finite subsets, so `Spec K` is the limit of the `Spec k(s)`, and a
morphism to `Z ×_k K` is a morphism to `Z` together with a compatible family of morphisms to
the `Spec k(s)`. -/
private noncomputable def isLimitBaseChangeCone {Z : Scheme.{u}} (T : Z ⟶ Spec (.of k)) :
    IsLimit (baseChangeCone (K := K) T) := by
  have hSpec : IsLimit (Scheme.Spec.mapCone (finsetIntermediateFieldCocone k K).op) :=
    isLimitOfPreserves Scheme.Spec (finsetIntermediateFieldIsColimit (K := k) (L := K)).op
  let lift (C : Cone ((finsetIntermediateFieldDiagram k K).op ⋙ Scheme.Spec)) :
      C.pt ⟶ Spec (.of K) := hSpec.lift C
  have hfac (C : Cone ((finsetIntermediateFieldDiagram k K).op ⋙ Scheme.Spec)) (s : Finset K) :
      lift C ≫ Spec.map (stageι s) = C.π.app (Opposite.op s) :=
    hSpec.fac C (Opposite.op s)
  let legSnd (S : Cone (baseChangeDiagram (K := K) T)) :
      Cone ((finsetIntermediateFieldDiagram k K).op ⋙ Scheme.Spec) :=
    { pt := S.pt
      π :=
        { app s := S.π.app s ≫ pullback.snd _ _
          naturality s t g := by
            rw [← S.w g]
            simp [baseChangeDiagram] } }
  have hfst (S : Cone (baseChangeDiagram (K := K) T)) (s) :
      S.π.app s ≫ pullback.fst _ _ =
        S.π.app (Opposite.op ∅) ≫ pullback.fst T (Spec.map (stageAlgebraMap (∅ : Finset K))) := by
    rw [← S.w (homOfLE (Finset.empty_subset s.unop)).op]
    simp [baseChangeDiagram]
  have hcond (S : Cone (baseChangeDiagram (K := K) T)) :
      (S.π.app (Opposite.op ∅) ≫ pullback.fst T (Spec.map (stageAlgebraMap (∅ : Finset K)))) ≫ T =
        lift (legSnd S) ≫ Spec.map (CommRingCat.ofHom (algebraMap k K)) := by
    rw [Spec_map_algebraMap_eq ∅, ← Category.assoc, hfac (legSnd S) ∅]
    simp [legSnd, pullback.condition]
  refine
    { lift S := pullback.lift _ _ (hcond S)
      fac S s := ?_
      uniq S m hm := ?_ }
  · apply pullback.hom_ext
    · simp only [Category.assoc, pullback.lift_fst, Category.comp_id, hfst S s]
    · simp only [Category.assoc, pullback.lift_snd, pullback.lift_snd_assoc]
      exact hfac (legSnd S) s.unop
  · apply pullback.hom_ext
    · rw [pullback.lift_fst, ← hm (Opposite.op ∅)]
      simp
    · rw [pullback.lift_snd]
      refine hSpec.uniq (legSnd S) _ fun s => ?_
      change (m ≫ pullback.snd _ _) ≫ Spec.map (stageι s.unop) = S.π.app s ≫ pullback.snd _ _
      rw [← hm s]
      simp

/-- **Spreading out a morphism over the finite subextensions.** A morphism from `Z ×_k K` to a
`k`-scheme `Y` locally of finite presentation, compatible with the maps to `Spec k`, factors
through `Z ×_k k(s)` for some finite subset `s ⊆ K`. -/
private lemma exists_comp_eq_of_locallyOfFinitePresentation {Z Y : Scheme.{u}}
    (T : Z ⟶ Spec (.of k)) [QuasiCompact T] [QuasiSeparated T] (p : Y ⟶ Spec (.of k))
    [LocallyOfFinitePresentation p]
    (a : pullback T (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶ Y)
    (ha : a ≫ p = pullback.fst _ _ ≫ T) :
    ∃ (s : Finset K) (ψ : pullback T (Spec.map (stageAlgebraMap s)) ⟶ Y),
      pullback.map _ _ _ _ (𝟙 _) (Spec.map (stageι s)) (𝟙 _) (by simp)
        (by rw [Category.comp_id, ← Spec.map_comp, stageAlgebraMap_comp_ι]) ≫ ψ = a := by
  let t : baseChangeDiagram (K := K) T ⟶ (Functor.const _).obj (Spec (.of k)) :=
    { app s := pullback.fst _ _ ≫ T
      naturality s s' g := by simp [baseChangeDiagram] }
  have hI {i j : (Finset K)ᵒᵖ} (g : i ⟶ j) :
      IsAffineHom ((baseChangeDiagram (K := K) T).map g) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (isPullback_map_snd T _ _ _ (by rw [← Spec.map_comp, stageAlgebraMap_comp_map])).flip
      inferInstance
  have hQ (i : (Finset K)ᵒᵖ) : QuasiSeparatedSpace ((baseChangeDiagram (K := K) T).obj i) :=
    quasiSeparatedSpace_of_quasiSeparated (pullback.snd T (Spec.map (stageAlgebraMap i.unop)))
  obtain ⟨i, ψ, h1, -⟩ := Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation
    (baseChangeDiagram T) t p (baseChangeCone T) (isLimitBaseChangeCone T) a (by
      ext s
      simp [t, ha])
  exact ⟨i.unop, ψ, h1⟩

end SpreadingOut

section BaseChange

variable {K : Type u} [Field K] {X : Scheme.{u}} {f : X ⟶ Spec (.of K)}
  [IsProjectiveVariety K f] {k : Type u} [Field k] [NumberField k] [Algebra k K]

/-- The base change map `X_k ×_k K ⟶ X_k ×_k L` for an intermediate field `k ⊆ L ⊆ K`. -/
private noncomputable abbrev baseChangeMap (F : FieldOfDefinition K f k)
    (L : IntermediateField k K) :
    pullback F.toSpec (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶
      pullback F.toSpec (Spec.map (CommRingCat.ofHom (algebraMap k L))) :=
  pullback.map _ _ _ _ (𝟙 _) (Spec.map (CommRingCat.ofHom (algebraMap L K))) (𝟙 _) (by simp)
    (by rw [Category.comp_id, ← Spec.map_comp]; rfl)

private lemma baseChangeMap_fst (F : FieldOfDefinition K f k) (L : IntermediateField k K) :
    baseChangeMap F L ≫ pullback.fst _ _ = pullback.fst _ _ := by
  simp [baseChangeMap]

private lemma isPullback_baseChangeMap (F : FieldOfDefinition K f k)
    (L : IntermediateField k K) :
    IsPullback (baseChangeMap F L) (pullback.snd _ _) (pullback.snd _ _)
      (Spec.map (CommRingCat.ofHom (algebraMap L K))) :=
  isPullback_map_snd _ _ _ _ (by rw [← Spec.map_comp]; rfl)

/-- The field of definition `L` of `X` obtained from a field of definition `k ⊆ L` by base
change: the model is `X_k ×_k L`. -/
private noncomputable abbrev baseChange (F : FieldOfDefinition K f k) (L : IntermediateField k K)
    [NumberField L] : FieldOfDefinition K f L where
  model := pullback F.toSpec (Spec.map (CommRingCat.ofHom (algebraMap k L)))
  toSpec := pullback.snd _ _
  isVariety := by
    have := F.isVariety
    have hX : IsIntegral X := inferInstance
    obtain ⟨h1, h2⟩ := flat_surjective_Spec_map (algebraMap L K)
    have : Flat (F.iso.hom ≫ baseChangeMap F L) :=
      have := MorphismProperty.of_isPullback (P := @Flat) (isPullback_baseChangeMap F L).flip h1
      inferInstance
    have : Surjective (F.iso.hom ≫ baseChangeMap F L) :=
      have := MorphismProperty.of_isPullback (P := @Surjective)
        (isPullback_baseChangeMap F L).flip h2
      inferInstance
    have := isIntegral_of_flat_of_surjective (F.iso.hom ≫ baseChangeMap F L)
    exact {}
  iso := F.iso ≪≫ (isPullback_baseChangeMap F L).isoPullback
  iso_hom_snd := by simp [F.iso_hom_snd]

private lemma baseChange_iso_hom_fst (F : FieldOfDefinition K f k) (L : IntermediateField k K)
    [NumberField L] :
    (baseChange F L).iso.hom ≫ pullback.fst _ _ = F.iso.hom ≫ baseChangeMap F L := by
  simp [baseChange]

/-- The residue field `k(p)` is contained in the residue field `L(p)` over the base change. -/
private lemma pointResidueField_le_baseChange (F : FieldOfDefinition K f k)
    (L : IntermediateField k K) [NumberField L] (p : Spec (.of K) ⟶ X) (hp : p ≫ f = 𝟙 _) :
    F.pointResidueField p hp ≤ ((baseChange F L).pointResidueField p hp).restrictScalars k :=
  fieldRange_descResidueField_comp_le (p ≫ (baseChange F L).iso.hom ≫ pullback.fst _ _)
    (pullback.fst _ _) (by
      rw [Category.assoc, Category.assoc, reassoc_of% baseChange_iso_hom_fst F L,
        baseChangeMap_fst])

/-- The residue field `L(p)` over the base change is contained in the compositum `L k(p)`. -/
private lemma baseChange_pointResidueField_le (F : FieldOfDefinition K f k)
    (L : IntermediateField k K) [NumberField L] (p : Spec (.of K) ⟶ X) (hp : p ≫ f = 𝟙 _) :
    ((baseChange F L).pointResidueField p hp).restrictScalars k ≤
      L ⊔ F.pointResidueField p hp := by
  set E := F.pointResidueField p hp
  set q := p ≫ F.iso.hom ≫ pullback.fst _ _
  let ιM : CommRingCat.of ↥(L ⊔ E) ⟶ CommRingCat.of K :=
    CommRingCat.ofHom (algebraMap ↥(L ⊔ E) K)
  let β : F.model.residueField (q (IsLocalRing.closedPoint K)) →+* ↥(L ⊔ E) :=
    (F.model.descResidueField (Scheme.stalkClosedPointTo q)).hom.codRestrict (L ⊔ E)
      fun y => (le_sup_right : E ≤ L ⊔ E) ⟨y, rfl⟩
  let r₁ : Spec (.of ↥(L ⊔ E)) ⟶ F.model :=
    Spec.map (CommRingCat.ofHom β) ≫ F.model.fromSpecResidueField _
  have hr₁ : Spec.map ιM ≫ r₁ = q := by
    rw [← Category.assoc, ← Spec.map_comp]
    exact Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K F.model q
  have : Epi (Spec.map ιM) := by
    obtain ⟨h1, h2⟩ := flat_surjective_Spec_map (algebraMap ↥(L ⊔ E) K)
    exact Flat.epi_of_flat_of_surjective _
  let incl : CommRingCat.of L ⟶ CommRingCat.of ↥(L ⊔ E) :=
    CommRingCat.ofHom (IntermediateField.inclusion (le_sup_left : L ≤ L ⊔ E)).toRingHom
  have hcond : r₁ ≫ F.toSpec = Spec.map incl ≫ Spec.map (CommRingCat.ofHom (algebraMap k L)) := by
    rw [← cancel_epi (Spec.map ιM), reassoc_of% hr₁, F.comp_toSpec p hp, ← Spec.map_comp,
      ← Spec.map_comp]
    rfl
  have hr : Spec.map ιM ≫ pullback.lift r₁ (Spec.map incl) hcond =
      p ≫ (baseChange F L).iso.hom ≫ pullback.fst _ _ := by
    apply pullback.hom_ext
    · rw [Category.assoc, pullback.lift_fst, hr₁, Category.assoc, Category.assoc,
        reassoc_of% baseChange_iso_hom_fst F L, baseChangeMap_fst]
    · rw [Category.assoc, pullback.lift_snd, ← Spec.map_comp, Category.assoc, Category.assoc]
      have h1 : pullback.fst (baseChange F L).toSpec
          (Spec.map (CommRingCat.ofHom (algebraMap L K))) ≫
            pullback.snd F.toSpec (Spec.map (CommRingCat.ofHom (algebraMap k L))) =
          pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom (algebraMap L K)) :=
        pullback.condition
      rw [h1, ← Category.assoc (baseChange F L).iso.hom, (baseChange F L).iso_hom_snd,
        ← Category.assoc, hp, Category.id_comp]
      rfl
  intro x hx
  obtain ⟨y, rfl⟩ := fieldRange_descResidueField_le (algebraMap ↥(L ⊔ E) K) _ hr hx
  exact y.2

/-- The residue field `L(p)` over the base change is the compositum `L k(p)`. -/
private lemma baseChange_pointResidueField_eq (F : FieldOfDefinition K f k)
    (L : IntermediateField k K) [NumberField L] (p : Spec (.of K) ⟶ X) (hp : p ≫ f = 𝟙 _) :
    (baseChange F L).pointResidueField p hp =
      IntermediateField.extendScalars (le_sup_left : L ≤ L ⊔ F.pointResidueField p hp) := by
  refine le_antisymm (fun x hx => baseChange_pointResidueField_le F L p hp hx) fun x hx => ?_
  have : L ⊔ F.pointResidueField p hp ≤
      ((baseChange F L).pointResidueField p hp).restrictScalars k :=
    sup_le (fun l hl => ((baseChange F L).pointResidueField p hp).algebraMap_mem ⟨l, hl⟩)
      (pointResidueField_le_baseChange F L p hp)
  exact this hx

/-- **The degree does not grow under base change**: `[L(p) : L] ≤ [k(p) : k]`. -/
private lemma pointDegree_baseChange_le (F : FieldOfDefinition K f k)
    (L : IntermediateField k K) [NumberField L] [FiniteDimensional k L] (p : Spec (.of K) ⟶ X)
    (hp : p ≫ f = 𝟙 _) :
    (baseChange F L).pointDegree p hp ≤ F.pointDegree p hp := by
  have h := IntermediateField.finrank_bot_mul_relfinrank
    (le_sup_left : L ≤ L ⊔ F.pointResidueField p hp)
  rw [IntermediateField.relfinrank_eq_finrank_of_le le_sup_left] at h
  have h2 := IntermediateField.finrank_sup_le L (F.pointResidueField p hp)
  rw [FieldOfDefinition.pointDegree, FieldOfDefinition.pointDegree,
    baseChange_pointResidueField_eq]
  exact Nat.le_of_mul_le_mul_left (h ▸ h2) Module.finrank_pos

end BaseChange

/-- An ample class `c` has a height of the form `m⁻¹ h_φ` for a projective embedding `φ`: if
`e • c = [L] ⊗ 1` and `L^{⊗ e'} ≅ φ^* 𝒪(1)`, then `cl(φ) ⊗ 1 = (e e') • c`. -/
private lemma exists_isHeightOfClass_height {k : Type u} [Field k] [Algebra ℚ k]
    [Algebra.IsAlgebraic ℚ k] {X : Scheme.{u}} {f : X ⟶ Spec (.of k)} [IsProjectiveVariety k f]
    [Smooth f] {c : X.picardGroup ⊗[ℤ] ℚ} (hc : IsAmpleClass f c) :
    ∃ (m n : ℕ) (φ : ProjectiveEmbedding f n), 0 < m ∧
      IsHeightOfClass f c fun x => (m : ℝ)⁻¹ * φ.height x := by
  obtain ⟨e, L, hL, he, ⟨e', he', n, φ, ⟨ι⟩⟩, hec⟩ := hc
  have hpow : X.picardClass (Stacks.Ample.tensorPowModule X L e') inferInstance =
      e' • X.picardClass L hL :=
    ((X.picardClass_eq_iff _ _ _ _).2
      ⟨(Stacks.PowerFamilyBridge.tensorPowerModuleIso X L e').symm⟩).trans
      (Stacks.SheafOfModules.picardClass_schemeTensorPower X L hL e')
  have hcl : embeddingClass f (FreeAbelianGroup.of ⟨n, φ⟩) = e' • X.picardClass L hL := by
    rw [embeddingClass_apply_of_eq_picardClass, ← hpow]
    exact (X.picardClass_eq_iff _ _ _ _).2 ⟨ι.symm⟩
  have hm : (((e * e').toNat : ℕ) : ℤ) = e * e' := Int.toNat_of_nonneg (by positivity)
  refine ⟨(e * e').toNat, n, φ, Int.lt_toNat.2 (by positivity),
    (e * e').toNat, FreeAbelianGroup.of ⟨n, φ⟩, Int.lt_toNat.2 (by positivity), ?_, 0,
      fun x => by simp [EmbeddingGroup.height]⟩
  rw [hcl, ← natCast_zsmul, hm, mul_comm, mul_smul, hec, TensorProduct.smul_tmul']

/-- **A projective embedding is defined over a finite subextension.** For a field of definition
`k` of `X` and a projective embedding `φ`, there is a number field `k ⊆ L ⊆ K`, finite over `k`,
such that `φ` is defined over the model `X_k ×_k L`. -/
private lemma exists_baseChange_factor {K : Type u} [Field K] [Algebra ℚ K]
    [Algebra.IsAlgebraic ℚ K] {X : Scheme.{u}} {f : X ⟶ Spec (.of K)} [IsProjectiveVariety K f]
    {k : Type u} [Field k] [NumberField k] [Algebra k K] (F : FieldOfDefinition K f k) {n : ℕ}
    (φ : ProjectiveEmbedding f n) :
    ∃ (L : IntermediateField k K) (_ : FiniteDimensional k L) (_ : NumberField L)
      (ψ : (baseChange F L).model ⟶ projectiveSpaceAtUniverse.{u} n),
      φ.hom ≫ projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of K)) =
        (baseChange F L).iso.hom ≫ pullback.fst _ _ ≫ ψ := by
  have : Algebra.IsAlgebraic k K := Algebra.IsAlgebraic.tower_top (K := ℚ) k
  have := F.isVariety
  let a : pullback F.toSpec (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶
      projectiveSpaceOver n (Spec (.of k)) :=
    pullback.lift (pullback.fst _ _ ≫ F.toSpec) (F.iso.inv ≫ φ.hom ≫ pullback.snd _ _)
      (terminal.hom_ext _ _)
  have : LocallyOfFinitePresentation (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.2 inferInstance
  obtain ⟨s, ψ, hψ⟩ := exists_comp_eq_of_locallyOfFinitePresentation (K := K) F.toSpec
    (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) a (pullback.lift_fst _ _ _)
  set L := IntermediateField.adjoin k (s : Set K)
  have : FiniteDimensional k L := IntermediateField.finiteDimensional_adjoin
    fun x _ => (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
  have : NumberField L := NumberField.of_module_finite k L
  let ψ' : pullback F.toSpec (Spec.map (CommRingCat.ofHom (algebraMap k L))) ⟶
      projectiveSpaceOver n (Spec (.of k)) := ψ
  have hψ' : baseChangeMap F L ≫ ψ' = a := hψ
  refine ⟨L, inferInstance, inferInstance, ψ' ≫ pullback.snd _ _, ?_⟩
  rw [← Category.assoc (baseChange F L).iso.hom, baseChange_iso_hom_fst, Category.assoc,
    reassoc_of% hψ', pullback.lift_snd, Iso.hom_inv_id_assoc]

/-- **Northcott's theorem.** If `h` is a height associated to an ample class
`c ∈ Pic(X) ⊗ ℚ` on a smooth projective variety `X` over a field `K` algebraic over `ℚ`, and
`F` is a number field of definition `k` of `X`, then for `δ ≥ 1` and `B ∈ ℝ` the set of
`K`-points `p` with `[k(p) : k] ≤ δ` and `h p ≤ B` is finite. -/
@[faltings "thm_ht_height_class_northcott"]
public theorem IsHeightOfClass.finite_setOf_pointDegree_le_and_le {K : Type u} [Field K]
    [Algebra ℚ K] [Algebra.IsAlgebraic ℚ K] {X : Scheme.{u}} {f : X ⟶ Spec (.of K)}
    [IsProjectiveVariety K f] [Smooth f] {k : Type u} [Field k] [NumberField k] [Algebra k K]
    (F : FieldOfDefinition K f k) {c : X.picardGroup ⊗[ℤ] ℚ} (hc : IsAmpleClass f c)
    {h : {p : Spec (.of K) ⟶ X // p ≫ f = 𝟙 _} → ℝ} (hh : IsHeightOfClass f c h)
    (δ : ℕ) (hδ : 1 ≤ δ) (B : ℝ) :
    {p | F.pointDegree p.1 p.2 ≤ δ ∧ h p ≤ B}.Finite := by
  obtain ⟨m, n, φ, hm, hφh⟩ := exists_isHeightOfClass_height hc
  obtain ⟨C, hC⟩ := hh.exists_abs_sub_le hφh
  obtain ⟨L, _, _, hφ⟩ := exists_baseChange_factor F φ
  refine (ProjectiveEmbedding.finite_setOf_pointDegree_le_height_le (baseChange F L) φ hφ hδ
    (m * (B + C))).subset fun p hp => ⟨(pointDegree_baseChange_le F L p.1 p.2).trans hp.1, ?_⟩
  rw [← inv_mul_le_iff₀ (by exact_mod_cast hm)]
  linarith [hp.2, (abs_le.1 (hC p)).1]

end Faltings
