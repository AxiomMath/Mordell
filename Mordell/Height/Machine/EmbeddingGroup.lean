module
public import Mordell.AlgebraicGeometry.ProjectiveSpace.Embedding
public import StacksFrontier.AlgebraicGeometry.PicardGroup.Pullback
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjTwistTensorPow
public import StacksFrontier.AlgebraicGeometry.Picard.GaloisDescent.Pullback

/-!
# The group of formal combinations of projective embeddings

Let `X` be a smooth projective variety over a field `k`, with structure morphism
`f : X ⟶ Spec k`. The group `Emb(X)` is the free abelian group on the set of projective
embeddings of `X`, that is, of closed immersions `X ⟶ ℙⁿ_k` over `Spec k`, for all `n`.
Its elements are the finite formal sums `∑ nᵢ φᵢ` with `nᵢ ∈ ℤ`.

## Main definitions

* `Faltings.EmbeddingGroup`: the free abelian group `Emb(X)` on the projective embeddings
  of `X`.

## Implementation notes

The projective embeddings of `X` into all projective spaces are the dependent pairs
`Σ n, Faltings.ProjectiveEmbedding f n`, and `Emb(X)` is `FreeAbelianGroup` on this type.
It is an `abbrev`, so the additive group structure and the universal property
(`FreeAbelianGroup.lift`, used to extend heights and the class map `ℤ`-linearly) are
available directly. The base field is an arbitrary field `k`; the case of the source is
`k = \bar{ℚ}`.

## References

* [Bombieri, *The Mordell conjecture revisited*, Sec. 2][bombieri1990]
-/

open AlgebraicGeometry CategoryTheory

universe u

namespace Faltings

/-- The group `Emb(X)` of a smooth projective variety `X` over a field `k`, with structure
morphism `f : X ⟶ Spec k`: the free abelian group generated by the projective embeddings
`X ⟶ ℙⁿ_k` of `X`, for all `n`. -/
@[faltings "def_ht_emb_group"]
public abbrev EmbeddingGroup {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    [IsProjectiveVariety k f] [Smooth f] : Type u :=
  FreeAbelianGroup (Σ n : ℕ, ProjectiveEmbedding f n)

end Faltings


/-!
# The class homomorphism `cl : Emb(X) → Pic(X)`

Let `X` be a smooth projective variety over a field `k`, with structure morphism
`f : X ⟶ Spec k`. A projective embedding `φ : X ⟶ ℙⁿ_k` pulls the hyperplane sheaf `𝒪(1)` of
`ℙⁿ_k` back to an invertible sheaf `φ^*𝒪(1)` on `X`. The *class homomorphism*
`cl : Emb(X) → Pic(X)` is the `ℤ`-linear map sending `φ` to the class `[φ^*𝒪(1)]`.

## Main definitions

* `Faltings.embeddingClass`: the homomorphism `cl : Emb(X) →+ Pic(X)`.

## Implementation notes

`Emb(X)` is the free abelian group `Faltings.EmbeddingGroup f`, so `cl` is
`FreeAbelianGroup.lift` of its value on generators; a `ℤ`-linear map between abelian groups is an
additive homomorphism, and it is stated as one. The hyperplane sheaf on `ℙⁿ_k` is
`Stacks.AlgebraicGeometry.ProjTwistTensorPow.twistOver n (Spec k) 1`, and the class of its
pullback is `Stacks.SheafOfModules.pullbackPicardClass`. The base field is an arbitrary field
`k`; the case of the source is `k = \bar{ℚ}`.

## References

* [Bombieri, *The Mordell conjecture revisited*, Sec. 2][bombieri1990]
-/

open AlgebraicGeometry CategoryTheory

namespace Faltings

/-- The class homomorphism `cl : Emb(X) → Pic(X)` of a smooth projective variety `X` over a
field `k`: the `ℤ`-linear map sending a projective embedding `φ : X ⟶ ℙⁿ_k` to the class
`[φ^*𝒪(1)]` of the pullback of the hyperplane sheaf. -/
@[expose, faltings "def_ht_cl_homomorphism"]
public noncomputable def embeddingClass {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [IsProjectiveVariety k f] [Smooth f] :
    EmbeddingGroup f →+ X.picardGroup :=
  FreeAbelianGroup.lift fun φ =>
    Stacks.SheafOfModules.pullbackPicardClass φ.2.hom
      (Stacks.AlgebraicGeometry.ProjTwistTensorPow.twistOver φ.1 (Spec (.of k)) 1)
      (Stacks.AlgebraicGeometry.ProjTwistTensorPow.isInvertibleModule_twistOver φ.1 _ 1)

/-- The class `cl(φ)` of a projective embedding `φ : X ⟶ ℙⁿ_k` is `[φ^*𝒪(1)]`. -/
public theorem embeddingClass_apply_of {k : Type u} [Field k] {X : Scheme.{u}}
    {f : X ⟶ Spec (.of k)} [IsProjectiveVariety k f] [Smooth f] {n : ℕ}
    (φ : ProjectiveEmbedding f n) :
    embeddingClass f (FreeAbelianGroup.of ⟨n, φ⟩) =
      Stacks.SheafOfModules.pullbackPicardClass φ.hom
        (Stacks.AlgebraicGeometry.ProjTwistTensorPow.twistOver n (Spec (.of k)) 1)
        (Stacks.AlgebraicGeometry.ProjTwistTensorPow.isInvertibleModule_twistOver n _ 1) :=
  FreeAbelianGroup.lift_apply_of _ _

/-- The class `cl(φ)` of a projective embedding `φ : X ⟶ ℙⁿ_k` is the Picard class of
`φ^* 𝒪(1)`, the pullback of the twisting sheaf along `φ`. -/
public theorem embeddingClass_apply_of_eq_picardClass {k : Type u} [Field k] {X : Scheme.{u}}
    {f : X ⟶ Spec (.of k)} [IsProjectiveVariety k f] [Smooth f] {n : ℕ}
    (φ : ProjectiveEmbedding f n) :
    embeddingClass f (FreeAbelianGroup.of ⟨n, φ⟩) =
      X.picardClass ((Scheme.Modules.pullback φ.hom).obj
        (Stacks.AmpleProjectiveImmersion.projectiveSpaceTwistingSheaf n (Spec (.of k))))
        inferInstance := by
  rw [embeddingClass_apply_of]
  refine (X.picardClass_eq_iff _ _ _ _).2 ⟨?_⟩
  exact ((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
    φ.hom.toLRSHom.toShHom).leftAdjointUniq
      (Scheme.Modules.pullbackPushforwardAdjunction φ.hom)).app _

/-- The class `cl(φ)` of a projective embedding `φ` with `φ^* 𝒪(1) ≅ L` is `[L]`. -/
public theorem embeddingClass_apply_of_eq_picardClass_of_iso {k : Type u} [Field k]
    {X : Scheme.{u}} {f : X ⟶ Spec (.of k)} [IsProjectiveVariety k f] [Smooth f] {n : ℕ}
    (φ : ProjectiveEmbedding f n) (L : X.Modules) [hL : Stacks.Ample.IsInvertibleModule X L]
    (hφ : Nonempty ((Scheme.Modules.pullback
      (φ.hom ≫ projectiveSpaceOver.toIntegralAtUniverse n _)).obj
        (Stacks.AmpleProjectiveImmersion.twistingSheafAtUniverse.{u} n) ≅ L)) :
    embeddingClass f (FreeAbelianGroup.of ⟨n, φ⟩) =
      Stacks.SheafOfModules.picardClass X.presheaf
        (Stacks.RingedSpace.structureIsSheaf X.toRingedSpace) L
        (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hL) := by
  rw [embeddingClass_apply_of]
  refine (X.picardClass_eq_iff _ _ _ _).mpr ⟨?_⟩
  exact (((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
    φ.hom.toLRSHom.toShHom).leftAdjointUniq
      (Scheme.Modules.pullbackPushforwardAdjunction φ.hom)).app _).symm ≪≫
    (Scheme.Modules.pullbackComp φ.hom _).app _ ≪≫ hφ.some

end Faltings
