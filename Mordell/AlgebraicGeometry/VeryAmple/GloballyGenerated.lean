/-- **Ratios are carried along a morphism of modules.** If `k` maps `L ^⊗ n` to `L' ^⊗ n`, then
on an open `V'` where `k t` does not vanish and which lies inside an open `V` where `t` does not
vanish, the ratio `k x / k t` is the restriction of `x / t`. -/
private theorem ratioOf_map {Y : Scheme.{u}} {L L' : Y.Modules} [IsInvertibleModule Y L]
    [IsInvertibleModule Y L'] {n : ℕ} (k : natTensorPow L n ⟶ natTensorPow L' n)
    (t x : Γ(natTensorPow L n, ⊤)) {V V' : Y.Opens}
    (hV : V ≤ Stacks.NonvanishingOpen.nonvanishingOpen Y (natTensorPow L n) t)
    (hV' : V' ≤ Stacks.NonvanishingOpen.nonvanishingOpen Y (natTensorPow L' n) (k.app ⊤ t))
    (hVV' : V' ≤ V) :
    ratioOf L' (k.app ⊤ t) hV' (k.app ⊤ x) =
      Y.presheaf.map (homOfLE hVV').op (ratioOf L t hV x) := by
  refine ratioOf_eq_of_resTop_eq L' _ hV' ?_
  have hnat : ∀ y : Γ(natTensorPow L n, ⊤),
      resTop (natTensorPow L' n) (k.app ⊤ y) V' = k.app V' (resTop (natTensorPow L n) y V') :=
    fun y => (PresheafOfModules.naturality_apply k.val (homOfLE (le_top : V' ≤ ⊤)).op y).symm
  rw [hnat, hnat, ← Stacks.TensorPowerTrivialize.res_resTop (natTensorPow L n) x (homOfLE hVV'),
    resTop_eq_ratioOf_smul L t hV x, Stacks.TensorPowerTrivialize.map_smul_resTop,
    Scheme.Modules.Hom.app_smul]

/-- **An element of the stalk of an invertible module outside `𝔪_x M_x` generates the stalk.**
The stalk is free of rank one on the germ of a trivializing section, and an element outside
`𝔪_x M_x` is a unit multiple of that germ. -/
private theorem exists_smul_eq_of_notMem_maximalSmul {X : Scheme.{u}} (M : X.Modules)
    [IsInvertibleModule X M] {x : X} {z : TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x}
    (hz : z ∉ Stacks.ModuleStalk.maximalSmul M x)
    (w : TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x) :
    ∃ r : X.presheaf.stalk x, w = r • z := by
  obtain ⟨V, hxV, ⟨t⟩⟩ := Stacks.SectionProduct.exists_trivialization_at M x
  obtain ⟨a, ha⟩ := Stacks.SectionProduct.exists_smul_germ_basis t hxV z
  obtain ⟨b, hb⟩ := Stacks.SectionProduct.exists_smul_germ_basis t hxV w
  have hunit : IsUnit a := by
    by_contra hna
    exact hz (ha ▸ Stacks.ModuleStalk.smul_mem_maximalSmul_of_mem_maximalIdeal
      ((IsLocalRing.mem_maximalIdeal a).mpr hna) _)
  obtain ⟨u, rfl⟩ := hunit
  refine ⟨b * ↑u⁻¹, ?_⟩
  rw [hb, ha, smul_smul, mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one]

open scoped Stacks.FinGenFromCover in
/-- A scalar multiple over the stalk of the `RingCat`-valued structure sheaf is also a scalar
multiple over `𝒪_{X,x}`: both actions are computed on germs over a common open. -/
private theorem exists_smul_eq_ringStalk_smul {X : Scheme.{u}} (M : X.Modules) (x : X)
    (r : (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
    (m : TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x) :
    ∃ r' : X.presheaf.stalk x, r • m = r' • m := by
  obtain ⟨U, hU, r₀, hr⟩ := TopCat.Presheaf.exists_germ_eq X.ringCatSheaf.obj r
  obtain ⟨V, hV, m₀, hm⟩ := TopCat.Presheaf.exists_germ_eq (C := Ab.{u}) M.presheaf m
  have hxW : x ∈ U ⊓ V := ⟨hU, hV⟩
  set r₁ : Γ(X, U ⊓ V) := X.presheaf.map (homOfLE (inf_le_left (a := U) (b := V))).op r₀
  set m₁ := M.presheaf.map (homOfLE (inf_le_right (a := U) (b := V))).op m₀
  have hrW : (TopCat.Presheaf.germ X.ringCatSheaf.obj (U ⊓ V) x hxW).hom r₁ = r :=
    (TopCat.Presheaf.germ_res_apply X.ringCatSheaf.obj (homOfLE inf_le_left) x hxW r₀).trans hr
  have hmW : (TopCat.Presheaf.germ (C := Ab.{u}) M.presheaf (U ⊓ V) x hxW).hom m₁ = m :=
    (TopCat.Presheaf.germ_res_apply (C := Ab.{u}) M.presheaf (homOfLE inf_le_right) x hxW
      m₀).trans hm
  refine ⟨(X.presheaf.germ (U ⊓ V) x hxW).hom r₁, ?_⟩
  rw [← hrW, ← hmW, ← Stacks.FinGenFromCover.ringStalk_germ_smul,
    Stacks.ModuleStalk.germ_smul]

open scoped Stacks.FinGenFromCover in
/-- **A globally generated invertible module has, at every point, a global section that does not
vanish there.** The germs of a generating family span the stalk, while `𝔪_x M_x` is a proper
submodule of it. -/
private theorem exists_mem_nonvanishingLocus_of_isGeneratedByGlobalSections {X : Scheme.{u}}
    (M : X.Modules) [IsInvertibleModule X M]
    (hM : _root_.SheafOfModules.IsGeneratedByGlobalSections M) (x : X) :
    ∃ s : Γ(M, ⊤), x ∈ nonvanishingLocus M s := by
  obtain ⟨σ⟩ := hM
  by_contra hcon
  simp only [not_exists] at hcon
  have hspan := (AlgebraicGeometry.generates_iff_stalkwise_generates X.ringCatSheaf M σ.s).mp
    σ.epi x
  obtain ⟨z, hz⟩ := Stacks.SectionProduct.exists_notMem_maximalSmul M x
  have hzspan := hspan ▸ (Submodule.mem_top (x := z))
  refine hz (Submodule.span_induction (p := fun y _ => y ∈ Stacks.ModuleStalk.maximalSmul M x)
    ?_ ?_ ?_ ?_ hzspan)
  · rintro _ ⟨i, rfl⟩
    exact not_not.mp (hcon ((σ.s i).eval (Opposite.op ⊤)))
  · exact Submodule.zero_mem _
  · exact fun _ _ _ _ => Submodule.add_mem _
  · intro r a _ ha
    obtain ⟨r', hr'⟩ := exists_smul_eq_ringStalk_smul M x r a
    rw [hr']
    exact Submodule.smul_mem _ r' ha

open scoped Stacks.TensorSectionNonvanishing in
/-- **Multiplying by a global section that does not vanish at `x` preserves nonvanishing at `x`**,
for a section over an arbitrary open. -/
private theorem mem_nonvanishingLocusOn_mulSec {X : Scheme.{u}} (F : X.Modules) {G : X.Modules}
    [IsInvertibleModule X F] [IsInvertibleModule X G] (g : 𝟙_ X.Modules ⟶ G) {U : X.Opens}
    (m : Γ(F, U)) {x : X} (hm : x ∈ nonvanishingLocusOn F U m)
    (hg : x ∈ nonvanishingLocus G (Stacks.SectionProduct.globalSection X G g)) :
    x ∈ nonvanishingLocusOn (F ⊗ G) U (Stacks.TensorSectionNonvanishing.mulSec F g m) := by
  obtain ⟨hxU, hgerm⟩ := hm
  refine ⟨hxU, Stacks.SectionProduct.notMem_maximalSmul_of_generates (F ⊗ G) x fun w => ?_⟩
  exact Stacks.TensorSectionNonvanishing.generates_mulSec F g
    (Stacks.TensorSectionNonvanishing.surjStalk_mulRight F g x hg) hxU m
    (exists_smul_eq_of_notMem_maximalSmul F hgerm) w

open Stacks.NonvanishingLocusRestrict (restrictSection) in
/-- Reading a section over `U` on the open subscheme `U` is natural in the module. -/
private theorem restrictSection_naturality {X : Scheme.{u}} (U : X.Opens) {M N : X.Modules}
    (h : M ⟶ N) (s : Γ(M, U)) :
    ((Scheme.Modules.pullback U.ι).map h).app ⊤ (restrictSection U M s) =
      restrictSection U N (h.app U s) := by
  unfold restrictSection
  have h1 := PresheafOfModules.naturality_apply ((Scheme.Modules.pullback U.ι).map h).val
    (homOfLE (Stacks.NonvanishingLocusRestrict.top_le_ι_preimage_self U)).op
    (Stacks.RingedSpace.pullbackUnit U.ι.toLRSHom.toShHom M (Opposite.op U) s)
  have h2 := Stacks.RingedSpace.pullbackUnit_naturality U.ι.toLRSHom.toShHom h (Opposite.op U) s
  exact h1.trans (congrArg _ h2)

open Stacks.AlgebraicGeometry.ProjChartRatioPullbackLocalMul in
/-- A morphism of modules `M ⟶ N`, read on the first tensor powers of the restrictions to an
open subscheme `U`. -/
private noncomputable def restrictPowOneMap {X : Scheme.{u}} (U : X.Opens) {M N : X.Modules}
    [IsInvertibleModule X M] [IsInvertibleModule X N] (m : M ⟶ N) :
    natTensorPow ((Scheme.Modules.pullback U.ι).obj M) 1 ⟶
      natTensorPow ((Scheme.Modules.pullback U.ι).obj N) 1 :=
  (restrictNatTensorPowIso M U 1).inv ≫
    (Scheme.Modules.pullback U.ι).map
      ((Stacks.AlgebraicGeometry.MorphismToProjUniversal.unitorPow M).hom ≫ m ≫
        (Stacks.AlgebraicGeometry.MorphismToProjUniversal.unitorPow N).inv) ≫
    (restrictNatTensorPowIso N U 1).hom

open Stacks.AlgebraicGeometry.ProjChartRatioPullbackLocalMul in
/-- `restrictPowOneMap` carries the restriction of a section `b` to that of `m b`. -/
private theorem restrictPowOneMap_app {X : Scheme.{u}} (U : X.Opens) {M N : X.Modules}
    [IsInvertibleModule X M] [IsInvertibleModule X N] (m : M ⟶ N) (b : Γ(M, U)) :
    (restrictPowOneMap U m).app ⊤ (restrictPowSection M U 1
        ((Stacks.AlgebraicGeometry.MorphismToProjUniversal.unitorPow M).inv.app U b)) =
      restrictPowSection N U 1
        ((Stacks.AlgebraicGeometry.MorphismToProjUniversal.unitorPow N).inv.app U (m.app U b)) := by
  rw [restrictPowSection_eq, restrictPowSection_eq]
  have key : ∀ y : Γ((Scheme.Modules.pullback U.ι).obj (natTensorPow M 1), ⊤),
      (restrictPowOneMap U m).app ⊤ ((restrictNatTensorPowIso M U 1).hom.app ⊤ y) =
        (restrictNatTensorPowIso N U 1).hom.app ⊤ (((Scheme.Modules.pullback U.ι).map
          ((Stacks.AlgebraicGeometry.MorphismToProjUniversal.unitorPow M).hom ≫ m ≫
            (Stacks.AlgebraicGeometry.MorphismToProjUniversal.unitorPow N).inv)).app ⊤ y) := by
    intro y
    simp only [restrictPowOneMap, Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply]
    rw [inv_app_hom_app']
  refine (key _).trans (congrArg _ ((restrictSection_naturality U _ _).trans (congrArg _ ?_)))
  simp only [Scheme.Modules.Hom.comp_app, ConcreteCategory.comp_apply]
  rw [hom_app_inv_app]

/-- **A global section vanishes wherever its image under a morphism of modules does not.** -/
private theorem nonvanishingOpen_app_le {Y : Scheme.{u}} {A B : Y.Modules}
    [IsInvertibleModule Y A] [IsInvertibleModule Y B] (k : A ⟶ B) (t : Γ(A, ⊤)) :
    Stacks.NonvanishingOpen.nonvanishingOpen Y B (k.app ⊤ t) ≤
      Stacks.NonvanishingOpen.nonvanishingOpen Y A t := by
  intro y hy hmem
  refine hy ?_
  rw [← Stacks.ModuleStalk.mapFun_Γgerm]
  exact Stacks.SectionProduct.mapFun_mem_maximalSmul k y hmem

/-- `ratioOf` depends only on the two sections, not on the proof of nonvanishing. -/
private theorem ratioOf_congr_sections {Y : Scheme.{u}} {L : Y.Modules}
    [IsInvertibleModule Y L] {n : ℕ} {V : Y.Opens} {t t' x x' : Γ(natTensorPow L n, ⊤)}
    (hV : V ≤ Stacks.NonvanishingOpen.nonvanishingOpen Y (natTensorPow L n) t)
    (hV' : V ≤ Stacks.NonvanishingOpen.nonvanishingOpen Y (natTensorPow L n) t')
    (ht : t = t') (hx : x = x') : ratioOf L t hV x = ratioOf L t' hV' x' := by
  subst ht hx
  rfl

/-- The degree-one element `Stacks.RelativeSegre.deg1` of a section is
`Stacks.Tag01VMVeryAmple.genSection`. -/
private theorem deg1_eq_genSection {S : Scheme.{u}} (E : S.Modules) [E.IsQuasicoherent]
    {W : S.Opens} (hW : IsAffineOpen W) (h : Γ(E, W)) :
    Stacks.RelativeSegre.deg1 E hW h = genSection E W h := by
  apply (Stacks.SymGraded.AffinePieces.symSectionRingEquiv E hW
    (Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent E)).injective
  rw [Stacks.RelativeSegre.deg1, RingEquiv.apply_symm_apply,
    Stacks.SymGraded.AffinePieces.symSectionRingEquiv_of_symmetricAlgebraGen]

/-- The ratio `c / c` of a degree-one generator by itself is `1`. -/
private theorem ratioOf_genSection_self {S : Scheme.{u}} (E : S.Modules) [E.IsQuasicoherent]
    {W : S.Opens} (hW : IsAffineOpen W) (c : Γ(E, W)) :
    Stacks.RelativeSegre.ratioOf E hW ⟨genSection E W c, genSection_mem E W c⟩ c = 1 := by
  unfold Stacks.RelativeSegre.ratioOf
  rw [show Stacks.RelativeSegre.deg1' E hW c = ⟨_, genSection_mem E W c⟩ from
    Subtype.ext (deg1_eq_genSection E hW c)]
  exact Stacks.RelativeSegre.ratio_self _ _

/-- **Ring maps out of `Sym(E)(W)_{(c)}` are determined by the ratios `h / c`.** The scalars
`r ∈ Γ(S, W)` are the ratios `(r c) / c`, and the ratios together with the scalars generate. -/
private theorem ringHom_ext_of_ratioOf {S : Scheme.{u}} (E : S.Modules) [E.IsQuasicoherent]
    {W : S.Opens} (hW : IsAffineOpen W) (c : Γ(E, W)) {R : Type*} [Ring R]
    {α β : HomogeneousLocalization.Away
      ((Stacks.Tag01VMRelativeVeryAmple.symAlgebra E).grading W) (genSection E W c) →+* R}
    (hαβ : ∀ h : Γ(E, W),
      α (Stacks.RelativeSegre.ratioOf E hW ⟨_, genSection_mem E W c⟩ h) =
        β (Stacks.RelativeSegre.ratioOf E hW ⟨_, genSection_mem E W c⟩ h)) :
    α = β := by
  have hT := Stacks.RelativeSegre.away_mem_of_ratios E hW ⟨_, genSection_mem E W c⟩ (α.prod β)
    (RingHom.eqLocus (RingHom.fst _ _) (RingHom.snd _ _))
    (fun r => by
      have := hαβ (r • c)
      rw [Stacks.RelativeSegre.ratioOf_smul, ratioOf_genSection_self, mul_one,
        Stacks.RelativeSegre.algebraMap_away] at this
      simpa using this)
    (fun h => by simpa using hαβ h)
  exact RingHom.ext fun z => by simpa using hT z

/-- **The chart ring map at a degree-one element `a = c` sends the ratio `h / c` to the ratio
`ψ(h) / ψ(c)` of sections.** -/
private theorem lift_ratioOf {S T : Scheme.{u}} (E : S.Modules) [E.IsQuasicoherent]
    {W : S.Opens} (hW : IsAffineOpen W) {L : T.Modules} [IsInvertibleModule T L]
    (ψ : Stacks.AlgebraicGeometry.ProjChartFullGraded.GradedSections
      ((Stacks.Tag01VMRelativeVeryAmple.symAlgebra E).grading W) L)
    {a : (Stacks.Tag01VMRelativeVeryAmple.symAlgebra E).sectionRing W}
    (ha : a ∈ (Stacks.Tag01VMRelativeVeryAmple.symAlgebra E).grading W 1) {V : T.Opens}
    (hV : V ≤ Stacks.NonvanishingOpen.nonvanishingOpen T (natTensorPow L 1) (ψ.toFun 1 ⟨a, ha⟩))
    (h : Γ(E, W)) :
    (ψ.homogeneousRatios ha hV).lift one_pos (Stacks.RelativeSegre.ratioOf E hW ⟨a, ha⟩ h) =
      ratioOf L (ψ.toFun 1 ⟨a, ha⟩) hV (ψ.toFun 1 ⟨genSection E W h, genSection_mem E W h⟩) := by
  have hx : Stacks.RelativeSegre.deg1 E hW h ∈
      (Stacks.Tag01VMRelativeVeryAmple.symAlgebra E).grading W (1 • 1) := by
    simpa only [smul_eq_mul, mul_one] using Stacks.RelativeSegre.deg1_mem E hW h
  change (ψ.homogeneousRatios ha hV).lift one_pos
    (HomogeneousLocalization.Away.mk _ ha 1 (Stacks.RelativeSegre.deg1 E hW h) hx) = _
  rw [Stacks.AlgebraicGeometry.ProjChartFullGraded.GradedSections.lift_mk ψ ha hV one_pos 1 _ hx
    ⟨genSection E W h, genSection_mem E W h⟩ (deg1_eq_genSection E hW h).symm]
  exact ψ.ratioOf_congr _ _ _ _ _ _ (by norm_num) (pow_one a) rfl

/-- The sections over `W` of the direct image of a morphism of modules, as a linear map. -/
private noncomputable def pushforwardSectionMap {X S : Scheme.{u}} (f : X ⟶ S) {M N : X.Modules}
    (m : M ⟶ N) (W : S.Opens) :
    Γ((Scheme.Modules.pushforward f).obj M, W) →ₗ[Γ(S, W)]
      Γ((Scheme.Modules.pushforward f).obj N, W) where
  toFun x := ((Scheme.Modules.pushforward f).map m).app W x
  map_add' := map_add _
  map_smul' := Scheme.Modules.Hom.app_smul _

/-- **A chart that is an immersion stays one along a morphism of modules.** For a morphism
`m : M ⟶ N` of invertible modules and a section `c` of `M` over `f⁻¹(W)`, if the chart of
`r_{M, ψ}` at `c` is an immersion, so is the chart of `r_{N, ψ}` at `m c`: on `X_{m c} ⊆ X_c` the
ratios `m h / m c` are the ratios `h / c`. -/
private theorem isImmersion_chart_map {X S : Scheme.{u}} (f : X ⟶ S) [QuasiCompact f]
    [QuasiSeparated f] {M N : X.Modules} [IsInvertibleModule X M] [IsInvertibleModule X N]
    (m : M ⟶ N) {W : S.Opens} (hW : IsAffineOpen W) (c : Γ(M, f ⁻¹ᵁ W))
    (himm : IsImmersion ((((directImageSymPowerMap f M).affineDatum W).homogeneousRatios
      (genSection_mem _ W (ofSec f M W c)) le_rfl).toSpecAway one_pos)) :
    IsImmersion ((((directImageSymPowerMap f N).affineDatum W).homogeneousRatios
      (genSection_mem _ W (ofSec f N W (m.app _ c))) le_rfl).toSpecAway one_pos) := by
  let φ := symSectionGradedHom ((Scheme.Modules.pushforward f).obj M)
    ((Scheme.Modules.pushforward f).obj N) hW hW (RingHom.id _) (pushforwardSectionMap f m W)
  let DM := (directImageSymPowerMap f M).affineDatum W
  let DN := (directImageSymPowerMap f N).affineDatum W
  let χ := Stacks.AlgebraicGeometry.ProjChartGradedRingFunctoriality.comap φ DN
  have ha := genSection_mem _ W (ofSec f M W c)
  have hφa : φ (genSection _ W (ofSec f M W c)) = genSection _ W (ofSec f N W (m.app _ c)) :=
    symSectionGradedHom_gen _ _ _ _ _ _ _
  let k := restrictPowOneMap (f ⁻¹ᵁ W) m
  have hKF : ∀ h : Γ(M, f ⁻¹ᵁ W),
      χ.toFun 1 ⟨genSection _ W (ofSec f M W h), genSection_mem _ W _⟩ =
        k.app ⊤ (DM.toFun 1 ⟨genSection _ W (ofSec f M W h), genSection_mem _ W _⟩) := by
    intro h
    rw [Stacks.AlgebraicGeometry.ProjChartGradedRingFunctoriality.comap_toFun]
    have e : (⟨φ (genSection _ W (ofSec f M W h)), map_mem φ (genSection_mem _ W _)⟩ :
        (Stacks.Tag01VMRelativeVeryAmple.symAlgebra
          ((Scheme.Modules.pushforward f).obj N)).grading W 1) =
        ⟨genSection _ W (ofSec f N W (m.app _ h)), genSection_mem _ W _⟩ :=
      Subtype.ext (symSectionGradedHom_gen _ _ _ _ _ _ _)
    rw [e, affineDatum_toFun_genSection, affineDatum_toFun_genSection]
    exact (restrictPowOneMap_app (f ⁻¹ᵁ W) m h).symm
  have hsub : Stacks.NonvanishingOpen.nonvanishingOpen _ _ (χ.toFun 1 ⟨_, ha⟩) ≤
      Stacks.NonvanishingOpen.nonvanishingOpen _ _ (DM.toFun 1 ⟨_, ha⟩) := by
    rw [hKF c]
    exact nonvanishingOpen_app_le k _
  have h1 : ∀ h : Γ((Scheme.Modules.pushforward f).obj M, W),
      (χ.homogeneousRatios ha le_rfl).lift one_pos
          (Stacks.RelativeSegre.ratioOf _ hW ⟨_, ha⟩ h) =
        (f ⁻¹ᵁ W).toScheme.presheaf.map (homOfLE hsub).op
          ((DM.homogeneousRatios ha le_rfl).lift one_pos
            (Stacks.RelativeSegre.ratioOf _ hW ⟨_, ha⟩ h)) := by
    intro h
    have hV' : Stacks.NonvanishingOpen.nonvanishingOpen _ _ (χ.toFun 1 ⟨_, ha⟩) ≤
        Stacks.NonvanishingOpen.nonvanishingOpen _ _ (k.app ⊤ (DM.toFun 1 ⟨_, ha⟩)) := by
      rw [← hKF c]
      exact le_rfl
    rw [lift_ratioOf, lift_ratioOf]
    exact (ratioOf_congr_sections le_rfl hV' (hKF c) (hKF h)).trans
      (ratioOf_map k _ _ le_rfl hV' hsub)
  have hlift : (χ.homogeneousRatios ha le_rfl).lift one_pos =
      (CommRingCat.Hom.hom ((f ⁻¹ᵁ W).toScheme.presheaf.map (homOfLE hsub).op)).comp
        ((DM.homogeneousRatios ha le_rfl).lift one_pos) :=
    ringHom_ext_of_ratioOf ((Scheme.Modules.pushforward f).obj M) hW (ofSec f M W c)
      fun h => (h1 h).trans (RingHom.comp_apply _ _ _).symm
  have hχ : IsImmersion ((χ.homogeneousRatios ha le_rfl).toSpecAway one_pos) := by
    rw [← Stacks.MorphismToProj.HomogeneousRatios.homOfLE_toSpecAway
      (DM.homogeneousRatios ha le_rfl) one_pos hsub (χ.homogeneousRatios ha le_rfl) hlift]
    infer_instance
  rw [toSpecAway_comap φ DN ha one_pos le_rfl] at hχ
  exact isImmersion_toSpecAway_of_eq DN hφa _ _ (@IsImmersion.of_comp _ _ _ _ _ hχ)

/-- Relative very ampleness from charts: if around every point some section of `L` over the
preimage of an affine open of the base does not vanish and has an immersion as its chart, then
`L` is relatively very ample. -/
private theorem isRelativelyVeryAmple_of_charts {X S : Scheme.{u}} (f : X ⟶ S) [QuasiCompact f]
    [QuasiSeparated f] (L : X.Modules) [IsInvertibleModule X L]
    (key : ∀ x : X, ∃ (W : S.Opens) (_ : IsAffineOpen W) (b : Γ(L, f ⁻¹ᵁ W)),
      x ∈ nonvanishingLocusOn L (f ⁻¹ᵁ W) b ∧
      IsImmersion ((((directImageSymPowerMap f L).affineDatum W).homogeneousRatios
        (genSection_mem _ W (ofSec f L W b)) le_rfl).toSpecAway one_pos)) :
    IsRelativelyVeryAmple f L := by
  have hepi : Epi ((Scheme.Modules.pullbackPushforwardAdjunction f).counit.app L) := by
    have h := epi_adjoint_of_forall_mem_nonvanishingLocusOn f (N := L)
      (𝟙 ((Scheme.Modules.pushforward f).obj L)) fun x => by
        obtain ⟨W, -, b, hb, -⟩ := key x
        exact ⟨W, ofSec f L W b, hb⟩
    rwa [homEquiv_symm_id] at h
  refine isRelativelyVeryAmple_of_isImmersionDirectImageBundle f L ⟨inferInstance, hepi, ?_⟩
  rw [isImmersion_toRelativeProj_iff]
  refine isImmersion_globalMorphism_of_chartsAreImmersions _ _ fun x => ?_
  obtain ⟨W, hW, b, hb, himm⟩ := key x
  have hmem : (⟨x, hb.1⟩ : (f ⁻¹ᵁ W).toScheme) ∈
      ((directImageSymPowerMap f L).affineDatum W).nonvanishingOpenAt 1
        ⟨genSection _ W (ofSec f L W b), genSection_mem _ W (ofSec f L W b)⟩ := by
    rw [GradedPowerMap.nonvanishingOpenAt_affineDatum]
    have hc : (Stacks.Tag01VMRelativeVeryAmple.symAlgebra
        ((Scheme.Modules.pushforward f).obj L)).componentEquiv W 1
        ⟨genSection _ W (ofSec f L W b), genSection_mem _ W (ofSec f L W b)⟩ =
        Scheme.Modules.Hom.app (Scheme.Modules.symmetricAlgebraGen S
          ((Scheme.Modules.pushforward f).obj L)) W (ofSec f L W b) := by
      rw [Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra.componentEquiv_apply]
      exact DirectSum.of_eq_same _ _
    rw [hc]
    exact (mem_nonvanishingOpenAt_directImageSymPowerMap_iff f L W (ofSec f L W b) x).mpr hb
  exact ⟨W, hW, genSection _ W (ofSec f L W b), genSection_mem _ W (ofSec f L W b),
    ⟨⟨x, hb.1⟩, hmem⟩, rfl, himm⟩

open scoped Stacks.TensorSectionNonvanishing in
/-- The statement for `V ⊗ G`, the multiplication by a section of `G` acting on the right. -/
private theorem isRelativelyVeryAmple_tensorObj {X S : Scheme.{u}} (f : X ⟶ S) [QuasiCompact f]
    [QuasiSeparated f] (G V : X.Modules) [IsInvertibleModule X G] [IsInvertibleModule X V]
    (hG : _root_.SheafOfModules.IsGeneratedByGlobalSections G)
    (hV : IsRelativelyVeryAmple f V) : IsRelativelyVeryAmple f (V ⊗ G) := by
  refine isRelativelyVeryAmple_of_charts f (V ⊗ G) fun x => ?_
  obtain ⟨W, hW, c, hxc, himm⟩ := exists_isImmersion_chart_of_member f V ⊤
    (isRelativelyVeryAmple_morphismRestrict f V hV ⊤) x trivial
  obtain ⟨s, hs⟩ := exists_mem_nonvanishingLocus_of_isGeneratedByGlobalSections G hG x
  let g : 𝟙_ X.Modules ⟶ G := (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X G).symm s
  have hg : Stacks.SectionProduct.globalSection X G g = s :=
    (Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv X G).apply_symm_apply s
  refine ⟨W, hW, Stacks.TensorSectionNonvanishing.mulSec V g c,
    mem_nonvanishingLocusOn_mulSec V g c hxc (hg ▸ hs), ?_⟩
  exact isImmersion_chart_map f (Stacks.TensorSectionNonvanishing.mulRight V g) hW c himm

/-- On a proper scheme `X` over a field `k`, with structure morphism `f`, the tensor product of an
invertible module `G` generated by global sections with an invertible module `V` very ample
relative to `f` is very ample relative to `f`. -/
@[faltings "lem_nt_very_ample_twist"]
theorem isRelativelyVeryAmple_tensorModules_of_isGeneratedByGlobalSections
    (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f]
    (G V : X.Modules) [IsInvertibleModule X G] [IsInvertibleModule X V]
    (hG : _root_.SheafOfModules.IsGeneratedByGlobalSections G)
    (hV : Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple f V) :
    Stacks.Tag01VMVeryAmple.IsRelativelyVeryAmple f
      (Stacks.RelativeVeryAmple.tensorModules X G V) := by
  obtain ⟨E, hE, i, him, hover, ⟨e⟩⟩ := isRelativelyVeryAmple_tensorObj f G V hG hV
  exact ⟨E, hE, i, him, hover,
    ⟨((Stacks.TensorSheafSpellingIso.monoidalTensorIso X G V).symm ≪≫ β_ G V) ≪≫ e⟩⟩

end Faltings
