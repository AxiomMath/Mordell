module

public import Mordell.AlgebraicGeometry.Ample
public import Mordell.AlgebraicGeometry.ProjectiveSpace.MorphismOfSections
public import Mordell.AlgebraicGeometry.ProjectiveSpace.Segre.ProductEmbedding
public import Mordell.AlgebraicGeometry.ProjectiveSpace.Segre.ProductPullback
public import StacksFrontier.AlgebraicGeometry.AmplePredicateBridge.Basic
public import StacksFrontier.AlgebraicGeometry.TensorSheafSpellingIso.Strict

/-!
# Twisting by a very ample line bundle

Let `X` be a projective variety over a field `k`, `L` a very ample line bundle and `M` any line
bundle on `X`. Then `M ⊗ L^{⊗ a}` is very ample for all sufficiently large integers `a`. This is
a consequence of Serre's theorem: for `a ≫ 0` the bundle `M ⊗ L^{⊗ (a - 1)}` is globally
generated, its sections give a morphism `t : X ⟶ ℙʳ_k` with `t^* 𝒪(1) ≅ M ⊗ L^{⊗ (a - 1)}`, and
the Segre product of `t` with a projective embedding `ι` with `ι^* 𝒪(1) ≅ L` is a projective
embedding pulling `𝒪(1)` back to `M ⊗ L^{⊗ a}`.

## Main results

* `Faltings.eventually_isVeryAmple_tensorModules_tensorPowModule`: if `L` is very ample, then
  `M ⊗ L^{⊗ a}` is very ample for all sufficiently large `a : ℤ`.

## Implementation notes

The tensor product of `𝒪_X`-modules is `Stacks.RelativeVeryAmple.tensorModules` and the
integer tensor powers are `Stacks.Ample.tensorPowModule`; both are invertible by instance, so
`Faltings.IsVeryAmple` applies to `M ⊗ L^{⊗ a}` directly. "For all sufficiently large integers"
is `∀ᶠ a in Filter.atTop` on `ℤ`. The base is an arbitrary field `k`; the source's case is
`k = \bar{ℚ}`.

## References

* [Hartshorne, *Algebraic Geometry*, II.5.17, II Ex. 7.5][hartshorne1977]
* [Bombieri, *The Mordell conjecture revisited*, Sec. 2][bombieri1990]
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace Faltings

section

variable {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProjectiveVariety k f]

/-- Very ampleness moves along an isomorphism of line bundles. -/
private lemma isVeryAmple_of_iso {L L' : X.Modules} [Stacks.Ample.IsInvertibleModule X L]
    [Stacks.Ample.IsInvertibleModule X L'] (i : L ≅ L') (hL : IsVeryAmple f L) :
    IsVeryAmple f L' := by
  obtain ⟨n, φ, ⟨e⟩⟩ := hL
  exact ⟨n, φ, ⟨i.symm ≪≫ e⟩⟩

/-- A very ample line bundle is ample: it is the restriction of `𝒪(1)` along a closed
immersion. -/
private lemma isAmple_of_isVeryAmple (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
    (hL : IsVeryAmple f L) : Stacks.Ample.IsAmple X L := by
  obtain ⟨n, φ, ⟨e⟩⟩ := hL
  have := φ.isClosedImmersion
  refine (Stacks.RelativeVeryAmple.isAmple_congr _ _ ?_).1
    (Stacks.AmplePullback.isAmple_modulePullback_of_isClosedImmersion φ.hom _
      (Stacks.ProjectiveSpace.isAmple_projectiveSpaceTwistingSheaf n (Spec (.of k))))
  exact ((RingedSpaceModuleAdjunction.modulePullbackPushforwardAdjunction
    φ.hom.toLRSHom.toShHom).leftAdjointUniq
      (Scheme.Modules.pullbackPushforwardAdjunction φ.hom)).app _ ≪≫ e.symm

/-- A line bundle generated by finitely many global sections has global sections
`s : Fin (c + 1) → Γ(P, ⊤)` without common zero (the family extended by `0`). -/
private lemma exists_fin_sections_nonvanishing (P : X.Modules)
    [Stacks.Ample.IsInvertibleModule X P] (σ : P.GeneratingSections) [Finite σ.I] :
    ∃ (c : ℕ) (s : Fin (c + 1) → Γ(P, ⊤)),
      ∀ x : X, ∃ j, x ∈ Stacks.Ample.nonvanishingLocus P (s j) := by
  obtain ⟨c, ⟨eI⟩⟩ := Finite.exists_equiv_fin σ.I
  refine ⟨c, Fin.snoc (fun j => (σ.s (eI.symm j)).eval (.op ⊤)) 0, fun x => ?_⟩
  obtain ⟨i, hi⟩ := Stacks.SheafOfModules.exists_generatingSection_nonvanishing P σ x
  refine ⟨(eI i).castSucc, ?_⟩
  have hi' : Fin.snoc (α := fun _ => Γ(P, ⊤)) (fun j => (σ.s (eI.symm j)).eval (.op ⊤)) 0
      (eI i).castSucc = (σ.s i).eval (.op ⊤) :=
    (Fin.snoc_castSucc ..).trans (congrArg (fun i => (σ.s i).eval (.op ⊤)) (eI.symm_apply_apply i))
  rw [hi', ← Stacks.AmplePredicateBridge.coe_nonvanishingOpen_eval X P (σ.s i)]
  exact hi

/-- **The Segre step.** If the global sections `s` of a line bundle `P` have no common zero and
`L` is very ample, then `P ⊗ L` is very ample: the Segre product of the morphism defined by `s`
with a projective embedding for `L` is a projective embedding pulling `𝒪(1)` back to `P ⊗ L`. -/
private lemma isVeryAmple_tensorModules_of_nonvanishing (P : X.Modules)
    [Stacks.Ample.IsInvertibleModule X P] {r : ℕ} (s : Fin (r + 1) → Γ(P, ⊤))
    (hs : ∀ x : X, ∃ j, x ∈ Stacks.Ample.nonvanishingLocus P (s j))
    (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] (hL : IsVeryAmple f L) :
    IsVeryAmple f (Stacks.RelativeVeryAmple.tensorModules X P L) := by
  obtain ⟨n, φ, ⟨e⟩⟩ := hL
  obtain ⟨t, ht, α, -⟩ := exists_hom_and_iso_pullback_projectiveSpaceTwistingSheaf f P s hs
  obtain ⟨ψ, hψ⟩ := ProjectiveEmbedding.exists_hom_eq_segreProduct t φ
    (ht.trans φ.hom_over.symm)
  obtain ⟨β⟩ := nonempty_pullback_segreProduct_projectiveSpaceTwistingSheaf_iso t φ.hom
    (ht.trans φ.hom_over.symm)
  refine ⟨_, ψ, ⟨?_⟩⟩
  rw [hψ]
  exact (β ≪≫ Stacks.RelativeVeryAmple.tensorModulesMapIso X α e.symm).symm

/-- `M ⊗ L^{⊗ (a - 1)} ⊗ L ≅ M ⊗ L^{⊗ a}`. -/
private noncomputable def tensorModulesTensorPowModuleSubOneIso (M L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L] (a : ℤ) :
    Stacks.RelativeVeryAmple.tensorModules X
        (Stacks.RelativeVeryAmple.tensorModules X M (Stacks.Ample.tensorPowModule X L (a - 1))) L ≅
      Stacks.RelativeVeryAmple.tensorModules X M (Stacks.Ample.tensorPowModule X L a) :=
  Stacks.TensorSheafSpellingIso.tensorModulesAssociator X _ _ _ ≪≫
    Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl M)
      (Stacks.RelativeVeryAmple.tensorModulesMapIso X (Iso.refl _)
        (Stacks.Ample.tensorPowModuleOneIso X L).symm ≪≫
       Stacks.Ample.tensorPowModuleAddIso X L (a - 1) 1 ≪≫
       Stacks.RelativeVeryAmple.tensorPowModuleCongr X L (by ring))

end

/-- **Twisting by a very ample bundle.** If `L` is a very ample line bundle on a projective
variety `X` over a field `k` and `M` is any line bundle on `X`, then `M ⊗ L^{⊗ a}` is very ample
for all sufficiently large integers `a`. -/
@[faltings "lem_ht_projective_geometry_facts"]
public theorem eventually_isVeryAmple_tensorModules_tensorPowModule {k : Type u} [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProjectiveVariety k f]
    (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L] (hL : IsVeryAmple f L)
    (M : X.Modules) [Stacks.Ample.IsInvertibleModule X M] :
    ∀ᶠ a : ℤ in Filter.atTop,
      IsVeryAmple f (Stacks.RelativeVeryAmple.tensorModules X M
        (Stacks.Ample.tensorPowModule X L a)) := by
  obtain ⟨n₀, hn₀⟩ := Stacks.AmpleLocalGeneration.isEventuallyGloballyGenerated_of_isAmple L
    (isAmple_of_isVeryAmple f L hL) M
    (Stacks.AmpleGlobalGeneration.isQuasicoherent_of_isInvertibleModule M)
    (Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule M)
  filter_upwards [Filter.eventually_ge_atTop (n₀ + 1)] with a ha
  obtain ⟨σ, hσ⟩ := hn₀ (a - 1) (by omega)
  -- `σ` generates `M ⊗ L^{⊗ (a - 1)}` in the monoidal spelling; move it to `tensorModules`.
  let eT := Stacks.AmplePullbackPart1.tensorIsoTensorModules X M
    (Stacks.Ample.tensorPowModule X L (a - 1))
  let σ' := @SheafOfModules.GeneratingSections.ofEpi _ _ _ _ _ _ _ _ σ eT.hom
    (@IsIso.epi_of_iso _ _ _ _ eT.hom (Iso.isIso_hom eT))
  have : Finite σ'.I := hσ
  obtain ⟨c, s, hs⟩ := exists_fin_sections_nonvanishing _ σ'
  exact isVeryAmple_of_iso f (tensorModulesTensorPowModuleSubOneIso M L a)
    (isVeryAmple_tensorModules_of_nonvanishing f _ s hs L hL)

end Faltings
