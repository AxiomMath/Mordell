module

public import Mordell.AlgebraicGeometry.ProjectiveSpace.Embedding
public import Mordell.AlgebraicGeometry.ProjectiveSpace.Veronese.ClosedImmersion

/-!
# Veronese composites of projective embeddings

Let `X` be a projective variety over a field `k` and `φ : X ⟶ ℙⁿ_k` a projective embedding.
For `e ≥ 1` let `Φ_e : ℙⁿ ⟶ ℙᴺ` be the Veronese morphism of degree `e`, whose homogeneous
coordinates `y_I` are the monomials `x^I` of degree `e` (so `N + 1 = binom (n + e) n`). Then the
Veronese composite `φ^{(e)} = Φ_e ∘ φ` is again a projective embedding: it is a composite of two
closed immersions.

## Main results

* `Faltings.ProjectiveEmbedding.exists_veronese`: for every ordering
  `σ : {I // |I| = e} ≃ Fin (N + 1)` of the monomials of degree `e`, there is a projective
  embedding `X ⟶ ℙᴺ_k` whose underlying morphism is `Φ_e ∘ φ`.

## Implementation notes

Projective space over `k` is `AlgebraicGeometry.projectiveSpaceOver n (Spec k)`, the base
change to `Spec k` of the integral model `AlgebraicGeometry.projectiveSpaceAtUniverse n`, which
is `Proj` of `MvPolynomial (Fin (n + 1)) (ULift ℤ)` graded by total degree. The Veronese
morphism is defined over `ℤ` and is given on the integral model by its charts: on `D₊(x_i)` it
lands in `D₊(y_{σ (e • eᵢ)})`, since `y_{e • eᵢ} = x_i ^ e`, and it pulls back
`y_{σ J} / y_{σ (e • eᵢ)}` to `x^J / x_i ^ e`. The charts `D₊(x_i)` cover `ℙⁿ`, and their
coordinate rings are generated by these fractions, so the conditions determine the morphism `V`.
A morphism to `ℙᴺ_k` over `Spec k` is determined by its composite with the projection to the
integral model, so the condition `ψ.hom ≫ pr = φ.hom ≫ pr ≫ V` pins `ψ` to `Φ_e ∘ φ`. The
target's coordinates are indexed by `Fin (N + 1)`, so the statement is quantified over an
arbitrary ordering `σ` of the monomials. Such an ordering forces `N + 1 = binom (n + e) n`.

`Faltings.exists_isClosedImmersion_veronese` takes the variables in the universe of the
coefficient ring and indexes the target coordinates by the monomials themselves, so it is
conjugated by the isomorphisms of `Proj` induced by renaming the variables, along `Equiv.ulift`
on the source and along `σ` on the target; on each chart `D₊(xᵢ)` such an isomorphism restricts
to the chart of the renamed coordinate (`AlgebraicGeometry.Proj.awayι_comp_map`). The base change
of a closed immersion `Y ⟶ Z` to `S ×_ℤ Y ⟶ S ×_ℤ Z` is a closed immersion by pasting pullback
squares.

## References

* [Bombieri, *The Mordell conjecture revisited*, §2][bombieri1990]
* [Gao, *An Introduction to Diophantine Geometry*, proof of Prop. 5.1.3(iii)][gao2022]
* [Hartshorne, *Algebraic Geometry*, II Ex. 5.13][hartshorne1977]
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

universe u v w

namespace Faltings

section Renaming

variable {R : Type u} [CommRing R]

/-- Renaming the variables along `τ` as a graded ring hom of polynomial rings graded by
total degree. -/
private noncomputable def renameGraded {α : Type v} {β : Type w} (τ : α → β) :
    homogeneousSubmodule α R →+*ᵍ homogeneousSubmodule β R where
  toRingHom := (rename τ : MvPolynomial α R →ₐ[R] MvPolynomial β R).toRingHom
  map_mem hx := ((mem_homogeneousSubmodule _ _).1 hx).rename_isHomogeneous

private lemma renameGraded_apply {α : Type v} {β : Type w} (τ : α → β) (p : MvPolynomial α R) :
    renameGraded (R := R) τ p = rename τ p := rfl

private lemma irrelevant_le_map_renameGraded {α : Type v} {β : Type w} (τ : α ≃ β) :
    HomogeneousIdeal.irrelevant (homogeneousSubmodule β R) ≤
      (HomogeneousIdeal.irrelevant (homogeneousSubmodule α R)).map (renameGraded τ) := by
  refine (HomogeneousIdeal.irrelevant_le _).2 fun i hi x hx => ?_
  have hy : rename τ.symm x ∈ homogeneousSubmodule α R i :=
    (mem_homogeneousSubmodule _ _).2 ((mem_homogeneousSubmodule _ _).1 hx).rename_isHomogeneous
  simpa [renameGraded_apply, rename_rename] using
    Ideal.mem_map_of_mem (renameGraded τ) (HomogeneousIdeal.mem_irrelevant_of_mem _ hi hy)

private lemma renameGraded_comp_renameGraded_symm {α : Type v} {β : Type w} (τ : α ≃ β) :
    (renameGraded (R := R) τ).comp (renameGraded τ.symm) = GradedRingHom.id _ :=
  GradedRingHom.ext fun x => by
    simp [GradedRingHom.comp_apply, renameGraded_apply, rename_rename]

private lemma renameGraded_symm_comp_renameGraded {α : Type v} {β : Type w} (τ : α ≃ β) :
    (renameGraded (R := R) τ.symm).comp (renameGraded τ) = GradedRingHom.id _ := by
  simpa using renameGraded_comp_renameGraded_symm (R := R) τ.symm

/-- A graded ring isomorphism, given as a pair of mutually inverse graded ring homs, induces an
isomorphism of the `Proj`s. -/
private noncomputable def projIsoOfInverse {A B σ τ : Type u} [CommRing A] [SetLike σ A]
    [AddSubgroupClass σ A] [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
    {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ) (g : ℬ →+*ᵍ 𝒜)
    (hf : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map f)
    (hg : HomogeneousIdeal.irrelevant 𝒜 ≤ (HomogeneousIdeal.irrelevant ℬ).map g)
    (hgf : g.comp f = .id 𝒜) (hfg : f.comp g = .id ℬ) :
    AlgebraicGeometry.Proj ℬ ≅ AlgebraicGeometry.Proj 𝒜 where
  hom := Proj.map f hf
  inv := Proj.map g hg
  hom_inv_id := by simp only [← Proj.map_comp, hfg, Proj.map_id]
  inv_hom_id := by simp only [← Proj.map_comp, hgf, Proj.map_id]

private lemma degree_domCongr {α : Type v} {β : Type w} (τ : α ≃ β) (I : α →₀ ℕ) :
    (Finsupp.domCongr τ I).degree = I.degree := by
  simp only [Finsupp.degree, Finsupp.domCongr_apply, Finsupp.equivMapDomain]
  exact Finset.sum_equiv τ.symm (by simp) (by simp)

/-- For a graded ring hom `f` with `f s = t`, the morphism `Proj.map f` restricts on the chart
`D₊(t)` to the chart `D₊(s)`, through the ring map `p / s ^ n ↦ f p / t ^ n`. -/
private lemma awayι_comp_map_of_eq {A B σ τ : Type u} [CommRing A] [SetLike σ A]
    [AddSubgroupClass σ A] [CommRing B] [SetLike τ B] [AddSubgroupClass τ B]
    {𝒜 : ℕ → σ} {ℬ : ℕ → τ} [GradedRing 𝒜] [GradedRing ℬ] (f : 𝒜 →+*ᵍ ℬ)
    (hf : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map f)
    {i : ℕ} (hi : 0 < i) (s : A) (hs : s ∈ 𝒜 i) (t : B) (ht : t ∈ ℬ i) (h : f s = t) :
    ∃ φ : HomogeneousLocalization.Away 𝒜 s →+* HomogeneousLocalization.Away ℬ t,
      Proj.awayι ℬ t ht hi ≫ Proj.map f hf =
          Spec.map (CommRingCat.ofHom φ) ≫ Proj.awayι 𝒜 s hs hi ∧
        ∀ (n : ℕ) (p : A) (hp : p ∈ 𝒜 (n • i)),
          φ (HomogeneousLocalization.Away.mk _ hs n p hp) =
            HomogeneousLocalization.Away.mk _ ht n (f p) (f.map_mem hp) := by
  subst h
  exact ⟨HomogeneousLocalization.Away.map f s, Proj.awayι_comp_map f hf hi s hs,
    fun n p hp => HomogeneousLocalization.Away.map_mk _ _ _ _ _ _⟩

private lemma Spec_map_appTop_ΓSpecIso_inv {A B : Type u} [CommRing A] [CommRing B]
    (φ : A →+* B) (x : A) :
    (Spec.map (CommRingCat.ofHom φ)).appTop ((Scheme.ΓSpecIso (.of A)).inv x) =
      (Scheme.ΓSpecIso (.of B)).inv (φ x) :=
  (ConcreteCategory.congr_hom (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ)) x).symm

/-- The Veronese morphism `Proj R[x₀, …, xₙ] ⟶ Proj R[y₀, …, y_N]` for monomials of degree `e`
ordered by `σ`: a closed immersion which on each chart `D₊(xᵢ)` factors through
`D₊(y_{σ(e·eᵢ)})` with `y_{σ J} / y_{σ(e·eᵢ)} ↦ x^J / xᵢ^e`.
This is `Faltings.exists_isClosedImmersion_veronese` transported along the renamings
`ULift (Fin (n + 1)) ≃ Fin (n + 1)` and `σ`. -/
private lemma exists_isClosedImmersion_veronese_fin {n : ℕ} (e : ℕ) (he : 1 ≤ e) (N : ℕ)
    (σ : {I : Fin (n + 1) →₀ ℕ // I.degree = e} ≃ Fin (N + 1)) :
    ∃ V : AlgebraicGeometry.Proj (homogeneousSubmodule (Fin (n + 1)) R) ⟶
        AlgebraicGeometry.Proj (homogeneousSubmodule (Fin (N + 1)) R),
      IsClosedImmersion V ∧
      ∀ i : Fin (n + 1),
        ∃ g : Spec (.of (HomogeneousLocalization.Away
              (homogeneousSubmodule (Fin (n + 1)) R) (MvPolynomial.X i))) ⟶
            Spec (.of (HomogeneousLocalization.Away
              (homogeneousSubmodule (Fin (N + 1)) R)
              (MvPolynomial.X (σ ⟨Finsupp.single i e, Finsupp.degree_single i e⟩)))),
          g ≫ Proj.awayι (homogeneousSubmodule (Fin (N + 1)) R)
              (MvPolynomial.X (σ ⟨Finsupp.single i e, Finsupp.degree_single i e⟩))
              ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ _)) one_pos =
            Proj.awayι (homogeneousSubmodule (Fin (n + 1)) R) (MvPolynomial.X i)
              ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ i)) one_pos ≫ V ∧
          ∀ J : {I : Fin (n + 1) →₀ ℕ // I.degree = e},
            g.appTop ((Scheme.ΓSpecIso _).inv
                (HomogeneousLocalization.Away.mk _
                  ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ _)) 1
                  (MvPolynomial.X (σ J))
                  ((mem_homogeneousSubmodule _ _).2 (isHomogeneous_X _ _)))) =
              (Scheme.ΓSpecIso _).inv
                (HomogeneousLocalization.Away.mk _
                  ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ i)) e (monomial J.1 1)
                  ((mem_homogeneousSubmodule _ _).2
                    (isHomogeneous_monomial _ (by rw [smul_eq_mul, mul_one]; exact J.2)))) := by
  obtain ⟨v, hv, -, hvc⟩ := Faltings.exists_isClosedImmersion_veronese R
    (ULift.{u} (Fin (n + 1))) e he
  -- reindexing the monomials of degree `e`
  let eS : {I : ULift.{u} (Fin (n + 1)) →₀ ℕ // I.degree = e} ≃
      {I : Fin (n + 1) →₀ ℕ // I.degree = e} :=
    Equiv.subtypeEquiv (Finsupp.domCongr Equiv.ulift).toEquiv fun I => by
      rw [AddEquiv.toEquiv_eq_coe, AddEquiv.coe_toEquiv, degree_domCongr]
  let τ := eS.trans σ
  refine ⟨(projIsoOfInverse _ _ (irrelevant_le_map_renameGraded (R := R) Equiv.ulift.{u})
      (irrelevant_le_map_renameGraded _) (renameGraded_symm_comp_renameGraded _)
      (renameGraded_comp_renameGraded_symm _)).hom ≫ v ≫
    (projIsoOfInverse _ _ (irrelevant_le_map_renameGraded (R := R) τ.symm)
      (irrelevant_le_map_renameGraded _) (renameGraded_symm_comp_renameGraded _)
      (renameGraded_comp_renameGraded_symm _)).hom, inferInstance, fun i => ?_⟩
  obtain ⟨g', hg'₁, hg'₂⟩ := hvc (ULift.up i)
  obtain ⟨φa, hφa₁, hφa₂⟩ := awayι_comp_map_of_eq (renameGraded (R := R) Equiv.ulift.{u})
    (irrelevant_le_map_renameGraded _) one_pos (MvPolynomial.X (ULift.up i))
    ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ _)) (MvPolynomial.X i)
    ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ _))
    (by rw [renameGraded_apply, rename_X]; rfl)
  obtain ⟨φb, hφb₁, hφb₂⟩ := awayι_comp_map_of_eq (renameGraded (R := R) τ.symm)
    (irrelevant_le_map_renameGraded _) one_pos
    (MvPolynomial.X (σ ⟨Finsupp.single i e, Finsupp.degree_single i e⟩))
    ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ _))
    (MvPolynomial.X ⟨Finsupp.single (ULift.up i) e, Finsupp.degree_single _ e⟩)
    ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ _))
    (by
      rw [renameGraded_apply, rename_X]
      simp only [τ, Equiv.symm_trans_apply, Equiv.symm_apply_apply]
      congr 1
      apply Subtype.ext
      simp [eS, Finsupp.equivMapDomain_single])
  refine ⟨Spec.map (CommRingCat.ofHom φa) ≫ g' ≫ Spec.map (CommRingCat.ofHom φb), ?_, ?_⟩
  · rw [Category.assoc, Category.assoc, ← hφb₁, ← Category.assoc g', hg'₁, Category.assoc,
      ← Category.assoc (Spec.map _), ← hφa₁]
    simp only [Category.assoc]
    rfl
  · intro J
    have hJ : renameGraded (R := R) τ.symm (MvPolynomial.X (σ J)) =
        MvPolynomial.X (eS.symm J) := by
      rw [renameGraded_apply, rename_X]
      simp only [τ, Equiv.symm_trans_apply, Equiv.symm_apply_apply]
    have hm : renameGraded (R := R) Equiv.ulift.{u} (monomial (eS.symm J).1 1) =
        monomial J.1 1 := by
      rw [renameGraded_apply, rename_monomial]
      congr 2
      ext j
      rw [← Equiv.ulift.apply_symm_apply j,
        Finsupp.mapDomain_apply_of_injective Equiv.ulift.injective]
      simp [eS]
    simp only [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    rw [Spec_map_appTop_ΓSpecIso_inv, hφb₂]
    simp only [hJ]
    rw [hg'₂ (eS.symm J), Spec_map_appTop_ΓSpecIso_inv, hφa₂]
    simp only [hm]

/-- The base change `S ×_ℤ Y ⟶ S ×_ℤ Z` of a closed immersion `V : Y ⟶ Z` of schemes is a closed
immersion. -/
private lemma isClosedImmersion_pullback_lift_terminal (S : Scheme.{u}) {Y Z : Scheme.{u}}
    (V : Y ⟶ Z) [IsClosedImmersion V] :
    IsClosedImmersion (Limits.pullback.lift (Limits.pullback.fst _ _)
      (Limits.pullback.snd _ _ ≫ V) (Limits.terminal.hom_ext _ _) :
        Limits.pullback (Limits.terminal.from S) (Limits.terminal.from Y) ⟶
          Limits.pullback (Limits.terminal.from S) (Limits.terminal.from Z)) := by
  refine MorphismProperty.of_isPullback (P := @IsClosedImmersion)
    (f' := Limits.pullback.snd _ _) (f := Limits.pullback.snd _ _) ?_ ‹_›
  refine IsPullback.of_bot (v₂₁ := Limits.pullback.fst _ _) (v₂₂ := Limits.terminal.from Z)
    (h₃₁ := Limits.terminal.from S) ?_ (Limits.pullback.lift_snd _ _ _).symm
    (IsPullback.of_hasPullback _ _).flip
  rw [Limits.pullback.lift_fst, Limits.terminal.hom_ext (V ≫ _) (Limits.terminal.from Y)]
  exact (IsPullback.of_hasPullback _ _).flip

end Renaming

/-- For a projective embedding `φ : X ⟶ ℙⁿ_k` and `e ≥ 1`, the **Veronese composite**
`Φ_e ∘ φ : X ⟶ ℙᴺ_k` is a projective embedding. Here `σ` orders the monomials of degree `e`.
`V` is the Veronese morphism of the integral models. On the chart `D₊(x_i)` it factors through
`D₊(y_{σ (e • eᵢ)})` and sends `y_{σ J} / y_{σ (e • eᵢ)}` to `x^J / x_i ^ e`. The embedding `ψ`
has underlying morphism `Φ_e ∘ φ`, the base change of `V` composed with `φ`. -/
@[faltings "lem_ht_veronese_embedding_closed_immersion"]
public theorem ProjectiveEmbedding.exists_veronese {k : Type u} [Field k] {X : Scheme.{u}}
    {f : X ⟶ Spec (.of k)} [IsProjectiveVariety k f] {n : ℕ} (φ : ProjectiveEmbedding f n)
    (e : ℕ) (he : 1 ≤ e) (N : ℕ)
    (σ : {I : Fin (n + 1) →₀ ℕ // I.degree = e} ≃ Fin (N + 1)) :
    ∃ (V : projectiveSpaceAtUniverse.{u} n ⟶ projectiveSpaceAtUniverse.{u} N)
      (ψ : ProjectiveEmbedding f N),
      (∀ i : Fin (n + 1),
        ∃ g : Spec (.of (HomogeneousLocalization.Away
              (homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ)) (MvPolynomial.X i))) ⟶
            Spec (.of (HomogeneousLocalization.Away
              (homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ))
              (MvPolynomial.X (σ ⟨Finsupp.single i e, Finsupp.degree_single i e⟩)))),
          g ≫ Proj.awayι (homogeneousSubmodule (Fin (N + 1)) (ULift.{u} ℤ))
              (MvPolynomial.X (σ ⟨Finsupp.single i e, Finsupp.degree_single i e⟩))
              ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ _)) one_pos =
            Proj.awayι (homogeneousSubmodule (Fin (n + 1)) (ULift.{u} ℤ)) (MvPolynomial.X i)
              ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ i)) one_pos ≫ V ∧
          ∀ J : {I : Fin (n + 1) →₀ ℕ // I.degree = e},
            g.appTop ((Scheme.ΓSpecIso _).inv
                (HomogeneousLocalization.Away.mk _
                  ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ _)) 1
                  (MvPolynomial.X (σ J))
                  ((mem_homogeneousSubmodule _ _).2 (isHomogeneous_X _ _)))) =
              (Scheme.ΓSpecIso _).inv
                (HomogeneousLocalization.Away.mk _
                  ((mem_homogeneousSubmodule 1 _).2 (isHomogeneous_X _ i)) e (monomial J.1 1)
                  ((mem_homogeneousSubmodule _ _).2
                    (isHomogeneous_monomial _ (by rw [smul_eq_mul, mul_one]; exact J.2))))) ∧
      ψ.hom ≫ projectiveSpaceOver.toIntegralAtUniverse N (Spec (.of k)) =
        φ.hom ≫ projectiveSpaceOver.toIntegralAtUniverse n (Spec (.of k)) ≫ V := by
  obtain ⟨V, hV, hVc⟩ := exists_isClosedImmersion_veronese_fin (R := ULift.{u} ℤ) e he N σ
  let w : projectiveSpaceOver n (Spec (.of k)) ⟶ projectiveSpaceOver N (Spec (.of k)) :=
    Limits.pullback.lift (Limits.pullback.fst _ _) (Limits.pullback.snd _ _ ≫ V)
      (Limits.terminal.hom_ext _ _)
  have : IsClosedImmersion w := isClosedImmersion_pullback_lift_terminal _ V
  have := φ.isClosedImmersion
  refine ⟨V, ⟨φ.hom ≫ w, inferInstance, ?_⟩, hVc, ?_⟩
  · rw [Category.assoc, show w ≫ projectiveSpaceOver N (Spec (.of k)) ↘ Spec (.of k) =
      projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k) from Limits.pullback.lift_fst _ _ _,
      φ.hom_over]
  · simp only [Category.assoc]
    exact congrArg (φ.hom ≫ ·) (Limits.pullback.lift_snd _ _ _)

end Faltings
