/-!
# Dimensions of cup-product sheaf cohomology

The cohomology `Hⁿ(X, ℱ)` of the derived cup-product framework has the dimension of
`cohomologyOverField` in nonnegative degree and vanishes in negative degree.
-/

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Module Faltings
open Faltings.BombieriVojta

namespace Faltings

universe u

/-- `Hⁿ(X, ℱ)` of the cup-product framework has the dimension of `cohomologyOverField` in
nonnegative degree. -/
public theorem finrank_sheafCohomology_natCast {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (F : X.Modules) (m : ℕ) :
    Module.finrank k (Stacks.Duality.sheafCohomology f F m) =
      Module.finrank k (cohomologyOverField k f F m) := by
  let e₁ :=
    ((Stacks.Duality.cohomologyBridge f m).app (Stacks.Duality.singleModule F)).toLinearEquiv
  let e₂ := ((@DerivedCategory.homologyFunctor (ModuleCat.{u} k) _ _ ModuleCat.hasDerivedCategory
    (m : ℤ)).mapIso ((@derivedGlobalSectionsOver k _ X f (Scheme.Modules.hasDerivedCategory X)
      ModuleCat.hasDerivedCategory).mapIso
      ((Scheme.Modules.derivedModelEquivCompQIso X).app
        ((CochainComplex.singleFunctor X.Modules 0).obj F)))).toLinearEquiv
  let e₃ := (Stacks.Duality.cohomologyOverFieldLinearEquivDerivedCohomologyOverField k f F m).symm
  exact (e₁.trans (e₂.trans e₃)).finrank_eq

/-- `Hⁿ(X, ℱ)` of the cup-product framework vanishes in negative degree. -/
public theorem finrank_sheafCohomology_of_neg {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (F : X.Modules) {n : ℤ} (hn : n < 0) :
    Module.finrank k (Stacks.Duality.sheafCohomology f F n) = 0 := by
  have : Subsingleton (Stacks.Cohomology.DerivedGlobalCupProduct.cohomologyModule
      (Stacks.Duality.singleModule F) n) :=
    ModuleCat.subsingleton_of_isZero
      (Stacks.Duality.isZero_cohomologyModule_singleModule_of_neg F hn)
  have : Subsingleton (Stacks.Duality.sheafCohomology f F n) := this
  exact Module.finrank_zero_of_subsingleton

/-- `Hⁿ(X, ℱ)` of the cup-product framework has the dimension of `cohomologyOverField` in
every degree `n : ℤ`, read as `0` in negative degree. -/
public theorem finrank_sheafCohomology_eq_ite {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (F : X.Modules) (n : ℤ) :
    Module.finrank k (Stacks.Duality.sheafCohomology f F n) =
      if 0 ≤ n then Module.finrank k (cohomologyOverField k f F n.toNat) else 0 := by
  split_ifs with hn
  · lift n to ℕ using hn
    exact finrank_sheafCohomology_natCast f F n
  · exact finrank_sheafCohomology_of_neg f F (not_le.1 hn)

end Faltings
