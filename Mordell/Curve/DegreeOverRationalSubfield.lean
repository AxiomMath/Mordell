module
public import StacksFrontier.AlgebraicGeometry.Curves.ZetaFunction.PeriodicClosedPoints
public import StacksFrontier.NumberTheory.Drinfeld.CurveFunctionField
public import Mordell.Curve.PlacesClosedPoints
public import Mordell.Curve.Normal
public import Mordell.Curve.FunctionField

/-!
# The degree of a function field over the subfield generated by a non-constant function

Let `C` be a smooth projective geometrically integral curve over a field `k` of characteristic
zero, with function field `k(C)`, and let `ς ∈ k(C)` be non-constant. Then `k(C)` is a finite
extension of `k(ς)`, and its degree `[k(C) : k(ς)]` is the degree of the divisor of zeros of `ς`,
`(ς)₀ = ∑_{ord_x ς > 0} ord_x(ς) · x`, the sum running over the closed points `x` of `C`, each
weighted by its degree `[κ(x) : k]`. Equivalently, it is the degree of the morphism
`ς : C → ℙ¹_k`.

## Main results

* `Faltings.FunctionField.finrank_adjoin_eq_finsum_ord`: for `ς ∈ k(C)` non-constant,
  `k(C)` is finite over `k⟮ς⟯` and `[k(C) : k⟮ς⟯] = ∑ᶠ x, (ord_x ς)⁺ · [κ(x) : k]`.
* `Faltings.FunctionField.separableClosure_functionField_eq_bot`: for a geometrically integral
  curve, `k` is separably closed in `k(C)`.
* `Faltings.FunctionField.transcendental_of_notMem_range`: in characteristic zero, a non-constant
  `ς ∈ k(C)` is transcendental over `k`.

## Implementation notes

The `k`-algebra structure on `C.functionField` is `AlgebraicGeometry.functionFieldAlgebra k f`,
induced by the structure morphism `f : C ⟶ Spec k`. The order of vanishing is Mathlib's
`AlgebraicGeometry.Scheme.ord`, which is `0` at points of codimension other than one (on a curve,
at the generic point), and the degree of a point is `f.residueDegree x = [κ(x) : κ(f x)]`, where
`κ(f x) = k`. The degree of the divisor of zeros is therefore the finite sum
`∑ᶠ x : C, (ord_x ς).toNat * f.residueDegree x` over all points of `C`.

## References

* [H. Stichtenoth, *Algebraic Function Fields and Codes*][stichtenoth2009], Theorem 1.4.11
* [R. Hartshorne, *Algebraic Geometry*][hartshorne1977], Proposition II.6.9
-/

open AlgebraicGeometry IntermediateField Polynomial CategoryTheory

universe u

/- Mathlib's `[IsSimpleAddGroup G] [IsNilpotent G] : AddCommGroup G` instance is tried first for
`AddCommGroup X.functionField` and, through `IsVariety.toIsIntegral` with an unknown base field,
enumerates every `Field` instance before failing: it is switched off in this file. -/
attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent

namespace Faltings.FunctionField

section Transcendence

variable {k : Type u} [Field k] {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f]

/-- For a geometrically integral curve, `k` is separably closed in the function field. -/
public lemma separableClosure_functionField_eq_bot [GeometricallyIntegral f] :
    letI := functionFieldAlgebra k f
    separableClosure k C.functionField = ⊥ := by
  let := functionFieldAlgebra k f
  let : Algebra k (C.residueField (genericPoint C)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ C.Γevaluation (genericPoint C)).hom.toAlgebra
  have hirr : separableClosure k (C.residueField (genericPoint C)) = ⊥ :=
    ((geometricallyIrreducible_tfae_functionField k C f (genericPoint C)
      (genericPoint_spec C)).out 1 3).mp (show GeometricallyIrreducible f from inferInstance)
  let e : C.functionField ≃ₐ[k] C.residueField (genericPoint C) :=
    AlgEquiv.ofRingEquiv (f := genericResidueEquiv C) (fun a => rfl)
  rw [← separableClosure.map_eq_of_algEquiv e.symm, hirr, IntermediateField.map_bot]

/-- A non-constant function on a geometrically integral curve in characteristic zero is
transcendental over the base field. -/
public lemma transcendental_of_notMem_range [CharZero k] [GeometricallyIntegral f]
    {ς : C.functionField}
    (hς : letI := functionFieldAlgebra k f; ς ∉ Set.range (algebraMap k C.functionField)) :
    letI := functionFieldAlgebra k f
    Transcendental k ς := by
  let := functionFieldAlgebra k f
  intro halg
  apply hς
  have hsep : ς ∈ separableClosure k C.functionField :=
    mem_separableClosure_iff.mpr
      (PerfectField.separable_of_irreducible (minpoly.irreducible halg.isIntegral))
  rw [separableClosure_functionField_eq_bot f] at hsep
  exact IntermediateField.mem_bot.mp hsep

/-- The function field of a curve is a function field over `k(X)`, embedded by `X ↦ ς` for a
transcendental `ς`. -/
private lemma functionField_ratFuncAlgebra {ς : C.functionField}
    (hT : letI := functionFieldAlgebra k f; Transcendental k ς) :
    letI := functionFieldAlgebra k f
    letI := Stacks.Drinfeld.ratFuncAlgebra hT
    FunctionField k C.functionField := by
  let := functionFieldAlgebra k f
  have : Algebra.EssFiniteType k C.functionField := Stacks.Zeta.essFiniteType_ffAlg f
  exact Stacks.Drinfeld.functionField_of_trdeg_eq_one (IntermediateField.fg_top _ _)
    (Faltings.trdeg_functionField_eq_one k f) hT

end Transcendence

section DVR

/-- The order `Ring.ord` of a nonzero element of a discrete valuation ring is preserved by ring
isomorphisms. -/
private lemma ord_map_ringEquiv {R R' : Type*} [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [CommRing R'] [IsDomain R'] [IsDiscreteValuationRing R']
    (e : R ≃+* R') {a : R} (ha : a ≠ 0) : Ring.ord R' (e a) = Ring.ord R a := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  obtain ⟨n, u, rfl⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha hπ
  have hπ' : Irreducible (e π) := (MulEquiv.irreducible_iff e.toMulEquiv).mpr hπ
  rw [map_mul, map_pow, Ring.ord_mul_of_isUnit_left (u.isUnit.map e),
    Ring.ord_mul_of_isUnit_left u.isUnit,
    Ring.ord_pow (mem_nonZeroDivisors_of_ne_zero hπ'.ne_zero),
    Ring.ord_pow (mem_nonZeroDivisors_of_ne_zero hπ.ne_zero),
    Ring.ord_of_irreducible hπ, Ring.ord_of_irreducible hπ']

/-- At a point of codimension one with discrete valuation ring as local ring, the order of
vanishing of a regular function is the order `Ring.ord` in the local ring. -/
private lemma ord_algebraMap_stalk {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X]
    {x : X} (hx : Order.coheight x = 1) [IsDiscreteValuationRing (X.presheaf.stalk x)]
    {a : X.presheaf.stalk x} (ha : a ≠ 0) :
    X.ord (algebraMap (X.presheaf.stalk x) X.functionField a) x =
      ((Ring.ord (X.presheaf.stalk x) a).toNat : ℤ) := by
  have : Ring.KrullDimLE 1 (X.presheaf.stalk x) := krullDimLE_of_coheight_le hx.le
  have ha' : algebraMap (X.presheaf.stalk x) X.functionField a ≠ 0 := by
    simpa using ha
  have hnz : a ∈ nonZeroDivisors (X.presheaf.stalk x) := mem_nonZeroDivisors_of_ne_zero ha
  rw [Scheme.ord_eq_iff hx ha', Stacks.BombieriStepanov.ordHom_eq_ordFrac hx,
    Ring.ordFrac_eq_ord _ ha]
  exact Ring.ordMonoidWithZeroHom_eq_coe _ hnz (ENat.natCast_toNat (Ring.ord_ne_top hnz)).symm

/-- A discrete valuation ring is integrally closed. Stated for an arbitrary ring so that the
instance is found once, rather than searched for on a stalk. -/
private lemma isIntegrallyClosed_of_isDiscreteValuationRing (R : Type*) [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] : IsIntegrallyClosed R :=
  inferInstance

/-- The generic point of an integral scheme has coheight zero, in particular not one. -/
public lemma coheight_genericPoint_ne_one (X : Scheme.{u}) [IsIntegral X] :
    Order.coheight (genericPoint X) ≠ 1 := by
  intro h
  have h1 := ringKrullDim_stalk_eq_coheight (genericPoint X)
  have h2 : ringKrullDim X.functionField = 0 := ringKrullDim_eq_zero_of_field _
  change ringKrullDim X.functionField = _ at h1
  rw [h2, h] at h1
  exact absurd h1 (by decide)

end DVR

section Localization

variable {S F : Type*} [CommRing S] [IsDomain S] [Field F] [Algebra S F] [IsFractionRing S F]

/-- The localization `S_P` of a domain `S` at a prime `P`, as a subring of the fraction field. -/
private noncomputable abbrev locAt (P : Ideal S) [P.IsPrime] : Subalgebra S F :=
  Localization.subalgebra.ofField F P.primeCompl P.primeCompl_le_nonZeroDivisors

private lemma mem_locAt {P : Ideal S} [P.IsPrime] {a : F} :
    a ∈ locAt (F := F) P ↔
      ∃ s t : S, t ∉ P ∧ a = algebraMap S F s * (algebraMap S F t)⁻¹ := by
  constructor <;> rintro ⟨s, t, ht, rfl⟩ <;> exact ⟨s, t, ht, rfl⟩

private lemma algebraMap_ne_zero_of_notMem {P : Ideal S} [P.IsPrime] {t : S} (ht : t ∉ P) :
    algebraMap S F t ≠ 0 :=
  IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (P.primeCompl_le_nonZeroDivisors ht)

private lemma inv_mem_locAt {P : Ideal S} [P.IsPrime] {t : S} (ht : t ∉ P) :
    (algebraMap S F t)⁻¹ ∈ locAt (F := F) P :=
  mem_locAt.mpr ⟨1, t, ht, by simp⟩

private lemma algebraMap_mem_locAt {P : Ideal S} [P.IsPrime] (s : S) :
    algebraMap S F s ∈ locAt (F := F) P :=
  (locAt (F := F) P).algebraMap_mem s

private lemma inv_notMem_locAt {P : Ideal S} [P.IsPrime] {s : S} (hs : s ∈ P) (hs0 : s ≠ 0) :
    (algebraMap S F s)⁻¹ ∉ locAt (F := F) P := by
  rw [mem_locAt]
  rintro ⟨a, t, ht, h⟩
  have hs0' : algebraMap S F s ≠ 0 := by simpa using hs0
  have ht0 := algebraMap_ne_zero_of_notMem (F := F) ht
  have : t = s * a := by
    apply IsFractionRing.injective S F
    rw [map_mul]
    field_simp at h
    linear_combination h
  exact ht (this ▸ P.mul_mem_right a hs)

/-- An injective ring map `ι : O → F` is an isomorphism onto its range. -/
private noncomputable def rangeEquiv {O : Type*} [CommRing O] (ι : O →+* F)
    (hι : Function.Injective ι) : O ≃+* ι.range :=
  RingEquiv.ofBijective ι.rangeRestrict
    ⟨fun _ _ hab => hι (congrArg Subtype.val hab), ι.rangeRestrict_surjective⟩

private lemma apply_rangeEquiv_symm {O : Type*} [CommRing O] (ι : O →+* F)
    (hι : Function.Injective ι) (y : ι.range) : ι ((rangeEquiv ι hι).symm y) = y :=
  congrArg Subtype.val ((rangeEquiv ι hι).apply_symm_apply y)

/-- A ring map into `F` with values in the image of an injective ring map `ι : O → F` factors
through `ι`. -/
private noncomputable def liftOfRange {O T : Type*} [CommRing O] [CommRing T] (ι : O →+* F)
    (hι : Function.Injective ι) (g : T →+* F) (h : ∀ s, g s ∈ ι.range) : T →+* O :=
  (rangeEquiv ι hι).symm.toRingHom.comp (g.codRestrict ι.range h)

private lemma liftOfRange_spec {O T : Type*} [CommRing O] [CommRing T] (ι : O →+* F)
    (hι : Function.Injective ι) (g : T →+* F) (h : ∀ s, g s ∈ ι.range) (s : T) :
    ι (liftOfRange ι hι g h s) = g s :=
  apply_rangeEquiv_symm ι hι _

/-- A prime of `S` is determined by its localization: `s ∈ P` iff `s = 0` or `1/s ∉ S_P`. -/
private lemma eq_of_coe_locAt_eq {P Q : Ideal S} [P.IsPrime] [Q.IsPrime]
    (h : (locAt (F := F) P : Set F) = locAt (F := F) Q) : P = Q := by
  have key : ∀ (P : Ideal S) [P.IsPrime] (s : S),
      s ∈ P ↔ (s = 0 ∨ (algebraMap S F s)⁻¹ ∉ locAt (F := F) P) := by
    intro P _ s
    by_cases hs0 : s = 0
    · simp [hs0]
    · exact ⟨fun hs => .inr (inv_notMem_locAt hs hs0),
        fun h => not_not.mp fun hsP => h.resolve_left hs0 (inv_mem_locAt hsP)⟩
  ext s
  rw [key P, key Q, ← SetLike.mem_coe, h, SetLike.mem_coe]

/-- If the localization `S_P` is a local subring `O ⊇ S` of `F`, then `P` is the
contraction of the maximal ideal of `O`. -/
private lemma eq_comap_of_locAt_eq_range {O : Type*} [CommRing O] [IsLocalRing O] (ι : O →+* F)
    (hι : Function.Injective ι) (φ : S →+* O) (hφ : ∀ s, ι (φ s) = algebraMap S F s)
    {P : Ideal S} [P.IsPrime]
    (hV : (locAt (F := F) P : Set F) = Set.range ι) :
    P = (IsLocalRing.maximalIdeal O).comap φ := by
  ext s
  rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  constructor
  · intro hs hu
    have hs0 : s ≠ 0 := by
      rintro rfl
      exact not_isUnit_zero (M₀ := O) (by simp at hu)
    apply inv_notMem_locAt (F := F) hs hs0
    obtain ⟨u, hu⟩ := hu
    have : (algebraMap S F s)⁻¹ = ι ↑u⁻¹ := by
      rw [← hφ, ← hu, map_units_inv]
    rw [← SetLike.mem_coe, hV, this]
    exact ⟨_, rfl⟩
  · intro hnu
    by_contra hs
    have hmem := inv_mem_locAt (F := F) hs
    rw [← SetLike.mem_coe, hV] at hmem
    obtain ⟨b, hb⟩ := hmem
    apply hnu
    refine IsUnit.of_mul_eq_one b (hι ?_)
    rw [map_mul, hφ, hb, map_one, mul_inv_cancel₀ (algebraMap_ne_zero_of_notMem hs)]

end Localization

section DedekindLocalization

variable {S F : Type*} [CommRing S] [IsDedekindDomain S] [Field F] [Algebra S F]
  [IsFractionRing S F]

private lemma isDiscreteValuationRing_locAt {P : Ideal S} [P.IsPrime] (hP : P ≠ ⊥) :
    IsDiscreteValuationRing (locAt (F := F) P) :=
  IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain S hP _

private lemma mem_or_inv_mem_locAt {P : Ideal S} [P.IsPrime] (hP : P ≠ ⊥) (a : F) :
    a ∈ locAt (F := F) P ∨ a⁻¹ ∈ locAt (F := F) P := by
  have := isDiscreteValuationRing_locAt (F := F) hP
  exact (ValuationRing.isInteger_or_isInteger (locAt (F := F) P) a).imp
    (fun ⟨b, hb⟩ => hb ▸ b.2) fun ⟨b, hb⟩ => hb ▸ b.2

/-- If `P` is the contraction of the maximal ideal of a local subring `O ⊇ S` of `F`, then the
localization `S_P` is `O`: a valuation ring is maximal for domination. -/
private lemma locAt_eq_range {O : Type*} [CommRing O] [IsLocalRing O] (ι : O →+* F)
    (hι : Function.Injective ι) (φ : S →+* O) (hφ : ∀ s, ι (φ s) = algebraMap S F s)
    {P : Ideal S} [P.IsPrime] (hP : P ≠ ⊥)
    (hPφ : P = (IsLocalRing.maximalIdeal O).comap φ) :
    (locAt (F := F) P : Set F) = Set.range ι := by
  have hunit : ∀ t : S, t ∉ P → IsUnit (φ t) := fun t ht => by
    by_contra h
    exact ht (hPφ ▸ (IsLocalRing.mem_maximalIdeal _).mpr h)
  ext a
  constructor
  · intro ha
    obtain ⟨s, t, ht, rfl⟩ := mem_locAt.mp ha
    obtain ⟨u, hu⟩ := hunit t ht
    refine ⟨φ s * ↑u⁻¹, ?_⟩
    rw [map_mul, hφ, map_units_inv, hu, hφ]
  · rintro ⟨b, rfl⟩
    by_contra hb
    have hinv := (mem_or_inv_mem_locAt (F := F) hP (ι b)).resolve_left hb
    obtain ⟨s, t, ht, hst⟩ := mem_locAt.mp hinv
    have ht0 := algebraMap_ne_zero_of_notMem (F := F) ht
    have hb0 : ι b ≠ 0 := by
      intro h0
      exact hb (h0 ▸ (locAt (F := F) P).zero_mem)
    by_cases hs : s ∈ P
    · have hφs : φ s ∈ IsLocalRing.maximalIdeal O := by rwa [hPφ] at hs
      have h1 : algebraMap S F s = (ι b)⁻¹ * algebraMap S F t := by
        rw [hst]; field_simp
      have : b * φ s = φ t := by
        apply hι
        rw [map_mul, hφ, hφ, h1, ← mul_assoc, mul_inv_cancel₀ hb0, one_mul]
      have : φ t ∈ IsLocalRing.maximalIdeal O := this ▸ Ideal.mul_mem_left _ b hφs
      exact ht (hPφ ▸ this)
    · apply hb
      have hs0 := algebraMap_ne_zero_of_notMem (F := F) hs
      have : ι b = algebraMap S F t * (algebraMap S F s)⁻¹ := by
        rw [← inv_inv (ι b), hst]
        field_simp
      rw [this]
      exact mul_mem (algebraMap_mem_locAt t) (inv_mem_locAt hs)

/-- The ramification index of `P` over `(r)` is the order of `r` in the discrete valuation ring
`O = S_P`. -/
private lemma ramificationIdx'_span_eq_ord {R : Type*} [CommRing R] [IsDomain R] [Algebra R S]
    [Module.IsTorsionFree R S] {O : Type*} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] (ι : O →+* F) (hι : Function.Injective ι) (φ : S →+* O)
    (hφ : ∀ s, ι (φ s) = algebraMap S F s) {r : R} (hr : r ≠ 0)
    {P : Ideal S} [P.IsPrime] [P.LiesOver (Ideal.span {r})] (hP : P ≠ ⊥)
    (hV : (locAt (F := F) P : Set F) = Set.range ι) :
    (Ideal.span {r}).ramificationIdx' P = (Ring.ord O (φ (algebraMap R S r))).toNat := by
  have hp : Ideal.span {r} ≠ ⊥ := by simpa using hr
  rw [Ideal.ramificationIdx'_eq_ramificationIdx _ P hp, Ideal.ramificationIdx_eq (Ideal.span {r}) P,
    Ideal.map_span, Set.image_singleton]
  change (Ring.ord (Localization.AtPrime P) (algebraMap R (Localization.AtPrime P) r)).toNat = _
  congr 1
  have := IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain S hP
    (Localization.AtPrime P)
  have hsub : (locAt (F := F) P).toSubring = ι.range :=
    SetLike.coe_injective (hV.trans (RingHom.coe_range ι).symm)
  let e1 : Localization.AtPrime P ≃ₐ[S] locAt (F := F) P :=
    IsLocalization.algEquiv P.primeCompl _ _
  let e : Localization.AtPrime P ≃+* O :=
    e1.toRingEquiv.trans ((RingEquiv.subringCongr hsub).trans (rangeEquiv ι hι).symm)
  have hrS : algebraMap R S r ≠ 0 := by
    rw [Ne, ← map_zero (algebraMap R S)]
    exact fun h => hr (FaithfulSMul.algebraMap_injective R S h)
  have h0 : algebraMap R (Localization.AtPrime P) r ≠ 0 := by
    rw [IsScalarTower.algebraMap_apply R S (Localization.AtPrime P)]
    exact (map_ne_zero_iff _ (IsLocalization.injective (Localization.AtPrime P)
      P.primeCompl_le_nonZeroDivisors)).mpr hrS
  have he : e (algebraMap R (Localization.AtPrime P) r) = φ (algebraMap R S r) := by
    apply hι
    rw [hφ]
    have h1 : ι (e (algebraMap R (Localization.AtPrime P) r)) =
        ((RingEquiv.subringCongr hsub) (e1 (algebraMap R (Localization.AtPrime P) r)) :
          F) :=
      apply_rangeEquiv_symm ι hι _
    rw [h1, IsScalarTower.algebraMap_apply R S (Localization.AtPrime P), AlgEquiv.commutes]
    rfl
  rw [← he, ord_map_ringEquiv e h0]

/-- The residue field of `O = S_P` is `S / P`: the residue map `S → O → κ(O)` is onto. -/
private lemma surjective_residue_comp {O : Type*} [CommRing O] [IsLocalRing O] (ι : O →+* F)
    (hι : Function.Injective ι) (φ : S →+* O) (hφ : ∀ s, ι (φ s) = algebraMap S F s)
    {P : Ideal S} [P.IsPrime] (hP : P ≠ ⊥)
    (hV : (locAt (F := F) P : Set F) = Set.range ι)
    (hPφ : P = (IsLocalRing.maximalIdeal O).comap φ) :
    Function.Surjective ((IsLocalRing.residue O).comp φ) := by
  intro y
  obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective y
  have hb : ι b ∈ locAt (F := F) P := by
    rw [← SetLike.mem_coe, hV]
    exact ⟨b, rfl⟩
  obtain ⟨s, t, ht, hst⟩ := mem_locAt.mp hb
  have hbt : b * φ t = φ s := by
    apply hι
    rw [map_mul, hφ, hφ, hst, mul_assoc, inv_mul_cancel₀ (algebraMap_ne_zero_of_notMem ht),
      mul_one]
  have hmax : P.IsMaximal := Ideal.IsPrime.isMaximal ‹_› hP
  let := Ideal.Quotient.field P
  have hmk : Ideal.Quotient.mk P t ≠ 0 := by
    rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
  obtain ⟨t', ht'⟩ := Ideal.Quotient.mk_surjective (Ideal.Quotient.mk P t)⁻¹
  have htt' : t * t' - 1 ∈ P := by
    rw [← Ideal.Quotient.eq, map_mul, ht', mul_inv_cancel₀ hmk, map_one]
  refine ⟨s * t', ?_⟩
  change IsLocalRing.residue O (φ (s * t')) = IsLocalRing.residue O b
  change Ideal.Quotient.mk _ _ = Ideal.Quotient.mk _ _
  rw [Ideal.Quotient.eq]
  have : φ (s * t') - b = b * φ (t * t' - 1) := by
    rw [map_mul, ← hbt, map_sub, map_mul, map_one]
    ring
  rw [this]
  exact Ideal.mul_mem_left _ b (by rwa [hPφ] at htt')

end DedekindLocalization

section Curve

variable {k : Type u} [Field k] {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f]
  [Algebra k C.functionField]
  (hk : ∀ c : k, algebraMap k C.functionField c =
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
      C.germToFunctionField ⊤ (h := ⟨⟨genericPoint C, trivial⟩⟩)).hom c)
  [Algebra k[X] C.functionField]
  (hC : ∀ c : k, algebraMap k[X] C.functionField (Polynomial.C c) = algebraMap k C.functionField c)

omit [Algebra k[X] C.functionField] in
include hk in
/-- The constants of the function field come from every local ring. -/
private lemma algebraMap_eq_algebraMap_fieldToStalk (x : C) (c : k) :
    algebraMap k C.functionField c =
      algebraMap (C.presheaf.stalk x) C.functionField ((fieldToStalk f x).hom c) :=
  (hk c).trans (Stacks.BombieriStepanov.algebraMap_functionFieldAlgebra f x c)

include hk hC in
/-- If `ς` is regular at a point `x` of a smooth curve, then so is every element of the function
field integral over `k[ς]`. -/
private lemma mem_range_of_isIntegral [Smooth f] {x : C} (hx : x ≠ genericPoint C)
    {a : C.presheaf.stalk x}
    {s : C.functionField} (hs : IsIntegral k[X] s) (ha : algebraMap (C.presheaf.stalk x)
      C.functionField a = algebraMap k[X] C.functionField X) :
    s ∈ (algebraMap (C.presheaf.stalk x) C.functionField).range := by
  have := IsCurve.isDiscreteValuationRing_stalk k f hx
  let g : k[X] →+* C.presheaf.stalk x := Polynomial.eval₂RingHom (fieldToStalk f x).hom a
  let : Algebra k[X] (C.presheaf.stalk x) := g.toAlgebra
  have : IsScalarTower k[X] (C.presheaf.stalk x) C.functionField := by
    refine IsScalarTower.of_algebraMap_eq fun q => ?_
    change algebraMap k[X] C.functionField q =
      ((algebraMap (C.presheaf.stalk x) C.functionField).comp g) q
    congr 1
    refine Polynomial.ringHom_ext (fun c => ?_) ?_
    · simp only [RingHom.comp_apply, g, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      rw [hC, algebraMap_eq_algebraMap_fieldToStalk f hk x c]
    · simp only [RingHom.comp_apply, g, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      exact ha.symm
  have := isIntegrallyClosed_of_isDiscreteValuationRing (C.presheaf.stalk x)
  obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := C.presheaf.stalk x)
    (K := C.functionField)).mp (hs.tower_top (A := C.presheaf.stalk x))
  exact ⟨y, hy⟩

include hC in
private lemma algebraMap_mem_integralClosure (c : k) :
    algebraMap k C.functionField c ∈ integralClosure k[X] C.functionField := by
  rw [← hC]
  exact (integralClosure k[X] _).algebraMap_mem _

variable [IsDedekindDomain (integralClosure k[X] C.functionField)]
  [IsFractionRing (integralClosure k[X] C.functionField) C.functionField]

/-- The place of `k(C)/k` given by the localization of `S = integralClosure k[X] k(C)` at a
nonzero prime `P`, provided `S_P ≠ k(C)`. -/
private noncomputable def placeOfPrime (P : Ideal (integralClosure k[X] C.functionField))
    [P.IsPrime] (hP : P ≠ ⊥) (hne : ∃ a, a ∉ locAt (F := C.functionField) P) :
    Faltings.Place k C.functionField where
  toSubalgebra :=
    { (locAt (F := C.functionField) P).toSubring with
      algebraMap_mem' := fun c =>
        algebraMap_mem_locAt (F := C.functionField) (P := P)
          ⟨_, algebraMap_mem_integralClosure f hC c⟩ }
  neg_mem' := (locAt (F := C.functionField) P).toSubring.neg_mem'
  mem_or_inv_mem' := mem_or_inv_mem_locAt hP
  ne_top h := by
    obtain ⟨a, ha⟩ := hne
    have : a ∈ (⊤ : Subalgebra k C.functionField) := Algebra.mem_top
    rw [← h] at this
    exact ha this

include hk hC in
/-- Every nonzero prime `P` of `S` with `S_P ≠ k(C)` is centred at a unique closed point: the
localization `S_P` is the local ring of `C` there. -/
private lemma existsUnique_isClosed_locAt_eq_range [IsNormal C] [IsProper f]
    [Algebra (RatFunc k) C.functionField] [IsScalarTower k (RatFunc k) C.functionField]
    [FunctionField k C.functionField]
    (P : Ideal (integralClosure k[X] C.functionField)) [P.IsPrime] (hP : P ≠ ⊥)
    (hne : ∃ a, a ∉ locAt (F := C.functionField) P) :
    ∃! x : C, IsClosed {x} ∧ (locAt (F := C.functionField) P : Set C.functionField) =
      Set.range (algebraMap (C.presheaf.stalk x) C.functionField) := by
  let φ := @AlgEquiv.ofRingEquiv k C.functionField C.functionField _ _ _
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
        C.germToFunctionField ⊤ (h := ⟨⟨genericPoint C, trivial⟩⟩)).hom.toAlgebra _
    (RingEquiv.refl _) (fun c => (hk c).symm)
  have hφ : ∀ A : Set C.functionField, φ '' A = A := fun A => by
    ext a
    exact ⟨fun ⟨b, hb, hba⟩ => hba ▸ hb, fun ha => ⟨a, ha, rfl⟩⟩
  have h := Faltings.FunctionField.existsUnique_isClosed_place_eq_image_stalk k C.functionField
    f φ (placeOfPrime f hC P hP hne)
  simp only [hφ] at h
  exact h

include hk hC in
/-- If `S_P` is the local ring of `C` at `x`, the inertia degree of `P` over `(X)` is the degree
`[κ(x) : k]` of `x`. -/
private lemma inertiaDeg'_eq_residueDegree {x : C}
    (P : Ideal (integralClosure k[X] C.functionField)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(X : k[X])})]
    (hP : P ≠ ⊥)
    (hS : ∀ s : integralClosure k[X] C.functionField,
      algebraMap (integralClosure k[X] C.functionField) C.functionField s ∈
        (algebraMap (C.presheaf.stalk x) C.functionField).range)
    (hV : (locAt (F := C.functionField) P : Set C.functionField) =
      Set.range (algebraMap (C.presheaf.stalk x) C.functionField)) :
    (Ideal.span {(X : k[X])}).inertiaDeg' P = f.residueDegree x := by
  set ι := algebraMap (C.presheaf.stalk x) C.functionField
  have hι : Function.Injective ι := IsFractionRing.injective _ _
  set φ := liftOfRange ι hι _ hS
  have hφ : ∀ s, ι (φ s) = algebraMap _ C.functionField s := liftOfRange_spec ι hι _ hS
  have hPφ := eq_comap_of_locAt_eq_range ι hι φ hφ hV
  have hsurj := surjective_residue_comp ι hι φ hφ hP hV hPφ
  have hker : RingHom.ker ((IsLocalRing.residue (C.presheaf.stalk x)).comp φ) = P := by
    rw [← RingHom.comap_ker, IsLocalRing.ker_residue, hPφ]
  let j := (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hsurj)
  let i : k[X] ⧸ Ideal.span {(X : k[X])} ≃+* k :=
    (Ideal.quotEquivOfEq (by simp)).trans (Polynomial.quotientSpanXSubCAlgEquiv (0 : k)).toRingEquiv
  rw [Ideal.inertiaDeg'_algebraMap, Stacks.Chow.residueDegree_eq_finrank_residueField k f x]
  let : Algebra k (C.presheaf.stalk x) :=
    ((C.presheaf.germ ⊤ x (by simp)).hom.comp
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom).toAlgebra
  refine Algebra.finrank_eq_of_equiv_equiv i j ?_
  have hi : ∀ g : k[X], i (Ideal.Quotient.mk _ g) = g.eval 0 := fun g => by
    simp [i, Polynomial.quotientSpanXSubCAlgEquiv_mk]
  refine Ideal.Quotient.ringHom_ext (Polynomial.ringHom_ext (fun c => ?_) ?_)
  · change IsLocalRing.residue _ (algebraMap k (C.presheaf.stalk x)
        (i (Ideal.Quotient.mk _ (Polynomial.C c)))) =
      IsLocalRing.residue _ (φ (algebraMap k[X] (integralClosure k[X] C.functionField)
        (Polynomial.C c)))
    congr 1
    rw [hi, Polynomial.eval_C]
    apply hι
    rw [hφ]
    exact ((hC c).trans (algebraMap_eq_algebraMap_fieldToStalk f hk x c)).symm
  · change IsLocalRing.residue _ (algebraMap k (C.presheaf.stalk x)
        (i (Ideal.Quotient.mk _ Polynomial.X))) =
      IsLocalRing.residue _ (φ (algebraMap k[X] (integralClosure k[X] C.functionField)
        Polynomial.X))
    rw [hi, Polynomial.eval_X, map_zero, map_zero, eq_comm, IsLocalRing.residue_eq_zero_iff]
    have h := (Ideal.mem_of_liesOver P _ _).mp (Ideal.mem_span_singleton_self (X : k[X]))
    rwa [hPφ] at h

include hk hC in
/-- At a prime `P` of `S` over `(X)` centred at the closed point `x`, the product of ramification
index and inertia degree is `ord_x ς · [κ(x) : k]`. -/
private lemma ramificationIdx'_mul_inertiaDeg'_eq [Smooth f] [IsLocallyNoetherian C]
    [Module.IsTorsionFree k[X] (integralClosure k[X] C.functionField)]
    {ς : C.functionField} (hX : algebraMap k[X] C.functionField X = ς) (hς0 : ς ≠ 0)
    (P : Ideal (integralClosure k[X] C.functionField)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(X : k[X])})] (hP : P ≠ ⊥) {x : C} (hcl : IsClosed {x})
    (hV : (locAt (F := C.functionField) P : Set C.functionField) =
      Set.range (algebraMap (C.presheaf.stalk x) C.functionField)) :
    (Ideal.span {(X : k[X])}).ramificationIdx' P * (Ideal.span {(X : k[X])}).inertiaDeg' P =
      (C.ord ς x).toNat * f.residueDegree x := by
  have hxη : x ≠ genericPoint C := Stacks.Zeta.ne_genericPoint_of_isClosed f hcl
  have := IsCurve.isDiscreteValuationRing_stalk k f hxη
  have hcoh : Order.coheight x = 1 := IsCurve.coheight_eq_one f hxη
  set ι := algebraMap (C.presheaf.stalk x) C.functionField
  have hι : Function.Injective ι := IsFractionRing.injective _ _
  have hS : ∀ s : integralClosure k[X] C.functionField,
      algebraMap (integralClosure k[X] C.functionField) C.functionField s ∈ ι.range := by
    intro s
    have h := algebraMap_mem_locAt (F := C.functionField) (P := P) s
    rwa [← SetLike.mem_coe, hV] at h
  set φ := liftOfRange ι hι _ hS
  have hφ : ∀ s, ι (φ s) = algebraMap _ C.functionField s := liftOfRange_spec ι hι _ hS
  have hφX : ι (φ (algebraMap k[X] (integralClosure k[X] C.functionField) X)) = ς := by
    rw [hφ, ← hX]
    rfl
  have ha0 : φ (algebraMap k[X] (integralClosure k[X] C.functionField) X) ≠ 0 := by
    intro h0
    exact hς0 (by rw [← hφX, h0, map_zero])
  rw [ramificationIdx'_span_eq_ord ι hι φ hφ Polynomial.X_ne_zero hP hV,
    inertiaDeg'_eq_residueDegree f hk hC P hP hS hV, ← hφX, ord_algebraMap_stalk hcoh ha0,
    Int.toNat_natCast]

include hk hC in
/-- A point where `ς` vanishes is a closed point, and the contraction to `S` of its maximal ideal
is a nonzero prime over `(X)` whose localization is the local ring there. -/
private lemma exists_prime_of_ord_pos [Smooth f] [IsLocallyNoetherian C]
    {ς : C.functionField} (hX : algebraMap k[X] C.functionField X = ς) {x : C}
    (hx : 0 < C.ord ς x) :
    ∃ P : Ideal (integralClosure k[X] C.functionField), ∃ _ : P.IsPrime,
      P.LiesOver (Ideal.span {(X : k[X])}) ∧ P ≠ ⊥ ∧ IsClosed {x} ∧
      (locAt (F := C.functionField) P : Set C.functionField) =
        Set.range (algebraMap (C.presheaf.stalk x) C.functionField) := by
  have hcoh : Order.coheight x = 1 := by
    by_contra h
    rw [Scheme.ord_eq_zero_of_coheight_neq_one h] at hx
    exact lt_irrefl _ hx
  have hxη : x ≠ genericPoint C := fun h => coheight_genericPoint_ne_one C (h ▸ hcoh)
  have := IsCurve.isDiscreteValuationRing_stalk k f hxη
  set ι := algebraMap (C.presheaf.stalk x) C.functionField
  have hι : Function.Injective ι := IsFractionRing.injective _ _
  obtain ⟨a, ha⟩ := Stacks.BombieriStepanov.exists_algebraMap_eq_of_ord_nonneg hcoh hx.le
  have hς0 : ς ≠ 0 := by
    rintro rfl
    simp at hx
  have ha0 : a ≠ 0 := by
    rintro rfl
    exact hς0 (by rw [← ha, map_zero])
  have ham : a ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
    by_contra h
    have hu : IsUnit a := by
      by_contra hu
      exact h ((IsLocalRing.mem_maximalIdeal _).mpr hu)
    rw [← ha, ord_algebraMap_stalk hcoh ha0, Ring.ord_of_isUnit hu] at hx
    simp at hx
  have hS : ∀ s : integralClosure k[X] C.functionField,
      algebraMap (integralClosure k[X] C.functionField) C.functionField s ∈ ι.range :=
    fun s => mem_range_of_isIntegral f hk hC hxη s.2 (ha.trans hX.symm)
  set φ := liftOfRange ι hι _ hS
  have hφ : ∀ s, ι (φ s) = algebraMap _ C.functionField s := liftOfRange_spec ι hι _ hS
  set P := (IsLocalRing.maximalIdeal (C.presheaf.stalk x)).comap φ
  have hφX : φ (algebraMap k[X] (integralClosure k[X] C.functionField) X) = a := by
    apply hι
    rw [hφ, ha, ← hX]
    rfl
  have hXP : algebraMap k[X] (integralClosure k[X] C.functionField) X ∈ P := by
    rw [Ideal.mem_comap, hφX]
    exact ham
  have hP0 : P ≠ ⊥ := by
    intro h
    rw [h, Ideal.mem_bot] at hXP
    rw [hXP, map_zero] at hφX
    exact ha0 hφX.symm
  have hpm : (Ideal.span {(X : k[X])}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible Polynomial.irreducible_X
  refine ⟨P, inferInstance, ⟨hpm.eq_of_le (Ideal.IsPrime.ne_top inferInstance) ?_⟩, hP0,
    Faltings.FunctionField.isClosed_singleton_of_ne_genericPoint k f hxη,
    locAt_eq_range ι hι φ hφ hP0 rfl⟩
  rw [Ideal.span_le, Set.singleton_subset_iff]
  exact hXP

include hk hC in
/-- The fundamental identity for the primes of `S` over `(X)`, read on the curve: the primes
over `(X)` are the points where `ς` vanishes, with ramification index `ord_x ς` and inertia
degree `[κ(x) : k]`. -/
private lemma sum_ramificationIdx'_mul_inertiaDeg'_eq_finsum [Smooth f] [IsNormal C] [IsProper f]
    [IsLocallyNoetherian C] [Algebra (RatFunc k) C.functionField]
    [IsScalarTower k (RatFunc k) C.functionField] [FunctionField k C.functionField]
    [Module.IsTorsionFree k[X] (integralClosure k[X] C.functionField)]
    {ς : C.functionField} (hX : algebraMap k[X] C.functionField X = ς) (hς0 : ς ≠ 0) :
    ∑ P ∈ IsDedekindDomain.primesOverFinset (Ideal.span {(X : k[X])})
        (integralClosure k[X] C.functionField),
      (Ideal.span {(X : k[X])}).ramificationIdx' P * (Ideal.span {(X : k[X])}).inertiaDeg' P =
    ∑ᶠ x : C, (C.ord ς x).toNat * f.residueDegree x := by
  classical
  have hpb : Ideal.span {(X : k[X])} ≠ ⊥ :=
    Ideal.span_singleton_eq_bot.not.mpr Polynomial.X_ne_zero
  have hpm : (Ideal.span {(X : k[X])}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible Polynomial.irreducible_X
  set T := IsDedekindDomain.primesOverFinset (Ideal.span {(X : k[X])})
    (integralClosure k[X] C.functionField)
  have hmem : ∀ P, P ∈ T ↔ P.IsPrime ∧ P.LiesOver (Ideal.span {(X : k[X])}) := fun P =>
    IsDedekindDomain.mem_primesOverFinset_iff hpb _
  have hξ : algebraMap (integralClosure k[X] C.functionField) C.functionField
      (algebraMap k[X] _ X) = ς := hX
  have hξ0 : algebraMap k[X] (integralClosure k[X] C.functionField) X ≠ 0 := fun h =>
    hς0 (by rw [← hξ, h, map_zero])
  have hξP : ∀ P ∈ T, algebraMap k[X] (integralClosure k[X] C.functionField) X ∈ P :=
    fun P hP => by
      obtain ⟨_, _⟩ := (hmem P).mp hP
      exact (Ideal.mem_of_liesOver P _ _).mp (Ideal.mem_span_singleton_self (X : k[X]))
  have hP0 : ∀ P ∈ T, P ≠ ⊥ := fun P hP h => by
    have := hξP P hP
    rw [h, Ideal.mem_bot] at this
    exact hξ0 this
  have hEU : ∀ P ∈ T, ∀ _ : P.IsPrime, ∃! x : C, IsClosed {x} ∧
      (locAt (F := C.functionField) P : Set C.functionField) =
        Set.range (algebraMap (C.presheaf.stalk x) C.functionField) := by
    intro P hP _
    refine existsUnique_isClosed_locAt_eq_range f hk hC P (hP0 P hP) ⟨ς⁻¹, ?_⟩
    rw [← hξ]
    exact inv_notMem_locAt (hξP P hP) hξ0
  choose! c hc using fun P (hP : P ∈ T) => (hEU P hP ((hmem P).mp hP).1).exists
  have hterm : ∀ P ∈ T, (Ideal.span {(X : k[X])}).ramificationIdx' P *
      (Ideal.span {(X : k[X])}).inertiaDeg' P =
        (C.ord ς (c P)).toNat * f.residueDegree (c P) := fun P hP => by
    have := ((hmem P).mp hP).1
    have := ((hmem P).mp hP).2
    refine ramificationIdx'_mul_inertiaDeg'_eq f hk hC hX hς0 P ?_ (hc P hP).1 (hc P hP).2
    exact hP0 P hP
  have hinj : Set.InjOn c T := fun P hP Q hQ h => by
    have := ((hmem P).mp hP).1
    have := ((hmem Q).mp hQ).1
    exact eq_of_coe_locAt_eq ((hc P hP).2.trans (h ▸ (hc Q hQ).2).symm)
  have hsupp : Function.support (fun x : C => (C.ord ς x).toNat * f.residueDegree x) ⊆
      (T.image c : Set C) := by
    intro x hx
    have hpos : 0 < C.ord ς x := by
      have : (C.ord ς x).toNat ≠ 0 := left_ne_zero_of_mul hx
      omega
    obtain ⟨P, hpr, hl, -, hcl, hV⟩ := exists_prime_of_ord_pos f hk hC hX hpos
    have hPT : P ∈ T := (hmem P).mpr ⟨hpr, hl⟩
    refine Finset.mem_coe.mpr (Finset.mem_image.mpr ⟨P, hPT, ?_⟩)
    exact (hEU P hPT hpr).unique (hc P hPT) ⟨hcl, hV⟩
  rw [finsum_eq_sum_of_support_subset _ hsupp, Finset.sum_image hinj]
  exact Finset.sum_congr rfl hterm

end Curve

/-- Let `C` be a smooth projective geometrically integral curve over a field `k` of characteristic
zero and `ς ∈ k(C)` non-constant. Then `k(C)` is a finite extension of `k⟮ς⟯`, of degree the degree
`∑_x (ord_x ς)⁺ [κ(x) : k]` of the divisor of zeros of `ς`. -/
@[faltings "lem_bvs_algebraic_relation"]
public theorem finrank_adjoin_eq_finsum_ord (k : Type u) [Field k] [CharZero k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
    [GeometricallyIntegral f] [IsLocallyNoetherian C] (ς : C.functionField)
    (hς : letI := functionFieldAlgebra k f; ς ∉ Set.range (algebraMap k C.functionField)) :
    letI := functionFieldAlgebra k f
    FiniteDimensional k⟮ς⟯ C.functionField ∧
      Module.finrank k⟮ς⟯ C.functionField = ∑ᶠ x : C, (C.ord ς x).toNat * f.residueDegree x := by
  let := functionFieldAlgebra k f
  have hT : Transcendental k ς := transcendental_of_notMem_range f hς
  let := Stacks.Drinfeld.ratFuncAlgebra hT
  have := Stacks.Drinfeld.isScalarTower_ratFuncAlgebra hT
  have : FiniteDimensional (RatFunc k) C.functionField := functionField_ratFuncAlgebra f hT
  let : Algebra k[X] C.functionField := (aeval ς).toRingHom.toAlgebra
  have hpoly : ∀ g : k[X], algebraMap k[X] C.functionField g = aeval ς g := fun _ => rfl
  have : IsScalarTower k[X] (RatFunc k) C.functionField :=
    IsScalarTower.of_algebraMap_eq fun g => by
      rw [hpoly, Stacks.Drinfeld.ratFuncAlgebra_algebraMap,
        ← div_one (algebraMap k[X] (RatFunc k) g), ← map_one (algebraMap k[X] (RatFunc k)),
        RatFunc.liftAlgHom_apply_div, map_one, div_one]
  have hX : algebraMap k[X] C.functionField X = ς := by rw [hpoly, aeval_X]
  have hC : ∀ c : k, algebraMap k[X] C.functionField (Polynomial.C c) =
      algebraMap k C.functionField c := fun c => by rw [hpoly, aeval_C]
  have : FaithfulSMul k[X] C.functionField :=
    (faithfulSMul_iff_algebraMap_injective _ _).2 ((transcendental_iff_injective).1 hT)
  have : IsNormal C := Faltings.FunctionField.isNormal_of_smooth k f
  have : Algebra.IsSeparable (RatFunc k) C.functionField :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  have : IsDedekindDomain (integralClosure k[X] C.functionField) :=
    integralClosure.isDedekindDomain k[X] (RatFunc k) C.functionField
  have : IsFractionRing (integralClosure k[X] C.functionField) C.functionField :=
    integralClosure.isFractionRing_of_finite_extension (RatFunc k) C.functionField
  have : Module.Finite k[X] (integralClosure k[X] C.functionField) :=
    IsIntegralClosure.finite k[X] (RatFunc k) C.functionField
      (integralClosure k[X] C.functionField)
  have hς0 : ς ≠ 0 := by
    rintro rfl
    exact hς ⟨0, map_zero _⟩
  have hpb : Ideal.span {(X : k[X])} ≠ ⊥ :=
    Ideal.span_singleton_eq_bot.not.mpr Polynomial.X_ne_zero
  have hpm : (Ideal.span {(X : k[X])}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible Polynomial.irreducible_X
  have : Module.IsTorsionFree k[X] (integralClosure k[X] C.functionField) :=
    Module.isTorsionFree_iff_faithfulSMul.mpr <| (faithfulSMul_iff_algebraMap_injective _ _).2
      fun a b h => FaithfulSMul.algebraMap_injective k[X] C.functionField (congrArg Subtype.val h)
  have hsum := sum_ramificationIdx'_mul_inertiaDeg'_eq_finsum f (fun _ => rfl) hC hX hς0
  rw [Ideal.sum_ramification_inertia (integralClosure k[X] C.functionField) (RatFunc k)
    C.functionField hpb] at hsum
  have hcomp : (algebraMap k⟮ς⟯ C.functionField).comp
      (RatFunc.algEquivOfTranscendental ς hT).toRingEquiv.toRingHom =
        (RingEquiv.refl C.functionField).toRingHom.comp
          (algebraMap (RatFunc k) C.functionField) := by
    refine IsLocalization.ringHom_ext (nonZeroDivisors k[X]) (RingHom.ext fun g => ?_)
    change ((RatFunc.algEquivOfTranscendental ς hT (algebraMap k[X] (RatFunc k) g) :
      k⟮ς⟯) : C.functionField) = algebraMap (RatFunc k) C.functionField
        (algebraMap k[X] (RatFunc k) g)
    rw [RatFunc.algEquivOfTranscendental_algebraMap, ← IsScalarTower.algebraMap_apply, hpoly]
    exact (Polynomial.aeval_algHom_apply k⟮ς⟯.val (AdjoinSimple.gen k ς) g).symm
  have hfr : Module.finrank (RatFunc k) C.functionField = Module.finrank k⟮ς⟯ C.functionField :=
    Algebra.finrank_eq_of_equiv_equiv _ _ hcomp
  exact ⟨FunctionField.finiteDimensional_of_adjoin_transcendental hT, hfr.symm.trans hsum⟩

end Faltings.FunctionField
