module
public import StacksFrontier.AlgebraicGeometry.Curves.NonsingularProjectiveModel
import StacksFrontier.AlgebraicGeometry.Curves.UniformizerDifferential
import Mordell.Curve.Topology
import Mordell.AlgebraicGeometry.RationalPoint
import Mordell.Curve.FunctionField

/-!
# A non-constant function is a local parameter at almost every point

Let `C` be a smooth projective geometrically integral curve over a field `k` of characteristic
zero and `ς ∈ k(C)` a non-constant function. At a `k`-rational point `z` at which `ς` is regular,
`ς - ς(z)` vanishes at `z`; it is a local uniformizing parameter there, i.e. generates the maximal
ideal of `𝒪_{C,z}`, unless `z` is a zero of the differential `dς`. Since `ς` is separable over
`k` (characteristic zero), `dς ≠ 0`, so this happens at only finitely many points.

In Bombieri's proof of the Mordell conjecture this is applied over `k̄` to the affine coordinate
functions `ξ_a = x_a / x₀` of the embedding `φ_{NP}`, at the points with `x₀(z) ≠ 0`, where `ξ_a`
is regular.

## Main results

* `Faltings.FunctionField.finite_setOf_maximalIdeal_ne_span_sub`: the `k`-points `z` of `C` at
  which `ς` is regular and `ς - ς(z)` is not a uniformizer form a finite set.

## Implementation notes

A `k`-point is a section `z : Spec k ⟶ C` of the structure morphism `f : C ⟶ Spec k`, and its
local ring is the stalk at `z (closedPoint k)`. That `ς` is regular at `z` means that `ς` lies in
the image of the stalk in `k(C)` (`AlgebraicGeometry.stalkFunctionFieldAlgebra`), say `ς = g`.
The constants are `c : k → 𝒪_{C,z}`, `(ΓSpecIso k).inv ≫ f.appTop ≫ germ`. The condition
"`g - ς(z)` is not a uniformizer" is written as `∀ a : k, 𝔪_z ≠ (g - c a)`: if `g - c a`
generates `𝔪_z` it vanishes at `z`, so `a = ς(z)`; this avoids naming the evaluation map.

## References

* [E. Bombieri, *The Mordell conjecture revisited*][bombieri1990], Section 7, proof of Lemma 6,
  and Section 9
-/

open AlgebraicGeometry CategoryTheory IsLocalRing Polynomial

universe u

namespace Faltings.FunctionField

/-- If `K` has transcendence degree one over a field `k` of characteristic zero and the image of
`X` under a `k[X]`-algebra structure on `K` is transcendental, then `K` is formally unramified over
`k[X]`: it is a finite separable extension of the fraction field `k(X)`. -/
public lemma formallyUnramified_polynomial {k K : Type*} [Field k] [CharZero k] [Field K]
    [Algebra k K] [Algebra k[X] K] [IsScalarTower k k[X] K] (htr : Algebra.trdeg k K = 1)
    (hς : Transcendental k (algebraMap k[X] K X)) : Algebra.FormallyUnramified k[X] K := by
  set ς := algebraMap k[X] K X
  have haeval : algebraMap k[X] K = (aeval ς).toRingHom := by
    ext a
    · change algebraMap k[X] K (algebraMap k k[X] a) = aeval ς (algebraMap k k[X] a)
      rw [← IsScalarTower.algebraMap_apply]; simp
    · simp [ς]
  have hinj : Function.Injective (algebraMap k[X] K) := by
    rw [haeval]; exact (transcendental_iff_injective).mp hς
  have hb : IsTranscendenceBasis k (fun _ : Unit => ς) :=
    ((algebraicIndependent_unique_type_iff (ι := Unit)).mpr
      hς).isTranscendenceBasis_of_lift_trdeg_le_of_finite (by rw [htr]; simp)
  have halg := hb.isAlgebraic
  have : Algebra.IsAlgebraic k[X] K := by
    have hr : Set.range (fun _ : Unit => ς) = {ς} := Set.range_const
    rw [hr] at halg
    refine Algebra.IsAlgebraic.of_ringHom_of_comp_eq (S := Algebra.adjoin k {ς}) (B := K)
      (algEquivOfTranscendental k ς hς).toRingHom (RingHom.id K)
      (algEquivOfTranscendental k ς hς).surjective Function.injective_id ?_
    rw [haeval]
    ext a <;> simp
  have : FaithfulSMul k[X] K := (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  let := FractionRing.liftAlgebra k[X] K
  have : Algebra.IsAlgebraic (FractionRing k[X]) K :=
    Algebra.IsAlgebraic.extendScalars (R := k[X]) (IsFractionRing.injective _ _)
  have : Algebra.IsSeparable (FractionRing k[X]) K :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  have : Algebra.FormallyUnramified (FractionRing k[X]) K := .of_isSeparable _ _
  have : Algebra.FormallyUnramified k[X] (FractionRing k[X]) :=
    .of_isLocalization (nonZeroDivisors k[X])
  exact .comp k[X] (FractionRing k[X]) K

/-- If `A` is unramified over `R` at a prime `P` and `S` is the localization of `A` at `P`, the
maximal ideal of `S` is generated by the prime of `R` under `P`. -/
private lemma map_under_eq_maximalIdeal {R A S : Type*} [CommRing R] [CommRing A] [CommRing S]
    [Algebra R A] [Algebra A S] [Algebra R S] [IsScalarTower R A S] [Algebra.EssFiniteType R A]
    (P : Ideal A) [P.IsPrime] [IsLocalization.AtPrime S P] [IsLocalRing S]
    [Algebra.IsUnramifiedAt R P] :
    (P.under R).map (algebraMap R S) = maximalIdeal S := by
  let := Localization.AtPrime.algebraOfLiesOver (P.under R) P
  have h := ((Algebra.isUnramifiedAt_iff_map_eq R (P.under R) P).mp inferInstance).2
  let e : Localization.AtPrime P ≃ₐ[A] S := IsLocalization.algEquiv P.primeCompl _ _
  have he : algebraMap R S =
      (e : Localization.AtPrime P →+* S).comp (algebraMap R (Localization.AtPrime P)) := by
    ext r
    simp [IsScalarTower.algebraMap_apply R A S,
      IsScalarTower.algebraMap_apply R A (Localization.AtPrime P)]
  rw [he, ← Ideal.map_map, h]
  have : (Ideal.map e (maximalIdeal (Localization.AtPrime P))).IsMaximal :=
    Ideal.map_isMaximal_of_equiv e
  exact IsLocalRing.eq_maximalIdeal this

/-- A proper ideal of `k[X]` containing `X - b` is the ideal generated by `X - b`. -/
private lemma eq_span_X_sub_C {k : Type*} [Field k] {p : Ideal k[X]} (hp : p ≠ ⊤) {b : k}
    (hb : (Polynomial.X - C b : k[X]) ∈ p) : p = Ideal.span {(Polynomial.X - C b : k[X])} := by
  have : (Ideal.span {(Polynomial.X - C b : k[X])}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible (irreducible_X_sub_C b)
  exact (this.eq_of_le hp ((Ideal.span_singleton_le_iff_mem _).mpr hb)).symm

/-- At a `k`-rational point `z` of a scheme over `k`, every element of the local ring is
congruent to a constant modulo the maximal ideal. -/
private lemma exists_sub_const_mem_maximalIdeal {k : Type u} [Field k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) (z : Spec (.of k) ⟶ C) (hz : z ≫ f = 𝟙 _)
    (t : C.presheaf.stalk (z (closedPoint k))) :
    ∃ b : k, t - ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
      C.presheaf.germ ⊤ (z (closedPoint k)) trivial).hom b ∈
        maximalIdeal (C.presheaf.stalk (z (closedPoint k))) := by
  have hε : Function.Surjective ((Scheme.ΓSpecIso (.of k)).inv ≫
      (Spec (.of k)).Γevaluation (closedPoint k)).hom := by
    have := isIso_germ_top_spec_field (closedPoint k)
    have h1 : Function.Surjective (Scheme.ΓSpecIso (.of k)).inv.hom :=
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of k)).inv).2
    have h2 : Function.Surjective ((Spec (.of k)).presheaf.germ ⊤ (closedPoint k) trivial).hom :=
      (ConcreteCategory.bijective_of_isIso _).2
    have h3 : Function.Surjective ((Spec (.of k)).residue (closedPoint k)).hom :=
      Scheme.residue_surjective _ _
    change Function.Surjective ((Scheme.ΓSpecIso (.of k)).inv ≫
      (Spec (.of k)).presheaf.germ ⊤ (closedPoint k) trivial ≫
        (Spec (.of k)).residue (closedPoint k)).hom
    simp only [CommRingCat.hom_comp, RingHom.coe_comp]
    exact (h3.comp h2).comp h1
  have hzf : ∀ v, z.appTop (f.appTop v) = v := by
    intro v
    change (f.appTop ≫ z.appTop).hom v = v
    rw [← Scheme.Hom.comp_appTop, hz]
    rfl
  have hc : ∀ b : k, (z.residueFieldMap (closedPoint k)).hom ((C.residue (z (closedPoint k))).hom
      (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
        C.presheaf.germ ⊤ (z (closedPoint k)) trivial).hom b)) =
      ((Scheme.ΓSpecIso (.of k)).inv ≫ (Spec (.of k)).Γevaluation (closedPoint k)).hom b := by
    intro b
    have h := Scheme.Γevaluation_naturality_apply z (closedPoint k)
      (f.appTop ((Scheme.ΓSpecIso (.of k)).inv b))
    rwa [hzf] at h
  obtain ⟨b, hb⟩ := hε ((z.residueFieldMap (closedPoint k)).hom
    ((C.residue (z (closedPoint k))).hom t))
  refine ⟨b, ?_⟩
  rw [← IsLocalRing.residue_eq_zero_iff]
  have : Nontrivial ((Spec (.of k)).residueField (closedPoint k)) :=
    (fun (Y : Scheme.{u}) (y : Y) => (inferInstance : Nontrivial (Y.residueField y))) _ _
  apply (z.residueFieldMap (closedPoint k)).hom.injective
  change (z.residueFieldMap (closedPoint k)).hom ((C.residue (z (closedPoint k))).hom (t - _)) = _
  rw [map_sub, map_sub, hc b, hb, sub_self]
  exact (map_zero _).symm

/-- The constants of the local ring at a point map to the constants of the function field. -/
public lemma algebraMap_const {k : Type u} [Field k] {C : Scheme.{u}} (f : C ⟶ Spec (.of k))
    [IsCurve k f] (x : C) (b : k) :
    letI := functionFieldAlgebra k f
    algebraMap (C.presheaf.stalk x) C.functionField
      (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ C.presheaf.germ ⊤ x trivial).hom b) =
        algebraMap k C.functionField b := by
  have : Nonempty (⊤ : C.Opens) := ⟨⟨genericPoint C, trivial⟩⟩
  exact Scheme.algebraMap_germ_eq_germToFunctionField C (U := ⊤) trivial _

/-- A function regular at a `k`-rational point of a curve and algebraic over `k` is a
constant. -/
private lemma mem_range_of_isAlgebraic {k : Type u} [Field k] {C : Scheme.{u}}
    (f : C ⟶ Spec (.of k)) [IsCurve k f] (z : Spec (.of k) ⟶ C) (hz : z ≫ f = 𝟙 _)
    (g : C.presheaf.stalk (z (closedPoint k))) :
    letI := functionFieldAlgebra k f
    IsAlgebraic k (algebraMap _ C.functionField g) →
      algebraMap _ C.functionField g ∈ Set.range (algebraMap k C.functionField) := by
  let := functionFieldAlgebra k f
  intro halg
  let R := C.presheaf.stalk (z (closedPoint k))
  let c := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
    C.presheaf.germ ⊤ (z (closedPoint k)) trivial).hom
  obtain ⟨b, hb⟩ := exists_sub_const_mem_maximalIdeal f z hz g
  set P := minpoly k (algebraMap _ C.functionField g)
  have hcK : (algebraMap R C.functionField).comp c = algebraMap k C.functionField :=
    RingHom.ext fun b => algebraMap_const f (z (closedPoint k)) b
  have hP : P.eval₂ c g = 0 := by
    apply IsFractionRing.injective R C.functionField
    rw [Polynomial.hom_eval₂, hcK, map_zero]
    exact minpoly.aeval k _
  have hres : residue R g = residue R (c b) := by
    rwa [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
  have hroot : P.IsRoot b := by
    have h := congrArg (residue R) hP
    rw [Polynomial.hom_eval₂, hres, map_zero, ← RingHom.comp_apply,
      Polynomial.eval₂_at_apply] at h
    exact (map_eq_zero_iff _ ((residue R).comp c).injective).mp h
  have hdeg := Polynomial.degree_eq_one_of_irreducible_of_root
    (minpoly.irreducible halg.isIntegral) hroot
  exact minpoly.natDegree_eq_one_iff.mp (Polynomial.natDegree_eq_of_degree_eq_some hdeg)

/-- A transcendental function `ς` on a curve over a field of characteristic zero is, on a
nonempty open set, a local parameter at every rational point: `ς - ς(z)` generates the maximal
ideal of the local ring at `z`. -/
private lemma exists_open_forall_maximalIdeal_eq_span (k : Type u) [Field k] [CharZero k]
    {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f] (ς : C.functionField)
    (hς : letI := functionFieldAlgebra k f; Transcendental k ς) :
    ∃ W : C.Opens, (W : Set C).Nonempty ∧ ∀ z : Spec (.of k) ⟶ C, z ≫ f = 𝟙 _ →
      z (closedPoint k) ∈ W → ∀ g : C.presheaf.stalk (z (closedPoint k)),
        algebraMap _ C.functionField g = ς → ∃ a : k,
          maximalIdeal (C.presheaf.stalk (z (closedPoint k))) =
            Ideal.span {g - ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
              C.presheaf.germ ⊤ (z (closedPoint k)) trivial).hom a} := by
  obtain ⟨U₀, hηU₀, s₀, hs₀⟩ := C.presheaf.exists_germ_eq (x := genericPoint C) ς
  obtain ⟨U, hU, hηU, hUU₀⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp C.isBasis_affineOpens hηU₀
  have hU : IsAffineOpen U := hU
  let s : Γ(C, U) := C.presheaf.map (homOfLE hUU₀).op s₀
  have : Nonempty U := ⟨⟨genericPoint C, hηU⟩⟩
  have hs : C.germToFunctionField U s = ς := by
    rw [← hs₀]; exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
  let ψ : k →+* Γ(C, U) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ U le_top).hom
  have hψ : RingHom.FiniteType ψ := by
    have h := HasRingHomProperty.appLE @LocallyOfFiniteType f inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
    exact h.comp (RingHom.FiniteType.of_surjective _
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of k)).inv).2)
  let : Algebra k[X] Γ(C, U) := (Polynomial.eval₂RingHom ψ s).toAlgebra
  have : Algebra.FiniteType k[X] Γ(C, U) :=
    RingHom.FiniteType.of_comp_finiteType (f := Polynomial.C) (by
      convert hψ using 1; ext a; simp)
  let := functionFieldAlgebra k f
  have hψK : ∀ a, C.germToFunctionField U (ψ a) = algebraMap k C.functionField a :=
    fun _ => TopCat.Presheaf.germ_res_apply _ _ _ _ _
  let : Algebra k[X] C.functionField :=
    ((algebraMap Γ(C, U) C.functionField).comp (algebraMap k[X] Γ(C, U))).toAlgebra
  have : IsScalarTower k[X] Γ(C, U) C.functionField := .of_algebraMap_eq' rfl
  have : IsScalarTower k k[X] C.functionField := .of_algebraMap_eq fun a => by
    rw [← hψK a]
    change _ = C.germToFunctionField U (Polynomial.eval₂ ψ s (Polynomial.C a))
    rw [Polynomial.eval₂_C]
  have hX : algebraMap k[X] C.functionField Polynomial.X = ς := by
    change C.germToFunctionField U (Polynomial.eval₂ ψ s Polynomial.X) = ς
    rw [Polynomial.eval₂_X, hs]
  have hfu : Algebra.FormallyUnramified k[X] C.functionField :=
    formallyUnramified_polynomial (Faltings.trdeg_functionField_eq_one k f)
      (hX ▸ hς)
  have : IsLocalization (⊥ : Ideal Γ(C, U)).primeCompl C.functionField := by
    have he : (⊥ : Ideal Γ(C, U)).primeCompl = nonZeroDivisors _ := by
      ext a
      rw [Ideal.mem_primeCompl_iff, mem_nonZeroDivisors_iff_ne_zero, Ideal.mem_bot]
    rw [he]
    exact functionField_isFractionRing_of_isAffineOpen C U hU
  have : Algebra.IsUnramifiedAt k[X] (⊥ : Ideal Γ(C, U)) :=
    Algebra.FormallyUnramified.of_equiv ((IsLocalization.algEquiv (⊥ : Ideal Γ(C, U)).primeCompl
      C.functionField (Localization.AtPrime ⊥)).restrictScalars k[X])
  obtain ⟨h, hh, hfuh⟩ :=
    Algebra.exists_formallyUnramified_of_isUnramifiedAt (R := k[X]) (⊥ : Ideal Γ(C, U))
  have h0 : h ≠ 0 := fun h0 => hh (h0 ▸ (⊥ : Ideal Γ(C, U)).zero_mem)
  refine ⟨C.basicOpen h, ?_, ?_⟩
  · rw [Set.nonempty_iff_ne_empty]
    intro he
    apply h0
    rw [← basicOpen_eq_bot_iff]
    exact SetLike.coe_injective (he.trans TopologicalSpace.Opens.coe_bot.symm)
  intro z hz hxW g hg
  let xU : U := ⟨z (closedPoint k), C.basicOpen_le h hxW⟩
  let : Algebra Γ(C, U) (C.presheaf.stalk xU) := C.presheaf.algebra_section_stalk xU
  have := hU.isLocalization_stalk xU
  let P := (hU.primeIdealOf xU).asIdeal
  have hgs : g = C.presheaf.germ U _ xU.2 s := by
    apply IsFractionRing.injective _ C.functionField
    rw [hg, Scheme.algebraMap_germ_eq_germToFunctionField, hs]
  have hPm : P = (maximalIdeal (C.presheaf.stalk (z (closedPoint k)))).comap
      (algebraMap Γ(C, U) (C.presheaf.stalk xU)) :=
    (IsLocalization.AtPrime.under_maximalIdeal (C.presheaf.stalk xU) P).symm
  have hhP : h ∉ P := by
    rw [hPm, Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
    exact (C.mem_basicOpen h _ xU.2).mp hxW
  have : Algebra.IsUnramifiedAt k[X] P :=
    (Algebra.basicOpen_subset_unramifiedLocus_iff.mpr hfuh)
      (show (⟨P, inferInstance⟩ : PrimeSpectrum Γ(C, U)) ∈ PrimeSpectrum.basicOpen h from hhP)
  let : Algebra k[X] (C.presheaf.stalk xU) :=
    ((algebraMap Γ(C, U) (C.presheaf.stalk xU)).comp (algebraMap k[X] Γ(C, U))).toAlgebra
  have : IsScalarTower k[X] Γ(C, U) (C.presheaf.stalk xU) := .of_algebraMap_eq' rfl
  have hmax := map_under_eq_maximalIdeal (R := k[X]) (S := C.presheaf.stalk xU) P
  obtain ⟨b, hb⟩ := exists_sub_const_mem_maximalIdeal f z hz g
  have hgb : algebraMap k[X] (C.presheaf.stalk xU) (Polynomial.X - Polynomial.C b) =
      g - ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
        C.presheaf.germ ⊤ (z (closedPoint k)) trivial).hom b := by
    change C.presheaf.germ U _ xU.2 (Polynomial.eval₂ ψ s (Polynomial.X - Polynomial.C b)) = _
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C, map_sub, hgs]
    congr 1
    exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
  have hmem : Polynomial.X - Polynomial.C b ∈ P.under k[X] := by
    rwa [Ideal.under, Ideal.mem_comap, hPm, Ideal.mem_comap, ← IsScalarTower.algebraMap_apply,
      hgb]
  have hne : P.under k[X] ≠ ⊤ := (Ideal.IsPrime.under k[X] P).ne_top
  refine ⟨b, ?_⟩
  rw [← hmax, eq_span_X_sub_C hne hmem, Ideal.map_span, Set.image_singleton, hgb]

/-- Let `C` be a smooth projective geometrically integral curve over a field `k` of characteristic
zero and `ς ∈ k(C)` non-constant. Then the `k`-points `z` of `C` at which `ς` is regular, say
`ς = g` with `g ∈ 𝒪_{C,z}`, and `g - ς(z)` is not a local uniformizing parameter (does not generate
the maximal ideal of `𝒪_{C,z}`) form a finite set. -/
@[faltings "lem_bvs_uniformizer_generic"]
public theorem finite_setOf_maximalIdeal_ne_span_sub (k : Type u) [Field k] [CharZero k]
    {C : Scheme.{u}} (f : C ⟶ Spec (.of k)) [IsCurve k f] [IsProjectiveVariety k f] [Smooth f]
    [GeometricallyIntegral f] (ς : C.functionField)
    (hς : letI := functionFieldAlgebra k f
      ς ∉ Set.range (algebraMap k C.functionField)) :
    {z : Spec (.of k) ⟶ C | z ≫ f = 𝟙 _ ∧
      ∃ g : C.presheaf.stalk (z (closedPoint k)),
        algebraMap _ C.functionField g = ς ∧
        ∀ a : k, maximalIdeal (C.presheaf.stalk (z (closedPoint k))) ≠
          Ideal.span {g - ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
            C.presheaf.germ ⊤ (z (closedPoint k)) trivial).hom a}}.Finite := by
  let := functionFieldAlgebra k f
  by_cases htr : Transcendental k ς
  · obtain ⟨W, hWne, hW⟩ := exists_open_forall_maximalIdeal_eq_span k f ς htr
    have hfin : ((W : Set C)ᶜ).Finite := by
      refine (finite_and_subset_closedPoints_of_isClosed_of_ne_univ k f
        W.isOpen.isClosed_compl fun h => ?_).1
      obtain ⟨x, hx⟩ := hWne
      exact (h ▸ Set.mem_univ x : x ∈ (W : Set C)ᶜ) hx
    refine Set.Finite.of_finite_image (f := fun z => z (closedPoint k)) (hfin.subset ?_)
      (Set.InjOn.mono (fun z hz => hz.1)
        (bijOn_rank_residueField_eq_one k f).injOn)
    rintro _ ⟨z, ⟨hz, g, hg, hbad⟩, rfl⟩ hzW
    exact (hW z hz hzW g hg).elim hbad
  · convert Set.finite_empty
    ext z
    simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
    rintro ⟨hz, g, hg, -⟩
    apply hς
    have := mem_range_of_isAlgebraic f z hz g (by rw [hg]; exact not_not.mp htr)
    rwa [hg] at this

end Faltings.FunctionField
