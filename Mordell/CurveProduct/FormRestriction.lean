module

public import Mathlib
public import Mordell.CurveProduct.Embedding.Psi
public import Mordell.Algebra.BiprojectiveNormality
public import Mordell.BombieriVojta.Representative.BasicSystem
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpaceHigherDirectImage.BaseDegreeSheaf
public import StacksFrontier.AlgebraicGeometry.VeryAmpleAffineBase.ChartBasicOpen

/-!
# Sections of `𝒪(δ₁ (NP) × C + δ₂ C × (NP))` are restrictions of forms

Let `(C, P)` be a curve over a field `k` with a divisor `P = ∑ nₓ x` of degree one, let `g` be
the genus of `C`, let `N ≥ 2g + 1`, let `L ≅ 𝒪_C(NP)` and let `x₀, …, xₙ` be a `k`-basis of
`H⁰(C, L)`, defining the morphism `φ_{NP} : C ⟶ ℙⁿ_k`, and let
`ψ = φ_{NP} × φ_{NP} : C ×_k C ⟶ ℙⁿ_k ×_k ℙⁿ_k`. There is `δ₀` such that for all
`δ₁, δ₂ ≥ δ₀` every global section of
`ψ^* 𝒪(δ₁, δ₂) = 𝒪(δ₁ (NP) × C + δ₂ C × (NP))` over `k` is the restriction along `ψ` of a
bihomogeneous form of bidegree `(δ₁, δ₂)` in `k[T₀, …, Tₙ; T'₀, …, T'ₙ]`: the restrictions of
the monomials `T^a T'^b` with `|a| = δ₁`, `|b| = δ₂` span the sections over `k`.

## Main results

* `Faltings.CurveWithDegreeOneDivisor.span_tensorSections_monomialSection_eq_top`: the
  restrictions along `ψ` of the bihomogeneous monomials of bidegree `(δ₁, δ₂)` span
  `H⁰(C ×_k C, ψ^* 𝒪(δ₁, δ₂))` over `k`, for `δ₁, δ₂` large.
* `Faltings.exists_surjective_vojtaFormRestriction`: for a closed immersion
  `ψ : Y ⟶ ℙⁿ_k ×_k ℙⁿ_k`, every global section of `ψ^*(pr₁^*𝒪(δ₁) ⊗ pr₂^*𝒪(δ₂))` is
  `Faltings.vojtaFormRestriction ψ δ₁ δ₂ G` of a form `G` over `k`, for `δ₁, δ₂` large;
  `Faltings.exists_surjective_vojtaFormRestriction_map` is the case `ψ = φ × φ`.

## Implementation notes

Write `X = C ×_k C` and `qᵢ = prᵢ ≫ φ_{NP} ≫ ℙⁿ_k ⟶ ℙⁿ_ℤ : X ⟶ ℙⁿ_ℤ` for the two composites to
the integral model, so that `qᵢ` is `ψ` followed by the `i`-th projection of
`ℙⁿ_k ×_k ℙⁿ_k` and the integral-model map. The twist `𝒪(d)` on `ℙⁿ_k` is pulled back from the
twist `projectiveSpaceAtUniverseTwistingSheaf n d` of `ℙⁿ_ℤ`, and
`ψ^* 𝒪(δ₁, δ₂) = ψ^*(pr₁^* 𝒪(δ₁) ⊗ pr₂^* 𝒪(δ₂))` is written as
`q₁^* 𝒪(δ₁) ⊗ q₂^* 𝒪(δ₂)`, the tensor product of sheaves of modules on `X`. The restriction of
the monomial `T^a T'^b` is the tensor product (`AlgebraicGeometry.tensorSections`) of the
pull-backs (`AlgebraicGeometry.pullbackGlobalSections`) of the monomial sections
`Stacks.AlgebraicGeometry.ProjectiveSpaceHigherDirectImage.monomialSectionAtUniverse` of
`𝒪(δ₁)` and `𝒪(δ₂)`; a form `F = ∑ c_{a,b} T^a T'^b` with `c_{a,b} ∈ k` restricts to the
corresponding `k`-linear combination, so "every section is the restriction of a form over `k`"
is "the restricted monomials span the `k`-module of global sections". The class of this sheaf in
`Pic(X)` is `Faltings.CurveWithDegreeOneDivisor.vojtaClass X (δ₁ N) (δ₂ N) 0`, the class of
`δ₁ (NP) × C + δ₂ C × (NP)`, by
`Faltings.CurveWithDegreeOneDivisor.isClosedImmersion_map_toProjectiveSpaceOver`.

The statement is over an arbitrary field `k`; the statement for sections defined over an
extension `K ⊇ k` (such as an algebraic closure) is the same statement for the base change of
`(C, P)` and of the basis to `K`.

## References

* [Bombieri, *The Mordell conjecture revisited*], Section 3
* [Mumford, *Lectures on curves on an algebraic surface*], Chapter 6, (6.10) Theorem

The proof follows Bombieri. By
`Faltings.CurveWithDegreeOneDivisor.isClosedImmersion_map_toProjectiveSpaceOver` the morphism
`ψ` is a closed immersion, so `C ×_k C` is a closed subscheme of `ℙⁿ_k ×_k ℙⁿ_k`, and biprojective
normality in high bidegree (`Faltings.exists_isWeightedHomogeneous_restrict_eq_of_compatible`) is
applied to its bihomogeneous ideal `I`, generated by the bihomogeneous polynomials whose
dehomogenisations vanish on every standard chart `Uᵢⱼ = q₁⁻¹ D₊(Tᵢ) ⊓ q₂⁻¹ D₊(T'ⱼ)`.

* On `Uᵢⱼ` the section `Tᵢ^{δ₁} T'ⱼ^{δ₂}` vanishes nowhere, so every section `s` restricts to
  `gᵢⱼ • Tᵢ^{δ₁} T'ⱼ^{δ₂}` for a unique function `gᵢⱼ`; on overlaps
  `gᵢⱼ = gᵢ'ⱼ' (Tᵢ'/Tᵢ)^{δ₁} (T'ⱼ'/T'ⱼ)^{δ₂}`.
* The functions on `Uᵢⱼ` are dehomogenisations of polynomials: `Uᵢⱼ` is the preimage under the
  closed immersion `ψ` of an affine open of `ℙⁿ_k ×_k ℙⁿ_k`, whose ring is generated by the
  constants and the affine coordinates.
* Two fractions `aᵢⱼ / uᵢⱼ^m` and `aᵢ'ⱼ' / uᵢ'ⱼ'^{m'}` that agree on `Uᵢⱼ ⊓ Uᵢ'ⱼ'` agree in
  `(S/I)_{uᵢⱼ uᵢ'ⱼ'}`, because the charts are quasi-compact and a function vanishing where
  `uᵢⱼ uᵢ'ⱼ'` is invertible is killed by a power of it.

The form `F` given by biprojective normality restricts on each chart to `gᵢⱼ`, so `s` is the
`k`-linear combination of restricted monomials given by the coefficients of `F`. The argument is
first carried out for any scheme with two morphisms to `ℙⁿ_ℤ` whose charts are quasi-compact and
have their rings of functions generated by constants and affine coordinates, and then specialised
to `C ×_k C`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open Stacks.AlgebraicGeometry.ProjectiveSpaceHigherDirectImage

universe u

namespace Faltings

attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local implicit_reducible] AlgebraicGeometry.projectiveSpaceAtUniverse
attribute [local instance]
  Stacks.AlgebraicGeometry.ProjectiveSpaceGeneratingSections.globalSectionsModule

section ProjCharts

open Opposite TopologicalSpace HomogeneousLocalization AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.SectionsToProjectiveSpace (coordGrading coordRing X_mem_coordGrading_one)
open Stacks.AlgebraicGeometry.ProjTwistSections

variable {n : ℕ}

/-- In the chart ring at `Tᵢ`, the fraction `T^a / Tᵢ^d` is the product of the `(Tₗ/Tᵢ)^{aₗ}`. -/
private lemma away_mk_monomial (i : Fin (n + 1)) (a : Fin (n + 1) →₀ ℕ) (d : ℕ)
    (hd : a.degree = d)
    (h : MvPolynomial.monomial a (1 : ULift.{u} ℤ) ∈ coordGrading.{u} n (d • 1)) :
    Away.mk (coordGrading.{u} n) (X_mem_coordGrading_one i) d (MvPolynomial.monomial a 1) h =
      ∏ l, (Stacks.TwistPullbackPinned.coordFrac.{u} i l) ^ (a l) := by
  apply (show Function.Injective (algebraMap (Away (coordGrading.{u} n) (MvPolynomial.X i))
    (Localization.Away (MvPolynomial.X i : coordRing.{u} n))) from val_injective _)
  simp only [map_prod, map_pow]
  simp only [HomogeneousLocalization.algebraMap_apply, Stacks.TwistPullbackPinned.coordFrac,
    Away.val_mk, Localization.mk_pow, Localization.mk_prod]
  congr 1
  · rw [MvPolynomial.monomial_eq, map_one, one_mul, Finsupp.prod_fintype _ _ (by simp)]
  · apply Subtype.ext
    simp only [SubmonoidClass.coe_pow, pow_one,
      Finset.prod_pow_eq_pow_sum]
    rw [← hd, Finsupp.degree_eq_sum]

/-- The monomial section `T^e` of `𝒪(d)` on `ℙⁿ_ℤ` is the degree-`d` section of the monomial. -/
private lemma monomialSectionAtUniverse_eq (d : ℕ) (e : MonomialIndex.{u} n (d : ℤ)) :
    monomialSectionAtUniverse e = degreeSection (coordGrading.{u} n) d
      ⟨coordMonomial e, by
        have h : e.1.degree = d := by exact_mod_cast e.2
        have := coordMonomial_mem e
        rwa [h] at this⟩ := by
  obtain ⟨e, he⟩ := e
  have h : e.degree = d := by exact_mod_cast he
  subst h
  rfl

/-- On `D₊(Tᵢ)` the degree-`d` section of `p` is `p / Tᵢ^d` times the section of `Tᵢ^d`. -/
private lemma degreeSection_res_eq_smul (i : Fin (n + 1)) (d : ℕ) (p : coordRing.{u} n)
    (hp : p ∈ coordGrading.{u} n d) (hp' : p ∈ coordGrading.{u} n (d • 1)) :
    (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ)).presheaf.map
        (homOfLE (le_top (a := Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i)))).op
        (degreeSection (coordGrading.{u} n) d ⟨p, hp⟩) =
      (Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i)).hom
          (Away.mk (coordGrading.{u} n) (X_mem_coordGrading_one i) d p hp') •
        (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ)).presheaf.map
          (homOfLE (le_top (a := Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i)))).op
          (degreeSection (coordGrading.{u} n) d
            ⟨MvPolynomial.X i ^ d, MvPolynomial.isHomogeneous_X_pow i d⟩) := by
  refine Subtype.ext (funext fun x => ?_)
  have hx := x.1.isPrime
  have key : ∀ (a : coordRing.{u} n) (ha : a ∈ coordGrading.{u} n d),
      ((projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ)).presheaf.map
        (homOfLE (le_top (a := Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i)))).op
        (degreeSection (coordGrading.{u} n) d ⟨a, ha⟩)).1 x =
      Localization.mk a (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl) :=
    fun a ha => degreeSection_apply (coordGrading.{u} n) d ⟨a, ha⟩ _
  have hR : ((Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i)).hom
          (Away.mk (coordGrading.{u} n) (X_mem_coordGrading_one i) d p hp') •
        (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ)).presheaf.map
          (homOfLE (le_top (a := Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i)))).op
          (degreeSection (coordGrading.{u} n) d
            ⟨MvPolynomial.X i ^ d, MvPolynomial.isHomogeneous_X_pow i d⟩)).1 x =
      HomogeneousLocalization.val
          (((Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i)).hom
            (Away.mk (coordGrading.{u} n) (X_mem_coordGrading_one i) d p hp')).1 x) *
        ((projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ)).presheaf.map
          (homOfLE (le_top (a := Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i)))).op
          (degreeSection (coordGrading.{u} n) d
            ⟨MvPolynomial.X i ^ d, MvPolynomial.isHomogeneous_X_pow i d⟩)).1 x := rfl
  have hval : HomogeneousLocalization.val
      (((Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i)).hom
        (Away.mk (coordGrading.{u} n) (X_mem_coordGrading_one i) d p hp')).1 x) =
      Localization.mk p ⟨(MvPolynomial.X i : coordRing.{u} n) ^ d, _⟩ := rfl
  rw [key p hp, hR, hval, key _ (MvPolynomial.isHomogeneous_X_pow i d), Localization.mk_mul]
  exact Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq (by simp; ring))

/-- The section `Tᵢ^d` of `𝒪(d)` vanishes nowhere on `D₊(Tᵢ)`. -/
private lemma mem_nonvanishingLocus_degreeSection_X_pow (i : Fin (n + 1)) (d : ℕ)
    {x : projectiveSpaceAtUniverse.{u} n}
    (hx : x ∈ Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i)) :
    x ∈ Stacks.Ample.nonvanishingLocus (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ))
      (degreeSection (coordGrading.{u} n) d
        ⟨MvPolynomial.X i ^ d, MvPolynomial.isHomogeneous_X_pow i d⟩) := by
  have key : ∀ (m : ℕ) (hm : d * 1 = m) (f : coordGrading.{u} n m),
      x ∈ Stacks.Ample.nonvanishingLocus (X := AlgebraicGeometry.Proj (coordGrading.{u} n))
          (twistingSheaf (coordGrading.{u} n) (m : ℤ)) (degreeSection (coordGrading.{u} n) m f) ↔
        x ∈ Proj.basicOpen (coordGrading.{u} n) (f : coordRing.{u} n) := by
    intro m hm f
    subst hm
    exact Stacks.AlgebraicGeometry.CommonDegreeTwist.mem_nonvanishingLocus_degreeSection_iff'
      (coordGrading.{u} n) 1 d f
      (by rw [Stacks.TwistPullbackPinned.whereInvertible_coordGrading_eq_top]; trivial)
  refine (key d (mul_one d) _).2 ?_
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · simp
  · rwa [Proj.basicOpen_pow _ _ _ hd]

/-- In the chart ring at `Tᵢ`, `(∏ Tₗ^{aₗ}) / Tᵢ^d` is the product of the `(Tₗ/Tᵢ)^{aₗ}`. -/
private lemma away_mk_prod (i : Fin (n + 1)) (a : Fin (n + 1) → ℕ) (d : ℕ)
    (hd : ∑ l, a l = d)
    (h : (∏ l, MvPolynomial.X l ^ a l : coordRing.{u} n) ∈ coordGrading.{u} n (d • 1)) :
    Away.mk (coordGrading.{u} n) (X_mem_coordGrading_one i) d (∏ l, MvPolynomial.X l ^ a l) h =
      ∏ l, (Stacks.TwistPullbackPinned.coordFrac.{u} i l) ^ (a l) := by
  apply (show Function.Injective (algebraMap (Away (coordGrading.{u} n) (MvPolynomial.X i))
    (Localization.Away (MvPolynomial.X i : coordRing.{u} n))) from val_injective _)
  simp only [map_prod, map_pow]
  simp only [HomogeneousLocalization.algebraMap_apply, Stacks.TwistPullbackPinned.coordFrac,
    Away.val_mk, Localization.mk_pow, Localization.mk_prod]
  congr 1
  apply Subtype.ext
  simp only [SubmonoidClass.coe_pow, pow_one,
    Finset.prod_pow_eq_pow_sum]
  rw [hd]

/-- `Γ(ℙⁿ_ℤ, D₊(Tᵢ))` is generated as a ring by the fractions `Tₗ/Tᵢ`. -/
private lemma subring_eq_top_of_coordFrac_mem (i : Fin (n + 1))
    (T : Subring Γ(projectiveSpaceAtUniverse.{u} n,
      Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i)))
    (h : ∀ l, (Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i)).hom
      (Stacks.TwistPullbackPinned.coordFrac.{u} i l) ∈ T) : T = ⊤ := by
  set ρ := (Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i)).hom with hρ
  have hsurj : Function.Surjective ρ := by
    have : IsIso (Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i)) :=
      (Proj.basicOpenIsoAway (coordGrading.{u} n) (MvPolynomial.X i)
        (X_mem_coordGrading_one i) Nat.one_pos).isIso_hom
    exact (ConcreteCategory.bijective_of_isIso
      (Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i))).2
  have hint : ∀ r : coordGrading.{u} n 0,
      ρ (algebraMap (coordGrading.{u} n 0) (Away (coordGrading.{u} n) (MvPolynomial.X i)) r) ∈
        T := by
    intro r
    obtain ⟨p, hp⟩ := r
    have hpC : p = MvPolynomial.C (p.coeff 0) :=
      MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp (Nat.le_zero.mp hp.totalDegree_le)
    have hr : (⟨p, hp⟩ : coordGrading.{u} n 0) =
        (((p.coeff 0).down : ℤ) : coordGrading.{u} n 0) := by
      apply Subtype.ext
      change p = (((p.coeff 0).down : ℤ) : coordRing.{u} n)
      conv_lhs => rw [hpC]
      rw [← map_intCast (MvPolynomial.C (σ := Fin (n + 1)) (R := ULift.{u} ℤ))]
      congr 1
    rw [hr, map_intCast, map_intCast]
    exact intCast_mem T _
  let T' : Subalgebra (coordGrading.{u} n 0) (Away (coordGrading.{u} n) (MvPolynomial.X i)) :=
    { T.comap ρ with algebraMap_mem' := hint }
  have hX : Algebra.adjoin (coordGrading.{u} n 0)
      (Set.range (MvPolynomial.X : Fin (n + 1) → coordRing.{u} n)) = ⊤ := by
    rw [eq_top_iff]
    rintro p -
    induction p using MvPolynomial.induction_on with
    | C a => exact (Algebra.adjoin _ _).algebraMap_mem (⟨MvPolynomial.C a,
        MvPolynomial.isHomogeneous_C _ a⟩ : coordGrading.{u} n 0)
    | add p q hp hq => exact add_mem hp hq
    | mul_X p l hp => exact mul_mem hp (Algebra.subset_adjoin ⟨l, rfl⟩)
  have hadj := Away.adjoin_mk_prod_pow_eq_top (𝒜 := coordGrading.{u} n)
    (X_mem_coordGrading_one i) (Fin (n + 1)) MvPolynomial.X hX (fun _ => 1)
    X_mem_coordGrading_one
  have hT' : T' = ⊤ := by
    rw [eq_top_iff, ← hadj, Algebra.adjoin_le_iff]
    rintro _ ⟨a, ai, hai, -, rfl⟩
    have hsum : ∑ l, ai l = a := by simpa using hai
    change ρ _ ∈ T
    rw [away_mk_prod i ai a hsum, map_prod]
    exact prod_mem fun l _ => pow_mem (h l) _
  rw [eq_top_iff]
  intro z _
  obtain ⟨w, rfl⟩ := hsurj z
  have : w ∈ T' := hT' ▸ Algebra.mem_top
  exact this

/-- On `D₊(TₚTᵢ)`, `Tₗ/Tₚ = (Tₗ/Tᵢ) · (Tᵢ/Tₚ)`. -/
private lemma res_coordFrac_eq_mul (p i l : Fin (n + 1)) :
    (projectiveSpaceAtUniverse.{u} n).presheaf.map
        (homOfLE (Proj.basicOpen_mono (coordGrading.{u} n) (MvPolynomial.X p)
          (MvPolynomial.X p * MvPolynomial.X i) ⟨MvPolynomial.X i, rfl⟩)).op
        ((Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X p)).hom
          (Stacks.TwistPullbackPinned.coordFrac.{u} p l)) =
      (projectiveSpaceAtUniverse.{u} n).presheaf.map
          (homOfLE (Proj.basicOpen_mono (coordGrading.{u} n) (MvPolynomial.X i)
            (MvPolynomial.X p * MvPolynomial.X i) ⟨MvPolynomial.X p, mul_comm _ _⟩)).op
          ((Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i)).hom
            (Stacks.TwistPullbackPinned.coordFrac.{u} i l)) *
        (projectiveSpaceAtUniverse.{u} n).presheaf.map
          (homOfLE (Proj.basicOpen_mono (coordGrading.{u} n) (MvPolynomial.X p)
            (MvPolynomial.X p * MvPolynomial.X i) ⟨MvPolynomial.X i, rfl⟩)).op
          ((Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X p)).hom
            (Stacks.TwistPullbackPinned.coordFrac.{u} p i)) := by
  have h1 := fun z => ConcreteCategory.congr_hom (Proj.awayMap_awayToSection (coordGrading.{u} n)
    (f := MvPolynomial.X p) (X_mem_coordGrading_one i)
    (rfl : MvPolynomial.X p * MvPolynomial.X i = MvPolynomial.X p * MvPolynomial.X i)) z
  have h2 := fun z => ConcreteCategory.congr_hom (Proj.awayMap_awayToSection (coordGrading.{u} n)
    (f := MvPolynomial.X i) (X_mem_coordGrading_one p)
    (mul_comm _ _ : MvPolynomial.X p * MvPolynomial.X i = MvPolynomial.X i * MvPolynomial.X p)) z
  have e1 : ∀ z, (projectiveSpaceAtUniverse.{u} n).presheaf.map
        (homOfLE (Proj.basicOpen_mono (coordGrading.{u} n) (MvPolynomial.X p)
          (MvPolynomial.X p * MvPolynomial.X i) ⟨MvPolynomial.X i, rfl⟩)).op
        ((Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X p)).hom z) =
      (Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X p * MvPolynomial.X i)).hom
        (awayMap (coordGrading.{u} n) (f := MvPolynomial.X p) (X_mem_coordGrading_one i)
          (rfl : MvPolynomial.X p * MvPolynomial.X i = MvPolynomial.X p * MvPolynomial.X i) z) :=
    fun z => (h1 z).symm
  have e2 : ∀ z, (projectiveSpaceAtUniverse.{u} n).presheaf.map
        (homOfLE (Proj.basicOpen_mono (coordGrading.{u} n) (MvPolynomial.X i)
          (MvPolynomial.X p * MvPolynomial.X i) ⟨MvPolynomial.X p, mul_comm _ _⟩)).op
        ((Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i)).hom z) =
      (Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X p * MvPolynomial.X i)).hom
        (awayMap (coordGrading.{u} n) (f := MvPolynomial.X i) (X_mem_coordGrading_one p)
          (mul_comm _ _ : MvPolynomial.X p * MvPolynomial.X i =
            MvPolynomial.X i * MvPolynomial.X p) z) :=
    fun z => (h2 z).symm
  rw [e1, e1, e2, ← map_mul]
  congr 1
  apply (show Function.Injective (algebraMap (Away (coordGrading.{u} n)
      (MvPolynomial.X p * MvPolynomial.X i))
    (Localization.Away (MvPolynomial.X p * MvPolynomial.X i : coordRing.{u} n))) from
      val_injective _)
  simp only [Stacks.TwistPullbackPinned.coordFrac, awayMap_mk, map_mul,
    HomogeneousLocalization.algebraMap_apply, Away.val_mk, Localization.mk_mul]
  exact Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq (by simp; ring))

end ProjCharts

section Algebra

/-- The bigrading weight `deg xᵢ = (1, 0)`, `deg x'ⱼ = (0, 1)`. -/
private abbrev biWeight (σ τ : Type*) : σ ⊕ τ → ℕ × ℕ := Sum.elim (fun _ ↦ (1, 0)) (fun _ ↦ (0, 1))

/-- The monomial `∏ tₛ^{mₛ}` for `t` constant on each of the two blocks of variables is
`t₁^{deg₁ m} t₂^{deg₂ m}`. -/
private lemma prod_sumElim_pow_eq {σ τ R : Type*} [CommMonoid R] (t₁ t₂ : R)
    (m : σ ⊕ τ →₀ ℕ) :
    m.prod (fun s e => (Sum.elim (fun _ => t₁) (fun _ => t₂) s : R) ^ e) =
      t₁ ^ (Finsupp.weight (biWeight σ τ) m).1 * t₂ ^ (Finsupp.weight (biWeight σ τ) m).2 := by
  classical
  induction m using Finsupp.induction with
  | zero => simp
  | single_add s e m hs he ih =>
    rw [Finsupp.prod_add_index (by simp) (fun _ _ _ _ => pow_add _ _ _), ih,
      Finsupp.prod_single_index (by simp), map_add, Finsupp.weight_single]
    rcases s with s | s <;> simp [pow_add, mul_left_comm, mul_assoc]

/-- Two ring homomorphisms out of a polynomial ring in two blocks of variables that agree on
constants and whose values on the variables of the two blocks differ by the factors `t₁`, `t₂`
differ by `t₁^{c₁} t₂^{c₂}` on a bihomogeneous polynomial of bidegree `(c₁, c₂)`. -/
private lemma map_eq_mul_of_isWeightedHomogeneous {σ τ k R : Type*} [CommSemiring k] [CommRing R]
    (φ ψ : MvPolynomial (σ ⊕ τ) k →+* R) (t₁ t₂ : R)
    (hC : ∀ c, φ (MvPolynomial.C c) = ψ (MvPolynomial.C c))
    (h₁ : ∀ s, φ (MvPolynomial.X (Sum.inl s)) = ψ (MvPolynomial.X (Sum.inl s)) * t₁)
    (h₂ : ∀ s, φ (MvPolynomial.X (Sum.inr s)) = ψ (MvPolynomial.X (Sum.inr s)) * t₂)
    {G : MvPolynomial (σ ⊕ τ) k} {c : ℕ × ℕ}
    (hG : G.IsWeightedHomogeneous (biWeight σ τ) c) :
    φ G = ψ G * t₁ ^ c.1 * t₂ ^ c.2 := by
  classical
  have hmon : ∀ (m : σ ⊕ τ →₀ ℕ) (a : k), φ (MvPolynomial.monomial m a) =
      ψ (MvPolynomial.monomial m a) * (t₁ ^ (Finsupp.weight (biWeight σ τ) m).1 *
        t₂ ^ (Finsupp.weight (biWeight σ τ) m).2) := by
    intro m a
    rw [← prod_sumElim_pow_eq, MvPolynomial.monomial_eq, map_mul, map_mul, hC,
      map_finsuppProd, map_finsuppProd, mul_assoc, ← Finsupp.prod_mul]
    congr 1
    refine Finsupp.prod_congr fun s _ => ?_
    rw [map_pow, map_pow, ← mul_pow]
    rcases s with s | s
    · rw [h₁]; rfl
    · rw [h₂]; rfl
  conv_lhs => rw [G.as_sum]
  conv_rhs => rw [G.as_sum]
  rw [map_sum, map_sum, Finset.sum_mul, Finset.sum_mul]
  refine Finset.sum_congr rfl fun m hm => ?_
  rw [hmon, hG (MvPolynomial.mem_support_iff.mp hm), mul_assoc]

end Algebra

section Charts

open Opposite TopologicalSpace HomogeneousLocalization
open Stacks.SectionsToProjectiveSpace (coordGrading coordRing X_mem_coordGrading_one)

variable {n : ℕ}

/-- The standard chart `D₊(Tᵢ)` of `ℙⁿ_ℤ`. -/
private noncomputable abbrev stdOpen (i : Fin (n + 1)) : (projectiveSpaceAtUniverse.{u} n).Opens :=
  Proj.basicOpen (coordGrading.{u} n) (MvPolynomial.X i)

/-- The affine coordinate `Tₗ/Tᵢ` on the standard chart `D₊(Tᵢ)`. -/
private noncomputable abbrev ratio (i l : Fin (n + 1)) :
    Γ(projectiveSpaceAtUniverse.{u} n, stdOpen i) :=
  (Proj.awayToSection (coordGrading.{u} n) (MvPolynomial.X i)).hom
    (Stacks.TwistPullbackPinned.coordFrac.{u} i l)

private lemma coordFrac_self (i : Fin (n + 1)) :
    Stacks.TwistPullbackPinned.coordFrac.{u} i i = 1 := by
  apply val_injective
  rw [Stacks.TwistPullbackPinned.coordFrac, Away.val_mk, HomogeneousLocalization.val_one,
    ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simp⟩

private lemma ratio_self (i : Fin (n + 1)) : ratio.{u} i i = 1 := by
  rw [ratio, coordFrac_self, map_one]

/-- Restricting a pulled-back section is pulling back a restricted section. -/
private lemma res_appLE {X Y : Scheme.{u}} (f : X ⟶ Y) {U U' : Y.Opens} (hU : U' ≤ U)
    {V V' : X.Opens} (hV : V' ≤ V) (e : V ≤ f ⁻¹ᵁ U) (e' : V' ≤ f ⁻¹ᵁ U') (z : Γ(Y, U)) :
    X.presheaf.map (homOfLE hV).op (f.appLE U V e z) =
      f.appLE U' V' e' (Y.presheaf.map (homOfLE hU).op z) := by
  rw [← ConcreteCategory.comp_apply, Scheme.Hom.appLE_map, ← ConcreteCategory.comp_apply,
    Scheme.Hom.map_appLE]

/-- The transition rule `Tₗ/Tₚ = (Tₗ/Tᵢ) (Tᵢ/Tₚ)` pulled back along a morphism `r` to an open
`V` lying over `D₊(Tₚ) ⊓ D₊(Tᵢ)`. -/
private lemma res_appLE_ratio {W : Scheme.{u}} (r : W ⟶ projectiveSpaceAtUniverse.{u} n)
    (p i l : Fin (n + 1)) {U U' V : W.Opens} (hU : U ≤ r ⁻¹ᵁ stdOpen p)
    (hU' : U' ≤ r ⁻¹ᵁ stdOpen i) (hVU : V ≤ U) (hVU' : V ≤ U') :
    W.presheaf.map (homOfLE hVU).op (r.appLE (stdOpen p) U hU (ratio p l)) =
      W.presheaf.map (homOfLE hVU').op (r.appLE (stdOpen i) U' hU' (ratio i l)) *
        W.presheaf.map (homOfLE hVU).op (r.appLE (stdOpen p) U hU (ratio p i)) := by
  have hV : V ≤ r ⁻¹ᵁ Proj.basicOpen (coordGrading.{u} n)
      (MvPolynomial.X p * MvPolynomial.X i) := by
    rw [Proj.basicOpen_mul]
    exact fun x hx => ⟨hU (hVU hx), hU' (hVU' hx)⟩
  rw [res_appLE r (Proj.basicOpen_mono (coordGrading.{u} n) (MvPolynomial.X p)
      (MvPolynomial.X p * MvPolynomial.X i) ⟨MvPolynomial.X i, rfl⟩) hVU hU hV,
    res_appLE r (Proj.basicOpen_mono (coordGrading.{u} n) (MvPolynomial.X p)
      (MvPolynomial.X p * MvPolynomial.X i) ⟨MvPolynomial.X i, rfl⟩) hVU hU hV,
    res_appLE r (Proj.basicOpen_mono (coordGrading.{u} n) (MvPolynomial.X i)
      (MvPolynomial.X p * MvPolynomial.X i) ⟨MvPolynomial.X p, mul_comm _ _⟩) hVU' hU' hV,
    ← map_mul]
  exact congrArg _ (res_coordFrac_eq_mul p i l)

variable {W : Scheme.{u}} (q₁ q₂ : W ⟶ projectiveSpaceAtUniverse.{u} n)

/-- The chart `q₁⁻¹ D₊(Tᵢ) ⊓ q₂⁻¹ D₊(Tⱼ)` of `W`. -/
private noncomputable abbrev chart (i j : Fin (n + 1)) : W.Opens :=
  q₁ ⁻¹ᵁ stdOpen i ⊓ q₂ ⁻¹ᵁ stdOpen j

/-- The charts cover `W`. -/
private lemma exists_mem_chart (y : W) : ∃ i j, y ∈ chart q₁ q₂ i j := by
  have htop := Stacks.AlgebraicGeometry.SegreChartProduct.iSup_basicOpen_X_eq_top
    (ULift.{u} ℤ) (Fin (n + 1))
  have h1 : q₁.base y ∈ (⊤ : (projectiveSpaceAtUniverse.{u} n).Opens) := trivial
  have h2 : q₂.base y ∈ (⊤ : (projectiveSpaceAtUniverse.{u} n).Opens) := trivial
  rw [← htop] at h1 h2
  obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp h1
  obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp h2
  exact ⟨i, j, hi, hj⟩

/-- The coordinate `Tₗ/Tᵢ` of the first factor, pulled back to the chart. -/
private noncomputable abbrev frac₁ (i j l : Fin (n + 1)) : Γ(W, chart q₁ q₂ i j) :=
  q₁.appLE (stdOpen i) (chart q₁ q₂ i j) inf_le_left (ratio i l)

/-- The coordinate `Tₗ/Tⱼ` of the second factor, pulled back to the chart. -/
private noncomputable abbrev frac₂ (i j l : Fin (n + 1)) : Γ(W, chart q₁ q₂ i j) :=
  q₂.appLE (stdOpen j) (chart q₁ q₂ i j) inf_le_right (ratio j l)

variable {k : Type u} [CommRing k] (κ : k →+* Γ(W, ⊤))

/-- The dehomogenisation at `(i, j)`: the ring map from the bigraded polynomial ring to the
functions on the chart `(i, j)` sending `xₗ ↦ Tₗ/Tᵢ`, `x'ₗ ↦ T'ₗ/T'ⱼ` and constants through
`κ`. -/
private noncomputable def chartHom (i j : Fin (n + 1)) :
    MvPolynomial (ULift.{u} (Fin (n + 1)) ⊕ ULift.{u} (Fin (n + 1))) k →+* Γ(W, chart q₁ q₂ i j) :=
  MvPolynomial.eval₂Hom ((W.presheaf.map (homOfLE le_top).op).hom.comp κ)
    (Sum.elim (fun l => frac₁ q₁ q₂ i j l.down) (fun l => frac₂ q₁ q₂ i j l.down))

private lemma chartHom_C (i j : Fin (n + 1)) (c : k) :
    chartHom q₁ q₂ κ i j (MvPolynomial.C c) = W.presheaf.map (homOfLE le_top).op (κ c) := by
  simp [chartHom]

private lemma chartHom_X_inl (i j : Fin (n + 1)) (l : ULift.{u} (Fin (n + 1))) :
    chartHom q₁ q₂ κ i j (MvPolynomial.X (Sum.inl l)) = frac₁ q₁ q₂ i j l.down := by
  simp [chartHom]

private lemma chartHom_X_inr (i j : Fin (n + 1)) (l : ULift.{u} (Fin (n + 1))) :
    chartHom q₁ q₂ κ i j (MvPolynomial.X (Sum.inr l)) = frac₂ q₁ q₂ i j l.down := by
  simp [chartHom]

private lemma chartHom_X_inl_self (i j : Fin (n + 1)) :
    chartHom q₁ q₂ κ i j (MvPolynomial.X (Sum.inl ⟨i⟩)) = 1 := by
  rw [chartHom_X_inl, frac₁, ratio_self, map_one]

private lemma chartHom_X_inr_self (i j : Fin (n + 1)) :
    chartHom q₁ q₂ κ i j (MvPolynomial.X (Sum.inr ⟨j⟩)) = 1 := by
  rw [chartHom_X_inr, frac₂, ratio_self, map_one]

/-- **The transition rule for the dehomogenisations.** On the overlap of the charts `(p, q)` and
`(i, j)`, the dehomogenisation at `(p, q)` of a bihomogeneous polynomial of bidegree `(c₁, c₂)`
is its dehomogenisation at `(i, j)` times `(Tᵢ/Tₚ)^{c₁} (T'ⱼ/T'_q)^{c₂}`. -/
private lemma res_chartHom_of_isWeightedHomogeneous (p q i j : Fin (n + 1))
    {G : MvPolynomial (ULift.{u} (Fin (n + 1)) ⊕ ULift.{u} (Fin (n + 1))) k} {c : ℕ × ℕ}
    (hG : G.IsWeightedHomogeneous (biWeight _ _) c) :
    W.presheaf.map (homOfLE (inf_le_left : chart q₁ q₂ p q ⊓ chart q₁ q₂ i j ≤ _)).op
        (chartHom q₁ q₂ κ p q G) =
      W.presheaf.map (homOfLE (inf_le_right : chart q₁ q₂ p q ⊓ chart q₁ q₂ i j ≤ _)).op
          (chartHom q₁ q₂ κ i j G) *
        W.presheaf.map (homOfLE (inf_le_left : chart q₁ q₂ p q ⊓ chart q₁ q₂ i j ≤ _)).op
          (frac₁ q₁ q₂ p q i) ^ c.1 *
        W.presheaf.map (homOfLE (inf_le_left : chart q₁ q₂ p q ⊓ chart q₁ q₂ i j ≤ _)).op
          (frac₂ q₁ q₂ p q j) ^ c.2 := by
  refine map_eq_mul_of_isWeightedHomogeneous
    ((W.presheaf.map (homOfLE (inf_le_left : chart q₁ q₂ p q ⊓ chart q₁ q₂ i j ≤ _)).op).hom.comp
      (chartHom q₁ q₂ κ p q))
    ((W.presheaf.map (homOfLE (inf_le_right : chart q₁ q₂ p q ⊓ chart q₁ q₂ i j ≤ _)).op).hom.comp
      (chartHom q₁ q₂ κ i j)) _ _ (fun c => ?_) (fun l => ?_) (fun l => ?_) hG
  · simp only [RingHom.comp_apply, chartHom_C, ← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  · simp only [RingHom.comp_apply, chartHom_X_inl]
    exact res_appLE_ratio q₁ p i l.down _ _ _ _
  · simp only [RingHom.comp_apply, chartHom_X_inr]
    exact res_appLE_ratio q₂ q j l.down _ _ _ _

/-- The locus of the chart `(p, q)` where `Tₐ/Tₚ` is invertible is its intersection with
`q₁⁻¹ D₊(Tₐ)`. -/
private lemma basicOpen_chartHom_X_inl (p q a : Fin (n + 1)) :
    W.basicOpen (chartHom q₁ q₂ κ p q (MvPolynomial.X (Sum.inl ⟨a⟩))) =
      chart q₁ q₂ p q ⊓ q₁ ⁻¹ᵁ stdOpen a := by
  rw [chartHom_X_inl]
  exact Stacks.ProjChartBasicOpen.basicOpen_appLE_awayToSection_mk (coordGrading.{u} n) q₁
    (X_mem_coordGrading_one p) Nat.one_pos 1 (MvPolynomial.X a) _ inf_le_left

private lemma basicOpen_chartHom_X_inr (p q a : Fin (n + 1)) :
    W.basicOpen (chartHom q₁ q₂ κ p q (MvPolynomial.X (Sum.inr ⟨a⟩))) =
      chart q₁ q₂ p q ⊓ q₂ ⁻¹ᵁ stdOpen a := by
  rw [chartHom_X_inr]
  exact Stacks.ProjChartBasicOpen.basicOpen_appLE_awayToSection_mk (coordGrading.{u} n) q₂
    (X_mem_coordGrading_one q) Nat.one_pos 1 (MvPolynomial.X a) _ inf_le_right

end Charts

section Sections

open Opposite TopologicalSpace

variable {W : Scheme.{u}}

/-- The tensor product `F ⊗ G` of two modules on a scheme, as a module on the scheme. -/
private noncomputable abbrev tensorSheaf (F G : W.Modules) : W.Modules :=
  Stacks.SheafOfModules.Invertible.tensorProduct W.toRingedSpace.presheaf
    (structureSheafRing W.toRingedSpace).property F G

/-- Restricting the global section of `F ⊗ G` attached to two global sections. -/
private lemma res_tensorSections (F G : W.Modules) (a : Γ(F, ⊤)) (b : Γ(G, ⊤)) (U : W.Opens) :
    (tensorSheaf F G).presheaf.map (homOfLE le_top).op
      ((Scheme.Modules.sectionsTopEquiv (tensorSheaf F G)).symm
        (tensorSections F G (Scheme.Modules.sectionsTopEquiv F a)
          (Scheme.Modules.sectionsTopEquiv G b))) =
      Stacks.SheafOfModules.TensorStalkRingedSpace.toTensorSheafSection W.toRingedSpace F G (op U)
        (F.presheaf.map (homOfLE le_top).op a ⊗ₜ[Γ(W, U)]
          G.presheaf.map (homOfLE le_top).op b) := by
  rw [← Scheme.Modules.sectionsTopEquiv_val]
  exact (congrArg (fun σ : (tensorSheaf F G).sections => σ.val (op U))
    (Equiv.apply_symm_apply (Scheme.Modules.sectionsTopEquiv (tensorSheaf F G))
      (tensorSections F G (Scheme.Modules.sectionsTopEquiv F a)
        (Scheme.Modules.sectionsTopEquiv G b)))).trans rfl

/-- Scalars on the two factors of an elementary tensor multiply. -/
private lemma toTensorSheafSection_smul_tmul_smul (F G : W.Modules) (U : W.Opens)
    (g h : Γ(W, U)) (x : Γ(F, U)) (y : Γ(G, U)) :
    (Stacks.SheafOfModules.TensorStalkRingedSpace.toTensorSheafSection W.toRingedSpace F G (op U)
        ((g • x) ⊗ₜ[Γ(W, U)] (h • y)) : Γ(tensorSheaf F G, U)) =
      @HSMul.hSMul Γ(W, U) Γ(tensorSheaf F G, U) Γ(tensorSheaf F G, U) instHSMul (g * h)
        (Stacks.SheafOfModules.TensorStalkRingedSpace.toTensorSheafSection
          W.toRingedSpace F G (op U) (x ⊗ₜ[Γ(W, U)] y)) := by
  refine (congrArg (Stacks.SheafOfModules.TensorStalkRingedSpace.toTensorSheafSection
    W.toRingedSpace F G (op U)) (TensorProduct.smul_tmul_smul (R := Γ(W, U)) g h x y)).trans ?_
  exact ((Stacks.SheafOfModules.TensorStalkRingedSpace.sheafifyUnit W.toRingedSpace
    (PresheafOfModules.tensorObj (O := W.toRingedSpace.presheaf) F.val G.val)).app
      (op U)).hom.map_smul _ _

/-- A relation `s|_V = g • t|_V` between global sections pulls back to the preimage of `V`. -/
private lemma res_pullbackGlobalSections_smul {Y : Scheme.{u}} (q : W ⟶ Y) (F : Y.Modules)
    {V : Y.Opens} (s t : Γ(F, ⊤)) (g : Γ(Y, V))
    (h : F.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op s =
      g • F.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op t)
    (U : W.Opens) (hU : U ≤ q ⁻¹ᵁ V) :
    ((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op
        (pullbackGlobalSections q F s) =
      q.appLE V U hU g • ((Scheme.Modules.pullback q).obj F).presheaf.map
        (homOfLE (le_top : U ≤ ⊤)).op (pullbackGlobalSections q F t) := by
  have e : ∀ x : Γ(F, ⊤), ((Scheme.Modules.pullback q).obj F).presheaf.map
      (homOfLE (le_top : U ≤ ⊤)).op (pullbackGlobalSections q F x) =
      ((Scheme.Modules.pullback q).obj F).presheaf.map (homOfLE hU).op
        (Stacks.TwistPullbackPinned.pullbackSectionOn q F V
          (F.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op x)) := by
    intro x
    rw [Stacks.TwistPullbackPinned.pullbackGlobalSections_res, ← Functor.map_comp_apply]
    rfl
  rw [e, e, h, Stacks.TwistPullbackPinned.pullbackSectionOn_smul, Scheme.Modules.map_smul]
  rfl

end Sections

section MonoSections

open Opposite TopologicalSpace HomogeneousLocalization
open Stacks.SectionsToProjectiveSpace (coordGrading coordRing X_mem_coordGrading_one)

variable {n : ℕ} {W : Scheme.{u}}

/-- The pull-back `q^* 𝒪(d)` of the twisting sheaf of `ℙⁿ_ℤ`. -/
noncomputable abbrev twistPullback (q : W ⟶ projectiveSpaceAtUniverse.{u} n) (d : ℕ) :
    W.Modules :=
  (Scheme.Modules.pullback q).obj (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ))

/-- The monomial `Tᵢ^d`. -/
private noncomputable def powIndex (i : Fin (n + 1)) (d : ℕ) : MonomialIndex.{u} n (d : ℤ) :=
  ⟨Finsupp.single ⟨i⟩ d, by simp⟩

private lemma coordMonomial_powIndex (i : Fin (n + 1)) (d : ℕ) :
    coordMonomial (powIndex.{u} i d) = MvPolynomial.X i ^ d := by
  simp [coordMonomial, powIndex, Finsupp.equivMapDomain_single, MvPolynomial.X_pow_eq_monomial]

/-- The monomial section `Tᵢ^d` is the degree-`d` section of `Tᵢ^d`. -/
private lemma monomialSectionAtUniverse_powIndex (i : Fin (n + 1)) (d : ℕ) :
    monomialSectionAtUniverse (powIndex.{u} i d) =
      ProjectiveSpectrum.Proj.degreeSection (coordGrading.{u} n) d
        ⟨MvPolynomial.X i ^ d, MvPolynomial.isHomogeneous_X_pow i d⟩ := by
  rw [monomialSectionAtUniverse_eq]
  exact congrArg _ (Subtype.ext (coordMonomial_powIndex i d))

/-- On `D₊(Tᵢ)` the monomial section `T^e` of `𝒪(d)` is `∏ (Tₗ/Tᵢ)^{eₗ}` times `Tᵢ^d`. -/
private lemma res_monomialSectionAtUniverse (i : Fin (n + 1)) (d : ℕ)
    (e : MonomialIndex.{u} n (d : ℤ)) :
    (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ)).presheaf.map
        (homOfLE (le_top (a := stdOpen.{u} i))).op (monomialSectionAtUniverse e) =
      (∏ l, ratio.{u} i l ^ (e.1 ⟨l⟩)) •
        (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ)).presheaf.map
          (homOfLE (le_top (a := stdOpen.{u} i))).op
          (monomialSectionAtUniverse (powIndex.{u} i d)) := by
  have hdeg : e.1.degree = d := by exact_mod_cast e.2
  have ha : (Finsupp.equivMapDomain Equiv.ulift e.1).degree = d := by
    rw [degree_equivMapDomain_ulift, hdeg]
  have hp' : coordMonomial e ∈ coordGrading.{u} n (d • 1) := by
    have := coordMonomial_mem e
    rw [hdeg] at this
    simpa using this
  rw [monomialSectionAtUniverse_eq, monomialSectionAtUniverse_powIndex,
    degreeSection_res_eq_smul i d (coordMonomial e) _ hp']
  congr 1
  simp only [ratio, ← map_pow, ← map_prod]
  congr 1
  exact away_mk_monomial i _ d ha hp'

/-- The pull-back of `res_monomialSectionAtUniverse` along `q`, to an open over `D₊(Tᵢ)`. -/
private lemma res_pullback_monomialSection (q : W ⟶ projectiveSpaceAtUniverse.{u} n)
    (i : Fin (n + 1)) (d : ℕ) (e : MonomialIndex.{u} n (d : ℤ)) (U : W.Opens)
    (hU : U ≤ q ⁻¹ᵁ stdOpen i) :
    (twistPullback q d).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op
        (pullbackGlobalSections q _ (monomialSectionAtUniverse e)) =
      (∏ l, q.appLE (stdOpen i) U hU (ratio.{u} i l) ^ (e.1 ⟨l⟩)) •
        (twistPullback q d).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op
          (pullbackGlobalSections q _ (monomialSectionAtUniverse (powIndex.{u} i d))) := by
  rw [res_pullbackGlobalSections_smul q _ _ _ _ (res_monomialSectionAtUniverse i d e) U hU,
    map_prod]
  simp only [map_pow]

variable (q₁ q₂ : W ⟶ projectiveSpaceAtUniverse.{u} n) (d₁ d₂ : ℕ)

/-- The restriction along `(q₁, q₂)` of the bihomogeneous monomial `T^a T'^b`, a global section of
`q₁^* 𝒪(d₁) ⊗ q₂^* 𝒪(d₂)`. -/
private noncomputable def tensorMonoSec
    (e : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ)) :
    Γ(tensorSheaf (twistPullback q₁ d₁) (twistPullback q₂ d₂), ⊤) :=
  (Scheme.Modules.sectionsTopEquiv _).symm
    (tensorSections (twistPullback q₁ d₁) (twistPullback q₂ d₂)
      (Scheme.Modules.sectionsTopEquiv _
        (pullbackGlobalSections q₁ _ (monomialSectionAtUniverse e.1)))
      (Scheme.Modules.sectionsTopEquiv _
        (pullbackGlobalSections q₂ _ (monomialSectionAtUniverse e.2))))

/-- **On the chart `(i, j)` the monomial `T^a T'^b` is `∏ (Tₗ/Tᵢ)^{aₗ} ∏ (T'ₗ/T'ⱼ)^{bₗ}` times
`Tᵢ^{d₁} T'ⱼ^{d₂}`.** -/
private lemma res_tensorMonoSec (i j : Fin (n + 1))
    (e : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ)) (U : W.Opens)
    (hU : U ≤ chart q₁ q₂ i j) :
    (tensorSheaf (twistPullback q₁ d₁) (twistPullback q₂ d₂)).presheaf.map
        (homOfLE (le_top : U ≤ ⊤)).op (tensorMonoSec q₁ q₂ d₁ d₂ e) =
      ((∏ l, q₁.appLE (stdOpen i) U (hU.trans inf_le_left) (ratio.{u} i l) ^ (e.1.1 ⟨l⟩)) *
        (∏ l, q₂.appLE (stdOpen j) U (hU.trans inf_le_right) (ratio.{u} j l) ^ (e.2.1 ⟨l⟩))) •
        (tensorSheaf (twistPullback q₁ d₁) (twistPullback q₂ d₂)).presheaf.map
          (homOfLE (le_top : U ≤ ⊤)).op
          (tensorMonoSec q₁ q₂ d₁ d₂ (powIndex.{u} i d₁, powIndex.{u} j d₂)) := by
  rw [tensorMonoSec, tensorMonoSec, res_tensorSections, res_tensorSections,
    res_pullback_monomialSection q₁ i d₁ e.1 U (hU.trans inf_le_left),
    res_pullback_monomialSection q₂ j d₂ e.2 U (hU.trans inf_le_right),
    toTensorSheafSection_smul_tmul_smul]

/-- `Tᵢ^d` vanishes nowhere on `D₊(Tᵢ)`. -/
private lemma mem_nonvanishingLocus_monomialSection_powIndex (i : Fin (n + 1)) (d : ℕ)
    {y : projectiveSpaceAtUniverse.{u} n} (hy : y ∈ stdOpen.{u} i) :
    y ∈ Stacks.Ample.nonvanishingLocus (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ))
      (monomialSectionAtUniverse (powIndex.{u} i d)) := by
  rw [monomialSectionAtUniverse_powIndex]
  exact mem_nonvanishingLocus_degreeSection_X_pow i d hy

/-- The two spellings of the passage between global sections and compatible families agree. -/
private lemma sectionsTopEquiv_eq_sectionsEquiv_symm (M : W.Modules) (a : Γ(M, ⊤)) :
    Scheme.Modules.sectionsTopEquiv M a =
      (Stacks.NonvanishingSpelling.sectionsEquiv W M).symm a := by
  apply (Stacks.NonvanishingSpelling.sectionsEquiv W M).injective
  rw [Equiv.apply_symm_apply, Stacks.NonvanishingSpelling.sectionsEquiv_apply]
  change (Scheme.Modules.sectionsTopEquiv M a).val (op ⊤) = a
  rw [Scheme.Modules.sectionsTopEquiv_val]
  exact Functor.map_id_apply _ _ _

private lemma sectionsTopEquiv_symm_eq_sectionsEquiv (M : W.Modules) (σ : M.sections) :
    (Scheme.Modules.sectionsTopEquiv M).symm σ =
      Stacks.NonvanishingSpelling.sectionsEquiv W M σ := by
  rw [Equiv.symm_apply_eq, sectionsTopEquiv_eq_sectionsEquiv_symm, Equiv.symm_apply_apply]

variable [∀ d : ℕ, Stacks.Ample.IsInvertibleModule W (twistPullback q₁ d)]
  [∀ d : ℕ, Stacks.Ample.IsInvertibleModule W (twistPullback q₂ d)]

private lemma isInvertibleModule_tensorSheaf : Stacks.Ample.IsInvertibleModule W
    (tensorSheaf (twistPullback q₁ d₁) (twistPullback q₂ d₂)) :=
  Stacks.AmplePullbackPart1.isInvertibleModule_tensorModules W _ _

attribute [local instance] isInvertibleModule_tensorSheaf

/-- **`Tᵢ^{d₁} T'ⱼ^{d₂}` vanishes nowhere on the chart `(i, j)`.** -/
private lemma chart_le_nonvanishingOpen (i j : Fin (n + 1)) :
    chart q₁ q₂ i j ≤ Stacks.NonvanishingOpen.nonvanishingOpen W
      (tensorSheaf (twistPullback q₁ d₁) (twistPullback q₂ d₂))
      (tensorMonoSec q₁ q₂ d₁ d₂ (powIndex.{u} i d₁, powIndex.{u} j d₂)) := by
  intro x hx
  have hm : tensorMonoSec q₁ q₂ d₁ d₂ (powIndex.{u} i d₁, powIndex.{u} j d₂) =
      Stacks.NonvanishingSpelling.sectionsEquiv W
        (tensorSheaf (twistPullback q₁ d₁) (twistPullback q₂ d₂))
        (tensorSections (twistPullback q₁ d₁) (twistPullback q₂ d₂)
          ((Stacks.NonvanishingSpelling.sectionsEquiv W _).symm
            (pullbackGlobalSections q₁ _ (monomialSectionAtUniverse (powIndex.{u} i d₁))))
          ((Stacks.NonvanishingSpelling.sectionsEquiv W _).symm
            (pullbackGlobalSections q₂ _ (monomialSectionAtUniverse (powIndex.{u} j d₂))))) :=
    (sectionsTopEquiv_symm_eq_sectionsEquiv _ _).trans
      (congrArg _ (congrArg₂ _ (sectionsTopEquiv_eq_sectionsEquiv_symm _ _)
        (sectionsTopEquiv_eq_sectionsEquiv_symm _ _)))
  rw [Stacks.NonvanishingOpen.mem_nonvanishingOpen, hm]
  refine (Set.ext_iff.mp (Stacks.NonvanishingSpelling.stalkNonvanishingLocus_eq W _ _) x).mp ?_
  refine (tensorSections_nonvanishing_iff _ _ x).mpr ⟨?_, ?_⟩
  · refine (Set.ext_iff.mp
      (Stacks.NonvanishingSpelling.stalkNonvanishingLocus_symm_eq W _ _) x).mpr ?_
    exact Stacks.TwistPullbackPinned.mem_nonvanishingLocus_pullbackGlobalSections q₁ _ _
      (mem_nonvanishingLocus_monomialSection_powIndex i d₁ hx.1)
  · refine (Set.ext_iff.mp
      (Stacks.NonvanishingSpelling.stalkNonvanishingLocus_symm_eq W _ _) x).mpr ?_
    exact Stacks.TwistPullbackPinned.mem_nonvanishingLocus_pullbackGlobalSections q₂ _ _
      (mem_nonvanishingLocus_monomialSection_powIndex j d₂ hx.2)

/-- Multiplication by `Tᵢ^{d₁} T'ⱼ^{d₂}` is a bijection on every open inside the chart. -/
private lemma bijective_smul_res_tensorMonoSec (i j : Fin (n + 1)) {V : W.Opens}
    (hV : V ≤ chart q₁ q₂ i j) :
    Function.Bijective fun g : Γ(W, V) => g •
      (tensorSheaf (twistPullback q₁ d₁) (twistPullback q₂ d₂)).presheaf.map
        (homOfLE (le_top : V ≤ ⊤)).op
        (tensorMonoSec q₁ q₂ d₁ d₂ (powIndex.{u} i d₁, powIndex.{u} j d₂)) :=
  Stacks.NonvanishingSpelling.bijective_smul W _ _
    (hV.trans (chart_le_nonvanishingOpen q₁ q₂ d₁ d₂ i j))

end MonoSections

section Surjective

open Opposite TopologicalSpace HomogeneousLocalization
open Stacks.SectionsToProjectiveSpace (coordGrading coordRing X_mem_coordGrading_one)

variable (n : ℕ) (k : Type u) [CommRing k]

/-- The structure morphism `ℙⁿ_k ⟶ Spec k`. -/
private noncomputable abbrev pk : projectiveSpaceOver n (Spec (.of k)) ⟶ Spec (.of k) :=
  pullback.fst _ _

/-- The projection `ℙⁿ_k ⟶ ℙⁿ_ℤ`. -/
private noncomputable abbrev tk : projectiveSpaceOver n (Spec (.of k)) ⟶
    projectiveSpaceAtUniverse.{u} n :=
  projectiveSpaceOver.toIntegralAtUniverse n _

/-- The first projection `ℙⁿ_k ×_k ℙⁿ_k ⟶ ℙⁿ_ℤ`. -/
private noncomputable abbrev rk₁ : pullback (pk n k) (pk n k) ⟶ projectiveSpaceAtUniverse.{u} n :=
  pullback.fst (pk n k) (pk n k) ≫ tk n k

/-- The second projection `ℙⁿ_k ×_k ℙⁿ_k ⟶ ℙⁿ_ℤ`. -/
private noncomputable abbrev rk₂ : pullback (pk n k) (pk n k) ⟶ projectiveSpaceAtUniverse.{u} n :=
  pullback.snd (pk n k) (pk n k) ≫ tk n k

/-- The `k`-algebra structure of the functions on `ℙⁿ_k ×_k ℙⁿ_k`. -/
private noncomputable abbrev κY : k →+* Γ(pullback (pk n k) (pk n k), ⊤) :=
  ((Scheme.ΓSpecIso (.of k)).inv ≫ (pullback.fst (pk n k) (pk n k) ≫ pk n k).appTop).hom

private lemma preimage_stdOpen_eq (i : Fin (n + 1)) :
    tk n k ⁻¹ᵁ stdOpen.{u} i =
      pullback.fst (terminal.from (Spec (.of k))) (terminal.from (projectiveSpaceAtUniverse.{u} n))
          ⁻¹ᵁ ⊤ ⊓ tk n k ⁻¹ᵁ stdOpen.{u} i := by
  rw [Scheme.Hom.preimage_top, top_inf_eq]

private lemma isAffineOpen_preimage_stdOpen (i : Fin (n + 1)) :
    IsAffineOpen (tk n k ⁻¹ᵁ stdOpen.{u} i) := by
  rw [preimage_stdOpen_eq]
  exact Stacks.AlgebraicGeometry.isAffineOpen_pullback_inf _ _ (isAffineOpen_top _)
    (Proj.isAffineOpen_basicOpen _ _ (X_mem_coordGrading_one i) Nat.one_pos)

private lemma isAffineOpen_chart_k (i j : Fin (n + 1)) :
    IsAffineOpen (chart (rk₁ n k) (rk₂ n k) i j) := by
  have h : chart (rk₁ n k) (rk₂ n k) i j =
      pullback.fst (pk n k) (pk n k) ⁻¹ᵁ (tk n k ⁻¹ᵁ stdOpen.{u} i) ⊓
        pullback.snd (pk n k) (pk n k) ⁻¹ᵁ (tk n k ⁻¹ᵁ stdOpen.{u} j) := by
    simp only [chart, rk₁, rk₂, Scheme.Hom.comp_preimage]
  rw [h]
  exact Stacks.AlgebraicGeometry.isAffineOpen_pullback_inf (pk n k) (pk n k)
    (isAffineOpen_preimage_stdOpen n k i) (isAffineOpen_preimage_stdOpen n k j)

/-- `Γ(ℙⁿ_k, D₊(Tᵢ))` is generated by the constants and the `Tₗ/Tᵢ`. -/
private lemma subring_eq_top_preimage_stdOpen (i : Fin (n + 1))
    (T : Subring Γ(projectiveSpaceOver n (Spec (.of k)), tk n k ⁻¹ᵁ stdOpen.{u} i))
    (h₀ : ∀ a : Γ(Spec (.of k), ⊤),
      (pk n k).appLE ⊤ (tk n k ⁻¹ᵁ stdOpen.{u} i)
        (le_of_le_of_eq le_top (Scheme.Hom.preimage_top (pk n k)).symm) a ∈ T)
    (h₁ : ∀ l, (tk n k).appLE (stdOpen i) (tk n k ⁻¹ᵁ stdOpen.{u} i) le_rfl (ratio.{u} i l) ∈ T) :
    T = ⊤ := by
  refine Stacks.AlgebraicGeometry.subring_eq_top_of_pullback_inf _ _ (isAffineOpen_top _)
    (Proj.isAffineOpen_basicOpen _ _ (X_mem_coordGrading_one i) Nat.one_pos)
    (preimage_stdOpen_eq n k i) (le_of_le_of_eq le_top (Scheme.Hom.preimage_top (pk n k)).symm)
    le_rfl
    T h₀ fun b => ?_
  have hT : T.comap ((tk n k).appLE (stdOpen i) (tk n k ⁻¹ᵁ stdOpen.{u} i) le_rfl).hom = ⊤ :=
    subring_eq_top_of_coordFrac_mem i _ h₁
  exact Subring.mem_comap.mp (hT ▸ Subring.mem_top b)

/-- Pulled back along a projection `π : ℙⁿ_k ×_k ℙⁿ_k ⟶ ℙⁿ_k` to the chart `(i, j)`, every
function on `D₊(Tₐ)` is a dehomogenisation, as soon as the coordinates `Tₗ/Tₐ` are. -/
private lemma comap_range_chartHom_k_eq_top (i j a : Fin (n + 1))
    (π : pullback (pk n k) (pk n k) ⟶ projectiveSpaceOver n (Spec (.of k)))
    (hπ : π ≫ pk n k = pullback.fst (pk n k) (pk n k) ≫ pk n k)
    (hle : chart (rk₁ n k) (rk₂ n k) i j ≤ π ⁻¹ᵁ (tk n k ⁻¹ᵁ stdOpen.{u} a))
    (hX : ∀ l, ∃ G, chartHom (rk₁ n k) (rk₂ n k) (κY n k) i j G =
      π.appLE _ _ hle ((tk n k).appLE (stdOpen a) _ le_rfl (ratio.{u} a l))) :
    (chartHom (rk₁ n k) (rk₂ n k) (κY n k) i j).range.comap (π.appLE _ _ hle).hom = ⊤ := by
  refine subring_eq_top_preimage_stdOpen n k a _ (fun c => ?_) hX
  refine ⟨MvPolynomial.C ((Scheme.ΓSpecIso (.of k)).hom c), ?_⟩
  have hκ : κY n k ((Scheme.ΓSpecIso (.of k)).hom c) =
      (pullback.fst (pk n k) (pk n k) ≫ pk n k).appTop c := by
    simp [κY]
  rw [chartHom_C, show (π.appLE _ _ hle) ((pk n k).appLE ⊤ _
      (le_of_le_of_eq le_top (Scheme.Hom.preimage_top (pk n k)).symm) c) =
      (π ≫ pk n k).appLE ⊤ _ (hle.trans (Scheme.Hom.preimage_mono _
        (le_of_le_of_eq le_top (Scheme.Hom.preimage_top (pk n k)).symm))) c from by
      rw [← ConcreteCategory.comp_apply, Scheme.Hom.appLE_comp_appLE],
    Stacks.TwistPullbackPinned.appLE_congr_hom hπ _ _ _ (le_of_le_of_eq le_top
      (Scheme.Hom.preimage_top (pullback.fst (pk n k) (pk n k) ≫ pk n k)).symm),
    Stacks.TwistPullbackPinned.appLE_apply, hκ]
  rfl

/-- **The dehomogenisation at `(i, j)` is surjective on `ℙⁿ_k ×_k ℙⁿ_k`.** -/
private lemma chartHom_k_surjective (i j : Fin (n + 1)) :
    Function.Surjective (chartHom (rk₁ n k) (rk₂ n k) (κY n k) i j) := by
  have le₁ : chart (rk₁ n k) (rk₂ n k) i j ≤
      pullback.fst (pk n k) (pk n k) ⁻¹ᵁ (tk n k ⁻¹ᵁ stdOpen.{u} i) := inf_le_left
  have le₂ : chart (rk₁ n k) (rk₂ n k) i j ≤
      pullback.snd (pk n k) (pk n k) ⁻¹ᵁ (tk n k ⁻¹ᵁ stdOpen.{u} j) := inf_le_right
  refine RingHom.range_eq_top.mp (Stacks.AlgebraicGeometry.subring_eq_top_of_pullback_inf
    (pk n k) (pk n k) (isAffineOpen_preimage_stdOpen n k i) (isAffineOpen_preimage_stdOpen n k j)
    rfl le₁ le₂ _ (fun a => ?_) (fun b => ?_))
  · refine Subring.mem_comap.mp ((comap_range_chartHom_k_eq_top n k i j i _ rfl le₁ fun l =>
      ⟨MvPolynomial.X (Sum.inl ⟨l⟩), ?_⟩) ▸ Subring.mem_top a)
    rw [chartHom_X_inl, ← ConcreteCategory.comp_apply, Scheme.Hom.appLE_comp_appLE]
  · refine Subring.mem_comap.mp ((comap_range_chartHom_k_eq_top n k i j j _
      pullback.condition.symm le₂ fun l => ⟨MvPolynomial.X (Sum.inr ⟨l⟩), ?_⟩) ▸
        Subring.mem_top b)
    rw [chartHom_X_inr, ← ConcreteCategory.comp_apply, Scheme.Hom.appLE_comp_appLE]

end Surjective

section ClosedSubscheme

/-- The charts of a closed subscheme of `ℙⁿ_k ×_k ℙⁿ_k` are affine, hence quasi-compact. -/
private lemma isCompact_chart_comp {n : ℕ} {k : Type u} [CommRing k] {Y : Scheme.{u}}
    (ψ : Y ⟶ pullback (pk.{u} n k) (pk.{u} n k)) [IsClosedImmersion ψ] (i j : Fin (n + 1)) :
    IsCompact (chart (ψ ≫ rk₁ n k) (ψ ≫ rk₂ n k) i j : Set Y) :=
  ((isAffineOpen_chart_k n k i j).preimage ψ).isCompact

/-- **The dehomogenisations are surjective on a closed subscheme of `ℙⁿ_k ×_k ℙⁿ_k`**, whose
`k`-structure `κ` is that of `ℙⁿ_k ×_k ℙⁿ_k` pulled back: the charts are the preimages of those of
`ℙⁿ_k ×_k ℙⁿ_k`, and functions on affine opens extend along a closed immersion. -/
private lemma chartHom_comp_surjective {n : ℕ} {k : Type u} [CommRing k] {Y : Scheme.{u}}
    (ψ : Y ⟶ pullback (pk.{u} n k) (pk.{u} n k)) [IsClosedImmersion ψ] (κ : k →+* Γ(Y, ⊤))
    (hκ : ∀ c, κ c = ψ.appTop (κY n k c))
    (i j : Fin (n + 1)) : Function.Surjective (chartHom (ψ ≫ rk₁ n k) (ψ ≫ rk₂ n k) κ i j) := by
  have hchart : ∀ G, chartHom (ψ ≫ rk₁ n k) (ψ ≫ rk₂ n k) κ i j G =
      ψ.appLE (chart (rk₁ n k) (rk₂ n k) i j) (chart (ψ ≫ rk₁ n k) (ψ ≫ rk₂ n k) i j) le_rfl
        (chartHom (rk₁ n k) (rk₂ n k) (κY n k) i j G) := by
    intro G
    have e := MvPolynomial.ringHom_ext (f := chartHom (ψ ≫ rk₁ n k) (ψ ≫ rk₂ n k) κ i j)
      (g := (ψ.appLE (chart (rk₁ n k) (rk₂ n k) i j) (chart (ψ ≫ rk₁ n k) (ψ ≫ rk₂ n k) i j)
        le_rfl).hom.comp (chartHom (rk₁ n k) (rk₂ n k) (κY n k) i j)) (fun c => ?_) (fun l => ?_)
    · exact congrArg (fun f => f G) e
    · rw [RingHom.comp_apply, chartHom_C, chartHom_C, hκ]
      exact ((Stacks.TwistPullbackPinned.appLE_apply ψ ⊤ _ _ _).symm.trans
        (ConcreteCategory.congr_hom (Scheme.Hom.map_appLE ψ
          (le_rfl : chart (ψ ≫ rk₁ n k) (ψ ≫ rk₂ n k) i j ≤
            ψ ⁻¹ᵁ chart (rk₁ n k) (rk₂ n k) i j)
          (homOfLE le_top).op) (κY n k c)).symm)
    · rcases l with l | l
      · rw [RingHom.comp_apply, chartHom_X_inl, chartHom_X_inl]
        exact (ConcreteCategory.congr_hom (Scheme.Hom.appLE_comp_appLE ψ (rk₁ n k) (stdOpen i)
          (chart (rk₁ n k) (rk₂ n k) i j) _ inf_le_left le_rfl) (ratio i l.down)).symm
      · rw [RingHom.comp_apply, chartHom_X_inr, chartHom_X_inr]
        exact (ConcreteCategory.congr_hom (Scheme.Hom.appLE_comp_appLE ψ (rk₂ n k) (stdOpen j)
          (chart (rk₁ n k) (rk₂ n k) i j) _ inf_le_right le_rfl) (ratio j l.down)).symm
  intro z
  have hs := ψ.app_surjective _ (isAffineOpen_chart_k n k i j)
  rw [Scheme.Hom.app_eq_appLE] at hs
  obtain ⟨y, hy⟩ := hs z
  obtain ⟨G, rfl⟩ := chartHom_k_surjective n k i j y
  exact ⟨G, (hchart G).trans hy⟩

end ClosedSubscheme

section Ideal

open Opposite TopologicalSpace

variable {n : ℕ} {W : Scheme.{u}} (q₁ q₂ : W ⟶ projectiveSpaceAtUniverse.{u} n)
  {k : Type u} [CommRing k] (κ : k →+* Γ(W, ⊤))

/-- The bigraded polynomial ring `k[xₗ, x'ₗ]`. -/
private abbrev BiPoly (n : ℕ) (k : Type u) [CommRing k] : Type u :=
  MvPolynomial (ULift.{u} (Fin (n + 1)) ⊕ ULift.{u} (Fin (n + 1))) k

/-- The bihomogeneous polynomials vanishing on every chart. -/
private noncomputable def vanishingSet : Set (BiPoly n k) :=
  {G | (∃ c, G.IsWeightedHomogeneous (biWeight _ _) c) ∧ ∀ p q, chartHom q₁ q₂ κ p q G = 0}

/-- **The bihomogeneous ideal of `(q₁, q₂)(W)`**: generated by the bihomogeneous polynomials
vanishing on every chart. -/
private noncomputable def vanishingIdeal : Ideal (BiPoly n k) := Ideal.span (vanishingSet q₁ q₂ κ)

private lemma chartHom_eq_zero_of_mem_vanishingIdeal {G : BiPoly n k}
    (hG : G ∈ vanishingIdeal q₁ q₂ κ) (p q : Fin (n + 1)) : chartHom q₁ q₂ κ p q G = 0 := by
  refine Submodule.span_induction (fun x hx => hx.2 p q) (map_zero _) (fun x y _ _ hx hy => ?_)
    (fun a x _ hx => ?_) hG
  · rw [map_add, hx, hy, add_zero]
  · rw [smul_eq_mul, map_mul, hx, mul_zero]

private lemma weightedHomogeneousComponent_mem_vanishingIdeal (m : ℕ × ℕ) (G : BiPoly n k)
    (hG : G ∈ vanishingIdeal q₁ q₂ κ) :
    MvPolynomial.weightedHomogeneousComponent (biWeight _ _) m G ∈ vanishingIdeal q₁ q₂ κ := by
  classical
  let := MvPolynomial.weightedGradedAlgebra k (biWeight (ULift.{u} (Fin (n + 1)))
    (ULift.{u} (Fin (n + 1))))
  refine MvPolynomial.weightedHomogeneousComponent_mem_of_mem k _ ?_ hG m
  refine Ideal.homogeneous_span _ _ fun x hx => ?_
  obtain ⟨c, hc⟩ := hx.1
  exact ⟨c, hc⟩

private lemma isWeightedHomogeneous_X_mul_X (i j : ULift.{u} (Fin (n + 1))) :
    (MvPolynomial.X (Sum.inl i) * MvPolynomial.X (Sum.inr j) : BiPoly n k).IsWeightedHomogeneous
      (biWeight _ _) (1, 1) := by
  have h1 := MvPolynomial.isWeightedHomogeneous_X k (biWeight (ULift.{u} (Fin (n + 1)))
    (ULift.{u} (Fin (n + 1)))) (Sum.inl i)
  have h2 := MvPolynomial.isWeightedHomogeneous_X k (biWeight (ULift.{u} (Fin (n + 1)))
    (ULift.{u} (Fin (n + 1)))) (Sum.inr j)
  exact h1.mul h2

private lemma chartHom_X_mul_X_self (i j : Fin (n + 1)) :
    chartHom q₁ q₂ κ i j (MvPolynomial.X (Sum.inl ⟨i⟩) * MvPolynomial.X (Sum.inr ⟨j⟩)) = 1 := by
  rw [map_mul, chartHom_X_inl_self, chartHom_X_inr_self, one_mul]

/-- The dehomogenisation at `(i, j)` factors through the quotient by the vanishing ideal. -/
private noncomputable def chartHomQuot (i j : Fin (n + 1)) :
    BiPoly n k ⧸ vanishingIdeal q₁ q₂ κ →+* Γ(W, chart q₁ q₂ i j) :=
  Ideal.Quotient.lift _ (chartHom q₁ q₂ κ i j)
    fun _ hG => chartHom_eq_zero_of_mem_vanishingIdeal q₁ q₂ κ hG i j

/-- The element `xᵢ x'ⱼ` of the quotient ring. -/
private noncomputable abbrev uQ (i j : Fin (n + 1)) : BiPoly n k ⧸ vanishingIdeal q₁ q₂ κ :=
  Ideal.Quotient.mk (vanishingIdeal q₁ q₂ κ)
    (MvPolynomial.X (Sum.inl ⟨i⟩) * MvPolynomial.X (Sum.inr ⟨j⟩))

/-- The dehomogenisation at `(i, j)` on the localization away from `xᵢ x'ⱼ`. -/
private noncomputable def chartHomLoc (i j : Fin (n + 1)) :
    Localization.Away (uQ q₁ q₂ κ i j) →+* Γ(W, chart q₁ q₂ i j) :=
  IsLocalization.Away.lift (uQ q₁ q₂ κ i j) (g := chartHomQuot q₁ q₂ κ i j) (by
    rw [chartHomQuot, Ideal.Quotient.lift_mk, chartHom_X_mul_X_self]
    exact isUnit_one)

private lemma chartHomLoc_algebraMap (i j : Fin (n + 1)) (G : BiPoly n k) :
    chartHomLoc q₁ q₂ κ i j (algebraMap _ (Localization.Away (uQ q₁ q₂ κ i j))
      (Ideal.Quotient.mk (vanishingIdeal q₁ q₂ κ) G)) = chartHom q₁ q₂ κ i j G :=
  (IsLocalization.Away.lift_eq _ _ _).trans (Ideal.Quotient.lift_mk _ _ _)

private lemma chartHomLoc_mk (i j : Fin (n + 1)) (G : BiPoly n k) (m : ℕ) :
    chartHomLoc q₁ q₂ κ i j (Localization.mk (Ideal.Quotient.mk (vanishingIdeal q₁ q₂ κ) G)
      (⟨_, m, rfl⟩ : Submonoid.powers (uQ q₁ q₂ κ i j))) = chartHom q₁ q₂ κ i j G := by
  have h : Localization.mk (Ideal.Quotient.mk (vanishingIdeal q₁ q₂ κ) G)
      (⟨_, m, rfl⟩ : Submonoid.powers (uQ q₁ q₂ κ i j)) *
      algebraMap _ (Localization.Away (uQ q₁ q₂ κ i j)) (uQ q₁ q₂ κ i j ^ m) =
      algebraMap _ (Localization.Away (uQ q₁ q₂ κ i j))
        (Ideal.Quotient.mk (vanishingIdeal q₁ q₂ κ) G) := by
    rw [← Localization.mk_one_eq_algebraMap, ← Localization.mk_one_eq_algebraMap,
      Localization.mk_mul]
    refine Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq ?_)
    simp only [OneMemClass.coe_one, mul_one, one_mul]
    ring
  have h' := congrArg (chartHomLoc q₁ q₂ κ i j) h
  rw [map_mul, chartHomLoc_algebraMap, show uQ q₁ q₂ κ i j ^ m = Ideal.Quotient.mk _
    ((MvPolynomial.X (Sum.inl ⟨i⟩) * MvPolynomial.X (Sum.inr ⟨j⟩)) ^ m) from (map_pow _ _ _).symm,
    chartHomLoc_algebraMap, map_pow, chartHom_X_mul_X_self, one_pow, mul_one] at h'
  exact h'

end Ideal

section Homogenize

open Opposite TopologicalSpace

variable {n : ℕ} {W : Scheme.{u}} (q₁ q₂ : W ⟶ projectiveSpaceAtUniverse.{u} n)
  {k : Type u} [CommRing k] (κ : k →+* Γ(W, ⊤))

private lemma isWeightedHomogeneous_X_inl_pow (i : ULift.{u} (Fin (n + 1))) (e : ℕ) :
    (MvPolynomial.X (Sum.inl i) ^ e : BiPoly n k).IsWeightedHomogeneous (biWeight _ _) (e, 0) := by
  have := (MvPolynomial.isWeightedHomogeneous_X k (biWeight (ULift.{u} (Fin (n + 1)))
    (ULift.{u} (Fin (n + 1)))) (Sum.inl i)).pow e
  simpa using this

private lemma isWeightedHomogeneous_X_inr_pow (i : ULift.{u} (Fin (n + 1))) (e : ℕ) :
    (MvPolynomial.X (Sum.inr i) ^ e : BiPoly n k).IsWeightedHomogeneous (biWeight _ _) (0, e) := by
  have := (MvPolynomial.isWeightedHomogeneous_X k (biWeight (ULift.{u} (Fin (n + 1)))
    (ULift.{u} (Fin (n + 1)))) (Sum.inr i)).pow e
  simpa using this

/-- Multiplying by powers of `xᵢ` and `x'ⱼ` does not change the dehomogenisation at `(i, j)`. -/
private lemma chartHom_mul_X_pow (i j : Fin (n + 1)) (H : BiPoly n k) (e₁ e₂ : ℕ) :
    chartHom q₁ q₂ κ i j
        (H * MvPolynomial.X (Sum.inl ⟨i⟩) ^ e₁ * MvPolynomial.X (Sum.inr ⟨j⟩) ^ e₂) =
      chartHom q₁ q₂ κ i j H := by
  rw [map_mul, map_mul, map_pow, map_pow, chartHom_X_inl_self, chartHom_X_inr_self, one_pow,
    one_pow, mul_one, mul_one]

/-- Every polynomial has the same dehomogenisation at `(i, j)` as some bihomogeneous one. -/
private lemma exists_isWeightedHomogeneous_chartHom_eq (i j : Fin (n + 1)) (G : BiPoly n k) :
    ∃ c H, H.IsWeightedHomogeneous (biWeight _ _) c ∧
      chartHom q₁ q₂ κ i j H = chartHom q₁ q₂ κ i j G := by
  induction G using MvPolynomial.induction_on with
  | C a => exact ⟨0, MvPolynomial.C a, MvPolynomial.isWeightedHomogeneous_C _ a, rfl⟩
  | add G₁ G₂ h₁ h₂ =>
    obtain ⟨c₁, H₁, hH₁, e₁⟩ := h₁
    obtain ⟨c₂, H₂, hH₂, e₂⟩ := h₂
    refine ⟨c₁ + c₂,
      H₁ * MvPolynomial.X (Sum.inl ⟨i⟩) ^ c₂.1 * MvPolynomial.X (Sum.inr ⟨j⟩) ^ c₂.2 +
      H₂ * MvPolynomial.X (Sum.inl ⟨i⟩) ^ c₁.1 * MvPolynomial.X (Sum.inr ⟨j⟩) ^ c₁.2, ?_, ?_⟩
    · refine MvPolynomial.IsWeightedHomogeneous.add ?_ ?_
      · convert (hH₁.mul (isWeightedHomogeneous_X_inl_pow _ c₂.1)).mul
          (isWeightedHomogeneous_X_inr_pow _ c₂.2) using 1
      · convert (hH₂.mul (isWeightedHomogeneous_X_inl_pow _ c₁.1)).mul
          (isWeightedHomogeneous_X_inr_pow _ c₁.2) using 1
        ext <;> simp [add_comm]
    · rw [map_add, chartHom_mul_X_pow, chartHom_mul_X_pow, e₁, e₂, map_add]
  | mul_X G l h =>
    obtain ⟨c, H, hH, e⟩ := h
    refine ⟨c + biWeight _ _ l, H * MvPolynomial.X l,
      hH.mul (MvPolynomial.isWeightedHomogeneous_X _ _ _), ?_⟩
    rw [map_mul, e, map_mul]

/-- Every polynomial has the same dehomogenisation at `(i, j)` as a bihomogeneous one of bidegree
`(d₁ + m, d₂ + m)` for some `m`. -/
private lemma exists_isWeightedHomogeneous_add_chartHom_eq (i j : Fin (n + 1)) (G : BiPoly n k)
    (d₁ d₂ : ℕ) : ∃ m H, H.IsWeightedHomogeneous (biWeight _ _) (d₁ + m, d₂ + m) ∧
      chartHom q₁ q₂ κ i j H = chartHom q₁ q₂ κ i j G := by
  obtain ⟨c, H, hH, e⟩ := exists_isWeightedHomogeneous_chartHom_eq q₁ q₂ κ i j G
  refine ⟨c.1 + c.2, H * MvPolynomial.X (Sum.inl ⟨i⟩) ^ (d₁ + c.2) *
    MvPolynomial.X (Sum.inr ⟨j⟩) ^ (d₂ + c.1), ?_, by rw [chartHom_mul_X_pow, e]⟩
  convert (hH.mul (isWeightedHomogeneous_X_inl_pow _ (d₁ + c.2))).mul
    (isWeightedHomogeneous_X_inr_pow _ (d₂ + c.1)) using 1
  ext <;> simp <;> omega

/-- A bihomogeneous polynomial whose dehomogenisations vanish where `v` is invertible is, after
multiplication by a power of the bihomogeneous `v`, in the vanishing ideal. -/
private lemma exists_pow_mul_mem_vanishingIdeal
    (hcpt : ∀ p q : Fin (n + 1), IsCompact (chart q₁ q₂ p q : Set W))
    {v D : BiPoly n k} {cv cD : ℕ × ℕ} (hv : v.IsWeightedHomogeneous (biWeight _ _) cv)
    (hD : D.IsWeightedHomogeneous (biWeight _ _) cD)
    (h : ∀ p q, W.presheaf.map (homOfLE (W.basicOpen_le (chartHom q₁ q₂ κ p q v))).op
      (chartHom q₁ q₂ κ p q D) = 0) :
    ∃ N, v ^ N * D ∈ vanishingIdeal q₁ q₂ κ := by
  have hN : ∀ p q : Fin (n + 1), ∃ N, chartHom q₁ q₂ κ p q v ^ N * chartHom q₁ q₂ κ p q D = 0 :=
    fun p q => exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isCompact W (hcpt p q) _ _
      (h p q)
  choose N hN using hN
  refine ⟨∑ p, ∑ q, N p q, Ideal.subset_span ⟨⟨_, (hv.pow _).mul hD⟩, fun p q => ?_⟩⟩
  have hle : N p q ≤ ∑ p, ∑ q, N p q :=
    (Finset.single_le_sum (f := fun q => N p q) (fun _ _ => Nat.zero_le _)
      (Finset.mem_univ q)).trans (Finset.single_le_sum (f := fun p => ∑ q, N p q)
        (fun _ _ => Nat.zero_le _) (Finset.mem_univ p))
  rw [map_mul, map_pow, ← Nat.sub_add_cancel hle, pow_add, mul_assoc, hN, mul_zero]

end Homogenize

section LocalizationAlgebra

/-- Two fractions `a / xᵐ` and `b / yᵐ'` agree in the localization away from `xy` as soon as
`(xy)ᴺ (a yᵐ' - b xᵐ) = 0`. -/
private lemma awayToAwayRight_mk_eq_awayToAwayLeft_mk {A : Type*} [CommRing A] (x y a b : A)
    (m m' : ℕ) (h : ∃ N, (x * y) ^ N * (a * y ^ m' - b * x ^ m) = 0) :
    IsLocalization.Away.awayToAwayRight (P := Localization.Away (x * y)) x y
        (Localization.mk a (⟨x ^ m, m, rfl⟩ : Submonoid.powers x)) =
      IsLocalization.Away.awayToAwayLeft (P := Localization.Away (x * y)) y x
        (Localization.mk b (⟨y ^ m', m', rfl⟩ : Submonoid.powers y)) := by
  set P := Localization.Away (x * y)
  have hxy : IsUnit (algebraMap A P (x * y)) := IsLocalization.Away.algebraMap_isUnit (x * y)
  rw [map_mul] at hxy
  have hx : IsUnit (algebraMap A P x) := isUnit_of_mul_isUnit_left hxy
  have hy : IsUnit (algebraMap A P y) := isUnit_of_mul_isUnit_right hxy
  have key : ∀ (z c : A) (e : ℕ),
      Localization.mk c (⟨z ^ e, e, rfl⟩ : Submonoid.powers z) *
        algebraMap A (Localization.Away z) (z ^ e) = algebraMap A (Localization.Away z) c := by
    intro z c e
    rw [← Localization.mk_one_eq_algebraMap, ← Localization.mk_one_eq_algebraMap,
      Localization.mk_mul]
    refine Localization.mk_eq_mk_iff.mpr (Localization.r_of_eq ?_)
    simp only [OneMemClass.coe_one, mul_one, one_mul]
    ring
  have hL := congrArg (IsLocalization.Away.awayToAwayRight (P := P) x y) (key x a m)
  have hR := congrArg (IsLocalization.Away.awayToAwayLeft (P := P) y x) (key y b m')
  rw [map_mul, IsLocalization.Away.awayToAwayRight_eq, IsLocalization.Away.awayToAwayRight_eq]
    at hL
  rw [map_mul, IsLocalization.Away.awayToAwayLeft_eq, IsLocalization.Away.awayToAwayLeft_eq]
    at hR
  obtain ⟨N, hN⟩ := h
  have heq : algebraMap A P (a * y ^ m') = algebraMap A P (b * x ^ m) := by
    refine (IsLocalization.eq_iff_exists (Submonoid.powers (x * y)) P).mpr
      ⟨⟨_, N, rfl⟩, ?_⟩
    simpa [mul_sub, sub_eq_zero] using hN
  have hunit : IsUnit (algebraMap A P (x ^ m * y ^ m')) := by
    rw [map_mul, map_pow, map_pow]
    exact (hx.pow m).mul (hy.pow m')
  refine hunit.mul_left_injective ?_
  rw [map_pow] at hL hR
  simp only [map_mul, map_pow] at heq hunit ⊢
  linear_combination (algebraMap A P y ^ m') * hL - (algebraMap A P x ^ m) * hR + heq

end LocalizationAlgebra

section Glue

open Opposite TopologicalSpace

variable {n : ℕ} {W : Scheme.{u}} (q₁ q₂ : W ⟶ projectiveSpaceAtUniverse.{u} n)
  {k : Type u} [CommRing k] (κ : k →+* Γ(W, ⊤)) (d₁ d₂ : ℕ)

private lemma res_res_mod (M : W.Modules) {U V O : W.Opens} (h : U ≤ V) (h' : V ≤ O)
    (x : Γ(M, O)) :
    M.presheaf.map (homOfLE h).op (M.presheaf.map (homOfLE h').op x) =
      M.presheaf.map (homOfLE (h.trans h')).op x := by
  rw [← Functor.map_comp_apply]
  rfl

private lemma res_res_ring {U V O : W.Opens} (h : U ≤ V) (h' : V ≤ O) (x : Γ(W, O)) :
    W.presheaf.map (homOfLE h).op (W.presheaf.map (homOfLE h').op x) =
      W.presheaf.map (homOfLE (h.trans h')).op x := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

private lemma prod_pow_powIndex {R : Type*} [CommMonoid R] (f : Fin (n + 1) → R) (i : Fin (n + 1))
    (d : ℕ) : ∏ l, f l ^ ((powIndex.{u} i d).1 ⟨l⟩) = f i ^ d := by
  classical
  rw [Finset.prod_eq_single i]
  · simp [powIndex]
  · intro l _ hl
    simp [powIndex, Ne.symm hl]
  · simp

variable {d₁ d₂} in
/-- A family of global sections of a module `M` on `W`, indexed by the bihomogeneous monomials
`T^a T'^b` of bidegree `(d₁, d₂)`, that behaves on the charts as the restrictions of these
monomials along `(q₁, q₂)` do: on an open `U` of the chart `(i, j)` the section of `T^a T'^b` is
`∏ (Tₗ/Tᵢ)^{aₗ} ∏ (T'ₗ/T'ⱼ)^{bₗ}` times that of `Tᵢ^{d₁} T'ⱼ^{d₂}`, and the latter is a basis of
`M` over `U`. -/
private structure IsChartMonomialFamily (M : W.Modules)
    (sec : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ) → Γ(M, ⊤)) : Prop where
  res (i j : Fin (n + 1)) (e : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ))
      (U : W.Opens) (hU : U ≤ chart q₁ q₂ i j) :
    M.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (sec e) =
      ((∏ l, q₁.appLE (stdOpen i) U (hU.trans inf_le_left) (ratio.{u} i l) ^ (e.1.1 ⟨l⟩)) *
        (∏ l, q₂.appLE (stdOpen j) U (hU.trans inf_le_right) (ratio.{u} j l) ^ (e.2.1 ⟨l⟩))) •
        M.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op (sec (powIndex.{u} i d₁, powIndex.{u} j d₂))
  bijective (i j : Fin (n + 1)) {V : W.Opens} (hV : V ≤ chart q₁ q₂ i j) :
    Function.Bijective fun g : Γ(W, V) =>
      g • M.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (sec (powIndex.{u} i d₁, powIndex.{u} j d₂))

variable {q₁ q₂ d₁ d₂} {M : W.Modules}
  {sec : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ) → Γ(M, ⊤)}

/-- **The gluing relation.** If the restrictions of a section `s` to the charts `(i, j)` and
`(i', j')` are `g • Tᵢ^{d₁}T'ⱼ^{d₂}` and `g' • Tᵢ'^{d₁}T'ⱼ'^{d₂}`, then on the overlap
`g = g' (Tᵢ'/Tᵢ)^{d₁} (T'ⱼ'/T'ⱼ)^{d₂}`. -/
private lemma IsChartMonomialFamily.res_eq_of_res_smul
    (hsec : IsChartMonomialFamily q₁ q₂ M sec) (s : Γ(M, ⊤))
    {i j i' j' : Fin (n + 1)} (g : Γ(W, chart q₁ q₂ i j)) (g' : Γ(W, chart q₁ q₂ i' j'))
    (hg : g • M.presheaf.map (homOfLE (le_top : chart q₁ q₂ i j ≤ ⊤)).op
        (sec (powIndex.{u} i d₁, powIndex.{u} j d₂)) =
      M.presheaf.map (homOfLE (le_top : chart q₁ q₂ i j ≤ ⊤)).op s)
    (hg' : g' • M.presheaf.map (homOfLE (le_top : chart q₁ q₂ i' j' ≤ ⊤)).op
        (sec (powIndex.{u} i' d₁, powIndex.{u} j' d₂)) =
      M.presheaf.map (homOfLE (le_top : chart q₁ q₂ i' j' ≤ ⊤)).op s) :
    W.presheaf.map (homOfLE (inf_le_left : chart q₁ q₂ i j ⊓ chart q₁ q₂ i' j' ≤ _)).op g =
      W.presheaf.map (homOfLE (inf_le_right : chart q₁ q₂ i j ⊓ chart q₁ q₂ i' j' ≤ _)).op g' *
        W.presheaf.map (homOfLE (inf_le_left : chart q₁ q₂ i j ⊓ chart q₁ q₂ i' j' ≤ _)).op
          (frac₁ q₁ q₂ i j i') ^ d₁ *
        W.presheaf.map (homOfLE (inf_le_left : chart q₁ q₂ i j ⊓ chart q₁ q₂ i' j' ≤ _)).op
          (frac₂ q₁ q₂ i j j') ^ d₂ := by
  set O := chart q₁ q₂ i j ⊓ chart q₁ q₂ i' j'
  have hO : O ≤ chart q₁ q₂ i j := inf_le_left
  have hO' : O ≤ chart q₁ q₂ i' j' := inf_le_right
  refine (hsec.bijective i j hO).injective ?_
  dsimp only
  have e1 := congrArg (M.presheaf.map (homOfLE hO).op) hg
  have e2 := congrArg (M.presheaf.map (homOfLE hO').op) hg'
  rw [Scheme.Modules.map_smul, res_res_mod, res_res_mod] at e1 e2
  rw [e1, ← e2, hsec.res i j _ O hO, smul_smul, prod_pow_powIndex,
    prod_pow_powIndex]
  congr 1
  rw [frac₁, frac₂, res_appLE q₁ le_rfl hO inf_le_left (hO.trans inf_le_left),
    res_appLE q₂ le_rfl hO inf_le_right (hO.trans inf_le_right)]
  simp only [homOfLE_refl, op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply]
  ring

private lemma weight_biWeight_fst (μ : ULift.{u} (Fin (n + 1)) ⊕ ULift.{u} (Fin (n + 1)) →₀ ℕ) :
    (Finsupp.weight (biWeight _ _) μ).1 = ∑ l, μ (Sum.inl l) := by
  rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp), Prod.fst_sum,
    Fintype.sum_sum_type]
  simp

private lemma weight_biWeight_snd (μ : ULift.{u} (Fin (n + 1)) ⊕ ULift.{u} (Fin (n + 1)) →₀ ℕ) :
    (Finsupp.weight (biWeight _ _) μ).2 = ∑ l, μ (Sum.inr l) := by
  rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp), Prod.snd_sum,
    Fintype.sum_sum_type]
  simp

/-- The first half of a monomial of bidegree `(d₁, ·)`, as a monomial index of degree `d₁`. -/
private noncomputable def splitFst (d : ℕ)
    (μ : ULift.{u} (Fin (n + 1)) ⊕ ULift.{u} (Fin (n + 1)) →₀ ℕ) : MonomialIndex.{u} n (d : ℤ) :=
  if h : (Finsupp.sumFinsuppEquivProdFinsupp μ).1.degree = d then ⟨_, by exact_mod_cast h⟩
  else powIndex.{u} 0 d

/-- The second half of a monomial of bidegree `(·, d₂)`. -/
private noncomputable def splitSnd (d : ℕ)
    (μ : ULift.{u} (Fin (n + 1)) ⊕ ULift.{u} (Fin (n + 1)) →₀ ℕ) : MonomialIndex.{u} n (d : ℤ) :=
  if h : (Finsupp.sumFinsuppEquivProdFinsupp μ).2.degree = d then ⟨_, by exact_mod_cast h⟩
  else powIndex.{u} 0 d

private lemma splitFst_apply {d : ℕ} {μ : ULift.{u} (Fin (n + 1)) ⊕ ULift.{u} (Fin (n + 1)) →₀ ℕ}
    (h : (Finsupp.weight (biWeight _ _) μ).1 = d) (l : ULift.{u} (Fin (n + 1))) :
    (splitFst d μ).1 l = μ (Sum.inl l) := by
  have h' : (Finsupp.sumFinsuppEquivProdFinsupp μ).1.degree = d := by
    rw [Finsupp.degree_eq_sum, ← h, weight_biWeight_fst]
    simp
  rw [splitFst, dite_eq_left h']
  exact Finsupp.fst_sumFinsuppEquivProdFinsupp μ l

private lemma splitSnd_apply {d : ℕ} {μ : ULift.{u} (Fin (n + 1)) ⊕ ULift.{u} (Fin (n + 1)) →₀ ℕ}
    (h : (Finsupp.weight (biWeight _ _) μ).2 = d) (l : ULift.{u} (Fin (n + 1))) :
    (splitSnd d μ).1 l = μ (Sum.inr l) := by
  have h' : (Finsupp.sumFinsuppEquivProdFinsupp μ).2.degree = d := by
    rw [Finsupp.degree_eq_sum, ← h, weight_biWeight_snd]
    simp
  rw [splitSnd, dite_eq_left h']
  exact Finsupp.snd_sumFinsuppEquivProdFinsupp μ l

/-- The dehomogenisation of a monomial. -/
private lemma chartHom_monomial (i j : Fin (n + 1))
    (μ : ULift.{u} (Fin (n + 1)) ⊕ ULift.{u} (Fin (n + 1)) →₀ ℕ) (c : k) :
    chartHom q₁ q₂ κ i j (MvPolynomial.monomial μ c) =
      W.presheaf.map (homOfLE le_top).op (κ c) *
        ((∏ l : Fin (n + 1), frac₁ q₁ q₂ i j l ^ μ (Sum.inl ⟨l⟩)) *
          ∏ l : Fin (n + 1), frac₂ q₁ q₂ i j l ^ μ (Sum.inr ⟨l⟩)) := by
  rw [chartHom, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_monomial,
    Finsupp.prod_fintype _ _ (by simp), Fintype.prod_sum_type]
  simp only [Sum.elim_inl, Sum.elim_inr, RingHom.coe_comp, Function.comp_apply]
  congr 2
  · exact Fintype.prod_equiv Equiv.ulift _ _ (fun _ => rfl)
  · exact Fintype.prod_equiv Equiv.ulift _ _ (fun _ => rfl)

variable (sec) in
/-- The section attached to a form of bidegree `(d₁, d₂)`, a `k`-linear combination of the
sections `sec` of the monomials. -/
private noncomputable def formSection (F : BiPoly n k) : Γ(M, ⊤) :=
  ∑ μ ∈ F.support, κ (F.coeff μ) • sec (splitFst d₁ μ, splitSnd d₂ μ)

/-- **On a chart, the section of a form is its dehomogenisation times `Tᵢ^{d₁}T'ⱼ^{d₂}`.** -/
private lemma IsChartMonomialFamily.res_formSection (hsec : IsChartMonomialFamily q₁ q₂ M sec)
    (i j : Fin (n + 1)) {F : BiPoly n k} (hF : F.IsWeightedHomogeneous (biWeight _ _) (d₁, d₂)) :
    M.presheaf.map (homOfLE (le_top : chart q₁ q₂ i j ≤ ⊤)).op (formSection κ sec F) =
      chartHom q₁ q₂ κ i j F • M.presheaf.map (homOfLE (le_top : chart q₁ q₂ i j ≤ ⊤)).op
        (sec (powIndex.{u} i d₁, powIndex.{u} j d₂)) := by
  conv_rhs => rw [F.as_sum, map_sum, Finset.sum_smul]
  rw [formSection, map_sum]
  refine Finset.sum_congr rfl fun μ hμ => ?_
  have hw := hF (MvPolynomial.mem_support_iff.mp hμ)
  rw [Scheme.Modules.map_smul, hsec.res i j _ _ le_rfl, smul_smul,
    chartHom_monomial]
  congr 2
  congr 1
  · refine Finset.prod_congr rfl fun l _ => ?_
    rw [splitFst_apply (by rw [hw])]
  · refine Finset.prod_congr rfl fun l _ => ?_
    rw [splitSnd_apply (by rw [hw])]

/-- **The cocycle condition in the polynomial ring.** If `aᵢⱼ` of bidegree `(d₁ + mᵢⱼ, d₂ + mᵢⱼ)`
dehomogenise to the coefficients `gᵢⱼ` of a section on the charts, then
`(uu')ᴺ (aᵢⱼ u'^{m'} - aᵢ'ⱼ' u^{m})` lies in the vanishing ideal for some `N`, where
`u = xᵢx'ⱼ` and `u' = xᵢ'x'ⱼ'`. -/
private lemma IsChartMonomialFamily.exists_pow_mul_sub_mem_vanishingIdeal
    (hsec : IsChartMonomialFamily q₁ q₂ M sec)
    (hcpt : ∀ p q : Fin (n + 1), IsCompact (chart q₁ q₂ p q : Set W)) (s : Γ(M, ⊤))
    (g : ∀ i j : Fin (n + 1), Γ(W, chart q₁ q₂ i j))
    (hg : ∀ i j, g i j • M.presheaf.map (homOfLE (le_top : chart q₁ q₂ i j ≤ ⊤)).op
        (sec (powIndex.{u} i d₁, powIndex.{u} j d₂)) =
      M.presheaf.map (homOfLE (le_top : chart q₁ q₂ i j ≤ ⊤)).op s)
    (m : Fin (n + 1) → Fin (n + 1) → ℕ) (a : Fin (n + 1) → Fin (n + 1) → BiPoly n k)
    (ha : ∀ i j, (a i j).IsWeightedHomogeneous (biWeight _ _) (d₁ + m i j, d₂ + m i j))
    (hga : ∀ i j, chartHom q₁ q₂ κ i j (a i j) = g i j) (i j i' j' : Fin (n + 1)) :
    ∃ N, ((MvPolynomial.X (Sum.inl ⟨i⟩) * MvPolynomial.X (Sum.inr ⟨j⟩)) *
        (MvPolynomial.X (Sum.inl ⟨i'⟩) * MvPolynomial.X (Sum.inr ⟨j'⟩))) ^ N *
      (a i j * (MvPolynomial.X (Sum.inl ⟨i'⟩) * MvPolynomial.X (Sum.inr ⟨j'⟩)) ^ m i' j' -
        a i' j' * (MvPolynomial.X (Sum.inl ⟨i⟩) * MvPolynomial.X (Sum.inr ⟨j⟩)) ^ m i j) ∈
      vanishingIdeal q₁ q₂ κ := by
  set u : BiPoly n k := MvPolynomial.X (Sum.inl ⟨i⟩) * MvPolynomial.X (Sum.inr ⟨j⟩) with hu
  set u' : BiPoly n k := MvPolynomial.X (Sum.inl ⟨i'⟩) * MvPolynomial.X (Sum.inr ⟨j'⟩) with hu'
  have hU : u.IsWeightedHomogeneous (biWeight _ _) (1, 1) := isWeightedHomogeneous_X_mul_X _ _
  have hU' : u'.IsWeightedHomogeneous (biWeight _ _) (1, 1) := isWeightedHomogeneous_X_mul_X _ _
  have hD : (a i j * u' ^ m i' j' - a i' j' * u ^ m i j).IsWeightedHomogeneous (biWeight _ _)
      (d₁ + m i j + m i' j', d₂ + m i j + m i' j') := by
    refine MvPolynomial.IsWeightedHomogeneous.sub ?_ ?_
    · convert (ha i j).mul (hU'.pow (m i' j')) using 1
      ext <;> simp
    · convert (ha i' j').mul (hU.pow (m i j)) using 1
      ext <;> simp <;> ring
  refine exists_pow_mul_mem_vanishingIdeal q₁ q₂ κ hcpt (hU.mul hU') hD fun p q => ?_
  set O := chart q₁ q₂ i j ⊓ chart q₁ q₂ i' j'
  set B := W.basicOpen (chartHom q₁ q₂ κ p q (u * u'))
  have hBO : B ≤ O := by
    intro x hx
    simp only [B, hu, hu', map_mul, Scheme.basicOpen_mul, basicOpen_chartHom_X_inl,
      basicOpen_chartHom_X_inr] at hx
    simp only [O, chart, TopologicalSpace.Opens.mem_inf] at hx ⊢
    tauto
  have hBpq : B ≤ chart q₁ q₂ p q ⊓ chart q₁ q₂ i j :=
    le_inf (W.basicOpen_le _) (hBO.trans inf_le_left)
  -- the dehomogenisation at `(i, j)` vanishes on the overlap
  have hz : W.presheaf.map (homOfLE (inf_le_left : O ≤ chart q₁ q₂ i j)).op
      (chartHom q₁ q₂ κ i j (a i j * u' ^ m i' j' - a i' j' * u ^ m i j)) = 0 := by
    have key2 := res_chartHom_of_isWeightedHomogeneous q₁ q₂ κ i j i' j' (ha i' j')
    have rel := hsec.res_eq_of_res_smul s (g i j) (g i' j') (hg i j) (hg i' j')
    rw [map_sub, map_mul, map_mul, map_pow, map_pow, hu, chartHom_X_mul_X_self, one_pow, mul_one,
      hga, hu', map_mul, chartHom_X_inl, chartHom_X_inr, map_sub, map_mul, map_pow, map_mul, key2,
      hga, rel]
    ring
  calc W.presheaf.map (homOfLE (W.basicOpen_le _)).op (chartHom q₁ q₂ κ p q _) =
      W.presheaf.map (homOfLE hBpq).op (W.presheaf.map (homOfLE inf_le_left).op
        (chartHom q₁ q₂ κ p q (a i j * u' ^ m i' j' - a i' j' * u ^ m i j))) :=
        (res_res_ring _ _ _).symm
    _ = W.presheaf.map (homOfLE hBO).op (W.presheaf.map (homOfLE (inf_le_left : O ≤ _)).op
        (chartHom q₁ q₂ κ i j (a i j * u' ^ m i' j' - a i' j' * u ^ m i j))) *
        W.presheaf.map (homOfLE hBpq).op (W.presheaf.map (homOfLE inf_le_left).op
          (frac₁ q₁ q₂ p q i) ^ (d₁ + m i j + m i' j')) *
        W.presheaf.map (homOfLE hBpq).op (W.presheaf.map (homOfLE inf_le_left).op
          (frac₂ q₁ q₂ p q j) ^ (d₂ + m i j + m i' j')) := by
        rw [res_chartHom_of_isWeightedHomogeneous q₁ q₂ κ p q i j hD, map_mul, map_mul,
          res_res_ring, res_res_ring]
    _ = 0 := by rw [hz, map_zero, zero_mul, zero_mul]

end Glue

section Main

open Opposite TopologicalSpace

variable {n : ℕ} {W : Scheme.{u}} (q₁ q₂ : W ⟶ projectiveSpaceAtUniverse.{u} n)
  {k : Type u} [Field k] (κ : k →+* Γ(W, ⊤))

/-- **Sections in high bidegree are restrictions of forms**, for a pair `q₁, q₂ : W ⟶ ℙⁿ_ℤ` whose
charts `q₁⁻¹D₊(Tᵢ) ⊓ q₂⁻¹D₊(Tⱼ)` (which cover `W`) are quasi-compact and have their functions
generated by the constants (through `κ`) and the coordinates `Tₗ/Tᵢ`, `T'ₗ/T'ⱼ`: this is the
situation of a closed subscheme of `ℙⁿ_k ×_k ℙⁿ_k`. For `δ₁, δ₂` large, every family of sections
indexed by the monomials of bidegree `(δ₁, δ₂)` that behaves on the charts as their restrictions
do spans the global sections over `k`. -/
private theorem span_eq_top_of_charts
    (hsurj : ∀ i j, Function.Surjective (chartHom q₁ q₂ κ i j))
    (hcpt : ∀ p q : Fin (n + 1), IsCompact (chart q₁ q₂ p q : Set W)) :
    ∃ δ₀ : ℕ, ∀ δ₁ δ₂ : ℕ, δ₀ ≤ δ₁ → δ₀ ≤ δ₂ → ∀ (M : W.Modules)
      (sec : MonomialIndex.{u} n (δ₁ : ℤ) × MonomialIndex.{u} n (δ₂ : ℤ) → Γ(M, ⊤)),
      IsChartMonomialFamily q₁ q₂ M sec →
      letI : Module k Γ(M, ⊤) := Module.compHom _ κ
      Submodule.span k (Set.range sec) = ⊤ := by
  classical
  obtain ⟨δ₀, hδ₀⟩ := Faltings.exists_isWeightedHomogeneous_restrict_eq_of_compatible k
    (ULift.{u} (Fin (n + 1))) (ULift.{u} (Fin (n + 1))) (vanishingIdeal q₁ q₂ κ)
    (fun m p hp => weightedHomogeneousComponent_mem_vanishingIdeal q₁ q₂ κ m p hp)
  refine ⟨δ₀, fun δ₁ δ₂ h1 h2 M sec hsec => ?_⟩
  let : Module k Γ(M, ⊤) := Module.compHom _ κ
  rw [eq_top_iff]
  rintro s -
  have hgex : ∀ i j : Fin (n + 1), ∃ g : Γ(W, chart q₁ q₂ i j),
      g • M.presheaf.map (homOfLE (le_top : chart q₁ q₂ i j ≤ ⊤)).op
        (sec (powIndex.{u} i δ₁, powIndex.{u} j δ₂)) =
      M.presheaf.map (homOfLE (le_top : chart q₁ q₂ i j ≤ ⊤)).op s :=
    fun i j => (hsec.bijective i j le_rfl).surjective _
  choose g hg using hgex
  have hex : ∀ i j : Fin (n + 1), ∃ (m : ℕ) (a : BiPoly n k),
      a.IsWeightedHomogeneous (biWeight _ _) (δ₁ + m, δ₂ + m) ∧
        chartHom q₁ q₂ κ i j a = g i j := by
    intro i j
    obtain ⟨G, hG⟩ := hsurj i j (g i j)
    obtain ⟨m, H, hH, e⟩ := exists_isWeightedHomogeneous_add_chartHom_eq q₁ q₂ κ i j G δ₁ δ₂
    exact ⟨m, H, hH, e.trans hG⟩
  choose m a ha hga using hex
  obtain ⟨F, hF, hFs⟩ := hδ₀ δ₁ δ₂ h1 h2
    (fun i j => Localization.mk (Ideal.Quotient.mk _ (a i.down j.down))
      ⟨_, m i.down j.down, rfl⟩)
    (fun i j => ⟨a i.down j.down, m i.down j.down, ha _ _, rfl⟩)
    (fun i j i' j' => by
      refine awayToAwayRight_mk_eq_awayToAwayLeft_mk _ _ _ _ _ _ ?_
      obtain ⟨N, hN⟩ := hsec.exists_pow_mul_sub_mem_vanishingIdeal κ hcpt s g hg m a ha
        hga i.down j.down i'.down j'.down
      refine ⟨N, ?_⟩
      have := (Ideal.Quotient.eq_zero_iff_mem (I := vanishingIdeal q₁ q₂ κ)).mpr hN
      simpa only [map_mul, map_pow, map_sub] using this)
  have hFg : ∀ i j : Fin (n + 1), chartHom q₁ q₂ κ i j F = g i j := by
    intro i j
    have := congrArg (chartHomLoc q₁ q₂ κ i j) (hFs ⟨i⟩ ⟨j⟩)
    rwa [chartHomLoc_algebraMap, chartHomLoc_mk, hga] at this
  have hsF : s = formSection κ sec F := by
    let Fsh : TopCat.Sheaf Ab.{u} W := ⟨M.presheaf, M.isSheaf⟩
    refine Fsh.eq_of_locally_eq' (fun ij : Fin (n + 1) × Fin (n + 1) => chart q₁ q₂ ij.1 ij.2) ⊤
      (fun _ => homOfLE le_top) ?_ _ _ fun ij => ?_
    · intro x _
      obtain ⟨i, j, h⟩ := exists_mem_chart q₁ q₂ x
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨(i, j), h⟩
    · change M.presheaf.map (homOfLE (le_top : chart q₁ q₂ ij.1 ij.2 ≤ ⊤)).op s =
        M.presheaf.map (homOfLE (le_top : chart q₁ q₂ ij.1 ij.2 ≤ ⊤)).op (formSection κ sec F)
      rw [hsec.res_formSection κ ij.1 ij.2 hF, hFg]
      exact (hg _ _).symm
  rw [hsF, formSection]
  exact Submodule.sum_mem _ fun μ _ =>
    Submodule.smul_mem _ (F.coeff μ) (Submodule.subset_span ⟨_, rfl⟩)

end Main

section MainMonoSec

variable {n : ℕ} {W : Scheme.{u}} (q₁ q₂ : W ⟶ projectiveSpaceAtUniverse.{u} n)
  {k : Type u} [Field k] (κ : k →+* Γ(W, ⊤))
  [∀ d : ℕ, Stacks.Ample.IsInvertibleModule W (twistPullback q₁ d)]
  [∀ d : ℕ, Stacks.Ample.IsInvertibleModule W (twistPullback q₂ d)]

/-- The restrictions `tensorMonoSec` of the bihomogeneous monomials behave on the charts as
monomials do. -/
private lemma isChartMonomialFamily_tensorMonoSec (d₁ d₂ : ℕ) :
    IsChartMonomialFamily q₁ q₂ _ (tensorMonoSec q₁ q₂ d₁ d₂) :=
  ⟨res_tensorMonoSec q₁ q₂ d₁ d₂, bijective_smul_res_tensorMonoSec q₁ q₂ d₁ d₂⟩

/-- **Sections in high bidegree are restrictions of forms**, for a pair `q₁, q₂ : W ⟶ ℙⁿ_ℤ` whose
charts `q₁⁻¹D₊(Tᵢ) ⊓ q₂⁻¹D₊(Tⱼ)` (which cover `W`) are quasi-compact and have their functions
generated by the constants (through `κ`) and the coordinates `Tₗ/Tᵢ`, `T'ₗ/T'ⱼ`: this is the
situation of a closed subscheme of `ℙⁿ_k ×_k ℙⁿ_k`. -/
private theorem span_tensorMonoSec_eq_top_of_charts
    (hsurj : ∀ i j, Function.Surjective (chartHom q₁ q₂ κ i j))
    (hcpt : ∀ p q : Fin (n + 1), IsCompact (chart q₁ q₂ p q : Set W)) :
    ∃ δ₀ : ℕ, ∀ δ₁ δ₂ : ℕ, δ₀ ≤ δ₁ → δ₀ ≤ δ₂ →
      letI : Module k Γ(tensorSheaf (twistPullback q₁ δ₁) (twistPullback q₂ δ₂), ⊤) :=
        Module.compHom _ κ
      Submodule.span k (Set.range (tensorMonoSec q₁ q₂ δ₁ δ₂)) = ⊤ := by
  obtain ⟨δ₀, hδ₀⟩ := span_eq_top_of_charts q₁ q₂ κ hsurj hcpt
  exact ⟨δ₀, fun δ₁ δ₂ h₁ h₂ =>
    hδ₀ δ₁ δ₂ h₁ h₂ _ _ (isChartMonomialFamily_tensorMonoSec q₁ q₂ δ₁ δ₂)⟩

end MainMonoSec

section FormRestriction

open Opposite TopologicalSpace MonoidalCategory
open Stacks.ProjectiveFromSections (resT)
open Stacks.SectionsToProjectiveSpace (coordGrading)

attribute [local instance] Stacks.SheafInternalHom.schemeMonoidalCategory

open scoped Stacks.TensorSectionNonvanishing

variable {n : ℕ} {k : Type u} [Field k] {Y : Scheme.{u}}

/-- The module `ψ^*(pr₁^*𝒪(d₁) ⊗ pr₂^*𝒪(d₂))` on `Y`, for `ψ : Y ⟶ ℙⁿ_k ×_k ℙⁿ_k`: the target of
`vojtaFormRestriction ψ d₁ d₂`. -/
private noncomputable abbrev formSheaf (ψ : Y ⟶ pullback (pk.{u} n k) (pk.{u} n k)) (d₁ d₂ : ℕ) :
    Y.Modules :=
  (Scheme.Modules.pullback ψ).obj
    ((Scheme.Modules.pullback (pullback.fst (pk.{u} n k) (pk n k))).obj
        ((Scheme.Modules.pullback (tk n k)).obj
          (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d₁ : ℤ))) ⊗
      (Scheme.Modules.pullback (pullback.snd (pk.{u} n k) (pk n k))).obj
        ((Scheme.Modules.pullback (tk n k)).obj
          (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d₂ : ℤ))))

/-- The restriction along `ψ : Y ⟶ ℙⁿ_k ×_k ℙⁿ_k` of the bihomogeneous monomial `T^a T'^b`, as a
global section of `ψ^*(pr₁^*𝒪(d₁) ⊗ pr₂^*𝒪(d₂))`; it is the summand of `vojtaFormRestriction`. -/
private noncomputable def formMonoSec (ψ : Y ⟶ pullback (pk.{u} n k) (pk.{u} n k)) (d₁ d₂ : ℕ)
    (e : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ)) :
    Γ(formSheaf ψ d₁ d₂, ⊤) :=
  pullbackGlobalSections ψ _ (Stacks.ProductFamilyTwist.prodSection
    (pullbackGlobalSections (pullback.fst _ _) _
      (pullbackGlobalSections (tk n k) _ (monomialSectionAtUniverse e.1)))
    (pullbackGlobalSections (pullback.snd _ _) _
      (pullbackGlobalSections (tk n k) _ (monomialSectionAtUniverse e.2))))

/-- The pull-back to `ℙⁿ_k ×_k ℙⁿ_k`, along the projection `π`, of `res_monomialSectionAtUniverse`
on the chart `(i, j)`. -/
private lemma resT_pullback_pullback_monomialSection (π : pullback (pk.{u} n k) (pk n k) ⟶
    projectiveSpaceOver n (Spec (.of k))) {i j a : Fin (n + 1)} (d : ℕ)
    (hle : chart (rk₁ n k) (rk₂ n k) i j ≤ π ⁻¹ᵁ (tk n k ⁻¹ᵁ stdOpen.{u} a))
    (e : MonomialIndex.{u} n (d : ℤ)) :
    resT (chart (rk₁ n k) (rk₂ n k) i j) (pullbackGlobalSections π _
        (pullbackGlobalSections (tk n k) _ (monomialSectionAtUniverse e))) =
      (∏ l, (π ≫ tk n k).appLE (stdOpen a) _ hle (ratio.{u} a l) ^ (e.1 ⟨l⟩)) •
        resT (chart (rk₁ n k) (rk₂ n k) i j) (pullbackGlobalSections π _
          (pullbackGlobalSections (tk n k) _ (monomialSectionAtUniverse (powIndex.{u} a d)))) := by
  have h₁ := res_pullbackGlobalSections_smul (tk n k) _ _ _ _
    (res_monomialSectionAtUniverse a d e) _ le_rfl
  have h₂ := res_pullbackGlobalSections_smul π _ _ _ _ h₁ _ hle
  refine h₂.trans ?_
  congr 1
  rw [← ConcreteCategory.comp_apply, Scheme.Hom.appLE_comp_appLE, map_prod]
  simp only [map_pow]

/-- **The restricted monomials behave on the charts as monomials do**, for a closed subscheme
of `ℙⁿ_k ×_k ℙⁿ_k`. -/
private lemma isChartMonomialFamily_formMonoSec (ψ : Y ⟶ pullback (pk.{u} n k) (pk.{u} n k))
    (d₁ d₂ : ℕ) :
    IsChartMonomialFamily (ψ ≫ rk₁ n k) (ψ ≫ rk₂ n k) _ (formMonoSec ψ d₁ d₂) := by
  refine ⟨fun i j e U hU => ?_, fun i j V hV => ?_⟩
  · have h₁ := resT_pullback_pullback_monomialSection (pullback.fst _ _) d₁
      (inf_le_left : chart (rk₁ n k) (rk₂ n k) i j ≤ _) e.1
    have h₂ := resT_pullback_pullback_monomialSection (pullback.snd _ _) d₂
      (inf_le_right : chart (rk₁ n k) (rk₂ n k) i j ≤ _) e.2
    have h := res_pullbackGlobalSections_smul ψ _ _ _ _ (resT_prodSection_eq_smul h₁ h₂) U hU
    refine h.trans ?_
    congr 1
    rw [map_mul, map_prod, map_prod]
    congr 1 <;> refine Finset.prod_congr rfl fun l _ => ?_ <;> rw [map_pow] <;> congr 1
    · exact ConcreteCategory.congr_hom
        (Scheme.Hom.appLE_comp_appLE ψ (rk₁ n k) (stdOpen i) (chart (rk₁ n k) (rk₂ n k) i j) U
          inf_le_left (hU.trans le_rfl)) (ratio i l)
    · exact ConcreteCategory.congr_hom
        (Scheme.Hom.appLE_comp_appLE ψ (rk₂ n k) (stdOpen j) (chart (rk₁ n k) (rk₂ n k) i j) U
          inf_le_right (hU.trans le_rfl)) (ratio j l)
  · have : ∀ (q : pullback (pk.{u} n k) (pk n k) ⟶ projectiveSpaceOver n (Spec (.of k))) (d : ℕ),
        Stacks.Ample.IsInvertibleModule _ ((Scheme.Modules.pullback q).obj
          ((Scheme.Modules.pullback (tk n k)).obj
            (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d : ℤ)))) := fun q d =>
      Stacks.InvertiblePullback.isInvertibleModule_pullback q _
    have := Stacks.InvertiblePullback.isInvertibleModule_pullback ψ
      ((Scheme.Modules.pullback (pullback.fst (pk.{u} n k) (pk n k))).obj
          ((Scheme.Modules.pullback (tk n k)).obj
            (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d₁ : ℤ))) ⊗
        (Scheme.Modules.pullback (pullback.snd (pk.{u} n k) (pk n k))).obj
          ((Scheme.Modules.pullback (tk n k)).obj
            (projectiveSpaceAtUniverseTwistingSheaf.{u} n (d₂ : ℤ))))
    refine Stacks.NonvanishingSpelling.bijective_smul _ _ _ fun y hy => ?_
    have hy' := hV hy
    refine Stacks.TwistPullbackPinned.mem_nonvanishingLocus_pullbackGlobalSections ψ _ _ ?_
    have h := Stacks.ProductFamilyTwist.nvOpen_prodSection
      (pullbackGlobalSections (pullback.fst (pk.{u} n k) (pk n k)) _
        (pullbackGlobalSections (tk n k) _ (monomialSectionAtUniverse (powIndex.{u} i d₁))))
      (pullbackGlobalSections (pullback.snd (pk.{u} n k) (pk n k)) _
        (pullbackGlobalSections (tk n k) _ (monomialSectionAtUniverse (powIndex.{u} j d₂))))
    refine (congrArg (ψ.base y ∈ ·) h).mpr ⟨?_, ?_⟩
    · refine Stacks.TwistPullbackPinned.mem_nonvanishingLocus_pullbackGlobalSections _ _ _ ?_
      refine Stacks.TwistPullbackPinned.mem_nonvanishingLocus_pullbackGlobalSections _ _ _ ?_
      exact mem_nonvanishingLocus_monomialSection_powIndex i d₁ hy'.1
    · refine Stacks.TwistPullbackPinned.mem_nonvanishingLocus_pullbackGlobalSections _ _ _ ?_
      refine Stacks.TwistPullbackPinned.mem_nonvanishingLocus_pullbackGlobalSections _ _ _ ?_
      exact mem_nonvanishingLocus_monomialSection_powIndex j d₂ hy'.2

/-- The bihomogeneous monomial `T^a T'^b` in the variables `x_ν = Sum.inl ν`, `x'_ν = Sum.inr ν`
of `vojtaFormRestriction`. -/
private noncomputable def monoExponent {d₁ d₂ : ℕ}
    (e : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ)) :
    (Fin (n + 1) ⊕ Fin (n + 1)) →₀ ℕ :=
  Finsupp.sumFinsuppEquivProdFinsupp.symm
    (Finsupp.equivMapDomain Equiv.ulift e.1.1, Finsupp.equivMapDomain Equiv.ulift e.2.1)

private lemma comapDomain_inl_monoExponent {d₁ d₂ : ℕ}
    (e : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ)) :
    (monoExponent e).comapDomain Sum.inl Sum.inl_injective.injOn =
      Finsupp.equivMapDomain Equiv.ulift e.1.1 := by
  ext l
  simp [monoExponent]

private lemma comapDomain_inr_monoExponent {d₁ d₂ : ℕ}
    (e : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ)) :
    (monoExponent e).comapDomain Sum.inr Sum.inr_injective.injOn =
      Finsupp.equivMapDomain Equiv.ulift e.2.1 := by
  ext l
  simp [monoExponent]

private lemma degree_equivMapDomain_monomialIndex {d : ℕ} (e : MonomialIndex.{u} n (d : ℤ)) :
    (Finsupp.equivMapDomain Equiv.ulift e.1).degree = d := by
  rw [degree_equivMapDomain_ulift]
  exact_mod_cast e.2

private lemma isWeightedHomogeneous_monomial_monoExponent {d₁ d₂ : ℕ}
    (e : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ)) (c : k) :
    (MvPolynomial.monomial (monoExponent e) c).IsWeightedHomogeneous
      (Sum.elim (fun _ => ((1 : ℕ), (0 : ℕ))) (fun _ => ((0 : ℕ), (1 : ℕ)))) (d₁, d₂) := by
  refine MvPolynomial.isWeightedHomogeneous_monomial _ _ _ ?_
  have h₁ := degree_equivMapDomain_monomialIndex e.1
  have h₂ := degree_equivMapDomain_monomialIndex e.2
  rw [← comapDomain_inl_monoExponent e, Finsupp.degree_eq_sum] at h₁
  rw [← comapDomain_inr_monoExponent e, Finsupp.degree_eq_sum] at h₂
  rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp), Fintype.sum_sum_type]
  ext <;> simp_all [Prod.fst_sum, Prod.snd_sum]

/-- `vojtaFormRestriction` sends the monomial `c T^a T'^b` to `c` times its restriction. -/
private lemma vojtaFormRestriction_monomial_monoExponent
    (ψ : Y ⟶ pullback (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k))
      (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k))) {d₁ d₂ : ℕ}
    (e : MonomialIndex.{u} n (d₁ : ℤ) × MonomialIndex.{u} n (d₂ : ℤ)) (c : Γ(Spec (.of k), ⊤)) :
    vojtaFormRestriction ψ d₁ d₂ (MvPolynomial.monomial (monoExponent e) c) =
      (ψ ≫ pullback.fst _ _ ≫ pk n k).appTop c • formMonoSec ψ d₁ d₂ e := by
  have h : ((monoExponent e).comapDomain Sum.inl Sum.inl_injective.injOn).degree = d₁ ∧
      ((monoExponent e).comapDomain Sum.inr Sum.inr_injective.injOn).degree = d₂ := by
    have h₁ := degree_equivMapDomain_monomialIndex e.1
    have h₂ := degree_equivMapDomain_monomialIndex e.2
    rw [← comapDomain_inl_monoExponent e] at h₁
    rw [← comapDomain_inr_monoExponent e] at h₂
    exact ⟨h₁, h₂⟩
  simp only [vojtaFormRestriction, AddMonoidHom.coe_comp, Function.comp_apply,
    AddEquiv.coe_toAddMonoidHom]
  rw [show AddMonoidAlgebra.coeffAddEquiv (MvPolynomial.monomial (monoExponent e) c) =
    Finsupp.single (monoExponent e) c from rfl, Finsupp.liftAddHom_apply_single]
  simp only [AddMonoidHom.coe_mk, ZeroHom.coe_mk, dite_eq_left h]
  congr 1
  have key : ∀ (d : ℕ) (β : Fin (n + 1) →₀ ℕ) (hβ) (e : MonomialIndex.{u} n (d : ℤ)),
      β = Finsupp.equivMapDomain Equiv.ulift e.1 →
        ProjectiveSpectrum.Proj.degreeSection (coordGrading.{u} n) d
          ⟨MvPolynomial.monomial β 1, hβ⟩ = monomialSectionAtUniverse e := by
    rintro d _ hβ e rfl
    rw [monomialSectionAtUniverse_eq]
    rfl
  delta formMonoSec
  rw [← key d₁ _ (MvPolynomial.isHomogeneous_monomial _ h.1) e.1
      (comapDomain_inl_monoExponent e),
    ← key d₂ _ (MvPolynomial.isHomogeneous_monomial _ h.2) e.2 (comapDomain_inr_monoExponent e)]
  rfl

/-- **Sections in high bidegree are restrictions of forms**, for a closed subscheme of
`ℙⁿ_k ×_k ℙⁿ_k`: for a closed immersion `ψ : Y ⟶ ℙⁿ_k ×_k ℙⁿ_k` there is `δ₀` such that for all
`δ₁, δ₂ ≥ δ₀` every global section of `ψ^*(pr₁^*𝒪(δ₁) ⊗ pr₂^*𝒪(δ₂))` is the restriction
`vojtaFormRestriction ψ δ₁ δ₂ G` of a bihomogeneous form `G` of bidegree `(δ₁, δ₂)` with
coefficients in `k`. -/
theorem exists_surjective_vojtaFormRestriction {Y : Scheme.{u}}
    (ψ : Y ⟶ pullback (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k))
      (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k))) [IsClosedImmersion ψ] :
    ∃ δ₀ : ℕ, ∀ δ₁ δ₂ : ℕ, δ₀ ≤ δ₁ → δ₀ ≤ δ₂ →
      Function.Surjective fun G : MvPolynomial.weightedHomogeneousSubmodule k
          (Sum.elim (fun _ => ((1 : ℕ), (0 : ℕ))) (fun _ => ((0 : ℕ), (1 : ℕ))) :
            Fin (n + 1) ⊕ Fin (n + 1) → ℕ × ℕ) (δ₁, δ₂) =>
        vojtaFormRestriction ψ δ₁ δ₂ (G.1.map (Scheme.ΓSpecIso (.of k)).inv.hom) := by
  classical
  have : IsClosedImmersion (Y := pullback (pk n k) (pk n k)) ψ := ‹_›
  let κ : k →+* Γ(Y, ⊤) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ (ψ ≫ pullback.fst _ _ ≫ pk n k).appTop).hom
  have hκ : ∀ c, κ c = ψ.appTop (κY n k c) := fun c => by
    simp only [κ, κY, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rfl
  obtain ⟨δ₀, hδ₀⟩ := span_eq_top_of_charts (ψ ≫ rk₁ n k) (ψ ≫ rk₂ n k) κ
    (chartHom_comp_surjective ψ κ hκ) (isCompact_chart_comp ψ)
  refine ⟨δ₀, fun δ₁ δ₂ h₁ h₂ (s : Γ(formSheaf ψ δ₁ δ₂, ⊤)) => ?_⟩
  let : Module k Γ(formSheaf ψ δ₁ δ₂, ⊤) := Module.compHom _ κ
  have hs := hδ₀ δ₁ δ₂ h₁ h₂ _ _ (isChartMonomialFamily_formMonoSec ψ δ₁ δ₂)
  obtain ⟨c, rfl⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp (hs ▸ Submodule.mem_top (x := s))
  refine ⟨⟨∑ e ∈ c.support, MvPolynomial.monomial (monoExponent e) (c e),
    Submodule.sum_mem _ fun e _ => isWeightedHomogeneous_monomial_monoExponent e (c e)⟩, ?_⟩
  simp only [map_sum, MvPolynomial.map_monomial, vojtaFormRestriction_monomial_monoExponent]
  rfl

/-- `exists_surjective_vojtaFormRestriction` for `ψ = φ × φ : C ×_k C ⟶ ℙⁿ_k ×_k ℙⁿ_k`, where
`φ : C ⟶ ℙⁿ_k` is a closed immersion over `k`; for instance `φ_{NP}`. -/
theorem exists_surjective_vojtaFormRestriction_map {C : Scheme.{u}} (f : C ⟶ Spec (.of k))
    (φ : C ⟶ projectiveSpaceOver n (Spec (.of k)))
    (hφ : φ ≫ (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) = f) [IsClosedImmersion φ] :
    ∃ δ₀ : ℕ, ∀ δ₁ δ₂ : ℕ, δ₀ ≤ δ₁ → δ₀ ≤ δ₂ →
      Function.Surjective fun G : MvPolynomial.weightedHomogeneousSubmodule k
          (Sum.elim (fun _ => ((1 : ℕ), (0 : ℕ))) (fun _ => ((0 : ℕ), (1 : ℕ))) :
            Fin (n + 1) ⊕ Fin (n + 1) → ℕ × ℕ) (δ₁, δ₂) =>
        vojtaFormRestriction (pullback.map f f _ _ φ φ (𝟙 _) (by simp [hφ]) (by simp [hφ])) δ₁ δ₂
          (G.1.map (Scheme.ΓSpecIso (.of k)).inv.hom) := by
  have : MorphismProperty.IsStableUnderComposition @IsClosedImmersion :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have : IsClosedImmersion (pullback.map f f (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k))
      (projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) φ φ (𝟙 _) (by simp [hφ])
      (by simp [hφ])) :=
    MorphismProperty.pullbackMap (P := @IsClosedImmersion)
      (f' := projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k))
      (g' := projectiveSpaceOver n (Spec (.of k)) ↘ Spec (.of k)) ‹_› ‹_› hφ.symm hφ.symm
  exact exists_surjective_vojtaFormRestriction _

end FormRestriction

section Statement

variable {k : Type u} [Field k]

/-- **Sections of `𝒪(δ₁ (NP) × C + δ₂ C × (NP))` are restrictions of forms.** Let `X = (C, P)` be
a curve over `k` with a divisor of degree one, of genus `g`, let `N ≥ 2g + 1`, let `L` be an
invertible `𝒪_C`-module of class `N • [𝒪_C(P)]`, and let `x₀, …, xₙ` be a `k`-basis of
`Γ(C, L)`, generating `L`, with morphism `φ = toProjectiveSpaceOver x hx X.f : C ⟶ ℙⁿ_k` and
`ψ = φ × φ`. Then there is `δ₀` such that for all `δ₁, δ₂ ≥ δ₀` the restrictions along `ψ` of
the monomials `T^a T'^b` of bidegree `(δ₁, δ₂)` span the global sections of
`ψ^* 𝒪(δ₁, δ₂) = q₁^* 𝒪(δ₁) ⊗ q₂^* 𝒪(δ₂)` over `k`, where `qᵢ : C ×_k C ⟶ ℙⁿ_ℤ` is `ψ`
followed by the `i`-th projection and the map to the integral model. -/
@[faltings "lem_nt_vojta_embeddings"]
theorem CurveWithDegreeOneDivisor.span_tensorSections_monomialSection_eq_top
    (X : CurveWithDegreeOneDivisor k) (N : ℕ) (hN : 2 * genus X.f + 1 ≤ N)
    (L : X.C.Modules) [hLinv : Stacks.Ample.IsInvertibleModule X.C L]
    (hL : Stacks.SheafOfModules.picardClass X.C.presheaf
        (Stacks.RingedSpace.structureIsSheaf X.C.toRingedSpace) L
        (Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ L hLinv) =
      (N : ℤ) • X.P.sum fun x n =>
        haveI : Smooth X.f := SmoothOfRelativeDimension.smooth 1 X.f
        haveI : IsCurve k X.f := Stacks.Chow.isCurve_of_smoothOfRelativeDimension_one X.f
        haveI := Stacks.Zeta.isEffectiveCartierDivisor_pointIdeal X.f x
        n • Stacks.Divisors.picardClass (Stacks.Zeta.pointIdeal x)) :
    letI : X.C.Over (Spec (.of k)) := ⟨X.f⟩
    letI : (pullback X.f X.f).Over (Spec (.of k)) := ⟨pullback.fst X.f X.f ≫ X.f⟩
    ∀ {n : ℕ} (x : Module.Basis (Fin (n + 1)) k Γ(L, ⊤))
      (hx : Stacks.ProjectiveFromSections.GeneratesStalks ⇑x),
    let p : projectiveSpaceOver n (Spec (.of k)) ⟶ Spec (.of k) := pullback.fst _ _
    let φ := Stacks.ProjectiveFromSections.toProjectiveSpaceOver ⇑x hx X.f
    let ψ : pullback X.f X.f ⟶ pullback p p :=
      pullback.map X.f X.f p p φ φ (𝟙 _) (by simp [φ, p]) (by simp [φ, p])
    let q₁ := ψ ≫ pullback.fst p p ≫ projectiveSpaceOver.toIntegralAtUniverse n _
    let q₂ := ψ ≫ pullback.snd p p ≫ projectiveSpaceOver.toIntegralAtUniverse n _
    ∃ δ₀ : ℕ, ∀ δ₁ δ₂ : ℕ, δ₀ ≤ δ₁ → δ₀ ≤ δ₂ →
      let M₁ := (Scheme.Modules.pullback q₁).obj
        (projectiveSpaceAtUniverseTwistingSheaf.{u} n δ₁)
      let M₂ := (Scheme.Modules.pullback q₂).obj
        (projectiveSpaceAtUniverseTwistingSheaf.{u} n δ₂)
      let T : (pullback X.f X.f).Modules :=
        Stacks.SheafOfModules.Invertible.tensorProduct (pullback X.f X.f).toRingedSpace.presheaf
          (structureSheafRing (pullback X.f X.f).toRingedSpace).property M₁ M₂
      let mono : MonomialIndex.{u} n δ₁ × MonomialIndex.{u} n δ₂ → Γ(T, ⊤) := fun e =>
        (Scheme.Modules.sectionsTopEquiv T).symm
          (tensorSections M₁ M₂
            (Scheme.Modules.sectionsTopEquiv M₁
              (pullbackGlobalSections q₁ _ (monomialSectionAtUniverse e.1)))
            (Scheme.Modules.sectionsTopEquiv M₂
              (pullbackGlobalSections q₂ _ (monomialSectionAtUniverse e.2))))
      Submodule.span k (Set.range mono) = ⊤ := by
  let : X.C.Over (Spec (.of k)) := ⟨X.f⟩
  let : (pullback X.f X.f).Over (Spec (.of k)) := ⟨pullback.fst X.f X.f ≫ X.f⟩
  intro n x hx p φ ψ q₁ q₂
  have : IsClosedImmersion ψ :=
    (CurveWithDegreeOneDivisor.isClosedImmersion_map_toProjectiveSpaceOver X N hN L hL x hx).1
  have h₁ : ∀ d : ℕ, Stacks.Ample.IsInvertibleModule _ (twistPullback q₁ d) := fun d =>
    Stacks.InvertiblePullback.isInvertibleModule_pullback q₁ _
  have h₂ : ∀ d : ℕ, Stacks.Ample.IsInvertibleModule _ (twistPullback q₂ d) := fun d =>
    Stacks.InvertiblePullback.isInvertibleModule_pullback q₂ _
  set κX : k →+* Γ(pullback X.f X.f, ⊤) :=
    Stacks.AlgebraicGeometry.ProjectiveSpaceGeneratingSections.baseRingHom k (pullback X.f X.f)
    with hκX
  -- the `k`-structure of `C ×_k C` is pulled back from that of `ℙⁿ_k ×_k ℙⁿ_k`
  have hfst : ψ ≫ pullback.fst p p ≫ p = pullback.fst X.f X.f ≫ X.f := by
    rw [← Category.assoc, pullback.lift_fst, Category.assoc,
      Stacks.ProjectiveFromSections.toProjectiveSpaceOver_fst]
  have hκ : ∀ c, κX c = ψ.appTop (κY n k c) := by
    intro c
    rw [hκX, Stacks.AlgebraicGeometry.ProjectiveSpaceGeneratingSections.baseRingHom, κY,
      ← ConcreteCategory.comp_apply, Category.assoc, ← Scheme.Hom.comp_appTop, hfst]
    rfl
  -- the charts of `C ×_k C` are the preimages of those of `ℙⁿ_k ×_k ℙⁿ_k`
  have hchart : ∀ i j G, chartHom q₁ q₂ κX i j G =
      ψ.appLE (chart (rk₁ n k) (rk₂ n k) i j) (chart q₁ q₂ i j) le_rfl
        (chartHom (rk₁ n k) (rk₂ n k) (κY n k) i j G) := by
    intro i j G
    have e := MvPolynomial.ringHom_ext (f := chartHom q₁ q₂ κX i j)
      (g := (ψ.appLE (chart (rk₁ n k) (rk₂ n k) i j) (chart q₁ q₂ i j) le_rfl).hom.comp
        (chartHom (rk₁ n k) (rk₂ n k) (κY n k) i j)) (fun c => ?_) (fun l => ?_)
    · exact congrArg (fun f => f G) e
    · rw [RingHom.comp_apply, chartHom_C, chartHom_C, hκ]
      exact ((Stacks.TwistPullbackPinned.appLE_apply ψ ⊤ _ _ _).symm.trans
        (ConcreteCategory.congr_hom (Scheme.Hom.map_appLE ψ
          (le_rfl : chart q₁ q₂ i j ≤ ψ ⁻¹ᵁ chart (rk₁ n k) (rk₂ n k) i j)
          (homOfLE le_top).op) (κY n k c)).symm)
    · rcases l with l | l
      · rw [RingHom.comp_apply, chartHom_X_inl, chartHom_X_inl]
        exact (ConcreteCategory.congr_hom (Scheme.Hom.appLE_comp_appLE ψ (rk₁ n k) (stdOpen i)
          (chart (rk₁ n k) (rk₂ n k) i j) (chart q₁ q₂ i j) inf_le_left le_rfl)
            (ratio i l.down)).symm
      · rw [RingHom.comp_apply, chartHom_X_inr, chartHom_X_inr]
        exact (ConcreteCategory.congr_hom (Scheme.Hom.appLE_comp_appLE ψ (rk₂ n k) (stdOpen j)
          (chart (rk₁ n k) (rk₂ n k) i j) (chart q₁ q₂ i j) inf_le_right le_rfl)
            (ratio j l.down)).symm
  have hsurj : ∀ i j, Function.Surjective (chartHom q₁ q₂ κX i j) := by
    intro i j z
    have hs := ψ.app_surjective _ (isAffineOpen_chart_k n k i j)
    rw [Scheme.Hom.app_eq_appLE] at hs
    obtain ⟨y, hy⟩ := hs z
    obtain ⟨G, rfl⟩ := chartHom_k_surjective n k i j y
    exact ⟨G, (hchart i j G).trans hy⟩
  exact span_tensorMonoSec_eq_top_of_charts q₁ q₂ κX hsurj
    fun i j => ((isAffineOpen_chart_k n k i j).preimage ψ).isCompact

end Statement

end Faltings
